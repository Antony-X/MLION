# Cloudflare Pages response headers (tools/deploy.sh copies this file into the upload).
# The Content-Security-Policy itself is a <meta> tag in index.html (tools/build.js stamps its script hashes);
# frame-ancestors only works as a header, so it is sent here. Two policies both apply: each can only tighten.
/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# The page and the service worker: always ask the server (an unchanged file costs a 304).
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

# Scripts and styles are loaded with ?v=<content hash> (tools/build.js), and the vendored libraries have
# their version in the file name, so a cached copy never goes stale.
/js/*
  Cache-Control: public, max-age=31536000, immutable
/css/*
  Cache-Control: public, max-age=31536000, immutable

# Icons and the link-preview image keep their names across versions: a day.
/img/*
  Cache-Control: public, max-age=86400
