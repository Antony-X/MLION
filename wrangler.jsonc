// Cloudflare hosting: a static-assets Worker (what Cloudflare Pages is now part of). No server code runs:
// every request is a file from dist/, which tools/deploy.sh fills with only the files the site serves.
// Deploy with `bash tools/deploy.sh` (needs a one-time `npx wrangler login`).
{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "mlion",
  "compatibility_date": "2026-11-04",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "none",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "mlion.lol", "custom_domain": true },
    { "pattern": "www.mlion.lol", "custom_domain": true }
  ]
}
