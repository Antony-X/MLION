{
  "id": "learning-paradigm",
  "pack": "theory",
  "text": "Name a learning paradigm",
  "note": "Supervised, unsupervised and every way of learning in between: settings defined by what signal or data the learner gets",
  "strip": ["learning", "paradigm", "supervision"],
  "answers": [
    { "a": "Learning using privileged information", "t": "mlion", "aka": ["LUPI", "privileged information", "learning with privileged information"], "q": "Vapnik's twist: a teacher's hints you get during training and never at test time." },

    { "a": "Learning from label proportions", "t": "longtail", "aka": ["LLP", "label proportions"], "q": "You only learn what fraction of each bag is positive. Think election results." },
    { "a": "Partial label learning", "t": "longtail", "aka": ["partial label", "superset label learning", "ambiguous label learning"] },
    { "a": "Complementary-label learning", "t": "longtail", "aka": ["complementary label"], "q": "Every label you get says what the example is NOT." },
    { "a": "Selective classification", "t": "longtail", "aka": ["learning with rejection", "classification with reject option", "reject option"] },
    { "a": "Learning to defer", "t": "longtail", "aka": ["L2D"] },
    { "a": "Never-ending learning", "t": "longtail", "aka": ["NELL", "never ending language learner"], "q": "CMU's NELL read the web nonstop from 2010, one belief at a time." },
    { "a": "Machine teaching", "t": "longtail", "q": "Flip the problem: find the smallest training set that teaches a known target." },
    { "a": "Self-paced learning", "t": "longtail", "aka": ["self-paced"] },
    { "a": "Dual learning", "t": "longtail" },
    { "a": "Distant supervision", "t": "longtail", "aka": ["distantly supervised"] },
    { "a": "Data programming", "t": "longtail", "aka": ["snorkel", "programmatic labeling", "labeling functions"] },
    { "a": "Split learning", "t": "longtail" },
    { "a": "Learning classifier systems", "t": "longtail", "aka": ["LCS", "learning classifier system"] },
    { "a": "Concept learning", "t": "longtail", "aka": ["version space learning", "version spaces"] },
    { "a": "Inductive logic programming", "t": "longtail", "aka": ["ILP"] },
    { "a": "Explanation-based learning", "t": "longtail", "aka": ["EBL"] },
    { "a": "Statistical relational learning", "t": "longtail", "aka": ["SRL", "relational learning"] },
    { "a": "Competitive learning", "t": "longtail", "aka": ["winner-take-all learning"] },
    { "a": "Differentially private learning", "t": "longtail", "aka": ["DP learning", "private learning", "differential privacy"] },
    { "a": "RLAIF", "t": "longtail", "aka": ["reinforcement learning from AI feedback"] },
    { "a": "Class-incremental learning", "t": "longtail", "aka": ["class incremental", "class-IL"] },
    { "a": "One-class classification", "t": "longtail", "aka": ["one-class learning", "one class", "novelty detection"] },
    { "a": "Inductive learning", "t": "longtail", "aka": ["induction"] },
    { "a": "Batch learning", "t": "longtail", "aka": ["offline learning"] },
    { "a": "Multi-view learning", "t": "longtail", "aka": ["multi-view"] },
    { "a": "Cost-sensitive learning", "t": "longtail", "aka": ["cost sensitive"] },

    { "a": "Inverse reinforcement learning", "t": "outlier", "aka": ["IRL", "inverse RL"], "q": "Watch the expert, infer the reward they must have been chasing." },
    { "a": "Offline RL", "t": "outlier", "aka": ["offline reinforcement learning", "batch RL", "batch reinforcement learning"], "q": "Learn a policy from a fixed log, no new interaction allowed. Distribution shift is the enemy." },
    { "a": "Multi-agent RL", "t": "outlier", "aka": ["MARL", "multi-agent reinforcement learning", "multi-agent learning"] },
    { "a": "Hierarchical RL", "t": "outlier", "aka": ["HRL", "hierarchical reinforcement learning"] },
    { "a": "Model-based RL", "t": "outlier", "aka": ["model-based reinforcement learning", "MBRL"] },
    { "a": "Self-play", "t": "outlier", "q": "AlphaZero's only teacher was itself. Took about a day to beat everyone else." },
    { "a": "Preference learning", "t": "outlier", "aka": ["learning from preferences"] },
    { "a": "Multiple instance learning", "t": "outlier", "aka": ["MIL", "multi-instance learning", "multiple-instance"], "q": "Labels come per bag, not per item. Born from drug-activity prediction." },
    { "a": "Positive-unlabeled learning", "t": "outlier", "aka": ["PU learning", "PU", "positive unlabeled"], "q": "Some positives, a pile of unknowns. Elkan & Noto showed you can still estimate p(y|x)." },
    { "a": "Multi-label learning", "t": "outlier", "aka": ["multi-label", "multilabel"] },
    { "a": "Learning to rank", "t": "outlier", "aka": ["LTR", "LETOR"] },
    { "a": "Metric learning", "t": "outlier", "aka": ["deep metric learning", "similarity learning", "distance metric learning"] },
    { "a": "Co-training", "t": "outlier", "q": "Blum & Mitchell 1998: two views of the data teach each other." },
    { "a": "Transductive learning", "t": "outlier", "aka": ["transduction", "transductive inference"], "q": "Vapnik: don't solve a harder problem than you need. Just label the test points you have." },
    { "a": "Instance-based learning", "t": "outlier", "aka": ["lazy learning", "memory-based learning"] },
    { "a": "Multimodal learning", "t": "outlier", "aka": ["multimodal", "multi-modal learning", "cross-modal learning"] },
    { "a": "Domain generalization", "t": "outlier", "aka": ["DG", "OOD generalization", "out-of-distribution generalization"] },
    { "a": "Open-world learning", "t": "outlier", "aka": ["open-set recognition", "open set", "open world"] },
    { "a": "Test-time training", "t": "outlier", "aka": ["TTT", "test-time adaptation", "TTA"], "q": "Keep learning on each test input with a self-supervised loss before predicting." },
    { "a": "Bandits", "t": "outlier", "aka": ["multi-armed bandits", "bandit learning", "contextual bandits", "MAB"], "q": "RL with one state. The slot-machine problem that runs half the internet's A/B tests." },
    { "a": "PAC learning", "t": "outlier", "aka": ["PAC", "probably approximately correct"], "q": "Valiant 1984: probably approximately correct, with polynomially many samples." },
    { "a": "Bayesian learning", "t": "outlier", "aka": ["bayesian", "bayesian deep learning"] },
    { "a": "Ensemble learning", "t": "outlier", "aka": ["ensembles", "ensembling"] },
    { "a": "Structured prediction", "t": "outlier", "aka": ["structured output learning", "structured learning"] },
    { "a": "Learning with noisy labels", "t": "outlier", "aka": ["noisy labels", "noisy label learning", "label noise"] },
    { "a": "Hebbian learning", "t": "outlier", "aka": ["hebbian"], "q": "Cells that fire together wire together. Hebb, 1949." },
    { "a": "Neuroevolution", "t": "outlier", "aka": ["evolutionary learning", "evolutionary"], "q": "Evolve the weights, the topology, or both. No gradients required." },
    { "a": "Neuro-symbolic learning", "t": "outlier", "aka": ["neurosymbolic", "neuro-symbolic AI"] },
    { "a": "Causal representation learning", "t": "outlier", "aka": ["causal learning", "CRL"] },
    { "a": "Machine unlearning", "t": "outlier", "aka": ["unlearning"], "q": "Learning's undo button. The GDPR's favorite paradigm." },
    { "a": "Human-in-the-loop", "t": "outlier", "aka": ["HITL", "interactive learning", "interactive machine learning"] },
    { "a": "One-shot learning", "t": "outlier", "aka": ["one-shot"] },

    { "a": "RLHF", "t": "indist", "aka": ["reinforcement learning from human feedback"] },
    { "a": "Self-training", "t": "indist", "aka": ["pseudo-labeling", "pseudo-labelling", "pseudo labels"] },
    { "a": "Knowledge distillation", "t": "indist", "aka": ["distillation", "teacher-student", "student-teacher"], "q": "Hinton et al. 2015: a big teacher's soft labels carry dark knowledge to a small student." },
    { "a": "Transfer learning", "t": "indist", "aka": ["transfer", "fine-tuning", "finetuning", "pretrain-finetune"], "q": "Pretrain on ImageNet, fine-tune on your 500 photos. Saved a generation of PhDs." },
    { "a": "Online learning", "t": "indist", "aka": ["online", "streaming learning", "incremental online learning"] },
    { "a": "Active learning", "t": "indist", "q": "Let the model choose what gets labeled. Your annotators will thank you." },
    { "a": "Multi-task learning", "t": "indist", "aka": ["MTL", "multitask"] },
    { "a": "Few-shot learning", "t": "indist", "aka": ["few-shot", "FSL"] },
    { "a": "Zero-shot learning", "t": "indist", "aka": ["zero-shot", "ZSL", "generalized zero-shot"], "q": "Recognize zebras having only read that they're striped horses." },
    { "a": "Weakly supervised", "t": "indist", "aka": ["weak supervision", "weakly supervised learning", "weakly-supervised"] },
    { "a": "Imitation learning", "t": "indist", "aka": ["behavioral cloning", "behavior cloning", "BC", "learning from demonstration", "LfD", "apprenticeship learning"], "q": "Copy the expert's actions. Works until you drift into states the expert never visited." },
    { "a": "Contrastive learning", "t": "indist", "aka": ["contrastive"] },
    { "a": "Continual learning", "t": "indist", "aka": ["lifelong learning", "incremental learning", "sequential learning", "continual"], "q": "Learn task B without forgetting task A. Catastrophic forgetting says no." },
    { "a": "Curriculum learning", "t": "indist", "aka": ["curriculum"], "q": "Bengio et al. 2009: easy examples first, like school." },
    { "a": "In-context learning", "t": "indist", "aka": ["ICL", "in context", "prompting"] },
    { "a": "Representation learning", "t": "indist", "aka": ["feature learning"] },
    { "a": "Domain adaptation", "t": "indist", "aka": ["UDA", "unsupervised domain adaptation"] },

    { "a": "Meta-learning", "t": "overfit", "aka": ["learning to learn", "meta learning"], "q": "Learning to learn. The paradigm that sounds clever enough that everyone types it." },
    { "a": "Federated learning", "t": "overfit", "aka": ["FL", "federated"], "q": "Train on a billion phones without the data leaving them. McMahan et al. 2017." },

    { "a": "Supervised learning", "t": "baseline", "aka": ["supervised"], "q": "Inputs with answers attached. The paradigm that made labeling a job title." },
    { "a": "Unsupervised learning", "t": "baseline", "aka": ["unsupervised"] },
    { "a": "Reinforcement learning", "t": "baseline", "aka": ["RL", "reinforcement"], "q": "No labels, just rewards, often late. Sutton & Barto wrote the book. Literally." },
    { "a": "Self-supervised learning", "t": "baseline", "aka": ["self-supervised", "SSL", "self supervision"], "q": "The data labels itself: mask it, predict it. LeCun's cake, minus the cherry." },
    { "a": "Semi-supervised learning", "t": "baseline", "aka": ["semi-supervised", "semisupervised"], "q": "A few labels, a lot of unlabeled data, and the hope that clusters mean classes." }
  ]
}
