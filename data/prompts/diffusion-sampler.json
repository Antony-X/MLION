    { "a": "Probability flow ODE", "t": "outlier", "aka": ["PF-ODE", "probability flow"], "q": "The deterministic ODE that shares the reverse SDE's marginals. Song et al., 2021." },
    { "a": "Euler–Maruyama", "t": "outlier", "aka": ["reverse SDE", "reverse diffusion"] },
    { "a": "Predictor-corrector", "t": "outlier", "aka": ["PC sampler", "langevin corrector"] },
    { "a": "Restart", "t": "outlier", "q": "Alternate big forward noise jumps with ODE steps to wash out accumulated error." },
    { "a": "Exponential", "t": "outlier", "aka": ["use_exponential_sigmas"] },
    { "a": "Zero terminal SNR", "t": "outlier", "aka": ["zero SNR", "rescale_betas_zero_snr", "zsnr"], "q": "A schedule that never reaches pure noise can't make a truly dark image. Fix the last step." },
    { "a": "Scaled linear", "t": "outlier" },
    { "a": "Consistency model sampling", "t": "outlier", "aka": ["consistency models", "multistep consistency sampling", "CMStochasticIterativeScheduler"] },
    { "a": "TCD", "t": "outlier", "aka": ["trajectory consistency distillation", "TCDScheduler"] },
    { "a": "Flow Match Euler", "t": "outlier", "aka": ["FlowMatchEulerDiscreteScheduler", "flow matching euler", "rectified flow euler"] },
    { "a": "Align Your Steps", "t": "outlier", "aka": ["AYS", "AlignYourStepsScheduler", "align your steps 11", "align your steps 32"], "q": "NVIDIA's optimized few-step schedules for Stable Diffusion and SVD." },

    { "a": "Heun", "t": "indist", "aka": ["Heun's method", "k_heun", "HeunDiscreteScheduler", "heun 2nd order"], "q": "Euler, then a correction: second order for two model calls a step. EDM's pick." },
    { "a": "LMS", "t": "indist", "aka": ["linear multistep", "LMS Karras", "k_lms", "LMSDiscreteScheduler"] },
