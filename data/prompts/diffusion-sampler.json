    { "a": "DPM-Solver", "t": "indist", "aka": ["DPM"], "q": "Solve the linear part exactly, Taylor-expand the rest: good samples in 10–20 steps." },
    { "a": "DPM-Solver++", "t": "indist", "aka": ["DPM++", "dpmpp"] },
    { "a": "DPM2", "t": "indist", "aka": ["k_dpm_2", "DPM2 Karras", "KDPM2DiscreteScheduler"] },
    { "a": "UniPC", "t": "indist", "aka": ["uni_pc", "unified predictor-corrector", "UniPCMultistepScheduler", "uni_pc_bh2"], "q": "Unified predictor-corrector: its corrector bolts onto other solvers at no extra model calls." },
    { "a": "LCM", "t": "indist", "aka": ["latent consistency model", "LCMScheduler"], "q": "Latent consistency distillation: decent images in four steps." },
    { "a": "Karras", "t": "indist", "aka": ["karras schedule", "karras sigmas", "use_karras_sigmas"], "q": "EDM's sigmas, spaced with ρ = 7. Appended to half the sampler names in A1111." },
    { "a": "Linear schedule", "t": "indist", "aka": ["linear beta schedule"] },
    { "a": "Cosine schedule", "t": "indist", "aka": ["squaredcos_cap_v2", "improved DDPM cosine"], "q": "Improved DDPM's schedule, gentler on information than linear. squaredcos_cap_v2 in diffusers." },
    { "a": "Annealed Langevin dynamics", "t": "indist", "aka": ["langevin dynamics", "annealed langevin", "langevin", "ALD"], "q": "NCSN, 2019: Langevin steps at shrinking noise levels. Diffusion's score-based ancestor." },

    { "a": "DPM++ 2M", "t": "overfit", "aka": ["DPM++ 2M Karras", "dpmpp_2m", "dpmpp 2m karras", "DPM-Solver++(2M)", "DPMSolverMultistepScheduler", "dpm solver multistep"], "q": "Second-order multistep DPM-Solver++. Add Karras sigmas and it's what countless model cards recommend." },
    { "a": "Euler ancestral", "t": "overfit", "aka": ["Euler a", "k_euler_a", "k_euler_ancestral", "EulerAncestralDiscreteScheduler"], "q": "A1111's default: Euler plus fresh noise every step, so more steps never quite converge." },

    { "a": "DDPM", "t": "baseline", "aka": ["denoising diffusion probabilistic models", "DDPMScheduler", "ancestral sampling"], "q": "Ho et al., 2020: a thousand small denoising steps, one at a time." },
    { "a": "DDIM", "t": "baseline", "aka": ["denoising diffusion implicit models", "DDIMScheduler"], "q": "Same training, non-Markovian sampling: 50 deterministic steps instead of 1,000." },
    { "a": "Euler", "t": "baseline", "aka": ["k_euler", "EulerDiscreteScheduler", "Euler Karras", "euler discrete"], "q": "First-order and humble, yet the default in most flow-matching pipelines." }
  ]
}
