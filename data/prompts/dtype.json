{
  "id": "dtype",
  "pack": "stack",
  "text": "Name a numeric data type used in ML",
  "note": "Precisions and number formats such as FP32, BF16, INT8, FP8 E4M3, MXFP4, NF4, TF32",
  "strip": ["precision", "format", "dtype", "number", "numbers"],
  "answers": [
    { "a": "Posit", "t": "mlion", "aka": ["posits", "unum", "type iii unum", "posit arithmetic", "posit8", "posit16", "posit32"], "q": "Gustafson's IEEE 754 challenger: tapered precision, a single NaR, and no negative zero." },

    { "a": "MXFP8", "t": "longtail", "aka": ["mx fp8"] },
    { "a": "MXFP6", "t": "longtail", "aka": ["mx fp6"] },
    { "a": "MXINT8", "t": "longtail", "aka": ["mx int8"] },
    { "a": "FP6", "t": "longtail", "aka": ["e3m2", "e2m3", "fp6-llm", "float6"] },
    { "a": "E8M0", "t": "longtail", "aka": ["ue8m0", "float8_e8m0fnu", "e8m0 scale"], "q": "All exponent, no mantissa: the shared power-of-two scale in every MX block." },
    { "a": "Block floating point", "t": "longtail", "aka": ["BFP", "block float", "blockfloat"] },
    { "a": "MSFP", "t": "longtail", "aka": ["microsoft floating point", "msfp12", "msfp16"], "q": "Project Brainwave's block-float format, a precursor of today's MX formats." },
    { "a": "Flexpoint", "t": "longtail", "aka": ["flex16+5"], "q": "Intel Nervana's 2017 format: 16-bit mantissas sharing one tensor-wide exponent." },
    { "a": "Logarithmic number system", "t": "longtail", "aka": ["LNS", "log format", "logarithmic"] },
    { "a": "Float128", "t": "longtail", "aka": ["quad precision", "fp128", "binary128", "quad"] },
    { "a": "CFloat8", "t": "longtail", "aka": ["cfloat16", "cfp8", "cfp16", "configurable float"], "q": "Tesla Dojo's configurable floats: software picks the exponent bias." },
    { "a": "HFP8", "t": "longtail", "aka": ["hybrid fp8", "hybrid 8-bit floating point"] },
    { "a": "DLFloat", "t": "longtail", "aka": ["dlfloat16", "dlfloat-16"] },
    { "a": "AdaptivFloat", "t": "longtail" },
    { "a": "Dynamic fixed point", "t": "longtail", "aka": ["dfxp", "dynamic fixed-point"] },
    { "a": "Minifloat", "t": "longtail", "aka": ["minifloats"] },
    { "a": "INT2", "t": "longtail", "aka": ["2-bit", "int2 quantization", "2-bit integer"] },
    { "a": "INT3", "t": "longtail", "aka": ["3-bit", "3-bit integer"] },
    { "a": "Complex128", "t": "longtail", "aka": ["cdouble", "complex double"] },

    { "a": "E4M3", "t": "outlier", "aka": ["fp8 e4m3", "e4m3fn", "float8_e4m3fn", "e4m3fnuz", "float8_e4m3fnuz"], "q": "4 exponent bits, 3 mantissa bits, no infinities. FP8 for the forward pass." },
    { "a": "E5M2", "t": "outlier", "aka": ["fp8 e5m2", "float8_e5m2", "e5m2fnuz", "float8_e5m2fnuz", "bf8"], "q": "FP16's exponent range squeezed into 8 bits. The gradient-friendly FP8." },
    { "a": "MXFP4", "t": "outlier", "aka": ["mx fp4", "microscaling", "microscaling fp4", "ocp mx"], "q": "32 E2M1 values sharing one power-of-two scale. gpt-oss shipped its weights in it." },
    { "a": "NVFP4", "t": "outlier", "aka": ["nvidia fp4"], "q": "Blackwell's FP4: 16-value blocks with FP8 scales, plus a per-tensor FP32 scale." },
    { "a": "FP4", "t": "outlier", "aka": ["e2m1", "float4", "4-bit float", "float4_e2m1fn", "float4_e2m1fn_x2", "bnb fp4"] },
    { "a": "INT16", "t": "outlier", "aka": ["short", "16-bit integer", "torch.int16", "np.int16"] },
    { "a": "Binary", "t": "outlier", "aka": ["1-bit", "binarized", "binary weights", "xnor", "int1", "bnn"], "q": "Weights and activations of ±1, multiplied with XNOR and popcount." },
    { "a": "Fixed-point", "t": "outlier", "aka": ["q format", "qm.n", "fixed", "q15", "q31", "q7"] },
    { "a": "Complex64", "t": "outlier", "aka": ["cfloat", "complex float", "complex"] },
    { "a": "K-quants", "t": "outlier", "aka": ["q4_k_m", "q4_0", "q8_0", "q5_k_m", "q6_k", "ggml quant types", "gguf quants"], "q": "llama.cpp's block-quantized types. Q4_K_M: the local-LLM default nobody can explain." },

    { "a": "FP64", "t": "indist", "aka": ["float64", "double", "double precision", "binary64", "torch.float64", "np.float64", "numpy float64", "torch.double", "tf.float64"] },
    { "a": "TF32", "t": "indist", "aka": ["tensorfloat-32", "tensor float 32"], "q": "NVIDIA's 19-bit format: FP32's exponent range with FP16's 10-bit mantissa, used inside Ampere tensor cores." },
    { "a": "INT4", "t": "indist", "aka": ["4-bit integer", "int4 quantization", "4-bit"] },
    { "a": "NF4", "t": "indist", "aka": ["normalfloat4", "4-bit normalfloat", "normal float 4", "normalfloat"], "q": "QLoRA's 4-bit type, with levels at the quantiles of a normal distribution." },
    { "a": "UINT8", "t": "indist", "aka": ["unsigned 8-bit", "byte", "uint8 image", "torch.uint8", "np.uint8"] },
    { "a": "INT32", "t": "indist", "aka": ["int", "32-bit integer", "integer", "torch.int32", "np.int32", "tf.int32"] },
    { "a": "INT64", "t": "indist", "aka": ["long", "64-bit integer", "torch.long", "torch.int64", "np.int64", "tf.int64"] },
    { "a": "Bool", "t": "indist", "aka": ["boolean", "torch.bool"] },

    { "a": "FP8", "t": "overfit", "aka": ["float8", "8-bit float", "8-bit floating point"], "q": "Hopper's headline format. Comes in two flavors, E4M3 and E5M2, so choose wisely." },
    { "a": "Ternary", "t": "overfit", "aka": ["1.58-bit", "ternary weights", "bitnet b1.58", "trit", "int1.58", "bitnet"], "q": "BitNet b1.58: every weight in {−1, 0, 1}, log₂3 ≈ 1.58 bits. 'The Era of 1-bit LLMs.'" },

    { "a": "FP32", "t": "baseline", "aka": ["float32", "single precision", "float", "binary32", "single", "torch.float32", "np.float32", "numpy float32", "tf.float32", "torch.float"] },
    { "a": "FP16", "t": "baseline", "aka": ["float16", "half precision", "half", "binary16", "torch.float16", "np.float16", "tf.float16", "torch.half"] },
    { "a": "BF16", "t": "baseline", "aka": ["bfloat16", "brain float", "brain floating point", "bfloat", "torch.bfloat16", "tf.bfloat16"], "q": "The B is for Google Brain: FP32's exponent range with only 7 mantissa bits." },
    { "a": "INT8", "t": "baseline", "aka": ["8-bit integer", "8-bit", "8-bit quantization", "torch.int8", "np.int8", "int8 quantization"] },
    { "a": "UINT16", "t": "longtail", "aka": ["unsigned 16-bit", "torch.uint16", "np.uint16"] },
    { "a": "UINT32", "t": "longtail", "aka": ["unsigned 32-bit", "torch.uint32", "np.uint32"] },
    { "a": "UINT64", "t": "longtail", "aka": ["unsigned 64-bit", "torch.uint64", "np.uint64"] },
    { "a": "UINT4", "t": "longtail", "aka": ["unsigned 4-bit"] },
    { "a": "MX9", "t": "longtail", "aka": ["mx6", "mx4", "shared microexponents"] },
    { "a": "I-quants", "t": "longtail", "aka": ["iq4_xs", "iq3_xxs", "iq2_xs", "iq4_nl", "imatrix quants"] },
    { "a": "qint8", "t": "longtail", "aka": ["quint8", "qint32", "quint4x2", "torch.qint8"] },
    { "a": "Complex32", "t": "longtail", "aka": ["chalf", "torch.complex32"] },
    { "a": "Float80", "t": "longtail", "aka": ["fp80", "x87", "extended precision", "80-bit float"] },
    { "a": "S2FP8", "t": "longtail", "aka": ["shifted and squeezed fp8"] }
  ]
}
