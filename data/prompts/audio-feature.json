    { "a": "MFCC", "t": "baseline", "aka": ["mel-frequency cepstral coefficients", "mel frequency cepstral coefficients", "mel cepstral coefficients", "MFCCs", "mfcc features"], "q": "Mel filterbank, log, then a DCT. Speech recognition's workhorse since Davis and Mermelstein, 1980." },
    { "a": "Mel spectrogram", "t": "baseline", "aka": ["mel-spectrogram", "melspectrogram", "mel spec", "mel scale spectrogram", "mel", "log-mel spectrogram", "log mel spectrogram", "log-mel", "log mel", "logmel", "mel spectrograms", "mel scale"], "q": "A spectrogram whose frequency axis is bent to the mel scale. What Whisper's encoder reads." },
    { "a": "Spectrogram", "t": "baseline", "aka": ["spectrograms", "magnitude spectrogram", "power spectrogram", "linear spectrogram", "spectrogram image", "log spectrogram", "amplitude spectrogram", "sonogram", "log-magnitude spectrogram"], "q": "Time on one axis, frequency on the other, brightness for energy." },
    { "a": "STFT", "t": "baseline", "aka": ["short-time Fourier transform", "short time Fourier transform", "windowed Fourier transform", "short-term Fourier transform", "stft magnitude", "short-time Fourier", "Fourier transform", "FFT", "DFT", "discrete Fourier transform"], "q": "Slide a window along the signal and take an FFT of each slice. Most spectrograms start here." },
    { "a": "Waveform", "t": "baseline", "aka": ["raw waveform", "raw audio", "audio waveform", "PCM", "samples", "time-domain signal", "amplitude", "raw samples", "wav", "raw waveforms"], "q": "The signal itself: typically 16,000 numbers a second. wav2vec 2.0 learns its own features straight from it." },

