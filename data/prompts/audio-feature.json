    { "a": "Speaker embedding", "t": "outlier", "aka": ["speaker embeddings", "voice embedding", "voiceprint", "speaker vector", "speaker representation", "ECAPA-TDNN", "ECAPA-TDNN embedding", "ECAPA", "speaker verification embedding"] },
