    { "a": "Neural codec tokens", "t": "outlier", "aka": ["codec tokens", "EnCodec tokens", "discrete audio tokens", "audio tokens", "RVQ tokens", "residual vector quantization codes", "SoundStream tokens", "DAC tokens", "audio codec codes", "neural audio codec", "acoustic tokens", "EnCodec", "SoundStream", "Mimi tokens", "RVQ codes", "audio codec tokens", "DAC", "Descript Audio Codec", "Mimi", "SpeechTokenizer", "audio tokenizer"], "q": "Residual-vector-quantised codes from a neural codec. How LLMs learn to speak: audio becomes a token stream." },
