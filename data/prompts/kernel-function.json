    { "a": "Constant", "t": "outlier", "aka": ["ConstantKernel", "bias kernel"] },
    { "a": "Biweight", "t": "outlier", "aka": ["quartic"] },
    { "a": "Tricube", "t": "outlier", "q": "(1 − |u|³)³. The weight function inside LOESS." },
    { "a": "Chi-squared", "t": "outlier", "aka": ["chi2", "chi-square", "additive chi-squared", "exponential chi-squared", "additive_chi2", "additive_chi2_kernel", "exponential chi2"], "q": "Built for histograms; the go-to for bag-of-visual-words SVMs." },
    { "a": "Histogram intersection", "t": "outlier", "aka": ["intersection kernel", "HIK"], "q": "Σ min(xᵢ, yᵢ). Swain & Ballard's 1991 color-histogram matcher, turned kernel." },
    { "a": "Tanimoto", "t": "outlier", "aka": ["jaccard kernel", "minmax kernel", "tanimoto coefficient"], "q": "Jaccard for molecular fingerprints. The chemist's default similarity, and positive definite." },
    { "a": "Fisher kernel", "t": "outlier", "q": "Jaakkola & Haussler, 1999: compare examples by the gradient of a generative model's log-likelihood." },
    { "a": "String kernel", "t": "outlier", "aka": ["subsequence string kernel", "string subsequence kernel", "SSK", "gap-weighted subsequence kernel"], "q": "Lodhi et al., 2002: compare texts by the gapped subsequences they share." },
    { "a": "Weisfeiler–Lehman", "t": "outlier", "aka": ["WL kernel", "WL subtree kernel", "weisfeiler-lehman subtree"], "q": "Color refinement on graphs, counted. The same test that caps message-passing GNNs." },
    { "a": "Random walk kernel", "t": "outlier", "aka": ["random walk graph kernel", "marginalized graph kernel"] },
    { "a": "Diffusion kernel", "t": "outlier", "aka": ["heat kernel", "graph diffusion kernel", "kondor-lafferty"], "q": "Kondor & Lafferty, 2002: the matrix exponential of a graph Laplacian. Heat spreading over nodes." },
    { "a": "Brownian motion", "t": "outlier", "aka": ["wiener process", "brownian", "wiener", "min kernel"], "q": "min(x, y). The covariance of a random walk in continuous time." },
    { "a": "ARD", "t": "outlier", "aka": ["automatic relevance determination", "ARD RBF", "anisotropic RBF", "ARD squared exponential"], "q": "One lengthscale per input; irrelevant dimensions stretch theirs out toward infinity." },
    { "a": "Locally periodic", "t": "outlier", "aka": ["quasi-periodic"] },
    { "a": "Arc-cosine", "t": "outlier", "aka": ["arccos", "ArcCosine", "cho-saul"] },
    { "a": "NNGP", "t": "outlier", "aka": ["neural network gaussian process", "NNGP kernel", "conjugate kernel"] },
    { "a": "Deep kernel", "t": "outlier", "aka": ["deep kernel learning", "DKL"], "q": "Wilson et al., 2016: run a neural net, then put an RBF on its output." },
    { "a": "Inverse multiquadric", "t": "outlier", "aka": ["IMQ"] },
    { "a": "Thin plate spline", "t": "outlier", "aka": ["TPS", "thin-plate", "polyharmonic spline kernel", "polyharmonic"], "q": "r² log r: the bending energy of a thin metal plate." },

    { "a": "Sigmoid", "t": "indist", "aka": ["tanh", "hyperbolic tangent", "MLP kernel"], "q": "tanh(α⟨x,y⟩ + c). An SVM-tutorial staple, despite not being positive definite." },
    { "a": "Laplacian", "t": "indist", "aka": ["laplace", "laplacian rbf"] },
    { "a": "Matérn", "t": "indist", "aka": ["Matérn 3/2", "Matérn 5/2", "matérn class", "MaternKernel"], "q": "ν = 1/2 is exponential, ν → ∞ is the RBF. 3/2 and 5/2 are the GP sweet spots." },
    { "a": "Rational quadratic", "t": "indist", "aka": ["RQ", "RationalQuadratic", "RQKernel"], "q": "A scale mixture of RBFs: every lengthscale at once." },
    { "a": "Periodic", "t": "indist", "aka": ["exp-sine-squared", "ExpSineSquared", "mackay periodic", "PeriodicKernel"], "q": "MacKay's exp-sine-squared, for data that keeps repeating itself." },
    { "a": "Exponential", "t": "indist", "aka": ["ornstein–uhlenbeck", "OU", "Matérn 1/2", "absolute exponential"] },
    { "a": "Uniform", "t": "indist", "aka": ["rectangular", "boxcar", "tophat", "box"] },
    { "a": "Triangular", "t": "indist", "aka": ["triangle", "tent", "Bartlett kernel", "Bartlett window"] },
    { "a": "Cosine", "t": "indist", "aka": ["cosine similarity kernel", "CosineKernel"], "q": "Two kernels share the name: a normalized dot product for SVMs, and a cos(πu/2) bump for KDE." },
    { "a": "White noise", "t": "indist", "aka": ["WhiteKernel", "white", "noise", "kronecker delta", "delta", "nugget"], "q": "The diagonal term that admits your observations are noisy." },

    { "a": "Epanechnikov", "t": "overfit", "aka": ["parabolic"], "q": "Epanechnikov, 1969: the asymptotically optimal KDE kernel. Barely beats the Gaussian, wins every trivia night." },
    { "a": "Neural tangent kernel", "t": "overfit", "aka": ["NTK", "neural tangent"], "q": "Jacot et al., 2018: infinitely wide nets train like kernel regression. Everyone read that paper." },

    { "a": "Linear", "t": "baseline", "aka": ["dot product", "DotProduct", "inner product", "LinearKernel"], "q": "Just ⟨x, y⟩. The kernel trick, minus the trick." },
