{
  "id": "alignment",
  "pack": "llm",
  "text": "Name a method for aligning or preference-tuning LLMs",
  "note": "Post-training and oversight methods that steer LLMs toward preferred behavior: RL from feedback, direct preference losses, self-improvement and AI feedback",
  "strip": ["method", "algorithm"],
  "answers": [
    { "a": "Nash learning from human feedback", "t": "mlion", "aka": ["NLHF", "Nash-MD"], "q": "Skip the reward model: find the policy that no rival policy is preferred over. RLHF meets game theory." },

    { "a": "ReMax", "t": "longtail" },
    { "a": "VAPO", "t": "longtail" },
    { "a": "VinePPO", "t": "longtail" },
    { "a": "REINFORCE++", "t": "longtail" },
    { "a": "PRIME", "t": "longtail", "aka": ["process reinforcement through implicit rewards"] },
    { "a": "RSO", "t": "longtail", "aka": ["statistical rejection sampling optimization"] },
    { "a": "DPOP", "t": "longtail", "aka": ["DPO-Positive", "Smaug"] },
    { "a": "TDPO", "t": "longtail", "aka": ["token-level DPO"] },
    { "a": "Step-DPO", "t": "longtail" },
    { "a": "R-DPO", "t": "longtail", "aka": ["length-regularized DPO"] },
    { "a": "β-DPO", "t": "longtail" },
    { "a": "BCO", "t": "longtail", "aka": ["binary classifier optimization"] },
    { "a": "NCA", "t": "longtail", "aka": ["noise contrastive alignment", "InfoNCA"] },
    { "a": "GPO", "t": "longtail", "aka": ["generalized preference optimization"] },
    { "a": "f-DPO", "t": "longtail" },
    { "a": "SPPO", "t": "longtail", "aka": ["self-play preference optimization"] },
    { "a": "DNO", "t": "longtail", "aka": ["direct Nash optimization"] },
    { "a": "Quark", "t": "longtail" },
    { "a": "Chain of Hindsight", "t": "longtail", "q": "Turn feedback into text, 'a bad answer: … a good answer: …', and fine-tune on that." },
    { "a": "SteerLM", "t": "longtail" },
    { "a": "ILQL", "t": "longtail", "aka": ["implicit language Q-learning"] },
    { "a": "Rule-Based Rewards", "t": "longtail", "aka": ["RBR"] },
    { "a": "Ghost Attention", "t": "longtail", "aka": ["GAtt"], "q": "Llama 2's trick for keeping a system instruction alive across many turns." },
    { "a": "Preference model pretraining", "t": "longtail", "aka": ["PMP"] },
    { "a": "PRO", "t": "longtail", "aka": ["preference ranking optimization"] },
    { "a": "Instruction hierarchy", "t": "longtail" },
    { "a": "Circuit breakers", "t": "longtail", "aka": ["representation rerouting"] },
    { "a": "WARM", "t": "longtail", "aka": ["weight averaged reward models"] },
    { "a": "RLCD", "t": "longtail", "aka": ["RL from contrastive distillation"] },
    { "a": "RLEF", "t": "longtail", "aka": ["RL from execution feedback"] },
    { "a": "Meta-rewarding", "t": "longtail" },
    { "a": "Instruction backtranslation", "t": "longtail", "aka": ["Humpback"] },
    { "a": "Outcome supervision", "t": "longtail", "aka": ["outcome reward model", "ORM"] },
    { "a": "ReST-EM", "t": "longtail" },
    { "a": "Recursive reward modeling", "t": "longtail", "aka": ["RRM"] },
    { "a": "Safe RLHF", "t": "longtail" },
    { "a": "Context distillation", "t": "longtail" },
    { "a": "RAFT", "t": "longtail", "aka": ["reward ranked fine-tuning"] },
    { "a": "Self-Align", "t": "longtail", "aka": ["principle-driven self-alignment", "Dromedary"] },
    { "a": "LIMA", "t": "longtail", "aka": ["less is more for alignment"], "q": "1,000 curated examples and plain SFT. The Superficial Alignment Hypothesis in one paper." },
    { "a": "Adversarial training", "t": "longtail", "aka": ["latent adversarial training"] },

    { "a": "RLOO", "t": "outlier", "aka": ["REINFORCE leave-one-out"], "q": "REINFORCE where each sample's baseline is the mean of the other k−1. Back to basics." },
    { "a": "DAPO", "t": "outlier", "q": "ByteDance's open GRPO upgrade: clip-higher, dynamic sampling, token-level loss." },
    { "a": "Dr. GRPO", "t": "outlier", "aka": ["GRPO done right"], "q": "GRPO with the length and std normalizations removed. 'Done right.'" },
    { "a": "GSPO", "t": "outlier", "aka": ["group sequence policy optimization"] },
    { "a": "CPO", "t": "outlier", "aka": ["contrastive preference optimization"] },
    { "a": "SPIN", "t": "outlier", "aka": ["self-play fine-tuning"], "q": "The model learns to tell human data from its own previous outputs. Self-play for SFT." },
    { "a": "Self-rewarding language models", "t": "outlier", "aka": ["self-rewarding", "self-rewarding LMs"], "q": "The model judges its own answers to build DPO pairs, trains on them, and repeats." },
    { "a": "Online DPO", "t": "outlier", "aka": ["iterative DPO", "OAIF", "online AI feedback"] },
    { "a": "Expert iteration", "t": "outlier", "aka": ["ExIt"] },
    { "a": "STaR", "t": "outlier", "aka": ["self-taught reasoner"], "q": "Generate rationales, keep the ones that reach the right answer, fine-tune, repeat." },
    { "a": "ReST", "t": "outlier", "aka": ["reinforced self-training"] },
    { "a": "RRHF", "t": "outlier" },
    { "a": "SLiC-HF", "t": "outlier", "aka": ["SLiC", "sequence likelihood calibration"] },
    { "a": "Process supervision", "t": "indist", "aka": ["process reward model", "PRM", "process-based supervision"], "q": "'Let's Verify Step by Step': reward each reasoning step, not just the final answer." },
    { "a": "Deliberative alignment", "t": "outlier", "q": "OpenAI's o-series reasons over the written safety spec before it answers." },
    { "a": "Debate", "t": "outlier", "aka": ["AI safety via debate"], "q": "Two AIs argue, a human judges. Bet: refuting a lie is easier than telling one convincingly." },
    { "a": "Iterated amplification", "t": "outlier", "aka": ["IDA", "iterated distillation and amplification"] },
    { "a": "Weak-to-strong generalization", "t": "outlier", "aka": ["weak-to-strong", "W2S"], "q": "Can GPT-2-level supervision steer GPT-4? OpenAI's superalignment analogy." },
    { "a": "Self-Instruct", "t": "indist" },
    { "a": "Activation steering", "t": "outlier", "aka": ["steering vectors", "representation engineering", "RepE", "activation addition", "ActAdd", "contrastive activation addition", "CAA"], "q": "Add a direction to the residual stream and the model gets nicer. Or obsessed with weddings." },

    { "a": "RLAIF", "t": "indist", "aka": ["reinforcement learning from AI feedback", "AI feedback", "d-RLAIF"] },
    { "a": "SFT", "t": "indist", "aka": ["supervised fine-tuning", "instruction tuning", "instruction fine-tuning", "behavior cloning"] },
    { "a": "KTO", "t": "indist", "aka": ["Kahneman-Tversky optimization"], "q": "Prospect theory for LLMs: losses loom larger than gains. Needs only thumbs-up/down labels." },
    { "a": "ORPO", "t": "indist", "aka": ["odds ratio preference optimization"], "q": "SFT and preference tuning in one loss via an odds-ratio penalty. No reference model." },
    { "a": "IPO", "t": "indist", "aka": ["identity preference optimization", "ΨPO"], "q": "DPO without the Bradley-Terry assumption, so it can't overfit deterministic preferences." },
    { "a": "SimPO", "t": "indist", "aka": ["simple preference optimization"] },
    { "a": "Reward modeling", "t": "indist", "aka": ["reward model", "Bradley-Terry reward model", "preference model", "RM"] },
    { "a": "Best-of-N", "t": "indist", "aka": ["BoN", "rejection sampling", "rejection sampling fine-tuning"], "q": "Sample N, keep the reward model's favorite. Llama 2 fine-tuned on these before PPO." },
    { "a": "RLVR", "t": "indist", "aka": ["RL with verifiable rewards", "reinforcement learning with verifiable rewards", "reinforcement fine-tuning", "verifiable rewards"], "q": "Reward = the answer checks out or the tests pass. Hard to argue with." },
    { "a": "REINFORCE", "t": "indist", "aka": ["policy gradient", "vanilla policy gradient"] },

    { "a": "GRPO", "t": "overfit", "aka": ["group relative policy optimization"], "q": "PPO minus the critic: score each sample against its group's mean. DeepSeekMath's trick, made famous by R1." },
    { "a": "Constitutional AI", "t": "overfit", "aka": ["CAI", "RL-CAI", "collective constitutional AI"], "q": "The model critiques and revises itself against a written list of principles, then RLAIF does the rest." },

    { "a": "RLHF", "t": "baseline", "aka": ["reinforcement learning from human feedback", "RL from human feedback", "human feedback"], "q": "InstructGPT's recipe: SFT, reward model, PPO. The step that turned GPT-3 into ChatGPT." },
    { "a": "DPO", "t": "baseline", "aka": ["direct preference optimization"], "q": "'Your language model is secretly a reward model.' RLHF as a classification loss, no RL loop." },
    { "a": "PPO", "t": "baseline", "aka": ["proximal policy optimization", "PPO-ptx"], "q": "Clip the ratio, stay near the old policy. Policy, reference, reward and value models all in memory." }
  ]
}
