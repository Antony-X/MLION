    { "a": "Nash learning from human feedback", "t": "mlion", "aka": ["NLHF","Nash-MD","NashMDTrainer"], "q": "Skip the reward model: find the policy that no rival policy is preferred over. RLHF meets game theory." },

    { "a": "ReMax", "t": "longtail" },
