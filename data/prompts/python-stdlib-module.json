    { "a": "statistics", "t": "indist", "q": "Mean, median, stdev: no NumPy required." },
    { "a": "hashlib", "t": "indist", "q": "md5, sha256 and friends. Don't trust md5 with anything security related." },
    { "a": "tempfile", "t": "indist" },
    { "a": "sqlite3", "t": "indist", "aka": ["sqlite"], "q": "A complete SQL database, in the standard library, in one file." },
    { "a": "socket", "t": "indist" },
