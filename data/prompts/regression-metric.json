{
  "id": "regression-metric",
  "pack": "classic",
  "text": "Name a regression evaluation metric",
  "note": "Scores for judging continuous predictions: error, percentage, scaled, probabilistic, interval, goodness-of-fit and model-selection metrics",
  "strip": ["error", "score", "metric", "loss"],
  "answers": [
    { "a": "Nash–Sutcliffe efficiency", "t": "mlion", "aka": ["NSE", "nash-sutcliffe", "nash–sutcliffe model efficiency"], "q": "Hydrology's R² since 1970: 1 − MSE / variance of observations. Below zero, the mean beat your model." },

    { "a": "Kling–Gupta efficiency", "t": "longtail", "aka": ["KGE", "Kling-Gupta"], "q": "Nash–Sutcliffe's successor, balancing correlation, bias and variability. Gupta et al., 2009." },
    { "a": "Willmott's index of agreement", "t": "longtail", "aka": ["index of agreement", "willmott's d", "willmott index", "Willmott"] },
    { "a": "Percent bias", "t": "longtail", "aka": ["PBIAS"] },
    { "a": "Theil's U", "t": "longtail", "aka": ["theil's U statistic", "theil U", "U2", "theil's inequality coefficient", "Theil"], "q": "Your forecast against the naive no-change forecast. Below 1, you beat it." },
    { "a": "MPE", "t": "longtail", "aka": ["mean percentage error"] },
    { "a": "MdAPE", "t": "longtail", "aka": ["median absolute percentage error"] },
    { "a": "RMSSE", "t": "longtail", "aka": ["root mean squared scaled error"], "q": "The M5 competition's scale-free RMSE, scaled by the naive forecast's error." },
    { "a": "MRAE", "t": "longtail", "aka": ["mean relative absolute error"] },
    { "a": "GMRAE", "t": "longtail", "aka": ["geometric mean relative absolute error"] },
    { "a": "MAAPE", "t": "longtail", "aka": ["mean arctangent absolute percentage error"] },
    { "a": "Mean directional accuracy", "t": "longtail", "aka": ["MDA", "directional accuracy", "direction accuracy", "directional symmetry", "percentage of correct direction"] },
    { "a": "Relative squared error", "t": "longtail" },
    { "a": "Gamma deviance", "t": "longtail", "aka": ["mean gamma deviance", "gamma loss"] },
    { "a": "D² score", "t": "longtail", "aka": ["D-squared", "fraction of deviance explained", "deviance explained", "d2_tweedie_score"] },
    { "a": "AICc", "t": "longtail", "aka": ["corrected AIC", "small-sample AIC"] },
    { "a": "Hannan–Quinn", "t": "longtail", "aka": ["HQIC", "HQC", "hannan-quinn information criterion"] },
    { "a": "PRESS", "t": "longtail", "aka": ["predicted residual sum of squares", "predicted residual error sum of squares", "PRESS statistic"] },
    { "a": "Predicted R²", "t": "longtail", "aka": ["Q²", "predicted R-squared", "cross-validated R²", "out-of-sample R²", "OOS R²"] },
    { "a": "Spearman correlation", "t": "longtail", "aka": ["spearman's rho", "rank correlation", "Spearman rank correlation", "Spearman", "Spearman rho", "spearman rank correlation coefficient"] },
    { "a": "Kendall's tau", "t": "longtail", "aka": ["kendall tau", "Kendall rank correlation"] },
    { "a": "Concordance correlation coefficient", "t": "longtail", "aka": ["CCC", "lin's CCC", "lin's concordance correlation coefficient", "lin's concordance", "concordance"], "q": "Lin, 1989: Pearson's r that also punishes bias and scale shifts." },
    { "a": "Interval score", "t": "longtail", "aka": ["winkler score", "winkler"] },
    { "a": "Weighted interval score", "t": "longtail", "aka": ["WIS"] },
    { "a": "Energy score", "t": "longtail" },
    { "a": "PICP", "t": "longtail", "aka": ["prediction interval coverage probability", "coverage", "empirical coverage", "interval coverage"] },
    { "a": "MPIW", "t": "longtail", "aka": ["mean prediction interval width", "average interval width"] },
    { "a": "Bland–Altman", "t": "longtail", "aka": ["limits of agreement", "bland-altman plot", "tukey mean-difference plot"], "q": "Plot differences against means, draw ±1.96 SD lines. Medicine's agreement check." },
    { "a": "Durbin–Watson", "t": "longtail", "aka": ["durbin-watson statistic", "DW"], "q": "Tests residuals for autocorrelation. Close to 2 means you're fine." },
    { "a": "F-statistic", "t": "longtail", "aka": ["F-test", "overall F-test"] },
    { "a": "Tracking signal", "t": "longtail" },
    { "a": "Cumulative forecast error", "t": "longtail", "aka": ["CFE"] },
    { "a": "ε-insensitive loss", "t": "longtail", "aka": ["epsilon-insensitive", "SVR loss", "Vapnik loss", "Vapnik's epsilon-insensitive loss"] },
    { "a": "Fraction of variance unexplained", "t": "longtail", "aka": ["FVU", "unexplained variance"] },

    { "a": "MASE", "t": "outlier", "aka": ["mean absolute scaled error"], "q": "Hyndman & Koehler, 2006: scale errors by the naive forecast's. Below 1 beats naive." },
    { "a": "WAPE", "t": "outlier", "aka": ["weighted absolute percentage error", "WMAPE", "weighted MAPE", "MAD/mean ratio"], "q": "Total absolute error over total actuals. MAPE's saner cousin for retail demand." },
    { "a": "RMSPE", "t": "outlier", "aka": ["root mean squared percentage error", "root mean square percentage error"] },
    { "a": "Mean bias error", "t": "outlier", "aka": ["MBE", "bias", "forecast bias", "mean signed error", "mean signed deviation", "mean signed difference"] },
    { "a": "Relative absolute error", "t": "outlier", "aka": ["RAE"] },
    { "a": "Root relative squared error", "t": "outlier", "aka": ["RRSE"] },
    { "a": "NRMSE", "t": "outlier", "aka": ["normalized RMSE", "CV(RMSE)", "coefficient of variation of RMSE", "relative RMSE", "scatter index"] },
    { "a": "Residual standard error", "t": "outlier", "aka": ["RSE", "standard error of the regression", "standard error of the estimate", "standard error of estimate", "SER"] },
    { "a": "Pearson correlation", "t": "outlier", "aka": ["correlation coefficient", "pearson's r", "pearson r", "Pearson", "pearson correlation coefficient"] },
    { "a": "Log-cosh", "t": "outlier", "q": "Smooth like MSE near zero, linear like MAE far out. Huber without the hyperparameter." },
    { "a": "Mallows' Cp", "t": "outlier", "aka": ["Cp", "mallows cp"], "q": "Colin Mallows' subset-selection score: a good model's Cp sits near its parameter count." },
    { "a": "Tweedie deviance", "t": "outlier", "aka": ["mean tweedie deviance", "Tweedie", "Tweedie loss"], "q": "For zero-heavy positive targets like insurance claims. Power 1 is Poisson, power 2 is gamma." },
    { "a": "Poisson deviance", "t": "outlier", "aka": ["mean poisson deviance", "poisson loss", "Poisson NLL", "PoissonNLLLoss"] },
    { "a": "Deviance", "t": "outlier", "aka": ["residual deviance"] },
    { "a": "Log-likelihood", "t": "outlier", "aka": ["negative log-likelihood", "NLL", "gaussian NLL", "log predictive density", "NLPD", "negative log predictive density", "likelihood", "log score", "logarithmic score"] },
    { "a": "CRPS", "t": "outlier", "aka": ["continuous ranked probability score", "CRPS-sum"], "q": "MAE generalized to whole predictive distributions. The weather forecaster's favorite." },

    { "a": "MAPE", "t": "indist", "aka": ["mean absolute percentage error", "MAPD", "mean absolute percentage deviation"], "q": "Divides by the actual value, so a single zero ruins everything." },
    { "a": "sMAPE", "t": "indist", "aka": ["symmetric MAPE", "symmetric mean absolute percentage error"], "q": "MAPE made 'symmetric', which it isn't quite. The M3 and M4 competitions used it anyway." },
    { "a": "MSLE", "t": "indist", "aka": ["mean squared log error", "mean squared logarithmic error"] },
    { "a": "RMSLE", "t": "indist", "aka": ["root mean squared log error", "root mean squared logarithmic error"], "q": "Error on log(1 + y): cares about ratios, not dollars. A Kaggle house-price staple." },
    { "a": "Median absolute error", "t": "indist", "aka": ["MedAE", "MdAE"] },
    { "a": "Max error", "t": "indist", "aka": ["maximum error", "maximum absolute error", "max absolute error", "L-infinity error", "Chebyshev error", "L∞ error", "worst-case error"] },
    { "a": "Explained variance", "t": "indist", "aka": ["explained variance score", "EVS"] },
    { "a": "Quantile loss", "t": "indist", "aka": ["pinball loss", "check loss", "mean pinball loss", "quantile regression loss", "tilted loss", "weighted quantile loss", "wQL", "mean weighted quantile loss", "quantile score"], "q": "Asymmetric absolute error. Minimize it and you get a quantile instead of a mean." },
    { "a": "RSS", "t": "indist", "aka": ["residual sum of squares", "SSE", "sum of squared errors", "sum of squared residuals"] },
    { "a": "AIC", "t": "indist", "aka": ["akaike information criterion"], "q": "Akaike, 1973: log-likelihood minus a parameter penalty. Lower is better." },
    { "a": "BIC", "t": "indist", "aka": ["bayesian information criterion", "schwarz criterion", "schwarz information criterion", "SBC"], "q": "Schwarz, 1978: AIC with a log(n) penalty that loves small models." },

    { "a": "Adjusted R²", "t": "overfit", "aka": ["adjusted R-squared", "adjusted coefficient of determination", "adj R²", "R-bar squared"], "q": "R² with a tax on every feature you add. The stats-class flex." },
    { "a": "Huber loss", "t": "overfit", "aka": ["smooth L1", "pseudo-huber", "Charbonnier", "Charbonnier loss"], "q": "Huber, 1964: quadratic near zero, linear in the tails. Robust, and more loss than metric." },

    { "a": "MSE", "t": "baseline", "aka": ["mean squared error", "L2 loss", "squared error", "mean squared deviation", "MSD", "mean squared prediction error", "MSPE", "quadratic loss"], "q": "Squares the errors, so outliers shout." },
    { "a": "RMSE", "t": "baseline", "aka": ["root mean squared error", "root mean square error", "RMSD", "root-mean-square deviation"], "q": "MSE back in the target's units. The Netflix Prize was decided by it." },
    { "a": "MAE", "t": "baseline", "aka": ["mean absolute error", "L1 loss", "absolute error", "mean absolute deviation", "MAD"], "q": "Mean of |y − ŷ|, in the target's own units. Every unit of error counts the same, big miss or small." },
    { "a": "R²", "t": "baseline", "aka": ["R-squared", "coefficient of determination", "R2 score"], "q": "Can go negative on test data, which surprises people every single time." },
    { "a": "Normalized MAE", "t": "longtail", "aka": ["NMAE", "normalized mean absolute error"] },
    { "a": "Legates–McCabe efficiency", "t": "longtail", "aka": ["Legates-McCabe", "E1", "modified Nash–Sutcliffe efficiency"] },
    { "a": "Volumetric efficiency", "t": "longtail", "aka": ["Criss–Winston volumetric efficiency"] },
    { "a": "Taylor skill score", "t": "longtail" },
    { "a": "Tukey biweight loss", "t": "longtail", "aka": ["Tukey's biweight", "bisquare loss", "Tukey bisquare"] },
    { "a": "WAIC", "t": "longtail", "aka": ["Watanabe–Akaike information criterion"] },
    { "a": "DIC", "t": "longtail", "aka": ["deviance information criterion"] },
    { "a": "PSIS-LOO", "t": "longtail", "aka": ["LOO-CV", "LOOIC", "Pareto smoothed importance sampling leave-one-out", "LOO", "ELPD", "expected log predictive density"] },
    { "a": "Explained sum of squares", "t": "longtail", "aka": ["ESS", "sum of squares due to regression"] },
    { "a": "Total sum of squares", "t": "longtail", "aka": ["TSS", "SST"] },
    { "a": "Median symmetric accuracy", "t": "longtail", "aka": ["MSA"] },
    { "a": "Symmetric signed percentage bias", "t": "longtail", "aka": ["SSPB"] },
    { "a": "Variogram score", "t": "longtail" },
    { "a": "Dawid–Sebastiani score", "t": "longtail", "aka": ["DSS", "Dawid-Sebastiani"] },
    { "a": "LINEX loss", "t": "longtail", "aka": ["linear-exponential loss", "linex"] },
    { "a": "Coverage width criterion", "t": "longtail", "aka": ["CWC"] },
    { "a": "Average coverage error", "t": "longtail", "aka": ["ACE"] },
    { "a": "Expected normalized calibration error", "t": "longtail", "aka": ["ENCE"] },
    { "a": "Miscalibration area", "t": "longtail" },
    { "a": "Cohen's f²", "t": "longtail", "aka": ["Cohen's f2"] },
    { "a": "Pseudo R²", "t": "longtail", "aka": ["pseudo R-squared", "pseudo R2", "Efron's R2", "Efron's R²"] },
    { "a": "Quantile calibration", "t": "longtail", "aka": ["calibrated regression", "calibration of regression uncertainty"] },
    { "a": "PIT histogram", "t": "longtail", "aka": ["probability integral transform", "PIT", "PIT coverage"] },
    { "a": "PSNR", "t": "outlier", "aka": ["peak signal-to-noise ratio", "peak signal to noise ratio"] },
    { "a": "SSIM", "t": "longtail", "aka": ["structural similarity", "structural similarity index", "MS-SSIM"] },
    { "a": "AbsRel", "t": "longtail", "aka": ["absolute relative error", "mean absolute relative error", "abs rel"] },
    { "a": "SILog", "t": "longtail", "aka": ["scale-invariant log error", "scale-invariant logarithmic error", "scale-invariant MSE"] },
    { "a": "Endpoint error", "t": "longtail", "aka": ["EPE", "AEPE", "average endpoint error"] },
    { "a": "Normalized Gini coefficient", "t": "longtail", "aka": ["normalized Gini", "Gini", "Gini index"] },
    { "a": "Regression error characteristic curve", "t": "longtail", "aka": ["REC curve", "REC", "regression error characteristic"] },
    { "a": "Partial R²", "t": "longtail", "aka": ["partial R-squared", "partial R2", "coefficient of partial determination"] },
    { "a": "Anomaly correlation coefficient", "t": "longtail", "aka": ["ACC", "anomaly correlation"] },
    { "a": "RSR", "t": "longtail", "aka": ["RMSE-observations standard deviation ratio", "ratio of RMSE to standard deviation"] },
    { "a": "FAC2", "t": "longtail", "aka": ["factor of two"] },
    { "a": "NMSE", "t": "longtail", "aka": ["normalized mean squared error", "normalized MSE", "normalised mean square error"] },
    { "a": "MSE skill score", "t": "longtail", "aka": ["MSESS", "mean squared error skill score", "reduction of variance"] },
    { "a": "Quadratic weighted kappa", "t": "longtail", "aka": ["QWK", "quadratic kappa"] },
    { "a": "Concordance index", "t": "longtail", "aka": ["C-index", "Harrell's C", "Harrell's concordance index", "c-statistic"] }
  ]
}
