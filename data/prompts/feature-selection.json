{
  "id": "feature-selection",
  "pack": "classic",
  "text": "Name a feature selection method",
  "note": "Filter, wrapper and embedded methods that keep a subset of the original features. Feature extraction (PCA, autoencoders) doesn't count",
  "strip": ["feature", "features", "selection", "method", "methods", "variable"],
  "answers": [
    { "a": "Knockoffs", "t": "mlion", "aka": ["knockoff filter", "model-x knockoffs", "knockoff", "fixed-x knockoffs"], "q": "Barber & Candès: give every feature a fake twin, keep the real ones that beat their doubles. FDR control included." },

    { "a": "RReliefF", "t": "longtail", "aka": ["regressional relieff"] },
    { "a": "SURF", "t": "longtail", "aka": ["SURF*", "spatially uniform relieff"] },
    { "a": "MultiSURF", "t": "longtail", "aka": ["multisurf*"] },
    { "a": "MIFS", "t": "longtail", "aka": ["battiti"] },
    { "a": "DISR", "t": "longtail", "aka": ["double input symmetrical relevance"] },
    { "a": "ICAP", "t": "longtail", "aka": ["interaction capping"] },
    { "a": "CIFE", "t": "longtail", "aka": ["conditional infomax feature extraction"] },
    { "a": "Gain ratio", "t": "longtail", "aka": ["information gain ratio"] },
    { "a": "Symmetric uncertainty", "t": "longtail" },
    { "a": "Maximal information coefficient", "t": "longtail", "aka": ["MIC"] },
    { "a": "Distance correlation", "t": "longtail", "aka": ["dcor"] },
    { "a": "HSIC Lasso", "t": "longtail", "aka": ["hsic"] },
    { "a": "Mann-Whitney U test", "t": "longtail", "aka": ["mann whitney", "wilcoxon rank-sum", "wilcoxon rank sum test"] },
    { "a": "Kruskal-Wallis test", "t": "longtail", "aka": ["kruskal wallis"] },
    { "a": "Kolmogorov-Smirnov test", "t": "longtail", "aka": ["KS test", "kolmogorov smirnov"] },
    { "a": "Missing value ratio", "t": "longtail", "aka": ["missing values ratio", "missingness filter"] },
    { "a": "SPEC", "t": "longtail", "aka": ["spectral feature selection"] },
    { "a": "MCFS", "t": "longtail", "aka": ["multi-cluster feature selection"] },
    { "a": "Concrete autoencoder", "t": "longtail", "aka": ["concrete selector"], "q": "Abid et al., 2019: an encoder that's a set of Concrete (Gumbel-softmax) picks over the input features." },
    { "a": "Plus-l take-away-r", "t": "longtail", "aka": ["plus l minus r", "LRS", "plus-l minus-r"] },
    { "a": "Branch and bound", "t": "longtail", "aka": ["narendra-fukunaga"], "q": "Narendra & Fukunaga, 1977: exact subset search, provided the criterion only goes up as you add features." },
    { "a": "Ant colony optimization", "t": "longtail", "aka": ["ACO"] },
    { "a": "Tabu search", "t": "longtail" },
    { "a": "Null importance", "t": "longtail", "aka": ["null importances", "target permutation importance"], "q": "Shuffle the target, refit, and see which importances survive the noise. A Kaggle favorite." },
    { "a": "LOCO", "t": "longtail", "aka": ["leave-one-covariate-out"] },
    { "a": "Fused lasso", "t": "longtail" },
    { "a": "Sparse group lasso", "t": "longtail" },
    { "a": "MCP", "t": "longtail", "aka": ["minimax concave penalty"] },
    { "a": "Dantzig selector", "t": "longtail", "q": "Candès & Tao, 2007: an ℓ1 cousin of the lasso, named after the father of linear programming." },
    { "a": "Sure independence screening", "t": "longtail", "aka": ["SIS", "ISIS", "iterative sure independence screening"] },
    { "a": "Orthogonal matching pursuit", "t": "longtail", "aka": ["OMP"] },
    { "a": "Horseshoe prior", "t": "longtail", "aka": ["horseshoe"] },
    { "a": "Regularized random forest", "t": "longtail", "aka": ["RRF", "guided regularized random forest", "GRRF"] },
    { "a": "VSURF", "t": "longtail" },
    { "a": "Markov blanket", "t": "longtail", "aka": ["IAMB", "incremental association markov blanket", "markov blanket feature selection"] },
    { "a": "HITON", "t": "longtail", "aka": ["HITON-PC", "HITON-MB"] },
    { "a": "LassoNet", "t": "longtail" },
    { "a": "Stochastic gates", "t": "longtail", "aka": ["STG"] },
    { "a": "INVASE", "t": "longtail" },
    { "a": "L2X", "t": "longtail", "aka": ["learning to explain"] },
    { "a": "TabNet", "t": "longtail" },

    { "a": "mRMR", "t": "outlier", "aka": ["minimum redundancy maximum relevance", "max-relevance min-redundancy", "MRMR"], "q": "Peng, Long & Ding, 2005: pick what's informative about the label but not about what you already picked." },
    { "a": "Relief", "t": "outlier", "q": "Kira & Rendell, 1992: a good feature differs at a point's nearest miss and matches at its nearest hit." },
    { "a": "ReliefF", "t": "outlier", "aka": ["relief-f"] },
    { "a": "Fisher score", "t": "outlier", "aka": ["fisher criterion", "fisher's discriminant ratio", "fisher ratio"] },
    { "a": "Laplacian score", "t": "outlier" },
    { "a": "CFS", "t": "outlier", "aka": ["correlation-based feature selection"] },
    { "a": "FCBF", "t": "outlier", "aka": ["fast correlation-based filter"] },
    { "a": "JMI", "t": "outlier", "aka": ["joint mutual information"] },
    { "a": "CMIM", "t": "outlier", "aka": ["conditional mutual information maximization"] },
    { "a": "SFFS", "t": "outlier", "aka": ["sequential floating forward selection", "floating search", "SFBS", "sequential floating backward selection", "floating selection"] },
    { "a": "Group lasso", "t": "outlier", "q": "Yuan & Lin, 2006: keep or drop whole groups, like every dummy of one categorical." },
    { "a": "Adaptive lasso", "t": "outlier" },
    { "a": "LARS", "t": "outlier", "aka": ["least angle regression", "lars-lasso"], "q": "Efron et al., 2004: the whole lasso path for roughly the cost of one least-squares fit." },
    { "a": "SCAD", "t": "outlier", "aka": ["smoothly clipped absolute deviation"] },
    { "a": "L0 regularization", "t": "outlier", "aka": ["L0", "L0 penalty", "L0 norm", "L0Learn"] },
    { "a": "Stability selection", "t": "outlier", "aka": ["randomized lasso"], "q": "Meinshausen & Bühlmann, 2010: keep the features that keep getting picked across random subsamples." },
    { "a": "Information value", "t": "outlier", "aka": ["IV", "weight of evidence", "WoE", "WoE/IV"] },
    { "a": "Information criteria", "t": "outlier", "aka": ["AIC", "BIC", "akaike information criterion", "bayesian information criterion", "mallows cp", "mallows' cp"] },
    { "a": "Drop-column importance", "t": "outlier", "aka": ["drop column importance", "leave one feature out"] },
    { "a": "Particle swarm optimization", "t": "outlier", "aka": ["PSO", "binary pso"] },
    { "a": "Simulated annealing", "t": "outlier", "aka": ["SA"] },
    { "a": "Spike-and-slab", "t": "outlier", "aka": ["spike and slab", "bayesian variable selection", "SSVS", "stochastic search variable selection"] },
    { "a": "Automatic relevance determination", "t": "outlier", "aka": ["ARD", "ARDRegression"] },
    { "a": "Domain knowledge", "t": "outlier", "aka": ["expert knowledge", "manual feature selection", "manual selection"], "q": "Ask someone who knows the data. Still undefeated." },

    { "a": "Chi-squared test", "t": "indist", "aka": ["chi-square", "chi2", "chi-squared", "chi square test", "χ²"], "q": "Non-negative counts against a categorical target. SelectKBest(chi2) is a text-classification classic." },
    { "a": "ANOVA F-test", "t": "indist", "aka": ["ANOVA", "F-test", "f_classif", "f_regression", "f-statistic", "f score"] },
    { "a": "Correlation filter", "t": "indist", "aka": ["correlation", "pearson correlation", "correlation coefficient", "correlation matrix", "spearman correlation", "high correlation filter", "remove correlated features"] },
    { "a": "Variance threshold", "t": "indist", "aka": ["VarianceThreshold", "low variance filter", "remove low variance features", "near-zero variance"], "q": "Drop the features that barely change. Constant columns go first." },
    { "a": "Variance inflation factor", "t": "indist", "aka": ["VIF"], "q": "A VIF above 5 or 10 says a feature is mostly predictable from the others." },
    { "a": "t-test", "t": "indist", "aka": ["student's t-test", "welch's t-test", "t test"] },
    { "a": "Univariate feature selection", "t": "indist", "aka": ["univariate", "SelectKBest", "SelectPercentile", "univariate statistical tests"] },
    { "a": "Permutation importance", "t": "indist", "aka": ["permutation feature importance", "mean decrease accuracy", "MDA"], "q": "Shuffle one column and watch the score drop. Breiman's random forest trick, now model-agnostic." },
    { "a": "Stepwise selection", "t": "indist", "aka": ["stepwise regression", "bidirectional elimination", "stepwise"], "q": "The method statisticians love to teach, and then love to warn you about." },
    { "a": "Best subset selection", "t": "indist", "aka": ["best subset", "exhaustive search", "exhaustive feature selection", "all subsets regression"] },
    { "a": "Elastic net", "t": "indist", "aka": ["elasticnet", "L1+L2"], "q": "Zou & Hastie, 2005: L1 plus L2, so correlated features get picked together instead of one at random." },
    { "a": "SHAP", "t": "indist", "aka": ["shap values", "shapley values", "shap importance", "shapley additive explanations"], "q": "Lundberg & Lee, 2017: Shapley's 1953 cooperative game theory, put to work attributing predictions." },
    { "a": "Genetic algorithm", "t": "indist", "aka": ["GA", "evolutionary algorithm", "genetic algorithms"], "q": "Features as genes, subsets as chromosomes, cross-validation score as fitness." },
    { "a": "Filter methods", "t": "indist", "aka": ["filter", "filter approach"] },
    { "a": "Wrapper methods", "t": "indist", "aka": ["wrapper", "wrapper approach"] },
    { "a": "Embedded methods", "t": "indist", "aka": ["embedded", "SelectFromModel"] },

    { "a": "Boruta", "t": "overfit", "aka": ["BorutaPy", "BorutaShap", "shadow features"], "q": "Shuffled 'shadow' copies of every feature compete against the real ones. Named after a Slavic forest spirit." },

    { "a": "Recursive feature elimination", "t": "baseline", "aka": ["RFE", "RFECV", "SVM-RFE", "recursive feature elimination with cross-validation"], "q": "Guyon et al., 2002: fit, drop the weakest, repeat. Born selecting genes with SVMs." },
    { "a": "Lasso", "t": "baseline", "aka": ["L1", "L1 regularization", "L1 penalty", "least absolute shrinkage and selection operator", "L1-SVM"], "q": "Tibshirani, 1996: the L1 penalty zeroes out the features it doesn't need." },
    { "a": "Forward selection", "t": "baseline", "aka": ["sequential forward selection", "SFS", "forward stepwise", "SequentialFeatureSelector", "forward feature selection"], "q": "Start with nothing, add the most helpful feature, repeat until nothing helps." },
    { "a": "Backward elimination", "t": "baseline", "aka": ["sequential backward selection", "SBS", "backward stepwise", "backward selection", "sequential backward elimination"], "q": "Start with everything and drop the weakest feature until dropping starts to hurt." },
    { "a": "Mutual information", "t": "baseline", "aka": ["MI", "information gain", "mutual_info_classif", "mutual_info_regression", "MIM"], "q": "Catches nonlinear dependence that correlation misses. Estimating it well is the hard part." },
    { "a": "Feature importance", "t": "baseline", "aka": ["tree-based feature importance", "random forest importance", "MDI", "mean decrease impurity", "gini importance", "feature_importances_", "gain importance", "tree importance"], "q": "Impurity-based importance favors high-cardinality features. Even sklearn's docs warn you." }
  ]
}
