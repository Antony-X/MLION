    { "a": "Robust scaling", "t": "indist", "aka": ["RobustScaler", "median-IQR scaling", "IQR scaling"], "q": "Median and IQR instead of mean and std, so outliers can't push you around." },
    { "a": "Ordinal encoding", "t": "indist", "aka": ["OrdinalEncoder"] },
    { "a": "Binning", "t": "indist", "aka": ["discretization", "discretisation", "bucketing", "bucketization", "KBinsDiscretizer", "data binning"] },
    { "a": "Binarization", "t": "indist", "aka": ["Binarizer", "binarisation", "thresholding"] },
    { "a": "Polynomial features", "t": "indist", "aka": ["polynomial expansion", "polynomial basis expansion"] },
