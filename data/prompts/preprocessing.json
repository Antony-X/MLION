    { "a": "Box-Cox", "t": "overfit", "q": "Box & Cox, 1964: one λ to make your data Gaussian-ish. Strictly positive values only." },
    { "a": "Target encoding", "t": "overfit", "aka": ["mean encoding", "likelihood encoding", "impact coding", "TargetEncoder", "mean target encoding", "target mean encoding"], "q": "Replace each category with its target mean. Skip the out-of-fold care and it leaks straight into your CV." },

    { "a": "Standardization", "t": "baseline", "aka": ["standard scaling", "StandardScaler", "z-score normalization", "z-score", "z-scoring", "autoscaling", "unit variance scaling", "feature scaling", "standardisation", "zero mean unit variance"], "q": "Subtract the mean, divide by the std. What every gradient-based model quietly wanted." },
