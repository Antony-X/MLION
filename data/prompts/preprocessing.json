    { "a": "Power transform", "t": "indist", "aka": ["PowerTransformer"] },
    { "a": "Yeo-Johnson", "t": "indist", "q": "Box-Cox that tolerates zeros and negatives. Yeo & Johnson, 2000." },
    { "a": "Quantile transform", "t": "indist", "aka": ["QuantileTransformer"], "q": "Push each feature through its empirical CDF to a uniform or normal. Ranks, then stretched." },
    { "a": "Frequency encoding", "t": "indist", "aka": ["count encoding", "CountEncoder", "frequency counting"] },
    { "a": "Mean centering", "t": "indist", "aka": ["centering", "demeaning", "mean subtraction", "mean removal", "zero centering"] },
    { "a": "Feature hashing", "t": "indist", "aka": ["hashing trick", "hash encoding", "FeatureHasher", "HashingEncoder", "HashingVectorizer"], "q": "Hash categories into a fixed number of columns. Collisions included at no extra cost." },
    { "a": "TF-IDF", "t": "indist", "aka": ["term frequency-inverse document frequency", "TfidfVectorizer", "TfidfTransformer"], "q": "Term frequency times inverse document frequency. Spärck Jones's 1972 IDF still pays rent." },
    { "a": "Bag of words", "t": "indist", "aka": ["BoW", "CountVectorizer", "count vectorization", "count vectorizer", "term frequency", "document-term matrix"] },
