    { "a": "Random kitchen sinks", "t": "mlion", "aka": ["random fourier features", "RFF", "RBFSampler"], "q": "Rahimi & Recht's random Fourier features. Its 2017 Test-of-Time talk called ML 'alchemy'." },

    { "a": "ZCA whitening", "t": "longtail", "aka": ["ZCA", "mahalanobis whitening", "zero-phase component analysis"] },
    { "a": "Decimal scaling", "t": "longtail" },
    { "a": "Pareto scaling", "t": "longtail" },
    { "a": "Spatial sign", "t": "longtail", "aka": ["spatial sign transformation"], "q": "Center, then project each sample onto the unit sphere. Outliers lose their leverage." },
    { "a": "Kernel centering", "t": "longtail", "aka": ["KernelCenterer"] },
    { "a": "Quantile normalization", "t": "longtail" },
    { "a": "RankGauss", "t": "longtail", "aka": ["gauss rank"], "q": "Rank, rescale, apply inverse erf: the Gaussian-ifier behind Michael Jahrer's Porto Seguro win." },
    { "a": "Inverse hyperbolic sine", "t": "longtail", "aka": ["asinh", "arcsinh", "IHS"], "q": "Acts like log for big values, yet handles zero and negatives. Economists love it." },
    { "a": "Logit transform", "t": "longtail" },
    { "a": "Reciprocal transform", "t": "longtail", "aka": ["inverse transform", "reciprocal"] },
    { "a": "Arcsine square root transform", "t": "longtail", "aka": ["arcsine transformation", "angular transformation", "arcsin sqrt"] },
    { "a": "Tukey's ladder of powers", "t": "longtail", "aka": ["ladder of powers", "tukey ladder"], "q": "Tukey, 1977: climb or descend the powers (x², √x, log x, 1/x) until the skew goes away." },
    { "a": "Optimal binning", "t": "longtail", "aka": ["OptBinning"] },
    { "a": "Decision tree discretization", "t": "longtail", "aka": ["tree-based binning", "supervised binning", "tree discretization", "DecisionTreeDiscretiser"] },
    { "a": "MDLP", "t": "longtail", "aka": ["fayyad-irani discretization", "entropy-based discretization", "MDL discretization"], "q": "Fayyad & Irani, 1993: cut where information gain beats the description-length cost." },
    { "a": "ChiMerge", "t": "longtail", "q": "Kerber, 1992: merge adjacent intervals while a chi-square test says they look alike." },
    { "a": "k-means binning", "t": "longtail", "aka": ["k-means discretization"] },
    { "a": "Jenks natural breaks", "t": "longtail", "aka": ["natural breaks", "jenks"] },
    { "a": "Rare label encoding", "t": "longtail", "aka": ["rare category grouping", "RareLabelEncoder", "grouping rare categories", "other bucket"] },
    { "a": "Thermometer encoding", "t": "longtail", "aka": ["unary encoding"], "q": "Ordinal level k becomes k ones and then zeros, like mercury rising." },
    { "a": "Similarity encoding", "t": "longtail", "aka": ["SimilarityEncoder"] },
    { "a": "MinHash encoding", "t": "longtail", "aka": ["MinHashEncoder"] },
