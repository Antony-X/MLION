    { "a": "Entity embeddings", "t": "outlier", "aka": ["categorical embeddings", "embedding encoding", "learned embeddings"], "q": "Guo & Berkhahn, 2016: learned category embeddings, from a third-place Rossmann Kaggle finish." },
