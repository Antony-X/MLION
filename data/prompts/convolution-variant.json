    { "a": "Masked", "t": "indist", "aka": ["masked convolution", "PixelCNN convolution", "masked conv"], "q": "Zero the kernel's future half so PixelCNN can generate an image one pixel at a time." },
    { "a": "Partial", "t": "indist", "aka": ["partial convolution", "PartialConv", "partial conv"], "q": "Convolve only over valid pixels, renormalize, shrink the hole. NVIDIA's irregular-hole inpainter." },
    { "a": "Cross-correlation", "t": "indist", "aka": ["correlation", "cross correlation", "torch convolution (cross-correlation)", "flipped-kernel convolution", "deep learning convolution is cross-correlation"], "q": "What every deep learning 'convolution' actually computes: no kernel flip. Don't tell signal processing." },
