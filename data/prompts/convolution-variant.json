    { "a": "CoordConv", "t": "outlier", "aka": ["coord conv", "coordinate convolution", "CoordConv2d", "AddCoords", "coordinate channels convolution"], "q": "Plain CNNs struggled to map (x, y) to a one-hot pixel. Add two coordinate channels and it's trivial." },
