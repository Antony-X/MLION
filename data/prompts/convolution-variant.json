{
  "id": "convolution-variant",
  "pack": "blocks",
  "text": "Name a type of convolution",
  "note": "Any variant of the convolution operation or conv layer used in neural networks: images, sequences, graphs, point clouds, spheres and beyond",
  "strip": ["convolution", "convolutions", "conv", "convolutional", "layer", "layers"],
  "answers": [
    { "a": "Octave convolution", "t": "mlion", "aka": ["OctConv", "octave"], "q": "\"Drop an Octave\": store low-frequency feature maps at half resolution. Fewer FLOPs, often better accuracy." },

    { "a": "2D convolution", "t": "baseline", "aka": ["2D", "Conv2d", "Conv2D", "standard convolution", "regular convolution", "vanilla convolution", "spatial convolution", "standard", "nn.Conv2d", "F.conv2d", "torch.nn.functional.conv2d", "torch.conv2d", "nn.LazyConv2d", "LazyConv2d", "tf.nn.conv2d", "tf.keras.layers.Conv2D", "keras.layers.Conv2D", "lax.conv", "conv_general_dilated", "lax.conv_general_dilated", "jax.lax.conv_general_dilated", "tf.nn.convolution", "image convolution"] },
    { "a": "Depthwise", "t": "baseline", "aka": ["depthwise convolution", "depth-wise", "DepthwiseConv2D", "channel-wise convolution", "channelwise", "DepthwiseConv1D", "tf.nn.depthwise_conv2d", "depthwise conv", "DWConv", "groups=in_channels", "per-channel convolution", "depthwise conv2d"] },
    { "a": "Depthwise separable", "t": "baseline", "aka": ["separable", "depthwise separable convolution", "SeparableConv2D", "DSC", "depthwise-separable", "separable convolution", "SeparableConv1D", "tf.nn.separable_conv2d", "separable conv", "SeparableConv", "depthwise separable conv"], "q": "Xception and MobileNet's engine: depthwise then pointwise. With 3x3 kernels, 8-9x less compute." },
    { "a": "Dilated", "t": "baseline", "aka": ["atrous", "à trous", "dilated convolution", "atrous convolution", "dilation", "tf.nn.atrous_conv2d", "dilated conv", "atrous conv", "dilation rate", "atrous spatial convolution", "DilatedConv"], "q": "Holes in the kernel ('à trous'): exponentially growing receptive field, same parameter count." },
    { "a": "Transposed", "t": "baseline", "aka": ["transposed convolution", "deconvolution", "deconv", "fractionally strided", "fractionally strided convolution", "ConvTranspose2d", "Conv2DTranspose", "upconvolution", "up-convolution", "backward convolution", "nn.ConvTranspose1d", "nn.ConvTranspose2d", "nn.ConvTranspose3d", "ConvTranspose1d", "ConvTranspose3d", "F.conv_transpose1d", "F.conv_transpose2d", "F.conv_transpose3d", "Conv1DTranspose", "Conv3DTranspose", "LazyConvTranspose2d", "tf.nn.conv2d_transpose", "transpose convolution", "convolution transpose", "transposed conv", "transposed convolution layer", "learned upsampling"], "q": "Not actually a deconvolution, despite the nickname. Checkerboard artifacts are its signature." },
    { "a": "1×1", "t": "baseline", "aka": ["1x1", "1x1 convolution", "pointwise", "pointwise convolution", "point-wise", "network in network", "NiN", "mlpconv", "bottleneck convolution"], "q": "Network in Network's gift: mix channels, change width, skip space entirely." },

    { "a": "Deformable", "t": "overfit", "aka": ["deformable convolution", "DCN", "DCNv2", "DCNv3", "DCNv4", "modulated deformable convolution", "deformable conv", "deformable convolution v1", "Deformable ConvNets", "DCNv1", "DCN v2", "DCN v3", "modulated deformable conv", "DeformConv2d", "torchvision.ops.deform_conv2d", "torchvision.ops.DeformConv2d"], "q": "Learn where each kernel tap samples via per-pixel offsets. The rigid grid, liberated." },

    { "a": "1D convolution", "t": "indist", "aka": ["1D", "Conv1d", "Conv1D", "temporal convolution", "1D conv", "nn.Conv1d", "F.conv1d", "nn.LazyConv1d", "LazyConv1d", "tf.nn.conv1d", "np.convolve", "scipy.signal.convolve", "sequence convolution", "text convolution"] },
    { "a": "3D convolution", "t": "indist", "aka": ["3D", "Conv3d", "Conv3D", "volumetric convolution", "spatiotemporal convolution", "C3D", "nn.Conv3d", "F.conv3d", "nn.LazyConv3d", "LazyConv3d", "tf.nn.conv3d", "video convolution"] },
    { "a": "Grouped", "t": "indist", "aka": ["grouped convolution", "group convolution", "group", "groups", "pointwise group convolution", "ResNeXt cardinality", "cardinality", "groups parameter", "group conv"], "q": "Born from splitting AlexNet across two GTX 580s. ResNeXt turned it into a feature." },
    { "a": "Strided", "t": "indist", "aka": ["strided convolution", "stride 2 convolution", "downsampling convolution", "patchify convolution", "patch embedding convolution", "conv stem", "patchify stem", "stride-2 conv"] },
    { "a": "Causal", "t": "indist", "aka": ["causal convolution", "dilated causal convolution", "dilated causal", "left-padded convolution", "TCN", "temporal convolutional network", "WaveNet convolution", "left padded causal convolution", "causal Conv1D", "padding=causal"], "q": "No peeking at the future: pad only on the left. WaveNet stacked them with dilation." },
    { "a": "Graph convolution", "t": "indist", "aka": ["graph", "GCN", "GCNConv", "graph convolutional network", "graph conv", "spectral GCN", "GCN layer", "graph conv layer", "message passing convolution", "GraphConv", "GCN2Conv", "SimpleConv"] },
    { "a": "Sub-pixel convolution", "t": "indist", "aka": ["sub-pixel", "subpixel", "pixel shuffle", "PixelShuffle", "efficient sub-pixel convolution", "ESPCN", "depth to space", "nn.PixelShuffle", "depth_to_space convolution", "F.pixel_shuffle", "sub pixel conv"], "q": "Predict r² channels, then shuffle them into an r-times bigger image. Upsampling without checkerboards." },
