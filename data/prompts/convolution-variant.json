{
  "id": "convolution-variant",
  "pack": "blocks",
  "text": "Name a type of convolution",
  "note": "Any variant of the convolution operation or conv layer used in neural networks: images, sequences, graphs, point clouds, spheres and beyond",
  "strip": ["convolution", "convolutions", "conv", "convolutional", "layer", "layers"],
  "answers": [
    { "a": "Octave convolution", "t": "mlion", "aka": ["OctConv", "octave"], "q": "\"Drop an Octave\": store low-frequency feature maps at half resolution. Fewer FLOPs, often better accuracy." },

    { "a": "2D convolution", "t": "baseline", "aka": ["2D", "Conv2d", "Conv2D", "standard convolution", "regular convolution", "vanilla convolution", "spatial convolution", "standard"] },
    { "a": "Depthwise", "t": "baseline", "aka": ["depthwise convolution", "depth-wise", "DepthwiseConv2D", "channel-wise convolution", "channelwise"] },
    { "a": "Depthwise separable", "t": "baseline", "aka": ["separable", "depthwise separable convolution", "SeparableConv2D", "DSC", "depthwise-separable", "separable convolution"], "q": "Xception and MobileNet's engine: depthwise then pointwise. With 3x3 kernels, 8-9x less compute." },
    { "a": "Dilated", "t": "baseline", "aka": ["atrous", "à trous", "dilated convolution", "atrous convolution", "dilation"], "q": "Holes in the kernel ('à trous'): exponentially growing receptive field, same parameter count." },
    { "a": "Transposed", "t": "baseline", "aka": ["transposed convolution", "deconvolution", "deconv", "fractionally strided", "fractionally strided convolution", "ConvTranspose2d", "Conv2DTranspose", "upconvolution", "up-convolution", "backward convolution"], "q": "Not actually a deconvolution, despite the nickname. Checkerboard artifacts are its signature." },
    { "a": "1×1", "t": "baseline", "aka": ["1x1", "1x1 convolution", "pointwise", "pointwise convolution", "point-wise", "network in network", "NiN", "mlpconv", "bottleneck convolution"], "q": "Network in Network's gift: mix channels, change width, skip space entirely." },

    { "a": "Deformable", "t": "overfit", "aka": ["deformable convolution", "DCN", "DCNv2", "DCNv3", "DCNv4", "modulated deformable convolution", "deformable conv"], "q": "Learn where each kernel tap samples via per-pixel offsets. The rigid grid, liberated." },

    { "a": "1D convolution", "t": "indist", "aka": ["1D", "Conv1d", "Conv1D", "temporal convolution", "1D conv"] },
    { "a": "3D convolution", "t": "indist", "aka": ["3D", "Conv3d", "Conv3D", "volumetric convolution", "spatiotemporal convolution", "C3D"] },
    { "a": "Grouped", "t": "indist", "aka": ["grouped convolution", "group convolution", "group", "groups", "pointwise group convolution"], "q": "Born from splitting AlexNet across two GTX 580s. ResNeXt turned it into a feature." },
    { "a": "Strided", "t": "indist", "aka": ["strided convolution", "stride 2 convolution", "downsampling convolution"] },
    { "a": "Causal", "t": "indist", "aka": ["causal convolution", "dilated causal convolution", "dilated causal", "left-padded convolution"], "q": "No peeking at the future: pad only on the left. WaveNet stacked them with dilation." },
    { "a": "Graph convolution", "t": "indist", "aka": ["graph", "GCN", "GCNConv", "graph convolutional network", "graph conv"] },
    { "a": "Sub-pixel convolution", "t": "indist", "aka": ["sub-pixel", "subpixel", "pixel shuffle", "PixelShuffle", "efficient sub-pixel convolution", "ESPCN", "depth to space"], "q": "Predict r² channels, then shuffle them into an r-times bigger image. Upsampling without checkerboards." },
    { "a": "Spatially separable", "t": "indist", "aka": ["spatially separable convolution", "asymmetric convolution", "factorized convolution", "kernel factorization", "1xn", "nx1", "1xn and nx1"] },
    { "a": "Masked", "t": "indist", "aka": ["masked convolution", "PixelCNN convolution", "masked conv"], "q": "Zero the kernel's future half so PixelCNN can generate an image one pixel at a time." },
    { "a": "Partial", "t": "indist", "aka": ["partial convolution", "PartialConv", "partial conv"], "q": "Convolve only over valid pixels, renormalize, shrink the hole. NVIDIA's irregular-hole inpainter." },
    { "a": "Cross-correlation", "t": "indist", "aka": ["correlation", "cross correlation"], "q": "What every deep learning 'convolution' actually computes: no kernel flip. Don't tell signal processing." },
    { "a": "Locally connected", "t": "indist", "aka": ["locally connected layer", "unshared convolution", "LocallyConnected2D", "local convolution", "unshared"], "q": "Convolution minus weight sharing. DeepFace used it on aligned faces, where position means something." },

    { "a": "CoordConv", "t": "outlier", "aka": ["coord conv", "coordinate convolution"], "q": "Plain CNNs struggled to map (x, y) to a one-hot pixel. Add two coordinate channels and it's trivial." },
    { "a": "Dynamic convolution", "t": "outlier", "aka": ["dynamic", "DyConv", "dynamic conv", "input-dependent convolution"], "q": "Attend over several kernels per input and blend them. More capacity, little extra compute." },
    { "a": "Gated convolution", "t": "outlier", "aka": ["gated", "GatedConv", "gated conv", "gated convolutional"], "q": "A learned soft mask at every channel and location. DeepFill v2's answer to free-form holes." },
    { "a": "FFT convolution", "t": "outlier", "aka": ["FFT", "FFT-based convolution", "Fourier convolution", "frequency-domain convolution", "convolution theorem"], "q": "Pointwise multiply in frequency space. Wins once kernels get big." },
    { "a": "Winograd", "t": "outlier", "aka": ["Winograd convolution", "Winograd minimal filtering", "Winograd algorithm"], "q": "Trade multiplies for adds: F(2x2, 3x3) needs 16 multiplies instead of 36." },
    { "a": "Valid convolution", "t": "outlier", "aka": ["valid", "valid padding", "no padding"] },
    { "a": "Same convolution", "t": "outlier", "aka": ["same", "same padding", "half padding"] },
    { "a": "Sparse convolution", "t": "outlier", "aka": ["sparse", "spconv", "Minkowski convolution", "generalized sparse convolution", "MinkowskiEngine"] },
    { "a": "Group equivariant convolution", "t": "outlier", "aka": ["group equivariant", "G-CNN", "G-conv", "GConv", "group equivariant CNN", "equivariant convolution"], "q": "Rotate the input and the features rotate along. Cohen & Welling made equivariance architectural." },
    { "a": "Large kernel", "t": "outlier", "aka": ["large kernel convolution", "large-kernel", "RepLKNet", "31x31 convolution"], "q": "RepLKNet went to 31x31 and found ConvNets had simply been thinking too small." },
    { "a": "Involution", "t": "outlier", "aka": ["involution layer"], "q": "Convolution inverted: kernels vary across space but are shared across channels." },
    { "a": "(2+1)D convolution", "t": "outlier", "aka": ["R(2+1)D", "2+1D", "(2+1)D", "factorized spatiotemporal convolution"], "q": "Split a 3D kernel into 2D spatial then 1D temporal: twice the nonlinearities, easier to optimize." },
    { "a": "CondConv", "t": "outlier", "aka": ["conditionally parameterized convolution", "conditional convolution", "conditionally parameterized"] },
    { "a": "Ghost convolution", "t": "outlier", "aka": ["ghost", "ghost module", "GhostConv", "GhostNet"], "q": "Make half the feature maps with cheap linear ops. GhostNet's ghosts are just discount features." },
    { "a": "Selective kernel", "t": "outlier", "aka": ["selective kernel convolution", "SKConv", "SKNet", "SK convolution"] },
    { "a": "Resize convolution", "t": "outlier", "aka": ["resize-convolution", "upsample convolution", "upsampling convolution", "upsample and convolve", "nearest neighbor upsampling convolution"], "q": "Odena et al.'s checkerboard fix: upsample by nearest neighbor, then convolve. Simple, clean." },
    { "a": "Spectral convolution", "t": "outlier", "aka": ["spectral", "spectral graph convolution", "SpectralConv"] },
    { "a": "Circular convolution", "t": "outlier", "aka": ["circular", "cyclic convolution", "circular padding", "periodic convolution"] },
    { "a": "EdgeConv", "t": "outlier", "aka": ["edge convolution", "edge", "DGCNN"] },
    { "a": "Re-parameterized convolution", "t": "outlier", "aka": ["reparameterized", "re-parameterized", "RepConv", "RepVGG", "structural re-parameterization"], "q": "Train with parallel 3x3, 1x1 and identity branches, then fuse them into one plain 3x3 for inference." },
    { "a": "Lightweight convolution", "t": "outlier", "aka": ["lightweight", "LightConv", "light conv"] },
    { "a": "Shift", "t": "outlier", "aka": ["shift operation", "shift convolution", "shift module", "active shift"], "q": "Zero FLOPs, zero parameters: shift channels in different directions, then mix with 1x1 convs." },

    { "a": "Full convolution", "t": "longtail", "aka": ["full", "full padding"] },
    { "a": "Tiled convolution", "t": "longtail", "aka": ["tiled"] },
    { "a": "Hybrid dilated convolution", "t": "longtail", "aka": ["HDC", "hybrid dilated"], "q": "Vary dilation rates across layers so the grid of holes doesn't leave gridding artifacts." },
    { "a": "Switchable atrous convolution", "t": "longtail", "aka": ["SAC", "switchable atrous"] },
    { "a": "Submanifold sparse convolution", "t": "longtail", "aka": ["submanifold", "submanifold sparse", "SSC", "submanifold convolution"], "q": "Only compute where the input is active, so sparse 3D data stays sparse layer after layer." },
    { "a": "Steerable convolution", "t": "longtail", "aka": ["steerable", "steerable CNN", "E(2)-equivariant convolution", "E2CNN"] },
    { "a": "Gauge equivariant convolution", "t": "longtail", "aka": ["gauge equivariant", "gauge CNN"] },
    { "a": "Spherical convolution", "t": "longtail", "aka": ["spherical", "spherical CNN", "S2 convolution", "SO(3) convolution"] },
    { "a": "Spiral convolution", "t": "longtail", "aka": ["spiral", "SpiralConv", "SpiralNet"] },
    { "a": "Geodesic convolution", "t": "longtail", "aka": ["geodesic", "geodesic CNN", "GCNN on manifolds"] },
    { "a": "Chebyshev convolution", "t": "longtail", "aka": ["Chebyshev", "ChebConv", "ChebNet", "Chebyshev spectral convolution"] },
    { "a": "Relational graph convolution", "t": "longtail", "aka": ["relational graph", "R-GCN", "RGCN", "RGCNConv"] },
    { "a": "Diffusion convolution", "t": "longtail", "aka": ["diffusion", "diffusion-convolutional", "DCRNN"] },
    { "a": "PointConv", "t": "longtail", "aka": ["point convolution", "point conv"] },
    { "a": "KPConv", "t": "longtail", "aka": ["kernel point convolution", "kernel point"] },
    { "a": "X-Conv", "t": "longtail", "aka": ["X-transformation", "PointCNN", "XConv"] },
    { "a": "Continuous convolution", "t": "longtail", "aka": ["continuous", "continuous-filter convolution", "cfconv", "parametric continuous convolution"] },
    { "a": "Quaternion convolution", "t": "longtail", "aka": ["quaternion", "quaternion CNN", "hypercomplex convolution"] },
    { "a": "Complex-valued convolution", "t": "longtail", "aka": ["complex-valued", "complex convolution", "deep complex networks"] },
    { "a": "Binary convolution", "t": "longtail", "aka": ["binary", "XNOR convolution", "binarized convolution", "XNOR-Net"], "q": "Weights and activations in ±1, so multiply-accumulate becomes XNOR plus popcount." },
    { "a": "Hexagonal convolution", "t": "longtail", "aka": ["hexagonal", "HexaConv", "hex convolution"] },
    { "a": "Gabor convolution", "t": "longtail", "aka": ["Gabor", "Gabor convolutional network", "Gabor filter convolution"] },
    { "a": "SincConv", "t": "longtail", "aka": ["sinc convolution", "sinc", "SincNet"], "q": "Learn only the cutoff frequencies of band-pass sinc filters. Raw-waveform speech with a DSP prior." },
    { "a": "Pixel-adaptive convolution", "t": "longtail", "aka": ["pixel-adaptive", "PAC", "PacConv"] },
    { "a": "ODConv", "t": "longtail", "aka": ["omni-dimensional dynamic convolution", "omni-dimensional dynamic"] },
    { "a": "MixConv", "t": "longtail", "aka": ["mixed depthwise convolution", "mixed depthwise", "mix conv"] },
    { "a": "Pyramidal convolution", "t": "longtail", "aka": ["pyramidal", "PyConv", "pyramid convolution"] },
    { "a": "Blueprint separable convolution", "t": "longtail", "aka": ["blueprint separable", "BSConv"] },
    { "a": "HetConv", "t": "longtail", "aka": ["heterogeneous kernel convolution", "heterogeneous convolution", "heterogeneous"] },
    { "a": "Self-calibrated convolution", "t": "longtail", "aka": ["self-calibrated", "SCConv", "SCNet"] },
    { "a": "Attention augmented convolution", "t": "longtail", "aka": ["attention augmented", "AA-Conv", "attention-augmented"] },
    { "a": "Fast Fourier Convolution", "t": "longtail", "aka": ["FFC", "fast Fourier"], "q": "Half the channels go spectral for an image-wide receptive field. LaMa inpaints with it." },
    { "a": "Long convolution", "t": "longtail", "aka": ["long", "global convolution", "global", "implicit long convolution", "implicit convolution"], "q": "A kernel as long as the sequence, computed via FFT. Hyena and S4 live here." },
    { "a": "Pseudo-3D convolution", "t": "longtail", "aka": ["P3D", "pseudo-3D", "pseudo 3D"] },
    { "a": "Inflated 3D convolution", "t": "longtail", "aka": ["I3D", "inflated", "inflated 3D", "kernel inflation"], "q": "Copy a pretrained 2D kernel across time and divide by its depth. Instant video model." },
    { "a": "Channel-separated convolution", "t": "longtail", "aka": ["channel-separated", "CSN", "channel separated"] }
  ]
}
