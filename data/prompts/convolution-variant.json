    { "a": "FFT convolution", "t": "outlier", "aka": ["FFT", "FFT-based convolution", "Fourier convolution", "frequency-domain convolution", "convolution theorem"], "q": "Pointwise multiply in frequency space. Wins once kernels get big." },
    { "a": "Winograd", "t": "outlier", "aka": ["Winograd convolution", "Winograd minimal filtering", "Winograd algorithm", "Winograd F(2,3)", "Winograd minimal filtering convolution", "Lavin-Gray Winograd"], "q": "Trade multiplies for adds: F(2x2, 3x3) needs 16 multiplies instead of 36." },
