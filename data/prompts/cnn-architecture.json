    { "a": "CSPNet", "t": "outlier", "aka": ["CSPDarknet", "CSPDarknet53", "Cross Stage Partial Network", "CSPResNeXt"] },
    { "a": "HRNet", "t": "outlier", "aka": ["High-Resolution Network", "HRNetV2"], "q": "Keeps a high-resolution branch alive through the whole network." },
    { "a": "Stacked Hourglass", "t": "outlier", "aka": ["Hourglass", "Hourglass Network", "Stacked Hourglass Network"], "q": "Encoder-decoders stacked end to end for human pose." },
    { "a": "Deformable ConvNet", "t": "outlier", "aka": ["DCN", "Deformable Convolutional Network", "DCNv2"] },
