    { "a": "SENet", "t": "indist", "aka": ["Squeeze-and-Excitation Network", "SE-ResNet", "SE-ResNeXt", "SENet-154"], "q": "Squeeze-and-excitation channel attention. Won the final ImageNet challenge, 2017." },
    { "a": "MobileNet", "t": "indist", "aka": ["MobileNetV1"], "q": "Depthwise separable convolutions with a width-multiplier knob." },
    { "a": "MobileNetV2", "t": "indist", "q": "Inverted residuals and linear bottlenecks." },
    { "a": "MobileNetV3", "t": "indist" },
    { "a": "ShuffleNet", "t": "indist", "aka": ["ShuffleNetV1"] },
    { "a": "SqueezeNet", "t": "indist", "q": "AlexNet-level accuracy with 50× fewer parameters, under 0.5MB compressed." },
    { "a": "ZFNet", "t": "indist", "aka": ["Zeiler-Fergus Net", "ZF Net"], "q": "Zeiler and Fergus visualized AlexNet, retuned it and won ILSVRC 2013." },
    { "a": "U-Net", "t": "indist", "q": "Built for cell segmentation in 2015; later the workhorse of diffusion models." },
    { "a": "FCN", "t": "indist", "aka": ["Fully Convolutional Network", "FCN-8s", "FCN-32s"] },
    { "a": "YOLO", "t": "indist", "aka": ["You Only Look Once"], "q": "A detector, but one big CNN all the same. We'll allow it." },
    { "a": "R-CNN", "t": "indist", "aka": ["Fast R-CNN", "Faster R-CNN", "Mask R-CNN", "Regions with CNN features"], "q": "A detector, but CNN is right there in the name." },

    { "a": "ConvNeXt", "t": "overfit", "q": "'A ConvNet for the 2020s': modernize ResNet one tweak at a time until it beats Swin." },
    { "a": "EfficientNet", "t": "overfit", "aka": ["EfficientNet-B0", "EfficientNet-B7", "EfficientNet-L2", "EfficientNet-Lite"], "q": "Compound scaling: grow depth, width and resolution together with one φ." },

    { "a": "LeNet", "t": "baseline", "aka": ["LeNet-5", "LeNet-1", "LeNet-4"], "q": "LeCun's digit reader. By the late '90s it was reading 10–20% of US checks." },
    { "a": "AlexNet", "t": "baseline", "aka": ["SuperVision"], "q": "Two GTX 580s, ReLU and dropout: ImageNet top-5 error from 26% to 15.3% in 2012." },
    { "a": "VGG", "t": "baseline", "aka": ["VGGNet", "VGG-11", "VGG-13", "VGG-16", "VGG-19", "Visual Geometry Group network"] },
    { "a": "GoogLeNet", "t": "baseline", "aka": ["Inception", "Inception-v1", "InceptionNet", "Inception network"], "q": "The capital L salutes LeNet. The paper cites the 'we need to go deeper' meme." },
    { "a": "ResNet", "t": "baseline", "aka": ["Residual Network", "Residual Neural Network", "Deep Residual Network", "ResNet-18", "ResNet-34", "ResNet-50", "ResNet-101", "ResNet-152"] }
  ]
}
