    { "a": "C3D", "t": "outlier", "aka": ["3D ConvNet", "3D CNN"] },
    { "a": "I3D", "t": "outlier", "aka": ["Inflated 3D ConvNet", "Two-Stream Inflated 3D ConvNet"] },
    { "a": "FaceNet", "t": "outlier" },

    { "a": "Inception-v3", "t": "indist", "aka": ["Inception-v2", "InceptionV3"], "q": "Factorized convolutions, plus the debut of label smoothing." },
    { "a": "Xception", "t": "indist", "aka": ["Extreme Inception"], "q": "Extreme Inception: depthwise separable convs all the way down. By the author of Keras." },
    { "a": "DenseNet", "t": "indist", "aka": ["Densely Connected Convolutional Network", "DenseNet-121", "DenseNet-169", "DenseNet-201"], "q": "Each layer feeds every later layer. CVPR 2017 best paper." },
    { "a": "ResNeXt", "t": "indist", "aka": ["ResNeXt-50", "ResNeXt-101"], "q": "Cardinality: a third dimension alongside depth and width." },
