    { "a": "Saturated activations", "t": "indist", "aka": ["saturation", "sigmoid saturation", "saturating neurons", "neuron saturation", "activation saturation"] },
    { "a": "Poor initialization", "t": "indist", "aka": ["bad initialization", "bad init", "poor init", "bad weight initialization"] },
    { "a": "Generalization gap", "t": "indist", "aka": ["train-test gap", "generalization error"] },
    { "a": "Numerical instability", "t": "indist", "aka": ["numerical overflow", "overflow", "underflow", "fp16 overflow", "numerical precision issues", "precision loss"] },
    { "a": "Out of memory", "t": "indist", "aka": ["OOM", "CUDA out of memory", "running out of memory", "memory error", "GPU out of memory"], "q": "\"CUDA out of memory. Tried to allocate 20.00 MiB.\" Deep learning's most-read sentence." },
    { "a": "Dataset bias", "t": "indist", "aka": ["sampling bias", "selection bias", "biased data", "data bias"] },
    { "a": "Bad hyperparameters", "t": "indist", "aka": ["poor hyperparameters", "bad hyperparameter choice", "wrong hyperparameters", "hyperparameter sensitivity"] },

    { "a": "Oscillation", "t": "outlier", "aka": ["oscillating loss", "loss oscillation", "zig-zagging", "oscillations"] },
    { "a": "Learning rate too low", "t": "outlier", "aka": ["lr too low", "too low learning rate", "learning rate too small", "low learning rate"] },
    { "a": "Ill-conditioning", "t": "outlier", "aka": ["ill-conditioned hessian", "poor conditioning", "ill conditioning", "ill-conditioned"] },
    { "a": "Sharp minima", "t": "outlier", "aka": ["sharp minimum"] },
    { "a": "Grokking", "t": "outlier", "aka": ["delayed generalization"], "q": "Power et al. 2022: train long past 100% train accuracy and validation suddenly snaps to perfect." },
