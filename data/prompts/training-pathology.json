    { "a": "Loss of plasticity", "t": "outlier", "aka": ["plasticity loss"], "q": "Keep training on new tasks and the network slowly loses the ability to learn anything new." },
    { "a": "Internal covariate shift", "t": "outlier", "aka": ["ICS"], "q": "What BatchNorm claimed to fix. Santurkar et al. 2018 showed that's not why BN works." },
    { "a": "Concept drift", "t": "outlier", "aka": ["drift", "concept shift"] },
    { "a": "Symmetry breaking failure", "t": "outlier", "aka": ["symmetry problem", "zero initialization", "symmetric weights", "weight symmetry", "symmetry"], "q": "Init every weight to the same value and every neuron learns the same thing, forever." },
    { "a": "Overconfidence", "t": "outlier", "aka": ["miscalibration", "poor calibration", "overconfident predictions", "calibration error"] },
    { "a": "Shortcut learning", "t": "outlier", "aka": ["shortcuts", "spurious correlations", "spurious features", "Clever Hans", "Clever Hans effect", "annotation artifacts"], "q": "Clever Hans the horse 'did math' by reading his trainer. Your X-ray model reads the hospital's marker." },
    { "a": "Benchmark contamination", "t": "outlier", "aka": ["test set contamination", "data contamination", "contamination"] },
    { "a": "Curse of dimensionality", "t": "outlier" },
    { "a": "Memorization", "t": "outlier", "aka": ["memorizing training data", "rote memorization"] },
    { "a": "Posterior collapse", "t": "outlier", "aka": ["KL vanishing", "KL collapse"], "q": "The VAE decoder gets so good it ignores the latent, and the KL term happily drops to zero." },
    { "a": "Representation collapse", "t": "outlier", "aka": ["collapse", "feature collapse", "complete collapse", "trivial solution", "trivial solutions"] },
    { "a": "Over-smoothing", "t": "outlier", "aka": ["oversmoothing"], "q": "Stack enough GNN layers and every node embedding converges to the same vector." },
    { "a": "Reward hacking", "t": "indist", "aka": ["specification gaming", "reward gaming", "Goodharting", "Goodhart's law", "reward model overoptimization", "reward overoptimization"], "q": "OpenAI's CoastRunners boat looped forever collecting points instead of finishing the race." },
    { "a": "Overestimation bias", "t": "outlier", "aka": ["Q-value overestimation", "maximization bias", "overestimation"] },
    { "a": "Discriminator overpowering", "t": "longtail", "aka": ["discriminator too strong", "discriminator wins", "strong discriminator", "vanishing generator gradients"] },
    { "a": "Checkerboard artifacts", "t": "outlier", "aka": ["checkerboard", "checkerboard pattern"], "q": "Transposed convs with uneven overlap paint a faint grid on everything. Odena et al. 2016." },
    { "a": "Forgetting zero_grad", "t": "outlier", "aka": ["not zeroing gradients", "forgot zero_grad", "missing zero_grad", "forgetting optimizer.zero_grad()"], "q": "PyTorch accumulates gradients by default. Skip zero_grad() and every step drags in the past." },
    { "a": "Forgetting model.eval()", "t": "outlier", "aka": ["train/eval mode mismatch", "forgot model.eval", "eval mode bug", "forgetting eval mode"], "q": "Dropout still on, BatchNorm still updating. Your validation numbers are quietly lying." },
    { "a": "Unshuffled data", "t": "outlier", "aka": ["no shuffling", "data not shuffled", "sorted data", "forgot to shuffle"] },
    { "a": "Training-serving skew", "t": "outlier", "aka": ["train-serve skew", "preprocessing mismatch", "training serving skew"] },
    { "a": "Exposure bias", "t": "outlier", "q": "Trained on ground truth, tested on its own outputs. Errors compound one token at a time." },
    { "a": "Model collapse", "t": "outlier", "aka": ["model autophagy disorder", "MAD", "training on synthetic data"], "q": "Train on your own outputs for a few generations and the tails of the distribution vanish." },
    { "a": "Label shift", "t": "outlier", "aka": ["prior probability shift", "prior shift", "target shift"] },
    { "a": "Sim-to-real gap", "t": "outlier", "aka": ["reality gap", "sim2real gap", "domain gap"] },
    { "a": "Validation overfitting", "t": "outlier", "aka": ["adaptive overfitting", "test set overfitting", "leaderboard overfitting", "overfitting to the validation set", "public leaderboard overfitting"], "q": "Tune on the public leaderboard long enough and the private one will humble you." },
    { "a": "Negative transfer", "t": "outlier", "aka": ["task interference"] },
    { "a": "Data poisoning", "t": "outlier", "aka": ["poisoning", "backdoor attack", "backdoors", "poisoned data"] },
    { "a": "Sparse rewards", "t": "outlier", "aka": ["sparse reward problem", "sparse reward"] },
    { "a": "Expert collapse", "t": "longtail", "aka": ["routing collapse", "load imbalance", "expert imbalance", "dead experts"], "q": "The MoE router picks a few favorites and the other experts never learn a thing." },
