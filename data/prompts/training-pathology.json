{
  "id": "training-pathology",
  "pack": "blocks",
  "text": "Name something that can go wrong when training a model",
  "note": "Failure modes, instabilities, collapses, generalization failures, data problems and classic bugs that bite during training",
  "strip": ["problem", "problems", "issue", "issues"],
  "answers": [
    { "a": "Glitch tokens", "t": "mlion", "aka": ["SolidGoldMagikarp", "under-trained tokens", "undertrained tokens", "anomalous tokens", "glitch token"], "q": "In the vocab, barely in the training data. Ask GPT-3 to repeat \" SolidGoldMagikarp\" and it said \"distribute\"." },

    { "a": "Overfitting", "t": "baseline", "aka": ["overfit", "over-fitting", "overtraining", "high variance"], "q": "Your model memorized the homework and failed the exam." },
    { "a": "Underfitting", "t": "baseline", "aka": ["underfit", "under-fitting", "high bias"] },
    { "a": "Vanishing gradients", "t": "baseline", "aka": ["vanishing gradient problem", "vanishing gradient", "gradient vanishing"], "q": "Hochreiter's 1991 thesis diagnosed it. His LSTM became the cure." },
    { "a": "Exploding gradients", "t": "baseline", "aka": ["exploding gradient problem", "exploding gradient", "gradient explosion"] },

    { "a": "Mode collapse", "t": "overfit", "aka": ["mode dropping", "Helvetica scenario", "GAN mode collapse"], "q": "The generator finds one output the discriminator likes and prints it forever. Goodfellow: the Helvetica scenario." },
    { "a": "Dying ReLU", "t": "overfit", "aka": ["dead ReLU", "dead ReLUs", "dead neurons", "dying ReLU problem", "dead units", "dying neurons"], "q": "Push a ReLU negative for every input and it never sees a gradient again. Rest in peace." },

    { "a": "Local minima", "t": "indist", "aka": ["local minimum", "stuck in a local minimum", "local optima", "local optimum", "bad local minima"] },
    { "a": "Saddle points", "t": "indist", "aka": ["saddle point"], "q": "Dauphin et al. 2014: in high dimensions, saddles, not local minima, are what slow you down." },
    { "a": "Plateaus", "t": "indist", "aka": ["plateau", "loss plateau", "training plateau", "flat regions"] },
    { "a": "Divergence", "t": "indist", "aka": ["loss divergence", "diverging loss", "training divergence", "diverging", "loss blows up", "loss explodes"] },
    { "a": "NaN loss", "t": "indist", "aka": ["NaN", "NaNs", "loss is NaN", "NaN gradients", "inf loss", "infinite loss", "nan values"], "q": "One log(0) and the whole run turns to NaN. Usually at 3 a.m., step 47,000." },
    { "a": "Loss spikes", "t": "indist", "aka": ["loss spike", "spikes", "spiky loss"] },
    { "a": "Training instability", "t": "indist", "aka": ["instability", "unstable training"] },
    { "a": "Learning rate too high", "t": "indist", "aka": ["lr too high", "too high learning rate", "learning rate too large", "high learning rate"] },
    { "a": "Slow convergence", "t": "indist", "aka": ["slow training", "converging slowly"] },
    { "a": "Failure to converge", "t": "indist", "aka": ["non-convergence", "not converging", "doesn't converge", "no convergence", "loss not decreasing", "fails to converge"] },
    { "a": "Catastrophic forgetting", "t": "indist", "aka": ["catastrophic interference", "forgetting"], "q": "Learn task B, forget task A. McCloskey & Cohen documented it back in 1989." },
    { "a": "Distribution shift", "t": "indist", "aka": ["dataset shift", "covariate shift", "domain shift", "data drift", "train-test mismatch", "out-of-distribution data", "OOD"] },
    { "a": "Data leakage", "t": "indist", "aka": ["leakage", "target leakage", "train-test leakage", "label leakage", "feature leakage", "train-test overlap", "look-ahead bias", "temporal leakage"], "q": "Your test score is amazing because the test set snuck into training. Enjoy it while it lasts." },
    { "a": "Label noise", "t": "indist", "aka": ["noisy labels", "mislabeled data", "wrong labels", "label errors", "annotation errors"] },
