    { "a": "sort_values", "t": "indist" },
    { "a": "value_counts", "t": "indist", "q": "Counts of each unique value, sorted from most frequent." },
    { "a": "isna", "t": "indist", "aka": ["isnull"], "q": "isnull is the same function under an older, R-flavoured name." },
    { "a": "to_csv", "t": "indist", "q": "Forget index=False and your file grows an unnamed column on the next read." },
    { "a": "loc", "t": "indist", "q": "Label-based. Its slices include the end label, unlike Python's." },
