{
  "id": "pandas-method",
  "pack": "stack",
  "text": "Name a pandas function or method",
  "note": "A pandas top-level function or a DataFrame, Series, GroupBy or accessor method; constructors like DataFrame count, plain attributes like shape do not",
  "strip": ["pandas", "pd", "df", "dataframe", "series", "function", "method", "func"],
  "answers": [
    { "a": "merge_asof", "t": "mlion", "aka": ["merge asof", "asof merge", "as-of join"], "q": "Joins each row to the nearest earlier key (backward by default), not an equal one. Quants match trades to quotes with it." },

    { "a": "read_csv", "t": "baseline", "q": "Dozens of parameters, and most data scripts start right here." },
    { "a": "groupby", "t": "baseline", "q": "Split, apply, combine. Hands back a lazy GroupBy object until you aggregate." },
    { "a": "merge", "t": "baseline", "q": "SQL-style joins for DataFrames. how='inner' unless you say otherwise." },
    { "a": "head", "t": "baseline", "q": "The first five rows, unless you ask for more." },
    { "a": "apply", "t": "baseline", "q": "Convenient, but often a Python-level loop in disguise. Vectorise if you can." },
    { "a": "concat", "t": "baseline", "aka": ["concatenate"], "q": "Stacks frames along an axis. axis=0 stacks rows." },

    { "a": "pivot_table", "t": "overfit", "aka": ["pivot table"], "q": "Excel's pivot table, with aggfunc='mean' as the default that quietly surprises people." },
    { "a": "melt", "t": "overfit", "q": "Wide to long: columns become rows. The tidy-data workhorse." },

    { "a": "describe", "t": "indist", "q": "Count, mean, std, min, quartiles, max. The first thing anyone calls on new data." },
