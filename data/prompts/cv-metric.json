{
  "id": "cv-metric",
  "pack": "classic",
  "text": "Name an evaluation metric for object detection or segmentation",
  "note": "Scores for boxes, masks, instances or panoptic maps, including speed and calibration of detectors. Pure loss functions don't count unless also used to score.",
  "strip": ["metric", "metrics", "score"],
  "answers": [
    { "a": "IoU", "t": "baseline", "aka": ["intersection over union", "intersection-over-union", "Jaccard index", "Jaccard", "Jaccard similarity", "Jaccard coefficient", "Jaccard similarity coefficient", "Tanimoto coefficient", "IOU", "box IoU", "mask IoU", "per-class IoU", "class IoU"], "q": "Overlap divided by union: the ruler for boxes and masks alike. Also the Jaccard index in a lab coat." },
    { "a": "mAP", "t": "baseline", "aka": ["mean average precision", "MAP", "mean Average Precision"], "q": "Area under each class's precision-recall curve, averaged over classes. COCO also averages it over IoU thresholds." },
    { "a": "Dice coefficient", "t": "baseline", "aka": ["Dice", "Dice score", "Dice similarity coefficient", "DSC", "Sørensen–Dice", "Sorensen-Dice", "Sørensen–Dice coefficient", "Dice index", "mean Dice", "mDice", "Dice-Sørensen coefficient", "Dice overlap", "Sorensen Dice coefficient", "Sørensen-Dice index", "Dice similarity"], "q": "Twice the overlap over the total size of both masks. Medical segmentation's default, and identical to F1 on pixels." },
    { "a": "mIoU", "t": "baseline", "aka": ["mean IoU", "mean intersection over union", "mean intersection-over-union", "MIoU", "average IoU", "mean Jaccard", "mean Jaccard index"], "q": "Per-class IoU, averaged. The number on every semantic segmentation leaderboard." },
    { "a": "Pixel accuracy", "t": "baseline", "aka": ["pixel acc", "global accuracy", "PA", "pixelwise accuracy", "pixel-wise accuracy", "pixel accuracy (PA)", "overall pixel accuracy", "overall accuracy", "OA"], "q": "Fraction of pixels labelled right. Scores 95% by painting everything background." },

    { "a": "Hausdorff distance", "t": "overfit", "aka": ["Hausdorff", "HD", "Hausdorff metric", "directed Hausdorff", "symmetric Hausdorff distance", "max surface distance", "maximum surface distance"], "q": "The worst boundary error: how far the most stray point is from the other mask. One speck ruins it." },
    { "a": "Panoptic quality", "t": "overfit", "aka": ["PQ", "panoptic quality (PQ)", "PQ score", "PQ thing", "PQ stuff", "PQth", "PQst", "PQ^th", "PQ^st", "mPQ", "bPQ"], "q": "Segmentation quality times recognition quality, so things and stuff are judged by one number." },

    { "a": "AUPRO", "t": "mlion", "aka": ["PRO", "per-region overlap", "AU-PRO", "area under the per-region overlap curve", "AUPRO@30", "AU-PRO30", "PRO score", "PRO curve", "AUPRO 0.3", "per region overlap", "AU-PRO 0.3"], "q": "Per-region overlap up to 30% false positives: a scratch counts as much as a stain. MVTec's fix for pixel AUROC drowning in background." },

    { "a": "Precision", "t": "indist", "aka": ["positive predictive value", "PPV", "precision rate", "detection precision"] },
    { "a": "Recall", "t": "indist", "aka": ["sensitivity", "true positive rate", "TPR", "hit rate", "detection rate", "detection recall"] },
    { "a": "F1 score", "t": "indist", "aka": ["F1", "F-measure", "F-score", "F1-score", "F measure", "F-1 score", "F score", "macro F1", "mean F1", "macro-F1"], "q": "Harmonic mean of precision and recall at one IoU threshold. For binary masks it equals Dice." },
    { "a": "Average precision", "t": "indist", "aka": ["AP", "average precision (AP)", "AP score", "box AP", "AP box", "PASCAL VOC AP", "11-point interpolated AP", "interpolated average precision", "VOC AP"] },
    { "a": "COCO mAP", "t": "indist", "aka": ["mAP@[.5:.95]", "mAP@[0.5:0.95]", "mAP50-95", "mAP@.5:.95", "AP@[.5:.95]", "AP[IoU=0.50:0.95]", "COCO AP", "COCO metric", "mAP 50-95", "mAP50:95", "mAP@0.5:0.95", "AP50-95", "COCO mean average precision", "primary COCO metric", "mAP@[.5:.05:.95]", "mAP@0.5:0.05:0.95", "mAP@IoU=0.5:0.95"], "q": "mAP averaged over ten IoU thresholds, 0.50 to 0.95. Rewards boxes that fit tightly, not just roughly." },
    { "a": "AP50", "t": "indist", "aka": ["mAP@0.5", "mAP50", "mAP@50", "mAP 0.5", "mAP@IoU=0.5", "AP@0.5", "AP@50", "mAP at IoU 0.5", "AP 50", "mAP@0.50", "AP at IoU 0.5", "mAP@.5", "AP@.5"], "q": "AP at IoU 0.5: the old PASCAL VOC bar, where a box that roughly overlaps counts as a hit." },
    { "a": "Precision-recall curve", "t": "indist", "aka": ["PR curve", "precision recall curve", "P-R curve", "PR-curve", "precision–recall curve", "PRC", "AUPRC", "PR AUC", "area under precision-recall curve", "area under the precision-recall curve"], "q": "Precision against recall as the confidence threshold moves; detection AP is the area under it." },
    { "a": "Mean accuracy", "t": "indist", "aka": ["mean class accuracy", "mean pixel accuracy", "mPA", "mAcc", "per-class accuracy", "class-wise pixel accuracy", "mean per-class accuracy", "class accuracy", "mean per-class pixel accuracy"], "q": "Accuracy averaged over classes, so a big class can't hide failures on small ones." },
    { "a": "Mask AP", "t": "indist", "aka": ["AP mask", "AP^mask", "segm AP", "segm mAP", "mAP mask", "instance segmentation AP", "mask mAP", "AP segm", "mask average precision"], "q": "COCO's AP with mask IoU in place of box IoU. The headline for instance segmentation." },

    { "a": "AP75", "t": "indist", "aka": ["mAP@0.75", "mAP75", "mAP@75", "AP@0.75", "AP@75", "AP 75", "mAP@IoU=0.75", "AP at IoU 0.75"], "q": "AP at IoU 0.75: the strict bar. Loose boxes don't pass." },
    { "a": "AP small", "t": "outlier", "aka": ["APs", "AP_S", "AP_small", "AP(S)", "mAP small", "mAP_S", "AP for small objects", "APS"], "q": "COCO's AP restricted to objects under 32×32 pixels. Where most detectors quietly fall apart." },
    { "a": "AP medium", "t": "outlier", "aka": ["APm", "AP_M", "AP_medium", "AP(M)", "mAP medium", "mAP_M", "AP for medium objects", "APM"] },
    { "a": "AP large", "t": "outlier", "aka": ["APl", "AP_L", "AP_large", "AP(L)", "mAP large", "mAP_L", "AP for large objects", "APL"] },
    { "a": "Average recall", "t": "indist", "aka": ["AR", "AR@100", "AR@10", "AR@1", "mAR", "mean average recall", "AR max=100", "AR_100", "AR(100)"], "q": "Recall averaged over IoU thresholds from 0.5 to 0.95, capped at a number of detections per image." },
    { "a": "GIoU", "t": "indist", "aka": ["Generalized IoU", "generalised IoU", "generalized intersection over union", "GIOU", "Generalized Intersection over Union", "generalised intersection over union"], "q": "IoU that still says something when boxes don't overlap, by looking at the smallest box that encloses both." },
    { "a": "HD95", "t": "outlier", "aka": ["95th percentile Hausdorff distance", "Hausdorff 95", "HD 95", "95% Hausdorff distance", "Hausdorff distance 95%", "HD95 (mm)", "percentile Hausdorff distance", "95th percentile Hausdorff", "robust Hausdorff distance"], "q": "Hausdorff distance, but ignoring the worst 5% of boundary points. Outlier-proof, so it's what papers actually report." },
    { "a": "Average surface distance", "t": "outlier", "aka": ["ASD", "ASSD", "average symmetric surface distance", "MSD", "mean surface distance", "average symmetric surface distance (ASSD)", "mean surface distance (MSD)", "average boundary distance"] },
    { "a": "Frequency-weighted IoU", "t": "indist", "aka": ["FWIoU", "fwIoU", "frequency weighted intersection over union", "frequency-weighted intersection over union", "FWIOU", "weighted IoU", "fIoU"], "q": "mIoU where common classes count more, so sky and road outvote the traffic signs." },
    { "a": "Boundary IoU", "t": "outlier", "aka": ["boundary-IoU", "Boundary Intersection over Union", "boundary IoU metric", "BIoU", "B-IoU"], "q": "IoU computed only in a thin band along the mask edge, so a fuzzy boundary can't hide behind a huge, easy interior." },
    { "a": "FPS", "t": "outlier", "aka": ["frames per second", "inference speed", "inference time", "latency", "throughput", "speed", "runtime", "FPS (frames per second)"], "q": "Not an accuracy metric, but no detector paper leaves it out." },
    { "a": "3D IoU", "t": "outlier", "aka": ["3D box IoU", "BEV IoU", "bird's-eye-view IoU", "3D intersection over union", "bird's eye view IoU", "rotated IoU", "3D bounding box IoU"] },
    { "a": "Tversky index", "t": "outlier", "aka": ["Tversky", "Tversky coefficient", "Tversky score", "Tversky similarity"], "q": "Dice with separate penalties for false positives and false negatives, so you can punish missed lesions harder." },

    { "a": "Segmentation quality", "t": "outlier", "aka": ["SQ", "segmentation quality (SQ)", "mean IoU of matched segments"], "q": "Half of PQ: average IoU of the segments that were matched correctly." },
    { "a": "Recognition quality", "t": "outlier", "aka": ["RQ", "DQ", "detection quality", "recognition quality (RQ)", "F1 of segments"], "q": "The other half of PQ: an F1 score over matched, missed and spurious segments." },
    { "a": "Normalized surface Dice", "t": "outlier", "aka": ["surface Dice", "NSD", "surface DSC", "normalised surface Dice", "surface Dice coefficient", "normalized surface distance", "surface Dice at tolerance", "Surface Dice (NSD)"], "q": "DeepMind's 2018 take: the fraction of boundary within a clinically acceptable tolerance of the other. Counts millimetres, not pixels." },
    { "a": "Boundary F1 score", "t": "outlier", "aka": ["BF score", "BF1", "boundary F-measure", "boundary F-score", "contour F1", "boundary F1", "BF-score", "contour accuracy", "F-measure of boundary"], "q": "Precision and recall of the predicted contour within a few pixels of the true one." },
    { "a": "Boundary AP", "t": "longtail", "aka": ["AP boundary", "AP^boundary", "boundary average precision", "APboundary"] },
    { "a": "clDice", "t": "longtail", "aka": ["centerline Dice", "centreline Dice", "centerline dice", "cl-Dice", "clDice score", "skeleton Dice", "topology-preserving Dice"], "q": "Dice computed on skeletons. Scores whether thin vessels and roads stay connected, not just how many pixels overlap." },
    { "a": "Betti number error", "t": "longtail", "aka": ["Betti error", "Betti matching error", "Betti numbers", "topological Betti error", "Betti number", "Betti matching", "Betti error (β0 and β1)"], "q": "Compares counts of connected components and holes. Topology-aware: a one-pixel gap can be a big error." },
    { "a": "APLS", "t": "longtail", "aka": ["average path length similarity", "Average Path Length Similarity", "SpaceNet APLS", "APLS metric"], "q": "SpaceNet's road-network metric: compares shortest-path lengths between nodes in the true and predicted graphs." },
    { "a": "Correctness, completeness and quality", "t": "longtail", "aka": ["CCQ", "completeness correctness quality", "correctness completeness quality", "completeness", "correctness", "road extraction quality", "relaxed precision recall"] },
    { "a": "Aggregated Jaccard Index", "t": "longtail", "aka": ["AJI", "AJI+", "aggregated Jaccard index plus", "Aggregated Jaccard Index (AJI)", "aggregate Jaccard index"], "q": "Kumar et al. 2017, for nuclei: sums matched intersections over sums of unions, and punishes every unmatched object." },
    { "a": "Symmetric best Dice", "t": "longtail", "aka": ["SBD", "FBD", "foreground-background Dice", "best Dice", "FGBGDice", "SymmetricBestDice", "foreground background Dice", "symmetric best dice (SBD)"], "q": "CVPPP leaf segmentation challenge: match each leaf to its best-overlapping partner both ways and keep the lower score." },
    { "a": "Segmentation covering", "t": "longtail", "aka": ["covering", "SC", "Segmentation Covering (SC)", "region covering"], "q": "Arbeláez et al.: each true segment's best overlap with a predicted one, weighted by its size." },
    { "a": "Probabilistic Rand index", "t": "longtail", "aka": ["PRI", "probabilistic Rand", "PRI (probabilistic Rand index)", "probabilistic rand index"] },
    { "a": "Variation of information", "t": "longtail", "aka": ["VI", "VoI", "variation of information (VI)", "VOI", "VI split and merge"], "q": "An information-theoretic distance between two partitions. EM-neuron folks report it split and merge." },
    { "a": "Rand index", "t": "longtail", "aka": ["ARI", "adjusted Rand index", "adjusted Rand error", "Rand error", "RI", "Rand score", "Adjusted Rand Index (ARI)"], "q": "Counts pixel pairs on which two segmentations agree about being in the same segment or not." },
    { "a": "Global consistency error", "t": "longtail", "aka": ["GCE", "local consistency error", "LCE", "consistency error", "Martin consistency errors", "GCE and LCE"], "q": "Martin et al. 2001: tolerates one segmentation being a refinement of the other, and punishes the rest." },
    { "a": "Boundary displacement error", "t": "longtail", "aka": ["BDE", "boundary displacement", "mean boundary displacement", "boundary displacement error (BDE)"] },
    { "a": "ODS F-measure", "t": "longtail", "aka": ["ODS", "OIS", "optimal dataset scale", "optimal image scale", "ODS/OIS", "BSDS F-measure", "contour detection F-measure", "ODS OIS AP", "OIS F-measure"], "q": "BSDS edge metric: best F-measure with one threshold for the whole dataset (ODS) or one per image (OIS)." },
    { "a": "S-measure", "t": "longtail", "aka": ["structure-measure", "structure measure", "S-measure (Sα)", "Sα", "S-alpha", "S_alpha", "structural similarity measure"], "q": "Saliency-map metric that scores object-level and region-level structure, rather than per-pixel error." },
    { "a": "E-measure", "t": "longtail", "aka": ["enhanced-alignment measure", "enhanced alignment measure", "E-measure (Eφ)", "Eφ", "E-phi", "enhanced alignment", "E_phi", "E-measure (E_phi)"] },
    { "a": "Weighted F-measure", "t": "longtail", "aka": ["Fβw", "weighted F-score", "F-beta weighted", "weighted F-beta", "weighted Fbeta", "F_beta^w", "weighted F-beta measure"] },
    { "a": "Pixel AUROC", "t": "outlier", "aka": ["pixel-level AUROC", "pixel AUC", "pixel-wise AUROC", "P-AUROC", "pixel ROC AUC", "pixel-level ROC-AUC", "pixel-wise AUC", "pixel-level AUC", "localization AUROC", "pixel ROC-AUC"], "q": "Anomaly localisation's headline number. Flattered by all the normal pixels." },
    { "a": "AUPIMO", "t": "longtail", "aka": ["Area Under the Per-IMage Overlap curve", "PIMO", "per-image overlap", "AUPIMO curve", "per image overlap"], "q": "A 2024 per-image cousin of AUPRO, proposed because AUROC and AUPRO were saturating on MVTec AD." },
    { "a": "Number of clicks", "t": "longtail", "aka": ["NoC", "NoC@85", "NoC@90", "NoC85", "NoC90", "number of clicks to reach IoU", "clicks to reach IoU", "NoC@80", "mean number of clicks"], "q": "Interactive segmentation: how many user clicks until the mask reaches 85% or 90% IoU?" },
    { "a": "Overall IoU", "t": "longtail", "aka": ["oIoU", "cumulative IoU", "overall intersection over union", "oIoU (overall IoU)", "cumulative intersection over union"], "q": "Referring segmentation: total intersection over total union across the whole dataset, so big objects dominate." },
    { "a": "J&F", "t": "outlier", "aka": ["J and F", "J&F mean", "J-mean", "F-mean", "JF", "region similarity and contour accuracy", "J and F score", "DAVIS J&F", "(J&F)", "J&F score", "J mean", "F mean"], "q": "DAVIS video-object-segmentation score: the mean of region similarity J (IoU) and contour accuracy F." },
    { "a": "Segmentation and Tracking Quality", "t": "longtail", "aka": ["STQ", "STEP STQ", "segmenting and tracking every pixel", "association quality", "AQ", "STQ (segmentation and tracking quality)"], "q": "STEP's video panoptic metric: the geometric mean of association quality and segmentation quality." },
    { "a": "Video panoptic quality", "t": "longtail", "aka": ["VPQ", "VPQ^k", "video PQ", "VPQ (video panoptic quality)"] },
    { "a": "Instance-level IoU", "t": "longtail", "aka": ["iIoU", "instance-level intersection over union", "iIoU class", "iIoU category", "Cityscapes iIoU", "instance IoU", "instance-level IoU (iIoU)"], "q": "Cityscapes' fix for big objects dominating mIoU: each pixel is weighted by the class's average instance size over its own instance's size." },
    { "a": "Volumetric similarity", "t": "longtail", "aka": ["VS", "volume similarity", "volumetric similarity (VS)", "volume overlap error"] },
    { "a": "Relative volume difference", "t": "longtail", "aka": ["RVD", "relative volume error", "volume difference", "volumetric difference", "volume error", "relative volume difference (RVD)", "relative absolute volume difference", "RAVD"] },
    { "a": "Log-average miss rate", "t": "outlier", "aka": ["LAMR", "MR-2", "miss rate", "MR−2", "log average miss rate", "miss rate vs FPPI", "FPPI", "false positives per image", "log-average miss rate (MR-2)", "MR^-2"], "q": "Pedestrian detection's yardstick: miss rate averaged over nine false-positives-per-image values, log-spaced from 0.01 to 1." },
    { "a": "FROC", "t": "longtail", "aka": ["free-response ROC", "free response ROC", "FROC curve", "free-response receiver operating characteristic", "lesion sensitivity at FP per scan", "FROC score"], "q": "Lesion sensitivity against false positives per scan. Medical detection's answer to ROC for many objects per image." },
    { "a": "LRP", "t": "longtail", "aka": ["localization recall precision", "oLRP", "optimal LRP", "LRP error", "Localisation-Recall-Precision", "Localization Recall Precision", "optimal localization recall precision", "LRP metric"], "q": "Oksuz et al. 2018: one error that mixes localisation, false positives and false negatives. Lower is better." },
    { "a": "TIDE", "t": "outlier", "aka": ["TIDE toolbox", "TIDE error analysis", "dAP", "Toolbox for Identifying Object Detection Errors", "TIDE errors", "A General Toolbox for Identifying Object Detection Errors", "error breakdown"], "q": "Splits a detector's mAP deficit into classification, localisation, duplicate, background and missed-object errors." },
    { "a": "PDQ", "t": "longtail", "aka": ["probability-based detection quality", "probabilistic detection quality", "Probability-based Detection Quality", "PDQ score", "Probabilistic Detection Quality (PDQ)"], "q": "For probabilistic detectors: rewards a box for being spatially and semantically well-calibrated, not just placed right." },
    { "a": "OC-cost", "t": "longtail", "aka": ["optimal correction cost", "OC cost", "Optimal Correction Cost", "optimal correction cost (OC-cost)"], "q": "Optimal-transport cost of correcting a detector's output into the ground truth, per image. A CVPR 2022 complement to mAP." },
    { "a": "D-ECE", "t": "longtail", "aka": ["detection expected calibration error", "detection ECE", "D-ECE metric", "Detection Expected Calibration Error", "calibration error for detection", "object detection ECE"], "q": "Expected calibration error where the confidence is also binned by box position and size, using precision as the hit rate." },
    { "a": "Wilderness impact", "t": "longtail", "aka": ["WI", "WI (wilderness impact)", "wilderness impact metric"], "q": "Open-world detection: how much known-class precision drops once unknown objects appear in the test set." },
    { "a": "A-OSE", "t": "longtail", "aka": ["absolute open-set error", "absolute open set error", "A-OSE (absolute open-set error)", "AOSE", "open-set error", "OSE"], "q": "Open-world detection: the raw count of unknown objects misclassified as a known class." },
    { "a": "U-Recall", "t": "longtail", "aka": ["unknown recall", "unknown class recall", "U-Recall (unknown recall)", "UR"] },
    { "a": "Normalized Wasserstein distance", "t": "longtail", "aka": ["NWD", "Wasserstein distance", "Gaussian Wasserstein distance", "NWD metric", "normalised Wasserstein distance", "normalized Gaussian Wasserstein distance", "NGWD"], "q": "Treats boxes as 2D Gaussians and compares them with Wasserstein distance, so a one-pixel slip on a tiny object isn't fatal." },
    { "a": "NDS", "t": "outlier", "aka": ["nuScenes detection score", "nuScenes Detection Score", "NDS (nuScenes)", "nuScenes score"], "q": "nuScenes' 3D detection score: half mAP, the rest from five true-positive error terms." },
    { "a": "nuScenes true positive errors", "t": "longtail", "aka": ["mATE", "mASE", "mAOE", "mAVE", "mAAE", "ATE", "ASE", "AOE", "AVE", "AAE", "TP metrics", "translation error", "scale error", "orientation error", "velocity error", "attribute error", "nuScenes TP metrics", "TP errors"] },
    { "a": "AOS", "t": "longtail", "aka": ["average orientation similarity", "Average Orientation Similarity", "orientation similarity", "AOS (KITTI)"], "q": "KITTI's penalty for boxes that are right but pointing backwards: a cosine similarity of heading, folded into AP." },
    { "a": "AP40", "t": "longtail", "aka": ["AP|R40", "40-point AP", "AP R40", "KITTI AP40", "AP at 40 recall positions", "40-point interpolated AP", "AP_R40", "AP11", "AP|R11", "KITTI AP", "KITTI mAP"], "q": "KITTI's updated AP, sampled at 40 recall positions instead of 11, with the recall-zero point dropped." },
    { "a": "mAPH", "t": "longtail", "aka": ["APH", "average precision weighted by heading", "mAP weighted by heading", "mAPH L2", "L1 mAPH", "L2 mAPH", "Waymo mAPH", "mAPH (Waymo)", "AP with heading"] },
    { "a": "Specificity", "t": "outlier", "aka": ["true negative rate", "TNR", "selectivity", "specificity (TNR)"] },
    { "a": "Matthews correlation coefficient", "t": "longtail", "aka": ["MCC", "phi coefficient", "Matthews correlation", "Matthews phi coefficient", "MCC score"], "q": "Correlation between prediction and truth, using all four confusion-matrix cells. Hard to flatter with a big background class." },
    { "a": "Acc@0.5", "t": "longtail", "aka": ["Pr@0.5", "Acc@0.5 (visual grounding)", "Precision@0.5", "grounding accuracy", "Acc@IoU0.5", "Pr@X", "visual grounding accuracy", "Acc@0.5 IoU"], "q": "Visual grounding: the fraction of phrases whose predicted box lands at IoU of at least 0.5 with the true one." },
    { "a": "APr", "t": "longtail", "aka": ["AP rare", "APc", "APf", "AP common", "AP frequent", "LVIS AP rare", "LVIS APr", "rare-category AP", "AP_r", "APr APc APf"], "q": "LVIS splits AP by how many training images a category has: rare, common, frequent. Long-tail honesty." },
    { "a": "DIoU", "t": "longtail", "aka": ["Distance-IoU", "distance IoU", "Distance IoU"] },
    { "a": "CIoU", "t": "longtail", "aka": ["Complete IoU", "complete-IoU", "Complete-IoU"], "q": "Zheng et al., 2020: IoU plus a centre-distance term and an aspect-ratio term. A staple box loss in YOLO versions." },
    { "a": "AUROC", "t": "outlier", "aka": ["ROC AUC", "AUC", "ROC-AUC", "AUC-ROC", "area under the ROC curve", "area under ROC curve"] },
    { "a": "Image AUROC", "t": "outlier", "aka": ["image-level AUROC", "I-AUROC", "image AUC", "image-level AUC", "image ROC AUC", "image-level ROC-AUC"] },
    { "a": "Expected calibration error", "t": "outlier", "aka": ["ECE", "calibration error"] },
    { "a": "False positive rate", "t": "outlier", "aka": ["FPR", "fall-out", "false alarm rate"] },
    { "a": "False negative rate", "t": "outlier", "aka": ["FNR"] },
    { "a": "Cohen's kappa", "t": "longtail", "aka": ["cohen kappa", "kappa coefficient"] },
    { "a": "Mean absolute error", "t": "longtail", "aka": ["MAE", "saliency MAE"] },
    { "a": "Average Hausdorff distance", "t": "longtail", "aka": ["AHD", "average Hausdorff", "modified Hausdorff distance"] },
    { "a": "FLOPs", "t": "longtail", "aka": ["GFLOPs", "MACs", "GMACs"] },
    { "a": "Saliency F-measure", "t": "longtail", "aka": ["max F-measure", "maxF", "Fmax", "maxFβ", "F-beta max", "max Fβ", "mean F-measure", "adaptive F-measure", "avg F-measure", "Fβ", "F-beta"] }
  ]
}
