{
  "id": "tree-hyperparameter",
  "pack": "classic",
  "text": "Name a hyperparameter of a random forest or gradient boosting",
  "note": "One answer per concept across sklearn, XGBoost, LightGBM, CatBoost, R and H2O names. Values (gini, dart) and plumbing (verbose, device, paths) don't count.",
  "strip": ["hyperparameter", "hyperparameters", "parameter", "number", "of", "num", "n"],
  "answers": [
    { "a": "max_delta_step", "t": "mlion", "aka": ["max delta step", "maximum delta step", "poisson_max_delta_step", "max_leaf_output", "max_tree_output", "max_abs_leafnode_pred", "maximum leaf output"], "q": "XGBoost's docs say it's usually not needed, then recommend it for extreme class imbalance. Poisson regression quietly sets it to 0.7." },

    { "a": "Number of trees", "t": "baseline", "aka": ["n_estimators", "num_boost_round", "num_iterations", "iterations", "num_trees", "n_trees", "number of estimators", "boosting rounds", "max_iter", "num_round", "num_rounds", "nrounds", "n_iter", "num_tree", "num_iteration", "ntree", "ntrees", "n.trees", "num.trees", "numTrees", "maxIter", "forest size", "number of boosting rounds", "number of boosting iterations", "number of iterations", "number of decision trees", "boosting iterations", "estimators", "trees", "rounds"], "q": "More trees barely overfit a forest but do overfit boosting, so boosted models pair this with early stopping." },
    { "a": "Learning rate", "t": "baseline", "aka": ["eta", "shrinkage", "shrinkage_rate", "learning_rate", "learn_rate", "lr", "step size", "stepSize", "shrinkage factor"], "q": "Friedman's shrinkage: each new tree's contribution is scaled down, so a smaller rate needs more trees. Forests have no such knob." },
    { "a": "Max depth", "t": "baseline", "aka": ["max_depth", "depth", "tree depth", "maximum depth", "maximum tree depth", "max tree depth", "depth of trees", "depth limit", "maxDepth", "max.depth", "interaction.depth", "interaction depth"], "q": "Defaults: XGBoost and CatBoost 6, sklearn boosting 3, LightGBM and sklearn forests unlimited. Unlimited depth memorizes the data." },
    { "a": "Min samples per leaf", "t": "baseline", "aka": ["min_samples_leaf", "min_child_samples", "min_data_in_leaf", "min_data_per_leaf", "min_data", "minimum samples per leaf", "min samples leaf", "min leaf size", "minimum leaf size", "min_samples_per_leaf", "nodesize", "min.node.size", "n.minobsinnode", "minInstancesPerNode", "min_rows"], "q": "The brake on leaf-wise growth: LightGBM's min_data_in_leaf (default 20) is the first knob to turn when it overfits." },
    { "a": "Max features", "t": "baseline", "aka": ["max_features", "mtry", "rsm", "random subspace method", "colsample_bynode", "feature_fraction_bynode", "colsample bynode", "features per split", "number of features per split", "number of features at each split", "col_sample_rate", "featureSubsetStrategy", "split features", "number of features to consider"], "q": "The random in random forest: each split sees only a random subset of features, decorrelating the trees. sqrt(p) is the classic default." },

    { "a": "Random seed", "t": "overfit", "aka": ["random_state", "seed", "random_seed", "rng seed", "random state", "bagging_seed", "feature_fraction_seed", "data_random_seed", "extra_seed", "drop_seed", "objective_seed", "bagging_fraction_seed"], "q": "random_state=42: the tutorial favourite, after Douglas Adams. Technically a hyperparameter, and quietly the most tuned one." },
    { "a": "Min child weight", "t": "overfit", "aka": ["min_child_weight", "min_sum_hessian_in_leaf", "min_hessian", "min_sum_hessian", "min_sum_hessian_per_leaf", "minimum child weight", "minimum sum of instance weight", "minimum hessian in leaf"], "q": "XGBoost's most misread knob: a minimum sum of Hessians in a child, not a sample count. For squared error the two coincide." },

    { "a": "Subsample", "t": "indist", "aka": ["bagging_fraction", "bagging", "sub_row", "max_samples", "row subsampling", "subsample ratio", "sample fraction", "sample_fraction", "row sampling", "sample rate", "sample_rate", "bagging fraction", "bag.fraction", "subsamplingRate", "sampsize", "bootstrap sample size", "fraction of samples", "row fraction"], "q": "Friedman's stochastic gradient boosting: each tree sees a random fraction of rows. In a forest the same knob is max_samples." },
    { "a": "Column subsample by tree", "t": "indist", "aka": ["colsample_bytree", "feature_fraction", "sub_feature", "colsample", "feature fraction", "column subsampling", "feature subsampling", "column sample by tree", "col_sample_rate_per_tree", "colsample by tree", "feature sampling", "column sampling", "subsample ratio of columns"], "q": "Draw a random share of columns once per tree. XGBoost calls it colsample_bytree, LightGBM feature_fraction." },
    { "a": "Number of leaves", "t": "indist", "aka": ["num_leaves", "max_leaf_nodes", "max_leaves", "max leaf nodes", "num_leaf", "max_leaf", "leaves", "maximum number of leaves", "leaf count", "maxnodes", "max terminal nodes", "number of terminal nodes", "terminal nodes"], "q": "LightGBM's main complexity control, since it grows leaf-wise. Keep it well under 2^max_depth or the depth limit stops mattering." },
    { "a": "L2 regularization", "t": "indist", "aka": ["reg_lambda", "lambda", "lambda_l2", "l2_leaf_reg", "l2_regularization", "L2 penalty", "L2 reg", "l2 regularisation", "ridge penalty", "L2 leaf regularization", "lambda regularization", "L2 regularization on leaf weights"], "q": "Shrinks leaf values toward zero via the denominator of the leaf weight: sum(g) / (sum(h) + lambda). XGBoost defaults to 1, CatBoost to 3." },
    { "a": "L1 regularization", "t": "indist", "aka": ["reg_alpha", "alpha", "lambda_l1", "l1_regularization", "L1 penalty", "lasso penalty", "L1 reg", "l1 regularisation", "L1 regularization on leaf weights"], "q": "Soft-thresholds leaf values, so leaves with small gradient sums become exactly zero. Defaults to 0 in XGBoost and LightGBM." },
    { "a": "Min samples split", "t": "indist", "aka": ["min_samples_split", "minimum samples to split", "min samples to split", "minimum samples for a split", "min split samples"], "q": "A node with fewer samples than this isn't split at all. Mostly redundant with min_samples_leaf, which is why people drop it." },
    { "a": "Min split loss", "t": "indist", "aka": ["gamma", "min_split_loss", "min_split_gain", "min_gain_to_split", "min_impurity_decrease", "minimum loss reduction", "minimum impurity decrease", "min split gain", "min impurity decrease", "gain threshold", "minInfoGain", "Lagrange multiplier"], "q": "XGBoost's gamma: a split must cut the loss by at least this much, or it's pruned. sklearn's min_impurity_decrease plays the same role." },
    { "a": "Split criterion", "t": "indist", "aka": ["criterion", "impurity measure", "splitting criterion", "impurity criterion", "split quality", "split quality measure", "score_function", "splitrule", "impurity", "split score function", "split scoring function"], "q": "How a split is scored: gini, entropy or log-loss for classification forests, friedman_mse for sklearn boosting, Cosine or L2 for CatBoost." },
    { "a": "Bootstrap", "t": "indist", "aka": ["bootstrap_type", "bootstrap sampling", "sampling with replacement", "bootstrapping", "replace", "with replacement", "bootstrap samples", "bootstrap sample"], "q": "Turn it off and every forest tree sees the full data, so the only randomness left is in the features. ExtraTrees defaults to off." },
    { "a": "Early stopping rounds", "t": "indist", "aka": ["early_stopping_rounds", "early_stopping_round", "early_stopping", "n_iter_no_change", "od_wait", "patience", "early stopping", "early stopping patience", "overfitting detector wait", "stopping rounds", "iterations without improvement", "early stopping round"], "q": "Stop adding trees once the validation metric hasn't improved for this many rounds. Picks the number of trees for you." },
    { "a": "Class weights", "t": "indist", "aka": ["class_weight", "class_weights", "scale_pos_weight", "auto_class_weights", "is_unbalance", "unbalance", "unbalanced_sets", "sample weights", "positive class weight", "balanced class weight", "class balancing", "classwt", "instance weights"], "q": "Up-weights the rare class. XGBoost's recipe for scale_pos_weight: sum(negative) / sum(positive)." },
    { "a": "Objective", "t": "indist", "aka": ["loss", "loss_function", "objective_type", "application", "loss function", "objective function", "custom_loss", "custom objective", "custom loss", "choice of loss", "loss type"], "q": "What the trees are fit to reduce: squared error, logloss, quantile, Poisson, ranking losses. Boosting needs only its gradient and Hessian." },
    { "a": "Max bins", "t": "indist", "aka": ["max_bin", "max_bins", "border_count", "number of bins", "bins", "histogram bins", "bin count", "number of borders", "nbins", "maxBins", "sketch_eps", "feature quantization"], "q": "Histogram methods bucket each feature into at most this many bins: 255 in LightGBM and sklearn's HistGradientBoosting, 254 in CatBoost." },
    { "a": "OOB score", "t": "indist", "aka": ["oob_score", "out-of-bag score", "out of bag", "oob", "use oob", "out-of-bag estimate", "oob estimate"], "q": "Score each tree on the rows its bootstrap left out, for a free validation estimate. About 37% of rows are out-of-bag per tree." },

    { "a": "Number of threads", "t": "outlier", "aka": ["n_jobs", "nthread", "nthreads", "num_threads", "thread_count", "n_threads", "num_thread", "number of jobs", "parallel jobs", "cpu cores", "number of cores"], "q": "Changes the clock, not the model (floating-point summation order aside). Everyone types it; few would call it a real hyperparameter." },
    { "a": "Min weight fraction leaf", "t": "outlier", "aka": ["min_weight_fraction_leaf", "minimum weighted fraction of leaf", "min weight fraction", "minimum weight fraction"] },
    { "a": "Cost-complexity pruning alpha", "t": "outlier", "aka": ["ccp_alpha", "cost complexity pruning alpha", "pruning alpha", "complexity parameter", "cp", "minimal cost-complexity pruning", "pruning parameter"], "q": "Minimal cost-complexity pruning: bigger alpha snips more subtrees. Default 0 means no pruning at all." },
    { "a": "Tree method", "t": "indist", "aka": ["tree_method", "exact vs hist", "tree construction algorithm", "tree algorithm", "split finding algorithm", "split algorithm", "hist", "gpu_hist"], "q": "XGBoost's split-finding algorithm: exact, approx or hist. Since 2.0 the default is hist." },
    { "a": "Grow policy", "t": "outlier", "aka": ["grow_policy", "tree growth policy", "growth strategy", "tree growth strategy", "leaf-wise vs level-wise", "level-wise vs leaf-wise", "symmetric trees", "oblivious trees", "growth policy"], "q": "Level-wise or leaf-wise growth. CatBoost's default is symmetric (oblivious) trees: one split condition per whole level." },
    { "a": "Booster type", "t": "indist", "aka": ["booster", "boosting_type", "boosting", "boost", "gbtree", "dart", "gblinear", "boosting algorithm", "base learner type", "base learner", "ordered vs plain boosting", "boosting mode"], "q": "gbtree, dart or gblinear in XGBoost; gbdt, dart, rf or goss in LightGBM; Ordered or Plain in CatBoost." },
    { "a": "Monotone constraints", "t": "outlier", "aka": ["monotone_constraints", "monotonic_cst", "mc", "monotone_constraint", "monotonicity constraints", "monotonic constraints", "monotonicity", "monotone constraint"], "q": "Force the prediction to rise or fall with a chosen feature. Common in credit scoring, where regulators insist." },
    { "a": "Interaction constraints", "t": "outlier", "aka": ["interaction_constraints", "interaction_cst", "feature interaction constraints", "interaction constraint", "allowed interactions"], "q": "Lists which features may appear together in a branch. Restrict them to pairs and you've built something close to a GA2M." },
    { "a": "Validation fraction", "t": "outlier", "aka": ["validation_fraction", "eval_fraction", "validation split", "internal validation fraction", "train.fraction", "early stopping validation fraction"] },
    { "a": "Bagging frequency", "t": "outlier", "aka": ["bagging_freq", "subsample_freq", "sampling_frequency", "bagging every k iterations", "subsample frequency"], "q": "LightGBM only resamples rows every k iterations, and bagging_fraction does nothing while this is 0. Classic silent no-op." },
    { "a": "Bagging temperature", "t": "outlier", "aka": ["bagging_temperature", "bayesian bootstrap temperature", "bayesian bagging temperature"], "q": "CatBoost's Bayesian bootstrap draws row weights from an exponential distribution; 0 means all weights 1, higher gets more aggressive." },
    { "a": "Random strength", "t": "outlier", "aka": ["random_strength", "split score noise", "random strength of splits"], "q": "CatBoost adds noise to split scores before choosing the best split. Default 1; more noise means less overfitting on noisy data." },
    { "a": "One-hot max size", "t": "outlier", "aka": ["one_hot_max_size", "max_cat_to_onehot", "max categories for one-hot", "one hot max size", "maximum one-hot size", "max_cat_to_one_hot"], "q": "Categorical features with at most this many values are one-hot encoded; bigger ones get target statistics. CatBoost's default is 2." },
    { "a": "Evaluation metric", "t": "outlier", "aka": ["eval_metric", "metric", "metrics", "custom_metric", "eval metric", "validation metric", "scoring", "early stopping metric"] },
    { "a": "Initial prediction", "t": "outlier", "aka": ["init", "base_score", "boost_from_average", "init_score", "initial estimator", "base score", "initial prediction", "init estimator", "starting prediction", "initial score"], "q": "Where boosting starts before tree one: the mean, the log-odds, or a whole fitted model. XGBoost's base_score became auto-estimated in 2.0." },
    { "a": "Column subsample by level", "t": "outlier", "aka": ["colsample_bylevel", "colsample by level", "column sample by level", "feature sampling per level", "column subsampling by level"], "q": "Resample columns again at every new depth of the tree. Sits between colsample_bytree and colsample_bynode." },
    { "a": "Number of parallel trees", "t": "outlier", "aka": ["num_parallel_tree", "parallel trees", "trees per round", "forest per round", "boosted random forest", "trees per boosting round"], "q": "More than one tree per boosting round turns XGBoost into boosted forests; with a single round it's a random forest." },
    { "a": "Warm start", "t": "outlier", "aka": ["warm_start", "incremental trees", "reuse previous solution", "continue training"] },
    { "a": "L2 leaf for categories", "t": "longtail", "aka": ["cat_l2", "categorical l2", "categorical L2 regularization", "L2 regularization for categorical splits"] },
    { "a": "Learning rate annealing", "t": "longtail", "aka": ["learn_rate_annealing", "lr decay", "learning rate decay", "learning rate schedule", "decaying learning rate", "lr schedule", "learning rate scheduler", "learning rate decay factor"], "q": "H2O's version: multiply the learning rate by this each tree, so the early trees do the heavy lifting and later ones fine-tune." },

    { "a": "DART drop rate", "t": "longtail", "aka": ["rate_drop", "drop_rate", "dart drop rate", "dropout rate", "dart dropout rate", "drop rate", "dart rate"], "q": "DART drops this fraction of existing trees before fitting the next one, so late trees stop merely patching early ones." },
    { "a": "DART skip drop", "t": "longtail", "aka": ["skip_drop", "skip drop", "dart skip probability", "probability of skipping dropout"] },
    { "a": "DART one drop", "t": "longtail", "aka": ["one_drop", "one drop", "always drop one tree"], "q": "Forces at least one tree to be dropped every round in XGBoost's DART, even when the random draw would drop none." },
    { "a": "DART max drop", "t": "longtail", "aka": ["max_drop", "max drop", "maximum dropped trees"] },
    { "a": "DART sample type", "t": "longtail", "aka": ["sample_type", "uniform_drop", "dart sample type", "uniform vs weighted dropout", "dart sampling", "dart drop selection"] },
    { "a": "DART normalize type", "t": "longtail", "aka": ["normalize_type", "dart normalize type", "tree vs forest normalization", "dart normalization"] },
    { "a": "xgboost_dart_mode", "t": "longtail", "aka": ["xgboost dart mode", "xgboost-style dart"], "q": "A LightGBM flag whose only job is to make its DART rescaling imitate XGBoost's. Same idea, two arithmetics." },
    { "a": "Path smoothing", "t": "longtail", "aka": ["path_smooth", "path smooth", "leaf path smoothing", "smooth leaf outputs"], "q": "LightGBM shrinks each leaf's output toward its parent's, more strongly for leaves with few samples." },
    { "a": "Extra trees", "t": "longtail", "aka": ["extra_trees", "extra_tree", "extremely randomized splits", "random thresholds", "extremely randomized trees option", "randomized split thresholds"], "q": "LightGBM's switch to Extra-Trees splitting: a single random threshold per feature instead of searching for the best one." },
    { "a": "GOSS top rate", "t": "longtail", "aka": ["top_rate", "goss top rate", "top rate", "retain ratio of large gradients"], "q": "Gradient-based One-Side Sampling keeps this share of the largest-gradient rows outright." },
    { "a": "GOSS other rate", "t": "longtail", "aka": ["other_rate", "goss other rate", "other rate", "small gradient sampling rate"], "q": "GOSS samples this share of the remaining small-gradient rows and re-weights them to compensate." },
    { "a": "Min data in bin", "t": "longtail", "aka": ["min_data_in_bin", "minimum data in bin", "min samples per bin"] },
    { "a": "Subsample for bin", "t": "longtail", "aka": ["subsample_for_bin", "bin_construct_sample_cnt", "bin construct sample count", "rows used to build bins"] },
    { "a": "Max categorical threshold", "t": "longtail", "aka": ["max_cat_threshold", "max cat threshold", "maximum categorical split threshold", "max categories per split"] },
    { "a": "Categorical smoothing", "t": "longtail", "aka": ["cat_smooth", "cat smooth", "categorical smoothing", "category smoothing", "smoothing for categorical features"], "q": "LightGBM's smoothing for categorical splits, so rare categories don't get over-trusted. Default 10." },
    { "a": "Min data per group", "t": "longtail", "aka": ["min_data_per_group", "minimum data per categorical group", "min samples per category"] },
    { "a": "Linear tree", "t": "longtail", "aka": ["linear_tree", "linear_trees", "linear leaves", "linear model trees", "piecewise linear trees"], "q": "LightGBM fits a small linear regression in each leaf instead of a constant." },
    { "a": "Linear lambda", "t": "longtail", "aka": ["linear_lambda", "linear tree regularization", "linear leaf regularization"] },
    { "a": "Leaf estimation iterations", "t": "longtail", "aka": ["leaf_estimation_iterations", "leaf estimation steps", "newton steps per leaf"] },
    { "a": "Leaf estimation method", "t": "longtail", "aka": ["leaf_estimation_method", "leaf estimation", "newton vs gradient", "leaf value calculation method"], "q": "CatBoost: set leaf values with Newton steps or plain gradient steps. Default depends on the loss." },
    { "a": "Leaf estimation backtracking", "t": "longtail", "aka": ["leaf_estimation_backtracking", "backtracking type", "leaf backtracking"] },
    { "a": "Overfitting detector type", "t": "longtail", "aka": ["od_type", "overfitting detector", "overfitting detector type", "od type", "IncToDec", "od_pval", "od pval", "overfitting detector p-value"], "q": "CatBoost's overfitting detector: stop on a fixed wait (Iter) or on a p-value test (IncToDec)." },
    { "a": "Use best model", "t": "longtail", "aka": ["use_best_model", "use best model", "best model shrinking", "shrink to best iteration"], "q": "CatBoost trims the model back to the best validation iteration after training. On by default when a validation set is given." },
    { "a": "Tolerance", "t": "longtail", "aka": ["tol", "early_stopping_min_delta", "min delta", "convergence tolerance", "early stopping tolerance", "early stopping min delta"] },
    { "a": "Sampling method", "t": "longtail", "aka": ["sampling_method", "data_sample_strategy", "gradient-based sampling", "uniform vs gradient_based", "data sample strategy", "row sampling method", "gradient based sampling"], "q": "XGBoost's uniform or gradient_based row sampling; LightGBM's bagging or GOSS. Gradient-based keeps rows that still matter." },
    { "a": "MVS regularization", "t": "longtail", "aka": ["mvs_reg", "mvs regularization", "minimum variance sampling regularization", "mvs reg"], "q": "CatBoost's default Minimum Variance Sampling picks rows by gradient magnitude; this term controls how much it smooths that." },
    { "a": "Sampling unit", "t": "longtail", "aka": ["sampling_unit", "sampling by group", "object vs group sampling"] },
    { "a": "Balanced bagging fractions", "t": "longtail", "aka": ["pos_bagging_fraction", "neg_bagging_fraction", "pos_bagging", "neg_bagging", "balanced bagging", "class-specific bagging fraction", "positive bagging fraction", "negative bagging fraction"] },
    { "a": "Tree learner", "t": "longtail", "aka": ["tree_learner", "tree learner type", "parallel tree learner", "serial vs data parallel", "feature parallel", "data parallel", "voting parallel"] },
    { "a": "Multi strategy", "t": "longtail", "aka": ["multi_strategy", "multi-output strategy", "one_output_per_tree", "multi_output_tree", "multi output tree", "multi-target strategy"], "q": "XGBoost 2.0: for multi-target problems, either one tree per output or a single vector-leaf tree for all of them." },
    { "a": "Tweedie variance power", "t": "longtail", "aka": ["tweedie_variance_power", "tweedie power", "tweedie p"], "q": "Between 1 and 2 the Tweedie loss is a compound Poisson-gamma: zero-inflated, skewed insurance claims." },
    { "a": "Huber slope", "t": "longtail", "aka": ["huber_slope", "huber delta", "huber threshold", "huber parameter", "pseudo huber slope"] },
    { "a": "Quantile alpha", "t": "longtail", "aka": ["quantile_alpha", "huber alpha", "quantile level", "alpha for quantile loss", "quantile parameter"] },
    { "a": "Fair loss c", "t": "longtail", "aka": ["fair_c", "fair loss parameter", "fair c"] },
    { "a": "Model size regularization", "t": "longtail", "aka": ["model_size_reg", "model size reg", "model size penalty"], "q": "CatBoost penalty on the size of the model's categorical-feature statistics. Larger means smaller, more compact models." },
    { "a": "Model shrink rate", "t": "longtail", "aka": ["model_shrink_rate", "model_shrink_mode", "model shrink mode", "model shrinkage"], "q": "CatBoost can shrink the whole existing model by a factor each iteration, a decay on all previous trees." },
    { "a": "Diffusion temperature", "t": "longtail", "aka": ["diffusion_temperature", "langevin", "posterior_sampling", "langevin boosting", "SGLB", "stochastic gradient langevin boosting"], "q": "CatBoost's SGLB: Gaussian noise injected into gradient boosting, with a proof that it converges to the global optimum." },
    { "a": "Fold length multiplier", "t": "longtail", "aka": ["fold_len_multiplier", "fold length multiplier", "ordered boosting fold growth"] },
    { "a": "Fold permutation block", "t": "longtail", "aka": ["fold_permutation_block", "permutation block size", "fold permutation block size"] },
    { "a": "Has time", "t": "longtail", "aka": ["has_time", "time-ordered data", "use data order"], "q": "CatBoost: stop shuffling and treat row order as time, so target statistics only use earlier rows." },
    { "a": "Max CTR complexity", "t": "longtail", "aka": ["max_ctr_complexity", "max ctr complexity", "maximum feature combination size", "categorical feature combinations"] },
    { "a": "CTR type", "t": "longtail", "aka": ["simple_ctr", "combinations_ctr", "per_feature_ctr", "ctr_description", "ctr type", "target statistics type", "categorical target statistics", "target encoding type", "ctr_target_border_count"] },
    { "a": "CTR leaf count limit", "t": "longtail", "aka": ["ctr_leaf_count_limit", "ctr leaf count limit", "max leaves with ctr"] },
    { "a": "Counter calc method", "t": "longtail", "aka": ["counter_calc_method", "counter ctr calculation", "counter ctr method"] },
    { "a": "Feature border type", "t": "longtail", "aka": ["feature_border_type", "border type", "binning method", "quantization type", "bin type"], "q": "CatBoost's quantization rule: median, uniform, GreedyLogSum, GreedyMinEntropy and friends. GreedyLogSum is the default." },
    { "a": "Missing value handling", "t": "longtail", "aka": ["nan_mode", "use_missing", "zero_as_missing", "missing", "missing values", "missing value mode", "nan mode"], "q": "Where NaNs go: CatBoost's nan_mode (Min, Max, Forbidden), LightGBM's use_missing and zero_as_missing, XGBoost learns a default direction." },
    { "a": "Feature use penalty", "t": "longtail", "aka": ["first_feature_use_penalties", "per_object_feature_penalties", "penalties_coefficient", "cegb_tradeoff", "cegb_penalty_split", "cegb_penalty_feature_coupled", "cegb_penalty_feature_lazy", "feature_contri", "feature_penalty", "feature_contrib", "cost-effective gradient boosting", "CEGB", "feature costs"], "q": "Make a feature pay to be used: cost-effective gradient boosting charges per feature, per split or per data point so cheap features win ties." },
    { "a": "Feature weights", "t": "longtail", "aka": ["feature_weights", "feature weight", "per-feature sampling weights", "column sampling weights"] },
    { "a": "Forced splits", "t": "longtail", "aka": ["forcedsplits_filename", "forced_splits", "fs", "forced_splits_file", "forced_splits_filename", "forcedsplits", "fixed_binary_splits", "fixed binary splits"] },
    { "a": "Monotone constraints method", "t": "longtail", "aka": ["monotone_constraints_method", "mc_method", "monotone_constraining_method", "monotone constraint enforcement"], "q": "LightGBM can enforce monotonicity via basic, intermediate or advanced; the later ones lose less accuracy at more compute." },
    { "a": "Monotone penalty", "t": "longtail", "aka": ["monotone_penalty", "mc_penalty", "ms_penalty", "monotone_splits_penalty", "monotone splits penalty"] },
    { "a": "Quantized gradients", "t": "longtail", "aka": ["use_quantized_grad", "num_grad_quant_bins", "stochastic_rounding", "quant_train_renew_leaf", "gradient quantization", "quantized training", "gradient quantization bins"], "q": "LightGBM 4's quantized training: gradients and Hessians stored in a few bits, with stochastic rounding. Faster histograms." },
    { "a": "Exclusive feature bundling", "t": "longtail", "aka": ["enable_bundle", "bundle", "is_enable_bundle", "EFB", "sparse_features_conflict_fraction", "feature bundling", "max conflict rate", "bundle conflict rate"], "q": "LightGBM merges mutually exclusive sparse features into one, tolerating a small conflict rate. Toggle it with enable_bundle." },
    { "a": "Feature pre-filter", "t": "longtail", "aka": ["feature_pre_filter", "feature prefilter", "pre-filter features"], "q": "LightGBM drops features that can't satisfy min_data_in_leaf when building the dataset, so changing that later raises an error." },
