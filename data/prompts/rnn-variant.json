    { "a": "SRU", "t": "outlier", "aka": ["Simple Recurrent Unit"] },
    { "a": "minGRU", "t": "outlier", "q": "'Were RNNs All We Needed?' Strip the GRU down until it trains with a parallel scan." },
    { "a": "Tree-LSTM", "t": "outlier", "aka": ["Child-Sum Tree-LSTM"] },
