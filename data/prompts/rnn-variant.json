    { "a": "Seq2seq", "t": "indist", "aka": ["Sequence to sequence", "RNN Encoder-Decoder", "Encoder-decoder RNN"] },
    { "a": "xLSTM", "t": "indist", "aka": ["Extended LSTM", "sLSTM"], "q": "Hochreiter's 2024 comeback: exponential gating and a matrix memory." },
    { "a": "RWKV", "t": "indist", "aka": ["Receptance Weighted Key Value"], "q": "Pronounced 'RwaKuv'. Trains in parallel like a transformer, runs like an RNN." },
    { "a": "Mamba", "t": "indist", "aka": ["Mamba-2", "Selective State Space Model"], "q": "A selective state-space model. At inference time, it's an RNN." },

    { "a": "Elman network", "t": "overfit", "aka": ["Elman RNN", "Elman", "Simple Recurrent Network", "SRN"], "q": "Elman, 1990, 'Finding Structure in Time': the hidden state is copied into context units." },
    { "a": "Hopfield network", "t": "overfit", "aka": ["Hopfield net", "Hopfield"], "q": "Hopfield, 1982: memories as energy minima. A share of the 2024 Nobel Prize in Physics." },

