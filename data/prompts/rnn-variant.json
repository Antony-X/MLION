    { "a": "Gated Linear Attention", "t": "longtail", "aka": ["GLA"] },
    { "a": "Universal Transformer", "t": "outlier", "q": "One transformer layer applied recurrently in depth, with adaptive halting." },

    { "a": "Modern Hopfield network", "t": "outlier", "aka": ["Dense Associative Memory", "Hopfield layer", "Hopfield Networks is All You Need"] },
    { "a": "Liquid state machine", "t": "outlier", "aka": ["LSM"] },
