    { "a": "Bidirectional RNN", "t": "indist", "aka": ["BiRNN", "BRNN", "Bidirectional"], "q": "Schuster and Paliwal, 1997: one pass forward, one backward." },
    { "a": "BiLSTM", "t": "indist", "aka": ["Bidirectional LSTM", "Bi-LSTM"] },
    { "a": "Deep RNN", "t": "indist", "aka": ["Stacked RNN", "Stacked LSTM", "Deep LSTM", "Multilayer RNN"] },
    { "a": "Jordan network", "t": "indist", "aka": ["Jordan RNN", "Jordan"], "q": "Michael I. Jordan, 1986: feeds the output, not the hidden state, back in." },
    { "a": "Echo state network", "t": "indist", "aka": ["ESN", "Reservoir computing", "Reservoir network"], "q": "A fixed random reservoir; only the readout gets trained. Jaeger, 2001." },
    { "a": "Peephole LSTM", "t": "indist", "aka": ["LSTM with peepholes", "Peephole connections"] },
