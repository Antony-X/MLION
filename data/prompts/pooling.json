{
  "id": "pooling",
  "pack": "blocks",
  "text": "Name a pooling operation",
  "note": "Any operation that aggregates features over space, time, sets or graphs: CNN pooling layers, global readouts, RoI ops, attention pooling…",
  "strip": ["pooling", "pool", "operation", "layer", "nn", "torch"],
  "answers": [
    { "a": "Fractional max pooling", "t": "mlion", "aka": ["FractionalMaxPool2d", "FractionalMaxPool3d", "FMP"], "q": "Ben Graham 2014: downsample by a non-integer factor like √2, with pseudo-randomly placed pooling regions." },

    { "a": "PSRoI pooling", "t": "longtail", "aka": ["position-sensitive RoI pooling", "PSRoIPool"] },
    { "a": "Precise RoI pooling", "t": "longtail", "aka": ["PrRoI pooling"] },
    { "a": "R-MAC", "t": "longtail", "aka": ["regional maximum activations of convolutions"] },
    { "a": "SPoC", "t": "longtail", "aka": ["sum-pooled convolutional features"] },
    { "a": "CroW", "t": "longtail", "aka": ["cross-dimensional weighting"] },
    { "a": "VLAD", "t": "longtail", "aka": ["vector of locally aggregated descriptors"] },
    { "a": "GhostVLAD", "t": "longtail" },
    { "a": "Fisher vector pooling", "t": "longtail", "aka": ["Fisher vector encoding"] },
    { "a": "Compact bilinear pooling", "t": "longtail" },
    { "a": "MCB", "t": "longtail", "aka": ["multimodal compact bilinear pooling"] },
    { "a": "Second-order pooling", "t": "longtail", "aka": ["covariance pooling", "O2P"] },
    { "a": "Kernel pooling", "t": "longtail" },
    { "a": "Mixed pooling", "t": "longtail", "aka": ["mixed max-average pooling"] },
    { "a": "Gated pooling", "t": "longtail" },
    { "a": "Tree pooling", "t": "longtail" },
    { "a": "LogSumExp pooling", "t": "longtail", "aka": ["LSE pooling"] },
    { "a": "Rank-based pooling", "t": "longtail" },
    { "a": "Wavelet pooling", "t": "longtail" },
    { "a": "Spectral pooling", "t": "longtail", "q": "Rippel et al. 2015: crop the Fourier spectrum instead of the spatial grid." },
    { "a": "SoftPool", "t": "longtail" },
    { "a": "LIP", "t": "longtail", "aka": ["local importance-based pooling"] },
    { "a": "Detail-preserving pooling", "t": "longtail", "aka": ["DPP"] },
    { "a": "S3Pool", "t": "longtail" },
    { "a": "TopK pooling", "t": "longtail", "aka": ["gPool", "graph U-Net pooling"] },
    { "a": "SAGPool", "t": "longtail", "aka": ["self-attention graph pooling"] },
    { "a": "MinCutPool", "t": "longtail", "aka": ["MinCut pooling"] },
    { "a": "SortPool", "t": "longtail", "aka": ["sort pooling"] },
    { "a": "EdgePool", "t": "longtail" },
    { "a": "ASAPool", "t": "longtail", "aka": ["ASAP", "adaptive structure aware pooling"] },
    { "a": "Set2Set", "t": "longtail", "q": "Vinyals et al.'s order-invariant LSTM-attention readout, borrowed for graph-level pooling." },
    { "a": "Graclus pooling", "t": "longtail" },
    { "a": "Statistics pooling", "t": "longtail", "aka": ["stats pooling", "attentive statistics pooling"] },
    { "a": "Concat pooling", "t": "longtail", "aka": ["AdaptiveConcatPool2d", "concat max and average pooling"] },
    { "a": "Global weighted rank pooling", "t": "longtail", "aka": ["GWRP"] },
    { "a": "Noisy-OR pooling", "t": "longtail" },
    { "a": "Maxout", "t": "longtail", "aka": ["cross-channel pooling", "channel max pooling"], "q": "Goodfellow et al. 2013: max-pool across channels instead of across space." },

    { "a": "RoIAlign", "t": "outlier", "q": "Mask R-CNN's fix: bilinear sampling instead of rounding RoI coordinates. Small change, big mask gains." },
    { "a": "Lp pooling", "t": "outlier", "aka": ["LPPool2d", "LPPool1d", "power-average pooling", "L2 pooling"], "q": "p=1 is sum pooling, p→∞ is max pooling, and everything in between." },
    { "a": "Stochastic pooling", "t": "outlier", "q": "Zeiler & Fergus 2013: sample one activation per window with probability proportional to its value." },
    { "a": "ASPP", "t": "outlier", "aka": ["atrous spatial pyramid pooling"] },
    { "a": "Pyramid pooling module", "t": "outlier", "aka": ["PPM", "PSPNet pooling"] },
    { "a": "Generalized mean pooling", "t": "outlier", "aka": ["GeM", "generalised mean pooling"], "q": "A learnable p between average and max. Image-retrieval and Kaggle landmark-recognition staple." },
    { "a": "NetVLAD", "t": "outlier", "q": "VLAD made differentiable for place recognition: soft-assign features to clusters, pool the residuals." },
    { "a": "Bilinear pooling", "t": "outlier" },
    { "a": "BlurPool", "t": "outlier", "aka": ["anti-aliased pooling", "MaxBlurPool", "blur pooling"], "q": "\"Making Convolutional Networks Shift-Invariant Again\" (Zhang 2019): low-pass filter before you subsample." },
    { "a": "K-max pooling", "t": "outlier", "aka": ["dynamic k-max pooling"], "q": "Kalchbrenner et al. 2014: keep the k largest values, in their original order." },
    { "a": "Max-over-time pooling", "t": "outlier", "aka": ["temporal max pooling"] },
    { "a": "Max unpooling", "t": "outlier", "aka": ["MaxUnpool2d", "unpooling"] },
    { "a": "DiffPool", "t": "outlier", "aka": ["differentiable pooling"], "q": "Learns a soft cluster assignment to coarsen graphs level by level." },
    { "a": "PMA", "t": "outlier", "aka": ["pooling by multihead attention", "multihead attention pooling", "MAP head"] },
    { "a": "Last-token pooling", "t": "outlier", "aka": ["EOS pooling"] },
    { "a": "Overlapping pooling", "t": "outlier", "aka": ["overlapping max pooling"], "q": "AlexNet's 3×3 windows at stride 2, credited with slightly reducing overfitting." },

    { "a": "Global max pooling", "t": "indist", "aka": ["GMP", "GlobalMaxPooling2D"] },
    { "a": "Adaptive average pooling", "t": "indist", "aka": ["AdaptiveAvgPool2d", "AdaptiveAvgPool1d", "AdaptiveAvgPool3d", "adaptive avg pooling"], "q": "You choose the output size and PyTorch works out the windows. How torchvision models handle any input size." },
    { "a": "Adaptive max pooling", "t": "indist", "aka": ["AdaptiveMaxPool2d", "AdaptiveMaxPool1d", "AdaptiveMaxPool3d"] },
    { "a": "Sum pooling", "t": "indist", "aka": ["add pooling", "global add pooling", "global sum pooling"], "q": "GIN's readout: sum, not mean, so pooling can count. Injective on multisets." },
    { "a": "Spatial pyramid pooling", "t": "indist", "aka": ["SPP", "SPPF", "SPP-net"], "q": "He et al. 2014: pool at several grid sizes and concatenate, so a CNN can take any image size." },
    { "a": "RoI pooling", "t": "indist", "aka": ["RoIPool", "region of interest pooling"], "q": "Fast R-CNN: max-pool every region proposal to a fixed grid. RoIAlign later fixed the rounding." },
    { "a": "Attention pooling", "t": "indist", "aka": ["attentive pooling", "attention-based pooling", "attention-based MIL pooling", "global attention pooling"] },
    { "a": "CLS token pooling", "t": "indist", "aka": ["CLS pooling", "class token pooling"] },

    { "a": "Min pooling", "t": "overfit", "aka": ["minimum pooling"], "q": "Real, if rare: it's just −maxpool(−x). The answer everyone thinks only they came up with." },

    { "a": "Max pooling", "t": "baseline", "aka": ["MaxPool", "MaxPool2d", "MaxPool1d", "MaxPool3d", "maximum pooling"] },
    { "a": "Average pooling", "t": "baseline", "aka": ["avg pooling", "mean pooling", "AvgPool2d", "AvgPool1d", "AvgPool3d", "AvgPool"] },
    { "a": "Global average pooling", "t": "baseline", "aka": ["GAP", "global avg pooling", "global mean pooling", "global pooling", "GlobalAveragePooling2D"], "q": "Network in Network (2013): average each feature map to a single number and drop the FC layers." }
  ]
}
