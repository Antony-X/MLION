{
  "id": "weight-init",
  "pack": "blocks",
  "text": "Name a weight initialization scheme",
  "note": "Any scheme for setting a network's starting weights: random distributions, variance-scaling rules, structured matrices, data-driven or pretrained starts.",
  "strip": ["initialization", "initialisation", "init", "initializer", "initialiser", "scheme", "weight", "weights", "nn", "torch", "keras", "initializers", "jax", "tf"],
  "answers": [
    { "a": "LSUV", "t": "mlion", "aka": ["layer-sequential unit-variance"], "q": "Mishkin & Matas's \"All you need is a good init\" (2015): orthonormal start, then rescale each layer to unit variance." },

    { "a": "Dirac initialization", "t": "longtail", "aka": ["dirac delta"] },
    { "a": "Sparse initialization", "t": "longtail", "q": "Martens 2010: only 15 nonzero incoming weights per unit, for Hessian-free training." },
    { "a": "SkipInit", "t": "longtail" },
    { "a": "T-Fixup", "t": "longtail" },
    { "a": "Admin", "t": "longtail", "aka": ["adaptive model initialization"] },
    { "a": "SmallInit", "t": "longtail", "aka": ["small embedding init", "small init", "small initialization", "Nguyen and Salazar initialization"] },
    { "a": "Data-dependent initialization", "t": "longtail", "aka": ["data-driven initialization", "k-means initialization", "kmeans init"] },
    { "a": "MetaInit", "t": "longtail" },
    { "a": "GradInit", "t": "longtail" },
    { "a": "Mimetic initialization", "t": "longtail", "q": "Trockman & Kolter 2023: set Q/K/V so fresh attention already looks like a pretrained ViT's." },
    { "a": "Random walk initialization", "t": "longtail" },
    { "a": "Net2Net", "t": "longtail", "aka": ["function-preserving initialization", "Net2WiderNet", "Net2DeeperNet"] },
    { "a": "Bilinear initialization", "t": "longtail", "aka": ["bilinear upsampling", "bilinear kernel"] },
    { "a": "ConvolutionAware", "t": "longtail" },
    { "a": "SIREN initialization", "t": "longtail", "aka": ["sine initialization"] },
    { "a": "Critical initialization", "t": "longtail", "aka": ["edge of chaos", "dynamical isometry"] },
    { "a": "NTK parametrization", "t": "longtail", "aka": ["NTK parameterization", "neural tangent parametrization"] },
    { "a": "Delta-orthogonal", "t": "longtail", "aka": ["delta orthogonal initialization"], "q": "Orthogonal at the kernel's center, zeros elsewhere. Trained 10,000-layer vanilla CNNs (Xiao et al. 2018)." },
    { "a": "Chrono initialization", "t": "longtail", "q": "Tallec & Ollivier 2018: set LSTM gate biases from the time scales you expect to need." },
    { "a": "PyTorch default", "t": "longtail", "aka": ["default PyTorch init", "PyTorch default initialization"], "q": "kaiming_uniform_ with a=√5, which is just the old Lua Torch 1/√fan_in rule in disguise." },

    { "a": "Variance scaling", "t": "indist", "aka": ["calculate_gain", "fan_in", "fan_out", "fan_avg", "fan-in", "fan-out", "fan-avg", "uniform unit scaling"], "q": "The recipe behind Xavier, He and LeCun: a variance from fan-in, fan-out or their average, times a gain." },
    { "a": "Fixup", "t": "outlier", "aka": ["fixed-update initialization"], "q": "Rescale residual branches and zero their last layers: deep ResNets trained with no normalization at all." },
    { "a": "Zero-init residual", "t": "outlier", "aka": ["zero gamma", "zero-init last BN", "zero-initialized last layer", "final layer zero init", "zero output init", "zero-init final layer", "zero last layer", "zero init last layer"] },
    { "a": "Greedy layer-wise pretraining", "t": "outlier", "aka": ["layer-wise pretraining", "unsupervised pretraining", "RBM pretraining", "DBN pretraining", "stacked autoencoder pretraining", "RBM", "deep belief network", "DBN", "autoencoder pretraining"], "q": "Hinton 2006: train one RBM layer at a time, then fine-tune. How deep learning got started again." },
    { "a": "μP", "t": "outlier", "aka": ["maximal update parametrization", "maximal update parameterization", "maximal update parametrisation", "μTransfer", "Depth-μP", "muP", "mup", "CompleteP"], "q": "Scale init and per-layer LRs with width so hyperparameters tuned on a small model transfer to a huge one." },
    { "a": "ReZero", "t": "outlier", "q": "Multiply each residual branch by a learnable α that starts at 0. The network begins as the identity." },
    { "a": "Scaled residual initialization", "t": "outlier", "aka": ["GPT-2 init", "GPT-2 scaled init", "Megatron initialization", "GPT-NeoX initialization", "1/sqrt(2N) scaling", "residual scaling"] },
    { "a": "Forget gate bias", "t": "outlier", "aka": ["unit forget bias", "forget bias 1"], "q": "Start the LSTM forget-gate bias at 1 so it remembers by default." },

    { "a": "LeCun initialization", "t": "indist", "aka": ["LeCun normal", "LeCun uniform", "self-normalizing networks init", "SELU initialization", "lecun_normal", "lecun_uniform"], "q": "Variance 1/fan_in. LeCun et al., 1998; the init SELU's self-normalization assumes." },
    { "a": "Truncated normal", "t": "indist", "aka": ["trunc_normal"], "q": "A Gaussian with its tails cut at ±2σ. BERT's and ViT's go-to." },
    { "a": "Constant initialization", "t": "indist", "aka": ["ones"], "q": "Every weight the same: then every unit in a layer gets the same gradient and they never differ. Fine for biases." },
    { "a": "Pretrained weights", "t": "indist", "aka": ["pretrained initialization", "transfer learning", "pretrained model", "ImageNet weights", "pretrained embeddings", "word2vec initialization", "GloVe initialization", "pretrain then finetune", "warm start", "warm-starting", "checkpoint initialization"], "q": "The best init is somebody else's training run." },
    { "a": "Identity initialization", "t": "indist", "aka": ["eye", "IRNN", "identity matrix", "identity RNN"], "q": "IRNN (Le, Jaitly & Hinton 2015): ReLU RNNs whose recurrent matrix starts as the identity." },

    { "a": "Orthogonal initialization", "t": "overfit", "aka": ["random orthogonal", "Haar orthogonal", "Saxe initialization", "unitary initialization", "orthonormal", "orthonormal initialization", "unitary RNN init"], "q": "Saxe et al. 2013: start from a random rotation so signals keep their norm. The RNN classic." },

    { "a": "Xavier initialization", "t": "baseline", "aka": ["Glorot", "Xavier uniform", "Xavier normal", "Glorot uniform", "Glorot normal", "normalized initialization", "Xavier filler", "Keras default", "TensorFlow default", "Glorot uniform default"], "q": "Glorot & Bengio, 2010: variance 2/(fan_in + fan_out), so signals keep their scale both ways. Designed for tanh." },
    { "a": "He initialization", "t": "baseline", "aka": ["Kaiming", "Kaiming normal", "Kaiming uniform", "He normal", "He uniform", "MSRA", "MSRA filler"], "q": "Variance 2/fan_in to make up for ReLU zeroing half its inputs. He et al. 2015." },
    { "a": "Random normal", "t": "baseline", "aka": ["normal", "Gaussian", "random Gaussian", "random", "random initialization", "small random numbers", "small random weights"], "q": "Draw weights from N(0, σ²). With one fixed σ, deep nets vanish or explode; scaling σ to the layer's width fixes it." },
    { "a": "Random uniform", "t": "baseline", "aka": ["uniform"], "q": "Draw weights from U(−a, a). PyTorch's Linear layers default to a Kaiming-uniform variant of exactly this." },
    { "a": "Zeros", "t": "baseline", "aka": ["zero", "zero initialization", "all zeros"], "q": "Every neuron identical, forever: the init your professor warned you about. (Fine for biases.)" },
    { "a": "Custom initializer", "t": "longtail", "aka": ["Initializer", "kernel initializer", "bias initializer", "custom init"] },
    { "a": "STFTInitializer", "t": "longtail", "aka": ["STFT initializer", "STFT initialization"] },
    { "a": "DeepNorm", "t": "longtail", "aka": ["DeepNet initialization", "DeepNorm initialization"] },
    { "a": "Wang init", "t": "longtail", "aka": ["Wang initialization"] },
    { "a": "u-μP", "t": "longtail", "aka": ["unit-scaled maximal update parametrization", "unit scaling", "u-muP", "umup"] },
    { "a": "LoRA initialization", "t": "outlier", "aka": ["LoRA init", "LoRA B zero init"] },
    { "a": "PiSSA", "t": "longtail", "aka": ["principal singular values and singular vectors adaptation"] },
    { "a": "MiLoRA", "t": "longtail" },
    { "a": "LoRA-GA", "t": "longtail" },
    { "a": "OLoRA", "t": "longtail" },
    { "a": "CorDA", "t": "longtail" },
    { "a": "EVA initialization", "t": "longtail", "aka": ["EVA", "explained variance adaptation"] },
    { "a": "Weight selection", "t": "longtail" },
    { "a": "Learngene", "t": "longtail" },
    { "a": "LiGO", "t": "longtail", "aka": ["linear growth operator"] },
    { "a": "bert2BERT", "t": "longtail" },
    { "a": "Depth up-scaling", "t": "longtail", "aka": ["depth upscaling", "DUS", "SOLAR depth up-scaling"] },
    { "a": "Progressive stacking", "t": "longtail", "aka": ["stacking initialization", "StackBERT"] },
    { "a": "Lottery ticket initialization", "t": "outlier", "aka": ["lottery ticket hypothesis", "winning ticket", "lottery ticket rewinding", "late rewinding", "rewinding"] },
    { "a": "Prior-probability bias initialization", "t": "longtail", "aka": ["focal loss bias init", "prior probability bias", "RetinaNet bias init", "prior bias"] },
    { "a": "Zero convolution", "t": "longtail", "aka": ["ControlNet zero convolution", "zero conv"] },
    { "a": "adaLN-Zero", "t": "longtail", "aka": ["adaLN zero", "zero init modulation"] },
    { "a": "LayerScale", "t": "longtail", "aka": ["LayerScale init", "layer scale", "CaiT LayerScale"] },
    { "a": "BERT initialization", "t": "longtail", "aka": ["normal 0.02", "initializer_range 0.02", "truncated normal 0.02"] },
    { "a": "Positive unit ball", "t": "longtail", "aka": ["PositiveUnitballFiller", "Caffe positive unitball filler"] },
    { "a": "Nguyen-Widrow initialization", "t": "longtail", "aka": ["Nguyen Widrow", "initnw", "Widrow-Nguyen"] },
    { "a": "HiPPO initialization", "t": "longtail", "aka": ["HiPPO", "HiPPO-LegS", "S4D-Lin", "S4D-Real", "S4 initialization"] },
    { "a": "Linear probing then fine-tuning", "t": "longtail", "aka": ["LP-FT", "LP then FT", "linear probe init"] },
    { "a": "Weight imprinting", "t": "longtail", "aka": ["imprinted weights", "classifier imprinting"] },
    { "a": "Inflated filters", "t": "longtail", "aka": ["I3D inflation", "filter inflation", "weight inflation", "2D to 3D inflation"] },
    { "a": "Complex weight initialization", "t": "longtail", "aka": ["complex initialization", "Rayleigh initialization", "Deep Complex Networks init"] },
    { "a": "Reservoir initialization", "t": "longtail", "aka": ["echo state initialization", "spectral radius scaling", "echo state network"] },
    { "a": "LoftQ", "t": "longtail", "aka": ["LoftQ initialization"] },
    { "a": "Patch whitening", "t": "longtail", "aka": ["Whitening", "Whitening initialization", "Patch-whitening initialization", "ZCA initialization"], "q": "Fast CIFAR-10 training's trick: the first conv layer starts as a whitening transform of image patches, not random noise." }
