{
  "id": "tokenizer",
  "pack": "llm",
  "text": "Name a tokenization algorithm or tokenizer",
  "note": "Algorithms, libraries and named vocabularies that split input into tokens; classic NLP, tokenizer-free and image/audio tokenizers count too",
  "strip": ["tokenization", "tokenisation", "tokenizer", "tokeniser", "algorithm"],
  "answers": [
    { "a": "BPE-dropout", "t": "mlion", "aka": ["BPE dropout"], "q": "Randomly skip merges during training so the model sees many segmentations of every word. Dropout for tokenizers." },

    { "a": "Morfessor", "t": "longtail", "q": "Unsupervised morphological segmentation via minimum description length, born in Helsinki for Finnish." },
    { "a": "Fast WordPiece", "t": "longtail", "aka": ["LinMaxMatch"] },
    { "a": "YouTokenToMe", "t": "longtail", "aka": ["YTTM"] },
    { "a": "fastBPE", "t": "longtail" },
    { "a": "Sudachi", "t": "longtail", "aka": ["SudachiPy"] },
    { "a": "Character n-grams", "t": "longtail", "aka": ["fastText subwords", "char n-grams"] },
    { "a": "GBST", "t": "longtail", "aka": ["Charformer", "gradient-based subword tokenization"] },
    { "a": "SuperBPE", "t": "longtail", "q": "A second BPE stage that merges across spaces, minting 'superword' tokens." },
    { "a": "H-Net", "t": "longtail", "aka": ["dynamic chunking"], "q": "Learns its own chunk boundaries end to end. Tokenization as a layer." },
    { "a": "TokenMonster", "t": "longtail" },
    { "a": "FSQ", "t": "longtail", "aka": ["finite scalar quantization"], "q": "Round each latent dimension to a few levels. VQ without the codebook collapse." },
    { "a": "LFQ", "t": "longtail", "aka": ["lookup-free quantization", "MAGVIT-v2"] },
    { "a": "TiTok", "t": "longtail" },
    { "a": "Cosmos Tokenizer", "t": "longtail" },
    { "a": "Mimi", "t": "longtail" },
    { "a": "SpeechTokenizer", "t": "longtail" },
    { "a": "o200k_harmony", "t": "longtail" },
    { "a": "Pre-tokenization", "t": "longtail", "aka": ["pretokenization", "regex pre-tokenizer", "GPT-2 regex"] },
    { "a": "KyTea", "t": "longtail", "aka": ["Kyoto Text Analysis Toolkit"] },
    { "a": "Juman++", "t": "longtail", "aka": ["JUMAN"] },
    { "a": "ICU word segmentation", "t": "longtail", "aka": ["UAX 29", "Unicode word boundaries", "ICU tokenizer"] },
    { "a": "DAC", "t": "longtail", "aka": ["Descript Audio Codec"] },

    { "a": "o200k_base", "t": "outlier", "aka": ["o200k", "GPT-4o tokenizer"], "q": "The ~200k-token vocabulary introduced with GPT-4o. Kinder to non-English text." },
    { "a": "r50k_base", "t": "outlier", "aka": ["r50k", "gpt2 encoding"], "q": "GPT-2 and GPT-3's 50,257 tokens, the last being <|endoftext|>." },
    { "a": "p50k_base", "t": "longtail", "aka": ["p50k", "p50k_edit"] },
    { "a": "Subword regularization", "t": "outlier" },
    { "a": "Penn Treebank tokenizer", "t": "outlier", "aka": ["PTB tokenizer", "Treebank tokenizer", "NLTK word_tokenize", "NLTK", "word_tokenize", "TreebankWordTokenizer"] },
    { "a": "Moses tokenizer", "t": "outlier", "aka": ["Moses", "tokenizer.perl", "Sacremoses"], "q": "tokenizer.perl from the Moses MT toolkit. A Perl script that outlived its decade." },
    { "a": "spaCy tokenizer", "t": "indist", "aka": ["spaCy"], "q": "Rule-based: split on whitespace, then peel off prefixes, suffixes and infixes, with per-language exceptions." },
    { "a": "subword-nmt", "t": "longtail" },
    { "a": "Punkt", "t": "outlier", "aka": ["sentence tokenization", "Punkt sentence tokenizer", "sent_tokenize", "sentence splitting", "sentence segmentation"], "q": "NLTK's unsupervised sentence splitter. It learns abbreviations so 'Dr.' doesn't end a sentence." },
    { "a": "MaxMatch", "t": "outlier", "aka": ["maximum matching", "greedy longest-match", "longest-match-first", "forward maximum matching", "reverse maximum matching", "bidirectional maximum matching"], "q": "Greedy longest-match-first: WordPiece's inference and an old trick for Chinese segmentation." },
    { "a": "Byte fallback", "t": "longtail", "q": "Unknown characters break into UTF-8 byte tokens instead of <unk>. Llama's SentencePiece does it." },
    { "a": "Jieba", "t": "outlier", "q": "Chinese for 'stutter': the go-to Python library for Chinese word segmentation." },
    { "a": "MeCab", "t": "longtail", "q": "The classic Japanese morphological analyzer, named after its author's favorite food, mekabu." },
    { "a": "Patchification", "t": "outlier", "aka": ["patch embedding", "image patches", "ViT patches", "patchify", "tubelet embedding"], "q": "'An Image is Worth 16x16 Words': ViT's tokenizer is a strided linear projection." },
    { "a": "VQ-VAE", "t": "outlier" },
    { "a": "VQGAN", "t": "outlier" },
    { "a": "EnCodec", "t": "outlier" },
    { "a": "SoundStream", "t": "longtail" },
    { "a": "Byte Latent Transformer", "t": "outlier", "aka": ["BLT", "entropy patching"], "q": "Meta's tokenizer-free model: start a new byte patch wherever next-byte entropy spikes." },
    { "a": "MEGABYTE", "t": "longtail", "q": "Fixed-size byte patches, a global transformer over patches and a local one within them." },
    { "a": "CANINE", "t": "longtail" },
    { "a": "Tekken", "t": "longtail", "q": "Mistral's tiktoken-based tokenizer since NeMo, ~30% more efficient on code and many languages." },

    { "a": "tiktoken", "t": "indist", "aka": ["OpenAI tokenizer"], "q": "OpenAI's fast BPE library: cl100k_base, o200k_base and friends." },
    { "a": "cl100k_base", "t": "indist", "aka": ["cl100k", "GPT-4 tokenizer", "GPT-3.5 tokenizer"], "q": "The ~100k-token vocabulary behind GPT-3.5-turbo and GPT-4." },
    { "a": "Character-level", "t": "indist", "aka": ["character tokenization", "char-level", "characters", "char CNN", "character CNN"], "q": "One token per character: a tiny vocabulary and very long sequences." },
    { "a": "Word-level", "t": "indist", "aka": ["word tokenization", "words", "WordLevel"], "q": "One token per word: a huge vocabulary, and any unseen word becomes [UNK]." },
    { "a": "Whitespace", "t": "indist", "aka": ["whitespace tokenization", "split on spaces", "WhitespaceSplit", "str.split", "split on whitespace", "space-separated"], "q": "Split on spaces. Useless for Chinese or Japanese, which don't use them." },
    { "a": "Subword tokenization", "t": "indist", "aka": ["subword", "subword units"], "q": "Common words stay whole, rare ones split into pieces: BPE, WordPiece, Unigram." },
    { "a": "Byte-level", "t": "indist", "aka": ["bytes", "byte tokenization", "UTF-8 bytes", "ByT5", "tokenizer-free", "token-free"], "q": "Works on raw UTF-8 bytes, so nothing is ever out of vocabulary. GPT-2's BPE starts from bytes." },
    { "a": "Hugging Face Tokenizers", "t": "indist", "aka": ["HF tokenizers", "tokenizers library", "AutoTokenizer", "fast tokenizers", "Rust tokenizers", "transformers tokenizer"], "q": "Hugging Face's Rust tokenizer library with Python bindings: the 'fast' tokenizers in transformers." },

    { "a": "Unigram", "t": "overfit", "aka": ["unigram language model", "Unigram LM", "SentencePiece unigram"], "q": "Start huge and prune: keep the vocab that maximizes a unigram LM's likelihood. Kudo, 2018." },
    { "a": "Byte-level BPE", "t": "overfit", "aka": ["BBPE", "byte-level byte-pair encoding", "GPT-2 BPE", "GPT-2 tokenizer", "GPT2Tokenizer", "ByteLevelBPETokenizer", "RoBERTa tokenizer"], "q": "GPT-2's trick: run BPE over raw bytes, so no input is ever <unk>." },

    { "a": "BPE", "t": "baseline", "aka": ["byte-pair encoding", "byte-pair", "CharBPETokenizer"], "q": "Philip Gage's 1994 compression algorithm, repurposed for NMT by Sennrich et al. in 2016." },
    { "a": "WordPiece", "t": "baseline", "aka": ["BertTokenizer", "BertWordPieceTokenizer"], "q": "Schuster & Nakajima 2012, for Japanese and Korean voice search. Later BERT's ##pieces." },
    { "a": "SentencePiece", "t": "baseline", "aka": ["spm", "Google SentencePiece", "SentencePiece BPE", "T5Tokenizer", "ALBERT tokenizer", "XLNet tokenizer"], "q": "Treats text as a raw stream, spaces included (▁). No pre-tokenization, any language." },
    { "a": "Llama tokenizer", "t": "outlier", "aka": ["LlamaTokenizer", "LLaMA tokenizer", "Llama 2 tokenizer"] },
    { "a": "Llama 3 tokenizer", "t": "outlier", "aka": ["Llama 3.1 tokenizer"] },
    { "a": "CLIP tokenizer", "t": "longtail" },
    { "a": "Whisper tokenizer", "t": "longtail" },
    { "a": "Gemma tokenizer", "t": "longtail" },
    { "a": "Qwen tokenizer", "t": "longtail" },
    { "a": "GPT-NeoX tokenizer", "t": "longtail" },
    { "a": "TweetTokenizer", "t": "longtail", "aka": ["NLTK TweetTokenizer", "Tweet tokenizer", "Twokenize"] },
    { "a": "Regex tokenizer", "t": "outlier", "aka": ["RegexpTokenizer", "regexp tokenizer", "regular expression tokenizer", "regex tokenization"] },
    { "a": "Stanford CoreNLP", "t": "longtail", "aka": ["CoreNLP", "Stanford tokenizer"] },
    { "a": "Stanza", "t": "longtail" },
    { "a": "13a", "t": "longtail", "aka": ["mteval-v13a", "sacreBLEU 13a", "sacreBLEU tokenizer"] },
    { "a": "pkuseg", "t": "longtail" },
    { "a": "THULAC", "t": "longtail" },
    { "a": "HanLP", "t": "longtail" },
    { "a": "PyThaiNLP", "t": "longtail" },
    { "a": "VnCoreNLP", "t": "longtail" },
    { "a": "Farasa", "t": "longtail" },
    { "a": "Kuromoji", "t": "longtail" },
    { "a": "Janome", "t": "longtail" },
    { "a": "KoNLPy", "t": "longtail", "aka": ["Komoran", "Kkma", "Hannanum"] },
    { "a": "MambaByte", "t": "longtail" },
