    { "a": "SNAC", "t": "longtail" },
    { "a": "WavTokenizer", "t": "longtail" },
    { "a": "Discrete speech units", "t": "longtail", "aka": ["HuBERT units", "k-means units", "discrete units", "semantic tokens"] },
    { "a": "PIXEL", "t": "longtail", "aka": ["language modelling with pixels", "pixel-based language modelling", "text rendering"] },
    { "a": "k-mer tokenization", "t": "longtail", "aka": ["k-mers", "kmer tokenization", "overlapping k-mers"] },
    { "a": "Digit splitting", "t": "longtail", "aka": ["digit-level", "split digits", "single-digit tokenization", "number tokenization"] },
    { "a": "xVal", "t": "longtail" },
