    { "a": "Morphological tokenization", "t": "outlier", "aka": ["morphological segmentation", "morpheme-based tokenization", "morphological analyzer", "morphemes", "linguistically motivated tokenization"] },
    { "a": "FLOTA", "t": "longtail", "aka": ["few longest token approximation"] },
    { "a": "MorphPiece", "t": "longtail" },
    { "a": "BPE-knockout", "t": "longtail" },
