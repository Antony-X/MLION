    { "a": "Gemini", "t": "indist", "aka": ["Gemini Pro Vision", "Gemini 1.5", "Gemini 2.0", "Gemini 2.5", "Gemini Ultra", "Gemini Flash"] },

    { "a": "SigLIP", "t": "overfit", "aka": ["sigmoid clip", "sigmoid loss for language image pre-training"], "q": "CLIP with a sigmoid in place of the softmax, so no batch-wide normalization. Now the default vision tower." },
    { "a": "ALIGN", "t": "overfit", "q": "Google's 2021 CLIP rival: 1.8 billion noisy alt-text pairs, barely filtered." },

    { "a": "CLIP", "t": "baseline", "aka": ["contrastive language-image pre-training", "openai clip"], "q": "400M image–text pairs and a contrastive loss. Zero-shot ImageNet from captions alone." },
    { "a": "LLaVA", "t": "baseline", "aka": ["large language and vision assistant", "visual instruction tuning"], "q": "GPT-4-written instruction data, a CLIP encoder and one projection into Vicuna." },
    { "a": "Flamingo", "t": "baseline", "aka": ["deepmind flamingo"], "q": "Perceiver resampler plus gated cross-attention into a frozen Chinchilla. Few-shot VQA, 2022." },
    { "a": "BLIP", "t": "baseline", "aka": ["bootstrapping language-image pre-training"], "q": "Bootstraps its own captions: a captioner writes them, a filter throws out the bad ones." },
