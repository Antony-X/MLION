    { "a": "Hoeffding tree", "t": "mlion", "aka": ["VFDT", "very fast decision tree", "VFDTc", "streaming decision tree"], "q": "Splits once the Hoeffding bound says it's sure. Learns from an endless stream, keeps none of it. Domingos & Hulten, 2000." },

    { "a": "AID", "t": "longtail", "aka": ["automatic interaction detection", "automatic interaction detector"], "q": "Morgan & Sonquist, 1963: the first regression tree, grown on survey data." },
