{
  "id": "regularization",
  "pack": "blocks",
  "text": "Name a regularization technique",
  "note": "Anything added to training to fight overfitting: penalties, noise, dropout variants, augmentation, early stopping, ensembling, weight averaging…",
  "strip": ["regularization", "regularisation", "regularizer", "regulariser", "technique", "method", "penalty", "constraint"],
  "answers": [
    { "a": "Flooding", "t": "mlion", "aka": ["flood level"], "q": "Ishida et al. 2020: once training loss sinks below a flood level b, do gradient ascent. Keeps the loss afloat." },

    { "a": "Alpha dropout", "t": "longtail", "aka": ["FeatureAlphaDropout"] },
    { "a": "Weight noise", "t": "longtail", "aka": ["weight noise injection"] },
    { "a": "Gradient noise", "t": "longtail", "aka": ["annealed gradient noise"] },
    { "a": "AugMix", "t": "longtail" },
    { "a": "TrivialAugment", "t": "longtail", "aka": ["TrivialAugmentWide"] },
    { "a": "Mosaic", "t": "longtail", "aka": ["mosaic augmentation"] },
    { "a": "Copy-Paste", "t": "longtail", "aka": ["copy-paste augmentation", "simple copy-paste"] },
    { "a": "GridMask", "t": "longtail" },
    { "a": "Hide-and-Seek", "t": "longtail" },
    { "a": "Back-translation", "t": "longtail" },
    { "a": "L0 regularization", "t": "longtail", "aka": ["hard concrete"], "q": "Louizos et al. 2018: hard-concrete gates make counting nonzero weights differentiable." },
    { "a": "Nuclear norm regularization", "t": "longtail", "aka": ["trace norm"] },
    { "a": "Activity regularization", "t": "longtail", "aka": ["activation regularization", "AR", "TAR", "temporal activation regularization"] },
    { "a": "Embedding dropout", "t": "longtail", "aka": ["word dropout"] },
    { "a": "DisturbLabel", "t": "longtail", "q": "Swap some training labels for wrong ones on purpose. Xie et al. 2016: it regularizes." },
    { "a": "LayerDrop", "t": "longtail", "aka": ["structured dropout"] },
    { "a": "Attention dropout", "t": "longtail" },
    { "a": "R-Drop", "t": "longtail", "q": "Run two dropout passes and penalize the KL between their outputs." },
    { "a": "Mixout", "t": "longtail", "q": "Randomly swap fine-tuned weights back to their pretrained values: dropout toward a target." },
    { "a": "L2-SP", "t": "longtail" },
    { "a": "Concrete dropout", "t": "longtail" },
    { "a": "Standout", "t": "longtail", "aka": ["adaptive dropout"] },
    { "a": "Swapout", "t": "longtail" },
    { "a": "ShakeDrop", "t": "longtail" },
    { "a": "Fraternal dropout", "t": "longtail" },
    { "a": "Targeted dropout", "t": "longtail" },
    { "a": "Stochastic pooling", "t": "longtail" },
    { "a": "Double backpropagation", "t": "longtail", "aka": ["input gradient regularization", "gradient norm penalty"], "q": "Drucker & LeCun 1992: penalize the input gradient's norm. Gradient penalties long before GANs." },
    { "a": "Tangent prop", "t": "longtail", "aka": ["tangent propagation"], "q": "Simard et al. 1992: penalize sensitivity along known invariances such as small rotations." },
    { "a": "Soft weight sharing", "t": "longtail" },
    { "a": "Weight elimination", "t": "longtail" },
    { "a": "Information bottleneck", "t": "longtail", "aka": ["variational information bottleneck", "VIB"] },
    { "a": "SCAD", "t": "longtail", "aka": ["smoothly clipped absolute deviation"] },
    { "a": "Minimax concave penalty", "t": "longtail", "aka": ["MCP"] },
    { "a": "Fused lasso", "t": "longtail" },
    { "a": "Jacobian regularization", "t": "longtail" },
    { "a": "Orthogonal regularization", "t": "longtail", "aka": ["orthogonality regularization"] },
    { "a": "Parseval networks", "t": "longtail", "aka": ["Parseval regularization"] },
    { "a": "Confidence penalty", "t": "longtail" },
    { "a": "Manifold regularization", "t": "longtail", "aka": ["Laplacian regularization", "graph Laplacian regularization", "graph regularization"] },
    { "a": "Subsampling", "t": "longtail", "aka": ["row subsampling", "column subsampling", "stochastic gradient boosting"] },

    { "a": "Random erasing", "t": "outlier" },
    { "a": "Gaussian dropout", "t": "outlier", "aka": ["multiplicative Gaussian noise"] },
    { "a": "Variational dropout", "t": "outlier", "aka": ["MC dropout", "Monte Carlo dropout", "Bayesian dropout"] },
    { "a": "DropBlock", "t": "outlier" },
    { "a": "Shake-Shake", "t": "outlier", "q": "Blend two residual branches with one random weight going forward and a different one coming back." },
    { "a": "Zoneout", "t": "outlier", "q": "Dropout for RNNs: randomly keep hidden units at their previous values instead of zeroing them." },
    { "a": "Manifold mixup", "t": "outlier", "q": "Mixup, but on hidden representations." },
    { "a": "AutoAugment", "t": "outlier" },
    { "a": "RandAugment", "t": "outlier" },
    { "a": "SpecAugment", "t": "outlier", "aka": ["time masking", "frequency masking", "time warping"], "q": "Mask frequency bands and time steps on spectrograms. Google's 2019 speech staple." },
    { "a": "Sharpness-aware minimization", "t": "outlier", "aka": ["SAM", "sharpness-aware minimisation"] },
    { "a": "Stochastic weight averaging", "t": "outlier", "aka": ["SWA", "weight averaging"] },
    { "a": "Exponential moving average", "t": "outlier", "aka": ["EMA", "EMA of weights", "model EMA", "Polyak averaging"] },
    { "a": "Gradient penalty", "t": "outlier", "aka": ["R1 regularization", "WGAN-GP"] },
    { "a": "Entropy regularization", "t": "outlier", "aka": ["entropy bonus", "entropy minimization"] },
    { "a": "Total variation regularization", "t": "outlier", "aka": ["TV regularization"] },
    { "a": "Group lasso", "t": "outlier", "aka": ["sparse group lasso"] },
    { "a": "Shrinkage", "t": "outlier", "aka": ["boosting shrinkage"], "q": "Boosting's regularizer: scale each new tree down and take many small steps." },
    { "a": "Virtual adversarial training", "t": "outlier", "aka": ["VAT"] },
    { "a": "Contractive regularization", "t": "outlier", "aka": ["contractive autoencoder", "CAE"] },
    { "a": "Sparsity penalty", "t": "outlier", "aka": ["KL sparsity", "sparse autoencoder penalty"] },
    { "a": "Consistency regularization", "t": "outlier", "aka": ["mean teacher", "pi model", "temporal ensembling", "UDA", "unsupervised data augmentation"] },
    { "a": "Spectral normalization", "t": "outlier", "aka": ["spectral norm", "spectral normalisation", "spectral norm regularization", "Lipschitz regularization"] },
    { "a": "Recurrent dropout", "t": "outlier", "aka": ["RNN dropout"] },
    { "a": "Elastic weight consolidation", "t": "outlier", "aka": ["EWC"], "q": "Penalize moving the weights the Fisher says mattered for old tasks. Regularization against forgetting." },

    { "a": "Elastic net", "t": "indist", "aka": ["L1+L2", "L1 and L2", "L1/L2 regularization"], "q": "L1 + L2 in one penalty: Zou & Hastie's fix for lasso dropping correlated features." },
    { "a": "Batch normalization", "t": "indist", "aka": ["BatchNorm", "BN", "batch normalisation"], "q": "Noisy batch statistics regularize as a side effect, which is why ResNets got away with no dropout." },
    { "a": "Noise injection", "t": "indist", "aka": ["Gaussian noise injection", "input noise", "Gaussian noise", "jitter", "training with noise"], "q": "Add noise to inputs, weights or activations in training. Bishop, 1995: small input noise acts like Tikhonov regularization." },
    { "a": "Max-norm constraint", "t": "indist", "aka": ["max norm regularization"], "q": "Cap each unit's incoming weight vector at norm c, projecting back when it grows. Paired with dropout by Srivastava et al., 2014." },
    { "a": "DropConnect", "t": "indist", "q": "Drop weights, not activations (Wan et al. 2013). AWD-LSTM's weight-dropped secret." },
    { "a": "Cutout", "t": "indist", "q": "Black out a random square of every training image. Simple, effective, 2017." },
    { "a": "CutMix", "t": "indist", "q": "Paste a patch from one image onto another and mix the labels by area." },
    { "a": "Stochastic depth", "t": "indist", "aka": ["DropPath"], "q": "Randomly skip entire residual blocks in training (Huang et al. 2016). ViT codebases call it DropPath." },
    { "a": "Spatial dropout", "t": "indist", "aka": ["Dropout2d", "SpatialDropout2D", "channel dropout", "Dropout1d", "Dropout3d", "SpatialDropout1D", "SpatialDropout3D"], "q": "Drops whole feature maps rather than pixels, since neighbouring pixels are too correlated. Tompson et al., 2015." },
    { "a": "Pruning", "t": "indist", "aka": ["tree pruning", "cost-complexity pruning", "weight pruning", "magnitude pruning", "structured pruning", "reduced error pruning", "minimal cost-complexity pruning", "ccp_alpha", "pre-pruning", "post-pruning"], "q": "Decision trees' original regularizer: grow it big, then cut it back." },
    { "a": "Bagging", "t": "indist", "aka": ["bootstrap aggregating"], "q": "Breiman 1996: bootstrap, train, average. Variance falls; random forests follow." },
    { "a": "Ensembling", "t": "indist", "aka": ["ensemble", "ensembles", "ensemble methods", "model averaging", "deep ensembles", "deep ensemble"], "q": "Average several models so their errors partly cancel. Costs one forward pass per member." },
    { "a": "Adversarial training", "t": "indist", "aka": ["FGSM training", "PGD training"], "q": "Train on inputs perturbed to fool the model: FGSM (Goodfellow et al., 2014), then PGD (Madry et al., 2017)." },

    { "a": "Label smoothing", "t": "overfit", "q": "Never let the model be 100% sure. Inception v3's trick, now in every training recipe." },
    { "a": "Mixup", "t": "overfit", "aka": ["input mixup"], "q": "Train on convex blends of image pairs and their labels. Zhang et al. 2018: cheap and weirdly effective." },

    { "a": "Dropout", "t": "baseline", "aka": ["inverted dropout", "standard dropout", "dropout layer", "input dropout", "visible dropout"], "q": "Randomly silence units during training so none can count on another. Switched off at test time." },
    { "a": "L2 regularization", "t": "baseline", "aka": ["ridge", "ridge regression", "Tikhonov regularization", "Frobenius norm regularization"], "q": "Penalize the sum of w². Shrinks weights smoothly: ridge regression, or weight decay under plain SGD (not under Adam)." },
    { "a": "L1 regularization", "t": "baseline", "aka": ["lasso", "lasso regression"], "q": "Penalize the sum of |w|. Drives many weights to exactly zero: the lasso (Tibshirani, 1996)." },
    { "a": "Weight decay", "t": "baseline", "aka": ["decoupled weight decay", "L2 weight decay"], "q": "Equals L2 for plain SGD but not for Adam, which is the whole point of AdamW." },
    { "a": "Early stopping", "t": "baseline", "q": "The free regularizer: quit when validation loss turns around." },
    { "a": "Data augmentation", "t": "baseline", "aka": ["augmentation", "data aug", "image augmentation", "random crop", "random cropping", "random flip", "horizontal flip", "random rotation", "color jitter", "colour jitter", "geometric augmentation", "image flipping"], "q": "More training data for free: transformed copies whose label stays the same." },
    { "a": "Model soups", "t": "longtail", "aka": ["model soup", "greedy soup", "checkpoint averaging"], "q": "Wortsman et al. 2022: average the weights of several fine-tuned models and beat the best single one." },
    { "a": "Snapshot ensembles", "t": "longtail", "aka": ["snapshot ensemble", "snapshot ensembling"], "q": "Huang et al. 2017: one training run, cyclic learning rate, an ensemble of the checkpoints at each minimum." },
    { "a": "Limiting tree depth", "t": "outlier", "aka": ["max depth", "max_depth", "tree depth", "min samples leaf", "min_samples_leaf", "min child weight", "minimum leaf size"] },
    { "a": "Weight tying", "t": "longtail", "aka": ["tied embeddings", "tied weights", "tying input and output embeddings", "embedding tying"] },
    { "a": "Self-distillation", "t": "longtail", "aka": ["born-again networks", "born again neural networks", "knowledge distillation", "distillation"] },
    { "a": "DART", "t": "longtail", "aka": ["dropouts meet multiple additive regression trees", "DART boosting"], "q": "Dropout for boosted trees: mute some earlier trees before fitting the next." },
    { "a": "Random subspace method", "t": "longtail", "aka": ["random subspaces", "feature bagging", "attribute bagging", "attribute subsampling"] },
    { "a": "Soft margin", "t": "longtail", "aka": ["soft-margin SVM", "SVM C parameter", "C parameter", "slack variables"] },
    { "a": "Spectral decoupling", "t": "longtail" },
    { "a": "Scheduled dropout", "t": "longtail", "aka": ["curriculum dropout", "dropout schedule", "dropout annealing", "ScheduledDropPath"] },
    { "a": "PatchDropout", "t": "longtail", "aka": ["patch dropout"] },
    { "a": "Easy Data Augmentation", "t": "longtail", "aka": ["EDA", "synonym replacement", "random swap", "random deletion", "random insertion"] },
    { "a": "PuzzleMix", "t": "longtail" },
    { "a": "SaliencyMix", "t": "longtail" },
    { "a": "FMix", "t": "longtail" },
    { "a": "RICAP", "t": "longtail", "aka": ["random image cropping and patching"] },
    { "a": "PixMix", "t": "longtail" },
    { "a": "Fast AutoAugment", "t": "longtail" },
    { "a": "DeepAugment", "t": "longtail" }
  ]
