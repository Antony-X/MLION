    { "a": "Early exaggeration", "t": "mlion", "aka": ["early_exaggeration", "t-SNE early exaggeration", "exaggeration"], "q": "t-SNE's hype phase: inflate attractions for the first iterations so clusters form, then calm down. Default 12." },

