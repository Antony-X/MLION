{
  "id": "decoding",
  "pack": "llm",
  "text": "Name a decoding or sampling strategy for language models",
  "note": "How the next token gets picked: search, truncation samplers, penalties, guided/constrained decoding and draft-and-verify speedups",
  "strip": ["sampling", "strategy", "method"],
  "answers": [
    { "a": "Mirostat", "t": "mlion", "aka": ["Mirostat v2", "mirostat 2.0"], "q": "A feedback loop that retunes truncation on the fly to hold perplexity at a target. A thermostat for surprise." },

    { "a": "Top-a sampling", "t": "longtail" },
    { "a": "Top-nσ sampling", "t": "longtail" },
    { "a": "Quadratic sampling", "t": "longtail", "aka": ["smoothing factor", "smooth sampling"] },
    { "a": "Dynamic temperature", "t": "longtail", "aka": ["DynaTemp", "entropy-based temperature"] },
    { "a": "DRY", "t": "longtail", "aka": ["DRY sampler", "don't repeat yourself"], "q": "Don't Repeat Yourself: penalizes tokens that would extend a sequence already in the context." },
    { "a": "XTC", "t": "longtail", "aka": ["XTC sampler", "exclude top choices"], "q": "Exclude Top Choices: sometimes deletes the most likely tokens on purpose. For creative writing." },
    { "a": "NeuroLogic decoding", "t": "longtail", "aka": ["NeuroLogic A*esque"] },
    { "a": "Noisy channel decoding", "t": "longtail", "aka": ["noisy channel reranking"] },
    { "a": "MCTS decoding", "t": "longtail", "aka": ["Monte Carlo tree search decoding", "PPL-MCTS", "MCTS", "tree search decoding"] },
    { "a": "GeDi", "t": "longtail", "aka": ["generative discriminator guided"] },
    { "a": "FUDGE", "t": "longtail", "aka": ["future discriminators"] },
    { "a": "DExperts", "t": "longtail" },
    { "a": "Context-aware decoding", "t": "longtail", "aka": ["CAD"] },
    { "a": "Arithmetic sampling", "t": "longtail" },
    { "a": "Entropix", "t": "longtail", "q": "Entropy and varentropy of the logits decide whether to sample, branch or stop and think." },
    { "a": "ReDrafter", "t": "longtail", "aka": ["recurrent drafter"] },
    { "a": "REST", "t": "longtail", "aka": ["retrieval-based speculative decoding"] },
    { "a": "Non-autoregressive decoding", "t": "longtail", "aka": ["NAT", "non-autoregressive generation"] },
    { "a": "Mask-Predict", "t": "longtail", "aka": ["CMLM", "conditional masked language model"] },
    { "a": "SMC steering", "t": "longtail", "aka": ["sequential Monte Carlo steering", "LLaMPPL"] },
    { "a": "CoT decoding", "t": "longtail", "aka": ["chain-of-thought decoding"], "q": "Branch on the first token and keep paths that answer confidently. Chain-of-thought without the prompt." },
    { "a": "Blockwise parallel decoding", "t": "longtail", "aka": ["blockwise parallel", "parallel decoding"] },
    { "a": "SpecInfer", "t": "longtail", "aka": ["token tree verification"] },
    { "a": "Staged speculative decoding", "t": "longtail", "aka": ["staged speculative"] },
    { "a": "Hydra", "t": "longtail", "aka": ["Hydra heads"] },
    { "a": "Multi-token prediction", "t": "longtail", "aka": ["MTP"] },
    { "a": "Coverage penalty", "t": "longtail" },

    { "a": "Contrastive decoding", "t": "outlier", "q": "Score tokens by big-model logprob minus small-model logprob. Subtract the amateur." },
    { "a": "DoLa", "t": "outlier", "aka": ["decoding by contrasting layers"], "q": "Contrast late-layer and early-layer logits to bring factual knowledge to the surface." },
    { "a": "Tail-free sampling", "t": "outlier", "aka": ["TFS"] },
    { "a": "Eta sampling", "t": "outlier", "aka": ["η-sampling"] },
    { "a": "Epsilon sampling", "t": "outlier", "aka": ["ε-sampling"] },
    { "a": "Constrained beam search", "t": "outlier", "aka": ["lexically constrained decoding", "grid beam search"] },
    { "a": "Stochastic beam search", "t": "outlier", "aka": ["Gumbel-top-k"] },
    { "a": "MBR decoding", "t": "outlier", "aka": ["minimum Bayes risk decoding", "MBR", "minimum Bayes risk"], "q": "Pick the sample that agrees most with all the others under a utility like BLEU." },
    { "a": "Self-consistency", "t": "outlier", "aka": ["majority voting", "self-consistency decoding"] },
    { "a": "Medusa", "t": "outlier", "q": "Extra decoding heads guess several future tokens; tree attention verifies them at once." },
    { "a": "EAGLE", "t": "outlier", "aka": ["EAGLE-2", "EAGLE-3"] },
    { "a": "Lookahead decoding", "t": "outlier", "aka": ["lookahead"], "q": "Jacobi iterations produce n-grams in parallel and verified ones get accepted. No draft model." },
    { "a": "Jacobi decoding", "t": "outlier" },
    { "a": "Prompt lookup decoding", "t": "outlier", "aka": ["prompt lookup"], "q": "Speculative decoding where the draft is copied from n-grams in the prompt. Great for edits and RAG." },
    { "a": "Self-speculative decoding", "t": "outlier", "aka": ["LayerSkip", "draft & verify", "self-speculative"] },
    { "a": "PPLM", "t": "outlier", "aka": ["plug and play language models", "plug and play"], "q": "Steer a frozen LM with gradients from a small attribute classifier." },
    { "a": "Logit bias", "t": "outlier", "aka": ["bad words", "bad_words_ids", "banned tokens", "token banning", "token masking", "logit masking"] },
    { "a": "Classifier-free guidance", "t": "outlier", "aka": ["CFG"], "q": "Borrowed from diffusion: push logits away from the unconditioned prompt." },

    { "a": "Ancestral sampling", "t": "indist", "aka": ["random sampling", "pure sampling", "multinomial sampling", "vanilla sampling", "unbiased sampling", "forward sampling", "stochastic sampling"], "q": "Sample each token from the model's full distribution, in order. Faithful to the model, but the long tail lets nonsense in." },
    { "a": "Min-p sampling", "t": "indist", "q": "Keep tokens with at least p times the top token's probability. The cutoff scales with confidence." },
    { "a": "Typical sampling", "t": "indist", "aka": ["locally typical sampling", "typical-p", "typical decoding"], "q": "Keep tokens whose surprisal sits near the expected entropy. Information theory picks your words." },
    { "a": "Contrastive search", "t": "indist", "aka": ["SimCTG"], "q": "Pick likely tokens that are also unlike the context so far. A built-in degeneration penalty." },
    { "a": "Repetition penalty", "t": "indist", "aka": ["repeat penalty", "penalized sampling"], "q": "From CTRL (2019): scale down the logits of tokens already generated." },
    { "a": "Frequency penalty", "t": "indist", "q": "Lowers a token's logit in proportion to how often it has already appeared." },
    { "a": "Presence penalty", "t": "indist", "q": "A flat logit penalty for any token that has already appeared, however often." },
    { "a": "Length penalty", "t": "indist", "aka": ["length normalization"], "q": "Normalizes beam scores by length so the search stops favouring short outputs. Google's 2016 translation system used one." },
    { "a": "No-repeat n-gram blocking", "t": "indist", "aka": ["n-gram blocking", "no_repeat_ngram_size", "no repeat ngram"], "q": "Forbid any n-gram from appearing twice. Stops loops, and also legitimate repeats like a name." },
    { "a": "Diverse beam search", "t": "indist", "aka": ["DBS", "group beam search", "beam search with diversity", "num_beam_groups"], "q": "Splits the beam into groups and penalizes groups for repeating each other. Vijayakumar et al., 2016." },
    { "a": "Grammar-constrained decoding", "t": "indist", "aka": ["constrained decoding", "structured generation", "structured outputs", "JSON mode", "guided decoding", "GBNF", "grammar sampling", "Outlines", "LMQL", "Jsonformer", "XGrammar", "guided generation", "regex-guided generation", "llama.cpp grammars", "finite state machine decoding"], "q": "Mask every token that would break a grammar, so the output always parses: valid JSON, SQL, or whatever you specify." },
    { "a": "Best-of-N sampling", "t": "indist", "aka": ["BoN", "rejection sampling", "best of n", "sample and rank", "reranking with reward model", "reward model reranking"], "q": "Generate N candidates and keep the one a reward model or verifier scores highest." },

    { "a": "Speculative decoding", "t": "overfit", "aka": ["speculative sampling", "assisted generation", "draft model decoding", "SpecDec", "draft model"], "q": "A small model drafts, the big one verifies in a single pass. Faster, and provably the same distribution." },

    { "a": "Greedy decoding", "t": "baseline", "aka": ["greedy", "greedy search", "argmax decoding", "argmax", "temperature 0"], "q": "Always the argmax. Deterministic, cheap, and prone to repeating itself forever." },
    { "a": "Beam search", "t": "baseline", "aka": ["beam decoding", "beam", "num_beams"], "q": "Keep the k best partial sequences at each step. Beats greedy for translation; in open-ended text it turns bland and repetitive." },
    { "a": "Top-k sampling", "t": "baseline", "q": "Sample only from the k most likely tokens. Fan et al., 2018, for story generation." },
    { "a": "Top-p sampling", "t": "baseline", "aka": ["nucleus sampling", "nucleus"], "q": "From 'The Curious Case of Neural Text Degeneration': keep the smallest set covering mass p." },
    { "a": "Temperature sampling", "t": "baseline", "aka": ["temperature", "temperature scaling", "softmax temperature", "sampling with temperature"], "q": "Divide the logits by T before the softmax: T < 1 sharpens toward greedy, T > 1 flattens toward random." },
    { "a": "Gumbel-max sampling", "t": "outlier", "aka": ["Gumbel-max trick", "Gumbel-max", "Gumbel max"] },
    { "a": "Sequoia", "t": "longtail" },
    { "a": "DistillSpec", "t": "longtail" },
    { "a": "SpecTr", "t": "longtail" },
    { "a": "Ouroboros", "t": "longtail" },
    { "a": "Online speculative decoding", "t": "longtail" },
    { "a": "Speculative streaming", "t": "longtail" },
    { "a": "Insertion Transformer", "t": "longtail" },
    { "a": "Levenshtein Transformer", "t": "longtail" },
    { "a": "Diffusion decoding", "t": "longtail", "aka": ["diffusion language model", "masked diffusion", "discrete diffusion", "iterative unmasking", "parallel unmasking"] },
    { "a": "N-best rescoring", "t": "longtail", "aka": ["n-best reranking", "rescoring", "lattice rescoring", "reranking"] },
    { "a": "Shallow fusion", "t": "longtail", "aka": ["LM fusion", "language model fusion", "deep fusion", "cold fusion"] },
    { "a": "Reward-augmented decoding", "t": "longtail", "aka": ["RAD"] },
    { "a": "CALM", "t": "longtail", "aka": ["confident adaptive language modeling", "early exit decoding", "early exiting"] },
    { "a": "LLM watermarking", "t": "longtail", "aka": ["green list watermark", "green-red list", "KGW", "SynthID", "SynthID-Text", "tournament sampling", "Kirchenbauer watermark"] }
  ]
