    { "a": "β-VAE", "t": "overfit", "q": "Turn up the KL weight, get disentangled factors. Or blurry faces. Usually both." },
    { "a": "VQ-VAE", "t": "overfit", "aka": ["vector quantized VAE", "vector-quantized variational autoencoder", "neural discrete representation learning"], "q": "Snap each latent to its nearest codebook entry and pass the gradient straight through." },

    { "a": "Variational autoencoder", "t": "baseline", "aka": ["VAE", "AEVB", "auto-encoding variational bayes"], "q": "Kingma & Welling, 2013: the reparameterization trick and an ELBO." },
