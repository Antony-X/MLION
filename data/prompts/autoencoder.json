    { "a": "Contractive autoencoder", "t": "indist", "aka": ["CAE"], "q": "Penalize the encoder's Jacobian so small input wiggles don't move the code." },
    { "a": "Stacked autoencoder", "t": "indist", "aka": ["greedy layer-wise autoencoder"] },
    { "a": "Stacked denoising autoencoder", "t": "indist", "aka": ["SDAE", "SdA"] },
    { "a": "Convolutional autoencoder", "t": "indist", "aka": ["ConvAE", "conv autoencoder"] },
    { "a": "Undercomplete autoencoder", "t": "indist", "aka": ["vanilla autoencoder", "basic autoencoder", "plain autoencoder", "bottleneck autoencoder", "standard autoencoder", "AE"] },
    { "a": "Overcomplete autoencoder", "t": "indist" },
    { "a": "Deep autoencoder", "t": "indist", "q": "Hinton & Salakhutdinov, Science 2006: RBM-pretrained, and it beat PCA." },
    { "a": "Linear autoencoder", "t": "indist", "q": "Linear layers and MSE, and it learns the same subspace as PCA." },
    { "a": "Conditional VAE", "t": "indist", "aka": ["CVAE"] },
    { "a": "Masked autoencoder", "t": "indist", "aka": ["MAE"], "q": "Hide 75% of the patches, reconstruct them. He et al., 2021." },
    { "a": "LSTM autoencoder", "t": "indist", "aka": ["sequence autoencoder", "recurrent autoencoder", "seq2seq autoencoder", "RNN autoencoder"] },
    { "a": "Adversarial autoencoder", "t": "indist", "aka": ["AAE"], "q": "Swap the KL term for a discriminator that pushes the codes toward the prior." },
