{
  "id": "ssl-method",
  "pack": "theory",
  "text": "Name a self-supervised learning method",
  "note": "Any self-supervised pretraining method or pretext task, in vision, language, speech, graphs or RL",
  "strip": ["method", "pretext", "task", "pretraining", "self-supervised", "ssl"],
  "answers": [
    { "a": "Split-Brain Autoencoder", "t": "mlion", "aka": ["split-brain", "split brain autoencoders", "split-brain ae"], "q": "Zhang, Isola & Efros cut the net in half; each half predicts the channels the other one sees." },

    { "a": "Exemplar CNN", "t": "longtail", "aka": ["exemplar", "exemplar-cnn"], "q": "Dosovitskiy 2014: every image is its own class. Contrastive learning's grandparent." },
    { "a": "Counting", "t": "longtail", "aka": ["learning to count", "visual primitives counting"] },
    { "a": "Shuffle and Learn", "t": "longtail", "aka": ["frame order verification", "shuffle & learn"], "q": "Are these video frames in order? Misra et al. made that a pretext task." },
    { "a": "Time-Contrastive Networks", "t": "longtail", "aka": ["TCN", "time-contrastive", "time contrastive network"] },
    { "a": "SeLa", "t": "longtail", "aka": ["self-labelling", "self-labeling via simultaneous clustering"] },
    { "a": "PCL", "t": "longtail", "aka": ["prototypical contrastive learning"] },
    { "a": "AMDIM", "t": "longtail", "aka": ["augmented multiscale deep infomax"] },
    { "a": "MoCHi", "t": "longtail", "aka": ["mixing of contrastive hard negatives"] },
    { "a": "W-MSE", "t": "longtail", "aka": ["whitening mse", "whitened mse"] },
    { "a": "MoCo v3", "t": "longtail", "aka": ["mocov3"] },
    { "a": "MaskFeat", "t": "longtail" },
