{
  "id": "ssl-method",
  "pack": "theory",
  "text": "Name a self-supervised learning method",
  "note": "Any self-supervised pretraining method or pretext task, in vision, language, speech, graphs or RL",
  "strip": ["method", "pretext", "task", "pretraining", "self-supervised", "ssl"],
  "answers": [
    { "a": "Split-Brain Autoencoder", "t": "mlion", "aka": ["split-brain", "split brain autoencoders", "split-brain ae"], "q": "Zhang, Isola & Efros cut the net in half; each half predicts the channels the other one sees." },

    { "a": "Exemplar CNN", "t": "longtail", "aka": ["exemplar", "exemplar-cnn"], "q": "Dosovitskiy 2014: every image is its own class. Contrastive learning's grandparent." },
    { "a": "Counting", "t": "longtail", "aka": ["learning to count", "visual primitives counting"] },
    { "a": "Shuffle and Learn", "t": "longtail", "aka": ["frame order verification", "shuffle & learn"], "q": "Are these video frames in order? Misra et al. made that a pretext task." },
    { "a": "Time-Contrastive Networks", "t": "longtail", "aka": ["TCN", "time-contrastive", "time contrastive network"] },
    { "a": "SeLa", "t": "longtail", "aka": ["self-labelling", "self-labeling via simultaneous clustering"] },
    { "a": "PCL", "t": "longtail", "aka": ["prototypical contrastive learning"] },
    { "a": "AMDIM", "t": "longtail", "aka": ["augmented multiscale deep infomax"] },
    { "a": "MoCHi", "t": "longtail", "aka": ["mixing of contrastive hard negatives"] },
    { "a": "W-MSE", "t": "longtail", "aka": ["whitening mse", "whitened mse"] },
    { "a": "MoCo v3", "t": "longtail", "aka": ["mocov3"] },
    { "a": "MaskFeat", "t": "longtail" },
    { "a": "CAE", "t": "longtail", "aka": ["context autoencoder"] },
    { "a": "PeCo", "t": "longtail", "aka": ["perceptual codebook"] },
    { "a": "SparK", "t": "longtail", "aka": ["sparse masked modeling"] },
    { "a": "FCMAE", "t": "longtail", "aka": ["fully convolutional masked autoencoder", "convnext v2"] },
    { "a": "AIM", "t": "longtail", "aka": ["autoregressive image models"] },
    { "a": "OBoW", "t": "longtail", "aka": ["online bag of visual words"] },
    { "a": "TS2Vec", "t": "longtail" },
    { "a": "TS-TCC", "t": "longtail" },
    { "a": "GraphCL", "t": "longtail" },
    { "a": "GRACE", "t": "longtail" },
    { "a": "BGRL", "t": "longtail", "aka": ["bootstrapped graph latents"] },
    { "a": "GraphMAE", "t": "longtail" },
    { "a": "APC", "t": "longtail", "aka": ["autoregressive predictive coding"] },
    { "a": "BEST-RQ", "t": "longtail", "aka": ["best rq", "random-projection quantizer"] },
    { "a": "SPR", "t": "longtail", "aka": ["self-predictive representations"] },
    { "a": "SimCSE", "t": "longtail", "q": "Same sentence, two dropout masks: that's a positive pair. Remarkably, it works." },
    { "a": "Skip-thought", "t": "longtail", "aka": ["skip-thought vectors", "skip thoughts"] },
    { "a": "Next sentence prediction", "t": "longtail", "aka": ["NSP"], "q": "BERT's second pretext task. RoBERTa dropped it and nobody missed it." },
    { "a": "Deep InfoMax", "t": "longtail", "aka": ["DIM", "deep infomax"] },

    { "a": "PIRL", "t": "outlier", "aka": ["pretext-invariant representation learning"] },
    { "a": "Instance discrimination", "t": "outlier", "aka": ["InstDisc", "NPID", "non-parametric instance discrimination"], "q": "Wu et al. 2018: treat every image as its own class with a memory bank." },
    { "a": "CMC", "t": "outlier", "aka": ["contrastive multiview coding"] },
    { "a": "NNCLR", "t": "outlier", "aka": ["nearest-neighbor contrastive learning"] },
    { "a": "MSN", "t": "outlier", "aka": ["masked siamese networks"] },
    { "a": "iBOT", "t": "outlier", "aka": ["image bert pre-training with online tokenizer"] },
    { "a": "SimMIM", "t": "outlier" },
    { "a": "data2vec", "t": "outlier", "aka": ["data2vec 2.0"], "q": "One recipe for speech, vision and text: predict your own teacher's latents." },
    { "a": "V-JEPA", "t": "outlier", "aka": ["v-jepa 2", "video jepa"] },
    { "a": "DINOv3", "t": "outlier" },
    { "a": "VideoMAE", "t": "outlier" },
    { "a": "iGPT", "t": "outlier", "aka": ["image gpt"], "q": "GPT-2 on pixel sequences. OpenAI showed next-pixel prediction learns features." },
    { "a": "Context encoders", "t": "outlier", "aka": ["context encoder", "inpainting"] },
    { "a": "Context prediction", "t": "outlier", "aka": ["relative patch location", "relative position prediction"] },
    { "a": "Colorization", "t": "outlier", "aka": ["image colorization", "colorful image colorization"], "q": "Predict the colors from a grayscale image. The features learn what grass is." },
    { "a": "Denoising autoencoder", "t": "outlier", "aka": ["DAE", "denoising autoencoders"] },
    { "a": "ELECTRA", "t": "outlier", "aka": ["replaced token detection", "RTD"], "q": "A discriminator spots which tokens a small generator swapped. More sample-efficient than MLM." },
    { "a": "wav2vec 2.0", "t": "outlier", "aka": ["wav2vec", "wav2vec2"], "q": "Mask speech latents, contrast against quantized targets. Ten minutes of labels went a long way." },
    { "a": "HuBERT", "t": "outlier", "q": "Predict k-means cluster IDs of masked speech frames, then re-cluster and repeat." },
    { "a": "WavLM", "t": "outlier" },
    { "a": "DGI", "t": "outlier", "aka": ["deep graph infomax"] },
    { "a": "CURL", "t": "outlier", "aka": ["contrastive unsupervised representations for reinforcement learning"] },
    { "a": "SEER", "t": "outlier" },
    { "a": "Word2vec", "t": "outlier", "aka": ["skip-gram", "CBOW", "word2vec skip-gram"], "q": "Predict a word from its neighbors and king − man + woman ≈ queen falls out." },
    { "a": "CLIP", "t": "outlier", "aka": ["contrastive language-image pretraining"], "q": "400M image–caption pairs, no human labels. Self-supervised if you squint at alt text." },

    { "a": "SimSiam", "t": "indist", "q": "Chen & He: no negatives, no momentum encoder. A stop-gradient prevents collapse." },
    { "a": "DeepCluster", "t": "indist", "aka": ["deepcluster-v2", "deep cluster"], "q": "K-means the features, train on the cluster IDs, repeat." },
    { "a": "VICReg", "t": "indist", "aka": ["variance-invariance-covariance regularization", "VICRegL"], "q": "Variance, invariance, covariance: three regularizers and no negatives needed." },
    { "a": "CPC", "t": "indist", "aka": ["contrastive predictive coding", "InfoNCE", "CPC v2"], "q": "Predict the future in latent space with InfoNCE. Half of SSL's loss functions came from here." },
    { "a": "BEiT", "t": "indist", "aka": ["BEiT v2", "BEiT-3"], "q": "BERT for images: predict discrete visual tokens for masked patches." },
    { "a": "DINOv2", "t": "indist", "q": "DINO + iBOT at scale on curated LVD-142M. General-purpose frozen features." },
    { "a": "JEPA", "t": "indist", "aka": ["I-JEPA", "joint embedding predictive architecture", "image jepa"], "q": "LeCun's bet: predict representations, not pixels." },
    { "a": "Masked language modeling", "t": "indist", "aka": ["MLM", "BERT", "masked language model", "cloze"] },
    { "a": "Next-token prediction", "t": "indist", "aka": ["autoregressive language modeling", "causal language modeling", "language modeling", "GPT", "next token"] },
    { "a": "Rotation prediction", "t": "indist", "aka": ["RotNet", "rotation", "predicting image rotations"], "q": "Gidaris et al.: guess which of four ways the image got turned. Surprisingly strong features." },
    { "a": "Jigsaw puzzles", "t": "indist", "aka": ["jigsaw", "jigsaw puzzle", "solving jigsaw puzzles"] },
    { "a": "Contrastive learning", "t": "indist", "aka": ["contrastive"] },
    { "a": "Autoencoder", "t": "indist", "aka": ["autoencoders", "AE"] },

    { "a": "Barlow Twins", "t": "overfit", "q": "Push the cross-correlation matrix toward identity. Named for neuroscientist Horace Barlow." },
    { "a": "SwAV", "t": "overfit", "aka": ["swapping assignments between views"], "q": "Predict the other view's cluster code. Sinkhorn keeps the clusters balanced." },

    { "a": "SimCLR", "t": "baseline", "aka": ["SimCLRv2", "simclr v2"], "q": "Two augmentations, one NT-Xent loss and a very large batch. Chen et al. 2020." },
    { "a": "MoCo", "t": "baseline", "aka": ["momentum contrast", "MoCo v2", "mocov2"], "q": "A momentum encoder and a queue of negatives, so the batch can stay small. He et al." },
    { "a": "BYOL", "t": "baseline", "aka": ["bootstrap your own latent"], "q": "No negatives and it still doesn't collapse. Half of 2020 tried to work out why." },
    { "a": "MAE", "t": "baseline", "aka": ["masked autoencoder", "masked autoencoders", "masked image modeling", "MIM"], "q": "Mask 75% of the patches and reconstruct pixels. Simple, scalable, and very Kaiming." },
    { "a": "DINO", "t": "baseline", "aka": ["self-distillation with no labels"], "q": "Self-distillation with no labels, and attention maps that segment objects for free." }
  ]
}
