    { "a": "Lookahead", "t": "outlier", "q": "Paper subtitle: \"k steps forward, 1 step back.\" Fast weights explore, slow weights follow." },
    { "a": "8-bit Adam", "t": "outlier", "aka": ["Adam8bit", "AdamW8bit", "8-bit AdamW", "bitsandbytes Adam"], "q": "Dettmers quantized the optimizer states and cut their memory by 75%." },
