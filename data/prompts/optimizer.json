    { "a": "Yogi", "t": "outlier" },
    { "a": "signSGD", "t": "outlier", "aka": ["Signum"], "q": "One bit per gradient coordinate. Lion's great-grandparent." },
    { "a": "ASGD", "t": "outlier", "aka": ["averaged SGD", "Polyak averaging", "Polyak-Ruppert averaging"] },
