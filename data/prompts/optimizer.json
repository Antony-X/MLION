    { "a": "Muon", "t": "overfit", "aka": ["MomentUm Orthogonalized by Newton-Schulz"], "q": "Newton-Schulz-orthogonalized momentum, born in the NanoGPT speedruns. Now it trains trillion-parameter models." },

    { "a": "Gradient descent", "t": "baseline", "aka": ["batch gradient descent", "vanilla gradient descent", "full-batch gradient descent", "steepest descent", "GD"], "q": "Cauchy, 1847. Still the ancestor of everything on this list." },
    { "a": "SGD", "t": "baseline", "aka": ["stochastic gradient descent", "mini-batch gradient descent", "minibatch SGD"] },
