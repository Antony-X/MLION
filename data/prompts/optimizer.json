{
  "id": "optimizer",
  "pack": "blocks",
  "text": "Name an optimizer used to train neural networks",
  "note": "Gradient-based training algorithms and their variants (SGD, Adam, Lion, Shampoo, Muon…). Second-order, distributed and gradient-free methods count too.",
  "strip": ["optimizer", "optimiser", "optimization", "optimisation", "algorithm", "method", "optim", "torch"],
  "answers": [
    { "a": "Hogwild!", "t": "mlion", "q": "Lock-free parallel SGD: let every thread overwrite the shared weights at once. Somehow it still converges." },

    { "a": "NovoGrad", "t": "longtail" },
    { "a": "Adan", "t": "longtail", "aka": ["adaptive Nesterov momentum"] },
    { "a": "AdamP", "t": "longtail", "aka": ["SGDP"] },
