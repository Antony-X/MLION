    { "a": "Prodigy", "t": "outlier" },
    { "a": "D-Adaptation", "t": "outlier", "aka": ["DAdapt", "D-Adapt Adam"] },
    { "a": "GaLore", "t": "outlier", "aka": ["gradient low-rank projection"], "q": "Projects gradients into a low-rank subspace, enough to pretrain a 7B model on a 24 GB GPU." },
