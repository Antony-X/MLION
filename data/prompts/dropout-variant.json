{
  "id": "dropout-variant",
  "pack": "blocks",
  "text": "Name a dropout variant",
  "note": "Dropout and its relatives: anything that randomly drops units, weights, paths, tokens or blocks during training",
  "strip": ["dropout", "regularization"],
  "answers": [
    { "a": "Zoneout", "t": "mlion", "aka": ["zone out", "zone-out", "Zoneout RNN", "Zoneout: regularizing RNNs", "stochastic identity RNN"], "q": "RNN units randomly keep last step's value instead of updating. Your network, quietly zoning out." },

    { "a": "Dropout", "t": "baseline", "aka": ["standard dropout", "vanilla dropout", "Bernoulli dropout", "unit dropout", "nn.Dropout", "F.dropout", "torch.nn.functional.dropout", "tf.keras.layers.Dropout", "keras.layers.Dropout", "tf.nn.dropout", "hidden dropout", "binary dropout", "Hinton dropout", "naive dropout", "classic dropout", "original dropout", "hidden_dropout_prob", "pointwise dropout", "nn.Dropout(p)", "neuron dropout"], "q": "Zero random units during training and rescale the rest. Hinton's group, 2012; the full paper is Srivastava et al., 2014." },
    { "a": "DropConnect", "t": "baseline", "aka": ["drop connect", "weight dropout", "connection dropout"], "q": "Wan et al. 2013: drop weights, not activations. Dropout's sibling." },
    { "a": "Spatial Dropout", "t": "baseline", "aka": ["SpatialDropout2D", "SpatialDropout1D", "Dropout2d", "Dropout1d", "Dropout3d", "channel dropout", "feature map dropout", "channel-wise dropout", "SpatialDropout3D", "F.dropout1d", "F.dropout2d", "F.dropout3d", "nn.Dropout1d", "nn.Dropout2d", "nn.Dropout3d", "DropChannel", "ChannelDrop", "feature-wise dropout", "spatial-shared dropout", "2D dropout", "1D dropout"], "q": "Drops whole feature maps, not single pixels: neighbouring pixels are too correlated for plain dropout. Tompson et al., 2015." },
    { "a": "MC Dropout", "t": "baseline", "aka": ["Monte Carlo dropout", "MCDropout", "Bayesian dropout", "dropout at inference", "test-time dropout", "Dropout as a Bayesian Approximation", "dropout as Bayesian approximation", "Gal dropout uncertainty", "dropout uncertainty estimation", "stochastic forward passes", "MC-Dropout", "dropout sampling at test time"], "q": "Leave dropout on at test time, sample many passes, call the spread uncertainty. Gal & Ghahramani, 2016." },

    { "a": "DropBlock", "t": "overfit", "aka": ["drop block", "DropBlock2d", "DropBlock3d", "torchvision.ops.DropBlock2d", "torchvision.ops.DropBlock3d", "drop_block_2d", "drop_block", "dropblock regularization"], "q": "Plain dropout barely helps convnets, so drop contiguous squares of the feature map instead." },
    { "a": "Stochastic Depth", "t": "overfit", "aka": ["DropPath", "drop path", "layer dropout", "random layer dropping", "local and global drop-path"], "q": "Randomly skip whole residual blocks. Huang et al. trained a 1202-layer ResNet with it." },

    { "a": "Gaussian Dropout", "t": "indist", "aka": ["multiplicative Gaussian noise", "GaussianDropout", "gaussian multiplicative noise", "tf.keras.layers.GaussianDropout", "keras GaussianDropout", "Gaussian multiplicative dropout", "gaussian dropout noise", "fast dropout gaussian approximation"] },
    { "a": "Alpha Dropout", "t": "indist", "aka": ["AlphaDropout", "nn.AlphaDropout", "F.alpha_dropout", "SELU dropout", "alpha-dropout"], "q": "SELU's companion: drops to the negative saturation value so mean and variance survive." },
    { "a": "Variational Dropout", "t": "indist", "aka": ["locked dropout", "variational RNN dropout", "Gal dropout", "same-mask dropout", "Kingma variational dropout", "variational Gaussian dropout", "Variational dropout and the local reparameterization trick", "VD", "locked dropout (variational)", "LockedDropout", "VariationalDropout"], "q": "Gal's version reuses one mask across time steps; Kingma's learns the noise. Both answer to the name." },
    { "a": "Inverted Dropout", "t": "indist", "aka": ["inverted", "scaled dropout"], "q": "Scale up the survivors during training so inference needs no rescaling. What every framework does." },
    { "a": "Attention Dropout", "t": "indist", "aka": ["attention probability dropout", "attn dropout", "attention weights dropout", "attn_drop", "attn_drop_rate", "attention_probs_dropout_prob", "attention_dropout", "softmax dropout", "dropout on attention scores", "attention dropout rate"] },
    { "a": "Recurrent Dropout", "t": "indist", "aka": ["recurrent", "recurrent dropout without memory loss", "Semeniuta dropout"] },
    { "a": "Concrete Dropout", "t": "indist", "aka": ["concrete", "learned dropout rate", "Concrete Relaxation dropout", "relaxed Bernoulli dropout", "Bernoulli relaxation dropout", "learned dropout"], "q": "Learn the dropout rate itself through a continuous relaxation. No more grid search over p." },
    { "a": "Embedding Dropout", "t": "indist", "aka": ["embedding", "word embedding dropout", "embed dropout", "embedding_dropout", "dropout on embeddings", "vocabulary dropout"] },

    { "a": "Word Dropout", "t": "indist", "aka": ["word-level dropout", "word", "word drop", "word dropping", "token replacement dropout", "unk dropout", "word-level dropout (Iyyer)"], "q": "Replace whole input words with UNK. Bowman's VAE used it to make the decoder lean on the latent." },
    { "a": "LayerDrop", "t": "outlier", "aka": ["layer drop", "structured dropout", "Reducing Transformer Depth on Demand with Structured Dropout", "structured layer dropout", "layer dropping"], "q": "Drop whole transformer layers in training, then prune them at inference for free." },
    { "a": "Token Dropping", "t": "outlier", "aka": ["token drop", "token dropout", "DropToken", "patch dropping", "random token drop", "random token dropping", "TokenBypass", "random-LTD", "random layerwise token dropping", "drop tokens"] },
    { "a": "Weight-Dropped LSTM", "t": "outlier", "aka": ["WeightDrop", "weight drop", "AWD-LSTM", "weight dropped lstm", "DropConnect LSTM", "weight_drop", "hidden-to-hidden DropConnect"], "q": "AWD-LSTM's DropConnect on the hidden-to-hidden matrix: regularize recurrence without touching cuDNN." },
    { "a": "R-Drop", "t": "outlier", "aka": ["RDrop", "regularized dropout", "R drop", "R-Drop regularization", "regularized drop", "Dropout consistency regularization"], "q": "Run each batch twice with different masks and penalize the KL between them." },
    { "a": "DropEdge", "t": "outlier", "aka": ["drop edge", "edge dropout", "drop-edge", "edge sampling dropout", "random edge dropping"], "q": "GNN dropout for the adjacency matrix: delete random edges to fight over-smoothing." },
    { "a": "Input Dropout", "t": "outlier", "aka": ["input", "input masking", "masking noise"] },
    { "a": "Residual Dropout", "t": "outlier", "aka": ["residual", "sublayer dropout", "proj_drop", "projection dropout", "output dropout", "resid_pdrop", "residual_dropout", "dropout on sublayer output", "post-attention dropout"] },
    { "a": "Cutout", "t": "outlier", "aka": ["cut out", "coarse dropout", "Random Erasing alternative", "cutout augmentation", "Cutout regularization"], "q": "Blank out a random square of the input image. Dropout's spatial cousin." },
    { "a": "Conditioning Dropout", "t": "outlier", "aka": ["conditioning", "condition dropout", "label dropout", "caption dropout", "classifier-free guidance dropout", "CFG dropout", "text dropout", "prompt dropout", "null conditioning", "unconditional dropout", "text conditioning dropout"], "q": "Drop the prompt ~10% of the time so one diffusion model learns both p(x) and p(x|c). Hello, CFG." },

    { "a": "Swapout", "t": "longtail", "aka": ["swap out"], "q": "Per unit, randomly pick identity, residual, both or neither. Dropout and stochastic depth as special cases." },
    { "a": "Standout", "t": "longtail", "aka": ["adaptive dropout", "standout network"] },
    { "a": "Curriculum Dropout", "t": "longtail", "aka": ["curriculum", "scheduled dropout", "dropout schedule"] },
    { "a": "Annealed Dropout", "t": "longtail", "aka": ["annealed"] },
    { "a": "ScheduledDropPath", "t": "outlier", "aka": ["scheduled drop path", "scheduled droppath"] },
    { "a": "Fast Dropout", "t": "outlier", "aka": ["fast"], "q": "Skip the sampling: approximate dropout's effect with a Gaussian in closed form." },
    { "a": "DropMax", "t": "longtail", "aka": ["drop max"] },
    { "a": "AutoDropout", "t": "longtail", "aka": ["auto dropout"] },
    { "a": "Targeted Dropout", "t": "longtail", "aka": ["targeted"] },
    { "a": "Spectral Dropout", "t": "longtail", "aka": ["spectral"] },
    { "a": "Max-pooling Dropout", "t": "longtail", "aka": ["max pooling dropout", "maxpool dropout", "max-pooling"] },
    { "a": "Information Dropout", "t": "longtail", "aka": ["information", "information-theoretic dropout"] },
    { "a": "Sparse Variational Dropout", "t": "outlier", "aka": ["sparse VD", "sparse variational", "SparseVD", "Sparsifying Bayesian networks"], "q": "Let each weight learn its own dropout rate; push it to 1 and the weight is gone. Pruning by noise." },
    { "a": "DropNode", "t": "longtail", "aka": ["drop node", "node dropout"] },
    { "a": "DropGNN", "t": "longtail", "aka": ["drop gnn"] },
    { "a": "DropMessage", "t": "longtail", "aka": ["drop message", "message dropout", "dropping messages"] },
    { "a": "Multi-Sample Dropout", "t": "outlier", "aka": ["multisample dropout", "multi-sample", "multi sample dropout", "MSD"] },
    { "a": "DropKey", "t": "longtail", "aka": ["drop key"] },
    { "a": "DropHead", "t": "longtail", "aka": ["drop head", "attention head dropout", "head dropout", "scheduled drophead", "HeadDrop", "head masking", "attention head dropout (DropHead)"] },
    { "a": "DropAttention", "t": "longtail", "aka": ["drop attention"] },
    { "a": "Mixout", "t": "longtail", "aka": ["mix out", "mix-out", "Mixout regularization", "mixout fine-tuning"], "q": "Instead of zeroing weights, randomly swap them back to their pretrained values during fine-tuning." },
    { "a": "Drop-Activation", "t": "longtail", "aka": ["drop activation", "dropactivation"] },
    { "a": "Expert Dropout", "t": "longtail", "aka": ["expert"] },
    { "a": "Shakeout", "t": "longtail", "aka": ["shake out"] },
    { "a": "Jumpout", "t": "longtail", "aka": ["jump out"] },
    { "a": "Early Dropout", "t": "longtail", "aka": ["early", "late dropout"], "q": "Liu et al. 2023: dropout only in the first epochs can reduce underfitting. Dropout, flipped." },
    { "a": "Modality Dropout", "t": "longtail", "aka": ["modality", "ModDrop", "missing modality dropout", "modal dropout", "modality-wise dropout", "stochastic modality dropout", "modality masking", "modality drop"] },
    { "a": "Federated Dropout", "t": "longtail", "aka": ["federated"] },
    { "a": "Progressive Layer Dropping", "t": "longtail", "aka": ["PLD", "progressive layer drop", "PLD transformer"] },
    { "a": "LayerSkip", "t": "longtail", "aka": ["layer skip"] },
    { "a": "Adversarial Dropout", "t": "longtail", "aka": ["adversarial"] },
    { "a": "Fraternal Dropout", "t": "longtail", "aka": ["fraternal"] },
    { "a": "RNNDrop", "t": "longtail", "aka": ["rnn drop"] },
    { "a": "PatchDropout", "t": "longtail", "aka": ["patch dropout"] },
    { "a": "GradDrop", "t": "longtail", "aka": ["gradient sign dropout", "grad drop", "gradient dropout"] },
    { "a": "ShakeDrop", "t": "longtail", "aka": ["shake drop"] },
    { "a": "Feature Alpha Dropout", "t": "longtail", "aka": ["FeatureAlphaDropout", "feature alpha", "nn.FeatureAlphaDropout", "F.feature_alpha_dropout"] },
    { "a": "Random Erasing", "t": "outlier", "aka": ["random erase", "RandomErasing", "torchvision RandomErasing", "random erasing augmentation", "Random Erasing Data Augmentation"] },
    { "a": "Hide-and-Seek", "t": "longtail", "aka": ["hide and seek", "hide-and-seek augmentation", "patch hiding", "random patch hiding"] },
    { "a": "GridMask", "t": "longtail", "aka": ["grid mask", "GridMask augmentation", "grid dropout", "GridDropout", "structured grid dropout"] },
    { "a": "SpecAugment", "t": "longtail", "aka": ["spec augment", "time masking", "frequency masking", "time and frequency masking", "TimeMasking", "FrequencyMasking", "SpecAugment masking"] },
    { "a": "Shake-Shake", "t": "longtail", "aka": ["shake shake", "Shake-Shake regularization", "shake-shake regularisation", "stochastic branch mixing"] },
    { "a": "DropCluster", "t": "longtail", "aka": ["drop cluster", "DropCluster structured dropout"] },
    { "a": "DropoutNet", "t": "longtail", "aka": ["Dropout Net", "dropout net", "DropoutNet cold start", "input view dropout recommender"] },
    { "a": "Activation Dropout", "t": "longtail", "aka": ["activation_dropout", "ReLU dropout", "relu_dropout", "FFN dropout", "MLP dropout", "feed-forward dropout", "intermediate dropout"] },
    { "a": "Classifier Dropout", "t": "longtail", "aka": ["classifier_dropout", "output layer dropout", "pre-classifier dropout", "dropout before classifier", "final dropout"] },
    { "a": "Stochastic Activation Pruning", "t": "longtail", "aka": ["SAP"] },
    { "a": "Whiteout", "t": "longtail", "aka": ["Whiteout Gaussian adaptive noise regularization"] }
  ]
}
