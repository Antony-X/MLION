{
  "id": "dropout-variant",
  "pack": "blocks",
  "text": "Name a dropout variant",
  "note": "Dropout and its relatives: anything that randomly drops units, weights, paths, tokens or blocks during training",
  "strip": ["dropout", "regularization"],
  "answers": [
    { "a": "Zoneout", "t": "mlion", "aka": ["zone out"], "q": "RNN units randomly keep last step's value instead of updating. Your network, quietly zoning out." },

    { "a": "Dropout", "t": "baseline", "aka": ["standard dropout", "vanilla dropout", "Bernoulli dropout", "unit dropout"] },
    { "a": "DropConnect", "t": "baseline", "aka": ["drop connect", "weight dropout"], "q": "Wan et al. 2013: drop weights, not activations. Dropout's sibling." },
    { "a": "Spatial Dropout", "t": "baseline", "aka": ["SpatialDropout2D", "SpatialDropout1D", "Dropout2d", "Dropout1d", "Dropout3d", "channel dropout", "feature map dropout", "channel-wise dropout"] },
    { "a": "MC Dropout", "t": "baseline", "aka": ["Monte Carlo dropout", "MCDropout", "Bayesian dropout", "dropout at inference", "test-time dropout"], "q": "Leave dropout on at test time, sample many passes, call the spread uncertainty. Gal & Ghahramani, 2016." },

    { "a": "DropBlock", "t": "overfit", "aka": ["drop block"], "q": "Plain dropout barely hurts convnets, so drop contiguous squares of the feature map instead." },
    { "a": "Stochastic Depth", "t": "overfit", "aka": ["DropPath", "drop path", "layer dropout", "random layer dropping", "local and global drop-path"], "q": "Randomly skip whole residual blocks. Huang et al. trained a 1202-layer ResNet with it." },

    { "a": "Gaussian Dropout", "t": "indist", "aka": ["multiplicative Gaussian noise", "GaussianDropout", "gaussian multiplicative noise"] },
    { "a": "Alpha Dropout", "t": "indist", "aka": ["AlphaDropout"], "q": "SELU's companion: drops to the negative saturation value so mean and variance survive." },
    { "a": "Variational Dropout", "t": "indist", "aka": ["locked dropout", "variational RNN dropout", "Gal dropout", "same-mask dropout", "Kingma variational dropout"], "q": "Gal's version reuses one mask across time steps; Kingma's learns the noise. Both answer to the name." },
    { "a": "Inverted Dropout", "t": "indist", "aka": ["inverted", "scaled dropout"], "q": "Scale up the survivors during training so inference needs no rescaling. What every framework does." },
    { "a": "Attention Dropout", "t": "indist", "aka": ["attention probability dropout", "attn dropout", "attention weights dropout"] },
    { "a": "Recurrent Dropout", "t": "indist", "aka": ["recurrent", "recurrent dropout without memory loss", "Semeniuta dropout"] },
    { "a": "Concrete Dropout", "t": "indist", "aka": ["concrete", "learned dropout rate"], "q": "Learn the dropout rate itself through a continuous relaxation. No more grid search over p." },
    { "a": "Embedding Dropout", "t": "indist", "aka": ["embedding", "word embedding dropout"] },

    { "a": "Word Dropout", "t": "indist", "aka": ["word-level dropout", "word"], "q": "Replace whole input words with UNK. Bowman's VAE used it to make the decoder lean on the latent." },
    { "a": "LayerDrop", "t": "outlier", "aka": ["layer drop", "structured dropout"], "q": "Drop whole transformer layers in training, then prune them at inference for free." },
    { "a": "Token Dropping", "t": "outlier", "aka": ["token drop", "token dropout", "DropToken", "patch dropping"] },
    { "a": "Weight-Dropped LSTM", "t": "outlier", "aka": ["WeightDrop", "weight drop", "AWD-LSTM", "weight dropped lstm"], "q": "AWD-LSTM's DropConnect on the hidden-to-hidden matrix: regularize recurrence without touching cuDNN." },
    { "a": "R-Drop", "t": "outlier", "aka": ["RDrop", "regularized dropout"], "q": "Run each batch twice with different masks and penalize the KL between them." },
    { "a": "DropEdge", "t": "outlier", "aka": ["drop edge", "edge dropout"], "q": "GNN dropout for the adjacency matrix: delete random edges to fight over-smoothing." },
    { "a": "Input Dropout", "t": "outlier", "aka": ["input", "input masking", "masking noise"] },
    { "a": "Residual Dropout", "t": "outlier", "aka": ["residual", "sublayer dropout"] },
    { "a": "Cutout", "t": "outlier", "aka": ["cut out", "coarse dropout"], "q": "Blank out a random square of the input image. Dropout's spatial cousin." },
    { "a": "Conditioning Dropout", "t": "outlier", "aka": ["conditioning", "condition dropout", "label dropout", "caption dropout", "classifier-free guidance dropout", "CFG dropout", "text dropout"], "q": "Drop the prompt ~10% of the time so one diffusion model learns both p(x) and p(x|c). Hello, CFG." },

    { "a": "Swapout", "t": "longtail", "aka": ["swap out"], "q": "Per unit, randomly pick identity, residual, both or neither. Dropout and stochastic depth as special cases." },
    { "a": "Standout", "t": "longtail", "aka": ["adaptive dropout", "standout network"] },
    { "a": "Curriculum Dropout", "t": "longtail", "aka": ["curriculum"] },
    { "a": "Annealed Dropout", "t": "longtail", "aka": ["annealed"] },
    { "a": "ScheduledDropPath", "t": "outlier", "aka": ["scheduled drop path", "scheduled droppath"] },
    { "a": "Fast Dropout", "t": "outlier", "aka": ["fast"], "q": "Skip the sampling: approximate dropout's effect with a Gaussian in closed form." },
    { "a": "DropMax", "t": "longtail", "aka": ["drop max"] },
    { "a": "AutoDropout", "t": "longtail", "aka": ["auto dropout"] },
    { "a": "Targeted Dropout", "t": "longtail", "aka": ["targeted"] },
    { "a": "Spectral Dropout", "t": "longtail", "aka": ["spectral"] },
    { "a": "Max-pooling Dropout", "t": "longtail", "aka": ["max pooling dropout", "maxpool dropout", "max-pooling"] },
    { "a": "Information Dropout", "t": "longtail", "aka": ["information"] },
    { "a": "Sparse Variational Dropout", "t": "outlier", "aka": ["sparse VD", "sparse variational"], "q": "Let each weight learn its own dropout rate; push it to 1 and the weight is gone. Pruning by noise." },
    { "a": "DropNode", "t": "longtail", "aka": ["drop node", "node dropout"] },
    { "a": "DropGNN", "t": "longtail", "aka": ["drop gnn"] },
    { "a": "DropMessage", "t": "longtail", "aka": ["drop message", "message dropout"] },
    { "a": "Multi-Sample Dropout", "t": "outlier", "aka": ["multisample dropout", "multi-sample"] },
    { "a": "DropKey", "t": "longtail", "aka": ["drop key"] },
    { "a": "DropHead", "t": "longtail", "aka": ["drop head", "attention head dropout", "head dropout", "scheduled drophead"] },
    { "a": "DropAttention", "t": "longtail", "aka": ["drop attention"] },
    { "a": "Mixout", "t": "longtail", "aka": ["mix out"], "q": "Instead of zeroing weights, randomly swap them back to their pretrained values during fine-tuning." },
    { "a": "Drop-Activation", "t": "longtail", "aka": ["drop activation", "dropactivation"] },
    { "a": "Expert Dropout", "t": "longtail", "aka": ["expert"] },
    { "a": "Shakeout", "t": "longtail", "aka": ["shake out"] },
    { "a": "Jumpout", "t": "longtail", "aka": ["jump out"] },
    { "a": "Early Dropout", "t": "longtail", "aka": ["early", "late dropout"], "q": "Liu et al. 2023: dropout only in the first epochs can reduce underfitting. Dropout, flipped." },
    { "a": "Modality Dropout", "t": "longtail", "aka": ["modality", "ModDrop"] },
    { "a": "Federated Dropout", "t": "longtail", "aka": ["federated"] },
    { "a": "Progressive Layer Dropping", "t": "longtail", "aka": ["PLD", "progressive layer drop"] },
    { "a": "LayerSkip", "t": "longtail", "aka": ["layer skip"] },
    { "a": "Adversarial Dropout", "t": "longtail", "aka": ["adversarial"] },
    { "a": "Fraternal Dropout", "t": "longtail", "aka": ["fraternal"] },
    { "a": "RNNDrop", "t": "longtail", "aka": ["rnn drop"] },
    { "a": "PatchDropout", "t": "longtail", "aka": ["patch dropout"] },
    { "a": "GradDrop", "t": "longtail", "aka": ["gradient sign dropout", "grad drop", "gradient dropout"] },
    { "a": "ShakeDrop", "t": "longtail", "aka": ["shake drop"] },
    { "a": "Feature Alpha Dropout", "t": "longtail", "aka": ["FeatureAlphaDropout", "feature alpha"] }
  ]
}
