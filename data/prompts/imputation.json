    { "a": "Surrogate splits", "t": "outlier", "aka": ["surrogate split", "CART surrogates"], "q": "CART's trick: when the split feature is missing, route by the variable that best mimics it." },
    { "a": "Sparsity-aware split finding", "t": "outlier", "aka": ["default direction", "learned default direction", "xgboost missing handling"], "q": "XGBoost learns a default branch for missing values at every split. No imputing needed." },
    { "a": "Column deletion", "t": "outlier", "aka": ["drop columns", "drop column", "variable deletion", "drop feature"] },

    { "a": "Constant imputation", "t": "indist", "aka": ["constant value", "fill with constant", "arbitrary value imputation", "sentinel value", "fill value", "placeholder value", "fillna", "-999"] },
    { "a": "Zero imputation", "t": "indist", "aka": ["zero fill", "fill with zero", "zero filling"] },
    { "a": "Listwise deletion", "t": "indist", "aka": ["complete case analysis", "complete-case analysis", "CCA", "casewise deletion", "drop rows", "dropna", "row deletion", "deletion"], "q": "Not technically imputation, but the most popular missing-data 'fix' ever. Unbiased only under MCAR." },
    { "a": "Regression imputation", "t": "indist", "aka": ["deterministic regression imputation", "conditional mean imputation", "linear regression imputation"] },
    { "a": "Iterative imputation", "t": "indist", "aka": ["IterativeImputer"], "q": "scikit-learn's MICE-inspired imputer. Still experimental, still needs its special enable import." },
    { "a": "Multiple imputation", "t": "indist", "aka": ["MI", "rubin's rules"], "q": "Rubin, 1987: impute m times, analyze each, pool with Rubin's rules so the uncertainty survives." },
    { "a": "EM algorithm", "t": "indist", "aka": ["expectation-maximization", "expectation maximization", "EM imputation", "EM"], "q": "Dempster, Laird & Rubin, 1977: alternate expected sufficient statistics and maximization until it settles." },
    { "a": "MissForest", "t": "indist", "aka": ["random forest imputation"], "q": "Stekhoven & Bühlmann, 2012: iterate random forests over the columns until the imputations stop changing." },
    { "a": "Missing indicator", "t": "indist", "aka": ["MissingIndicator", "missingness indicator", "indicator method", "dummy variable adjustment", "NA indicator", "add_indicator", "missing flag"], "q": "Add a was-this-missing column. Sometimes the missingness is the signal." },
    { "a": "Forward fill", "t": "indist", "aka": ["LOCF", "last observation carried forward", "ffill", "pad", "carry forward", "last value carried forward", "previous value"], "q": "Last observation carried forward: time series' default, and clinical trials' cautionary tale." },
