    { "a": "SoftImpute", "t": "outlier", "q": "Mazumder, Hastie & Tibshirani, 2010: iterative soft-thresholded SVD for matrix completion." },
    { "a": "Iterative SVD", "t": "outlier", "aka": ["SVDimpute", "SVD imputation", "iterative singular value decomposition"] },
