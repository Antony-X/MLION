    { "a": "Mean imputation", "t": "baseline", "aka": ["mean substitution", "average imputation", "mean fill", "fill with mean", "unconditional mean imputation", "SimpleImputer"], "q": "Fast, simple, and quietly shrinks your variances and correlations." },
    { "a": "Median imputation", "t": "baseline", "aka": ["median fill", "fill with median"], "q": "Mean imputation for skewed data and the outlier-shy." },
