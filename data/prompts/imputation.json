    { "a": "Amelia", "t": "mlion", "aka": ["Amelia II", "EMB", "EM with bootstrapping", "expectation-maximization with bootstrapping"], "q": "EM with bootstrapping, by Honaker, King & Blackwell. Named for history's most famous missing person, Amelia Earhart." },

    { "a": "Cold-deck imputation", "t": "longtail", "aka": ["cold deck"], "q": "Hot deck's sibling: the donor comes from another dataset, like last year's survey." },
    { "a": "Midastouch", "t": "longtail", "q": "A predictive mean matching variant that weights donors by distance. Gaffert, Meinfelder & Bosch." },
    { "a": "Buck's method", "t": "longtail", "aka": ["buck"], "q": "Buck, 1960: regress each missing variable on the observed ones, one missingness pattern at a time." },
    { "a": "Approximate Bayesian bootstrap", "t": "longtail", "aka": ["ABB"] },
