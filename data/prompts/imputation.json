    { "a": "Kalman smoothing", "t": "outlier", "aka": ["kalman filter imputation", "kalman smoother", "state space imputation", "na_kalman"] },
    { "a": "Moving average imputation", "t": "outlier", "aka": ["rolling mean imputation", "na_ma"] },
    { "a": "Kriging", "t": "outlier", "aka": ["gaussian process imputation", "gaussian process regression"] },
    { "a": "GAIN", "t": "outlier", "aka": ["generative adversarial imputation nets", "generative adversarial imputation networks"], "q": "Yoon, Jordon & van der Schaar, 2018: a GAN whose discriminator guesses which entries were imputed." },
    { "a": "Autoencoder imputation", "t": "outlier", "aka": ["VAE imputation", "variational autoencoder imputation"] },
    { "a": "FIML", "t": "outlier", "aka": ["full information maximum likelihood", "direct maximum likelihood", "direct ML"], "q": "Skip imputing: maximize the likelihood over whatever each row observed. SEM software's default." },
