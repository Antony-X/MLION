    { "a": "Polynomial interpolation", "t": "longtail" },
    { "a": "Seasonal decomposition imputation", "t": "longtail", "aka": ["seasonally decomposed imputation", "na_seadec", "seasonal adjustment imputation"] },
    { "a": "Stineman interpolation", "t": "longtail", "aka": ["stineman"], "q": "Stineman's 1980 interpolant that refuses to overshoot. imputeTS ships it." },
    { "a": "Baseline observation carried forward", "t": "longtail", "aka": ["BOCF"] },
    { "a": "Worst observation carried forward", "t": "longtail", "aka": ["WOCF"], "q": "The pessimist's LOCF, straight from clinical trials." },
    { "a": "Inverse distance weighting", "t": "longtail", "aka": ["IDW"] },
    { "a": "MIDA", "t": "longtail", "aka": ["multiple imputation using denoising autoencoders", "denoising autoencoder imputation"] },
