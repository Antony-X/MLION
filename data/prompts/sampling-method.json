    { "a": "MALA", "t": "outlier", "aka": ["metropolis-adjusted langevin", "metropolis adjusted langevin algorithm"] },
    { "a": "SGLD", "t": "outlier", "aka": ["stochastic gradient langevin dynamics", "SG-MCMC", "stochastic gradient mcmc"], "q": "Welling & Teh 2011: SGD plus the right amount of noise is a posterior sampler." },
    { "a": "Parallel tempering", "t": "outlier", "aka": ["replica exchange", "replica exchange MCMC", "exchange monte carlo"], "q": "Run hot and cold chains side by side and swap states, so the cold one escapes local modes." },
