    { "a": "Likelihood weighting", "t": "outlier" },
    { "a": "Ancestral sampling", "t": "outlier", "aka": ["forward sampling", "ancestral"] },
    { "a": "Jackknife", "t": "outlier", "aka": ["jackknife resampling", "leave-one-out resampling"] },
    { "a": "Reservoir sampling", "t": "outlier", "aka": ["algorithm r", "reservoir"], "q": "Sample k items uniformly from a stream of unknown length, in one pass. A favorite interview question." },
    { "a": "Negative sampling", "t": "outlier" },
    { "a": "Cluster sampling", "t": "outlier" },
    { "a": "Systematic sampling", "t": "outlier" },
    { "a": "Speculative sampling", "t": "outlier", "aka": ["speculative decoding"] },
    { "a": "Thompson sampling", "t": "outlier", "aka": ["posterior sampling", "probability matching"] },

    { "a": "Slice sampling", "t": "indist", "aka": ["slice"], "q": "Neal 2003: sample uniformly under the density's curve, one horizontal slice at a time." },
    { "a": "Langevin dynamics", "t": "indist", "aka": ["langevin", "langevin monte carlo", "ULA", "unadjusted langevin", "annealed langevin dynamics"] },
    { "a": "Particle filter", "t": "indist", "aka": ["sequential monte carlo", "SMC", "particle filtering", "bootstrap filter", "sequential importance resampling"], "q": "A cloud of weighted samples tracks a hidden state. Resample when the weights collapse." },
    { "a": "Monte Carlo", "t": "indist", "aka": ["monte carlo sampling", "monte carlo integration", "crude monte carlo"], "q": "Named by Ulam and Metropolis after the casino where Ulam's uncle gambled." },
    { "a": "Inverse transform sampling", "t": "indist", "aka": ["inverse cdf", "inverse transform", "inversion sampling", "smirnov transform"] },
    { "a": "Stratified sampling", "t": "indist", "aka": ["stratified"] },
    { "a": "Simple random sampling", "t": "indist", "aka": ["random sampling", "SRS", "uniform sampling"] },
    { "a": "Bootstrap", "t": "indist", "aka": ["bootstrapping", "bootstrap resampling"], "q": "Efron 1979: resample your own data with replacement and pull yourself up by the bootstraps." },
    { "a": "Temperature sampling", "t": "indist", "aka": ["temperature"] },
    { "a": "Top-k sampling", "t": "indist", "aka": ["top-k", "top k"] },
    { "a": "Nucleus sampling", "t": "indist", "aka": ["top-p", "top p", "nucleus"], "q": "Holtzman et al.: sample from the smallest set covering p of the mass. Fixes neural text degeneration." },

    { "a": "NUTS", "t": "overfit", "aka": ["no-u-turn sampler", "no u-turn", "no u turn"], "q": "HMC that stops when the trajectory starts doubling back. Stan's default, so everyone knows it." },

    { "a": "Metropolis–Hastings", "t": "baseline", "aka": ["MH", "metropolis hastings", "metropolis", "random walk metropolis", "RWM", "metropolis algorithm"], "q": "Propose, then accept with a ratio of densities. Normalizing constants cancel, which is the point." },
    { "a": "Gibbs sampling", "t": "baseline", "aka": ["gibbs"], "q": "Sample each variable from its conditional, in turn. The Gemans named it after Gibbs in 1984." },
    { "a": "Hamiltonian Monte Carlo", "t": "baseline", "aka": ["HMC", "hybrid monte carlo"], "q": "Give the sample momentum and let physics carry it far. Born as 'hybrid Monte Carlo' in lattice QCD." },
    { "a": "MCMC", "t": "baseline", "aka": ["markov chain monte carlo"] },
    { "a": "Importance sampling", "t": "baseline", "aka": ["importance"], "q": "Sample from q, reweight by p/q. Great until q misses where p lives." },
    { "a": "Rejection sampling", "t": "baseline", "aka": ["acceptance-rejection", "accept-reject", "rejection"], "q": "Draw under an envelope, keep what lands under the curve. Wasteful in high dimensions." }
