    { "a": "Coupling from the past", "t": "mlion", "aka": ["CFTP", "propp-wilson", "perfect sampling", "exact sampling"], "q": "Propp & Wilson 1996: run the chain from the infinite past and get an exact sample in finite time." },

    { "a": "Swendsen–Wang", "t": "longtail", "aka": ["swendsen wang"], "q": "Flip whole clusters of Ising spins at once instead of one at a time." },
