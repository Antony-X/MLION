    { "a": "Elliptical slice sampling", "t": "outlier", "aka": ["ESS", "elliptical slice"], "q": "Murray, Adams & MacKay: slice sampling along an ellipse for Gaussian priors. No step size to tune." },
    { "a": "Collapsed Gibbs", "t": "outlier", "aka": ["collapsed gibbs sampling"] },
    { "a": "Affine-invariant ensemble sampler", "t": "outlier", "aka": ["emcee", "stretch move", "goodman-weare", "ensemble sampler"], "q": "Goodman & Weare's stretch move, shipped by emcee to every astronomer." },
    { "a": "Stein variational gradient descent", "t": "outlier", "aka": ["SVGD"], "q": "Particles repel each other while following the score. Liu & Wang 2016." },
    { "a": "Contrastive divergence", "t": "outlier", "aka": ["CD-k", "persistent contrastive divergence", "PCD"] },
    { "a": "Quasi-Monte Carlo", "t": "outlier", "aka": ["QMC", "low-discrepancy sequence", "low discrepancy"], "q": "Swap random points for low-discrepancy sequences and the error falls nearly as 1/N." },
    { "a": "Sobol sequence", "t": "outlier", "aka": ["sobol"] },
    { "a": "Latin hypercube sampling", "t": "outlier", "aka": ["LHS", "latin hypercube"], "q": "One sample per row and column of every stratum grid. A sudoku for experimental design." },
    { "a": "Antithetic variates", "t": "outlier", "aka": ["antithetic sampling", "antithetic"] },
    { "a": "Nested sampling", "t": "outlier", "q": "Skilling 2004: shrink the prior volume inside rising likelihood contours. Built for evidence." },
    { "a": "Approximate Bayesian computation", "t": "outlier", "aka": ["ABC", "ABC rejection", "likelihood-free inference"] },
    { "a": "Sampling importance resampling", "t": "outlier", "aka": ["SIR", "importance resampling"] },
    { "a": "Box–Muller", "t": "outlier", "aka": ["box muller", "box-muller transform"], "q": "Two uniforms in, two independent normals out, via a log, a sqrt and a cosine." },
