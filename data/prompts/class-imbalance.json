{
  "id": "class-imbalance",
  "pack": "classic",
  "text": "Name a technique for handling class imbalance",
  "note": "Resampling, reweighting, losses, ensembles, long-tail recognition tricks and imbalance-aware evaluation all count",
  "strip": ["technique", "method", "loss", "algorithm"],
  "answers": [
    { "a": "NearMiss", "t": "mlion", "aka": ["near miss", "NearMiss-1", "NearMiss-2", "NearMiss-3"], "q": "Keep only the majority points that sit closest to the minority class. Three versions, all from Mani & Zhang, 2003." },

    { "a": "Safe-Level-SMOTE", "t": "longtail", "aka": ["safe level smote"] },
    { "a": "MWMOTE", "t": "longtail", "aka": ["majority weighted minority oversampling technique"] },
    { "a": "G-SMOTE", "t": "longtail", "aka": ["geometric smote"] },
    { "a": "DBSMOTE", "t": "longtail", "aka": ["density-based smote"] },
    { "a": "Cluster-based oversampling", "t": "longtail", "aka": ["cluster based oversampling"] },
    { "a": "BAGAN", "t": "longtail", "aka": ["balancing gan"] },
    { "a": "Remix", "t": "longtail", "aka": ["rebalanced mixup"], "q": "Mixup that mixes features freely but tilts the mixed label toward the minority class." },
    { "a": "Repeated Edited Nearest Neighbours", "t": "longtail", "aka": ["RENN", "repeated enn", "repeated edited nearest neighbors"] },
    { "a": "All-kNN", "t": "longtail", "aka": ["allknn", "all k-nn"] },
    { "a": "Instance hardness threshold", "t": "longtail", "aka": ["IHT", "InstanceHardnessThreshold"] },
    { "a": "Balance Cascade", "t": "longtail", "aka": ["balancecascade"] },
    { "a": "SMOTEBagging", "t": "longtail", "aka": ["smote bagging"] },
    { "a": "AdaCost", "t": "longtail", "aka": ["AdaC1", "AdaC2", "AdaC3", "cost-sensitive boosting"] },
    { "a": "MetaCost", "t": "longtail", "q": "Domingos, 1999: relabel the training set with the cost-minimizing class, then train any classifier you like." },
    { "a": "Self-paced ensemble", "t": "longtail", "aka": ["SPE", "self paced ensemble"] },
    { "a": "Equalization loss", "t": "longtail", "aka": ["EQL", "equalization loss v2", "EQLv2"] },
    { "a": "Seesaw loss", "t": "longtail" },
    { "a": "BBN", "t": "longtail", "aka": ["bilateral-branch network", "bilateral branch network"] },
    { "a": "Repeat factor sampling", "t": "longtail", "aka": ["RFS"], "q": "LVIS's trick: repeat images that contain rare categories, by an amount set per category." },
    { "a": "Square-root sampling", "t": "longtail", "aka": ["sqrt sampling", "square root sampling"] },
    { "a": "Focal Tversky loss", "t": "longtail", "aka": ["focal tversky"] },
    { "a": "Generalized Dice loss", "t": "longtail", "aka": ["GDL", "generalised dice loss"] },
    { "a": "GHM", "t": "longtail", "aka": ["gradient harmonizing mechanism", "GHM-C"] },
    { "a": "Asymmetric loss", "t": "longtail", "aka": ["ASL"] },
    { "a": "MetaWeight-Net", "t": "longtail", "aka": ["meta-weight-net", "meta weight net", "MW-Net"] },
    { "a": "Learning to reweight", "t": "longtail", "aka": ["L2RW", "learning to reweight examples"] },
    { "a": "Prior correction", "t": "longtail", "aka": ["rare events logistic regression", "king and zeng correction", "intercept correction"], "q": "King & Zeng, 2001: fit on balanced data, then shift the intercept back to the true base rate." },
    { "a": "Cohen's kappa", "t": "longtail", "aka": ["kappa", "cohen kappa"] },
    { "a": "G-mean", "t": "longtail", "aka": ["geometric mean", "geometric mean of recall"] },
    { "a": "HDDT", "t": "longtail", "aka": ["hellinger distance decision tree", "hellinger distance"] },

    { "a": "SMOTE-Tomek", "t": "outlier", "aka": ["SMOTETomek", "smote + tomek links"] },
    { "a": "SMOTE-ENN", "t": "outlier", "aka": ["SMOTEENN", "smote + enn"] },
    { "a": "SVM-SMOTE", "t": "outlier", "aka": ["SVMSMOTE", "svm smote"] },
    { "a": "K-Means SMOTE", "t": "outlier", "aka": ["kmeanssmote", "kmeans smote"] },
    { "a": "SMOTE-NC", "t": "outlier", "aka": ["SMOTENC", "SMOTEN", "smote nominal continuous"] },
    { "a": "ROSE", "t": "outlier", "aka": ["random over-sampling examples"] },
    { "a": "Edited Nearest Neighbours", "t": "outlier", "aka": ["ENN", "edited nearest neighbors", "wilson editing"] },
    { "a": "Condensed Nearest Neighbour", "t": "outlier", "aka": ["CNN", "condensed nearest neighbor", "hart's algorithm"] },
    { "a": "One-sided selection", "t": "outlier", "aka": ["OSS"] },
    { "a": "Neighbourhood cleaning rule", "t": "outlier", "aka": ["NCL", "NCR", "neighborhood cleaning rule"] },
    { "a": "Cluster centroids", "t": "outlier", "aka": ["ClusterCentroids", "cluster centroid undersampling"] },
    { "a": "Easy Ensemble", "t": "outlier", "aka": ["EasyEnsemble", "EasyEnsembleClassifier"], "q": "Liu, Wu & Zhou: train on many random majority subsets, then boost and combine. Undersampling without the regret." },
    { "a": "Balanced bagging", "t": "outlier", "aka": ["UnderBagging", "BalancedBaggingClassifier", "OverBagging", "roughly balanced bagging"] },
    { "a": "RUSBoost", "t": "outlier" },
    { "a": "SMOTEBoost", "t": "outlier" },
    { "a": "LDAM loss", "t": "outlier", "aka": ["LDAM", "LDAM-DRW", "label-distribution-aware margin", "deferred re-weighting", "DRW"], "q": "Bigger margins for rarer classes, ∝ n^(-1/4). Cao et al., 2019, best served with deferred re-weighting." },
    { "a": "Logit adjustment", "t": "outlier", "aka": ["logit-adjusted loss", "logit adjusted softmax", "post-hoc logit adjustment"], "q": "Add τ·log(prior) to the logits while training, or subtract it afterward. Menon et al., 2021." },
    { "a": "Balanced softmax", "t": "outlier", "aka": ["balanced meta-softmax", "BALMS"] },
    { "a": "Class-balanced loss", "t": "outlier", "aka": ["CB loss", "effective number of samples", "class-balanced focal loss"], "q": "Cui et al., 2019: weight by the effective number (1−βⁿ)/(1−β), not the raw count." },
    { "a": "Decoupled training", "t": "outlier", "aka": ["decoupling representation and classifier", "classifier retraining", "cRT", "tau-normalization", "τ-normalization", "tau-norm", "LWS"], "q": "Kang et al., 2020: learn features with plain sampling, then rebalance only the classifier." },
    { "a": "OHEM", "t": "outlier", "aka": ["online hard example mining", "hard negative mining", "hard example mining"] },
    { "a": "Tversky loss", "t": "outlier", "aka": ["tversky"] },
    { "a": "Balanced accuracy", "t": "outlier", "aka": ["macro recall", "balanced acc"] },
    { "a": "Matthews correlation coefficient", "t": "outlier", "aka": ["MCC", "matthews correlation", "phi coefficient"] },
    { "a": "GAN-based oversampling", "t": "outlier", "aka": ["GAN oversampling", "generative oversampling", "synthetic data generation", "GAN augmentation"] },
    { "a": "Downsample and upweight", "t": "outlier", "aka": ["downsampling and upweighting", "downsample and upweight"], "q": "Google's crash-course recipe: drop most of the majority, then multiply its loss weight by the same factor." },
    { "a": "Bias initialization", "t": "outlier", "aka": ["output bias initialization", "prior initialization", "prior bias init", "bias init"], "q": "Set the output bias to log(pos/neg) so step one isn't wasted learning the base rate. RetinaNet does it too." },
    { "a": "Collect more data", "t": "outlier", "aka": ["gather more data", "more data", "get more data"], "q": "The technique every blog lists first and every deadline rules out." },

    { "a": "Tomek links", "t": "indist", "aka": ["tomek link", "TomekLinks", "tomek"], "q": "Two opposite-class points that are each other's nearest neighbor. Ivan Tomek, 1976." },
    { "a": "Borderline-SMOTE", "t": "indist", "aka": ["borderline smote", "borderlinesmote"] },
    { "a": "Cost-sensitive learning", "t": "indist", "aka": ["cost-sensitive", "cost matrix", "misclassification costs", "cost-sensitive classification"], "q": "Elkan, 2001: given a cost matrix, the right decision threshold follows from the costs." },
    { "a": "Threshold moving", "t": "indist", "aka": ["threshold tuning", "threshold adjustment", "decision threshold", "cutoff tuning", "threshold optimization"], "q": "Nobody said the cutoff had to be 0.5." },
    { "a": "Data augmentation", "t": "indist", "aka": ["augmentation", "augment minority class"] },
    { "a": "Stratified sampling", "t": "indist", "aka": ["stratified k-fold", "stratified split", "stratification", "StratifiedKFold"] },
    { "a": "Class-balanced sampling", "t": "indist", "aka": ["balanced sampling", "balanced batch sampling", "WeightedRandomSampler", "weighted sampling", "instance-balanced sampling"] },
    { "a": "Anomaly detection", "t": "indist", "aka": ["one-class classification", "novelty detection", "outlier detection"] },
    { "a": "F1 score", "t": "indist", "aka": ["F1", "f-score", "f-measure", "f-beta", "fbeta score"] },
    { "a": "PR AUC", "t": "indist", "aka": ["precision-recall curve", "average precision", "AUPRC", "PR curve", "area under precision-recall curve"] },
    { "a": "Balanced Random Forest", "t": "indist", "aka": ["BRF", "BalancedRandomForestClassifier"] },
    { "a": "Dice loss", "t": "indist", "aka": ["dice", "soft dice", "dice coefficient loss"] },

    { "a": "ADASYN", "t": "overfit", "aka": ["adaptive synthetic sampling", "adaptive synthetic"], "q": "SMOTE that spends its synthetic budget on minority points stranded among the majority. He et al., 2008." },

    { "a": "SMOTE", "t": "baseline", "aka": ["synthetic minority oversampling technique", "synthetic minority over-sampling technique"], "q": "Pick two neighboring minority points and invent one on the line between them. Chawla et al., 2002." },
    { "a": "Random oversampling", "t": "baseline", "aka": ["oversampling", "over-sampling", "upsampling", "ROS", "RandomOverSampler", "minority oversampling"], "q": "Duplicate minority examples until the classes match. Easy, and easy to overfit." },
    { "a": "Random undersampling", "t": "baseline", "aka": ["undersampling", "under-sampling", "downsampling", "RUS", "RandomUnderSampler", "majority undersampling"], "q": "Throw away majority examples until the classes match. Fast, but you lose data." },
    { "a": "Class weighting", "t": "baseline", "aka": ["class weights", "class weight", "class_weight", "weighted loss", "weighted cross-entropy", "inverse frequency weighting", "loss weighting", "reweighting", "sample weights"], "q": "Make minority mistakes cost more. In sklearn it's one argument: class_weight='balanced'." },
    { "a": "Focal loss", "t": "baseline", "aka": ["focal"], "q": "Lin et al., 2017: multiply by (1−p)^γ so easy negatives stop drowning out the rare positives." }
  ]
}
