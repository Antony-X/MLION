{
  "id": "info-theory",
  "pack": "theory",
  "text": "Name an information theory concept used in ML",
  "note": "Measures, bounds, theorems, codes and principles from information theory that show up in ML (entropy, KL, mutual information, perplexity, ...)",
  "strip": ["concept"],
  "answers": [
    { "a": "Bits-back coding", "t": "mlion", "aka": ["bits back", "bits-back", "bits back coding"], "q": "Hinton & van Camp: borrow bits to pick a latent, get them back on decoding. The ELBO is a code length." },

    { "a": "Interaction information", "t": "longtail", "aka": ["co-information"] },
    { "a": "Directed information", "t": "longtail" },
    { "a": "Transfer entropy", "t": "longtail" },
    { "a": "Variation of information", "t": "longtail", "aka": ["VI distance", "shared information distance"], "q": "H(X|Y) + H(Y|X): a true metric between clusterings, courtesy of Meilă." },
    { "a": "Adjusted mutual information", "t": "longtail", "aka": ["AMI"] },
    { "a": "Uncertainty coefficient", "t": "longtail", "aka": ["theil's u", "entropy coefficient"] },
    { "a": "Redundancy", "t": "longtail" },
    { "a": "Typical set", "t": "longtail", "aka": ["AEP", "asymptotic equipartition property", "typicality"], "q": "Almost all long sequences land in a set of about 2^{nH} equally likely ones." },
    { "a": "Binary symmetric channel", "t": "longtail", "aka": ["BSC"] },
    { "a": "Erasure channel", "t": "longtail", "aka": ["binary erasure channel", "BEC"] },
    { "a": "Water-filling", "t": "longtail", "aka": ["water filling", "waterfilling"] },
    { "a": "Blahut–Arimoto", "t": "longtail", "aka": ["blahut arimoto", "blahut-arimoto algorithm"] },
    { "a": "Kraft inequality", "t": "longtail", "aka": ["kraft-mcmillan", "kraft"] },
    { "a": "Prefix codes", "t": "longtail", "aka": ["prefix code", "prefix-free code", "instantaneous code"] },
    { "a": "Shannon–Fano coding", "t": "longtail", "aka": ["shannon-fano", "shannon fano"] },
    { "a": "Lempel–Ziv", "t": "longtail", "aka": ["LZ77", "LZ78", "LZW", "lempel ziv", "lempel-ziv complexity"] },
    { "a": "Tsallis entropy", "t": "longtail", "aka": ["tsallis"] },
    { "a": "Collision entropy", "t": "longtail", "aka": ["renyi-2 entropy", "quadratic entropy"] },
    { "a": "Min-entropy", "t": "longtail", "aka": ["min entropy"] },
    { "a": "Hartley entropy", "t": "longtail", "aka": ["hartley function", "renyi-0 entropy"] },
    { "a": "Von Neumann entropy", "t": "longtail", "aka": ["von neumann", "quantum entropy"] },
    { "a": "Donsker–Varadhan", "t": "longtail", "aka": ["donsker varadhan", "donsker-varadhan representation", "DV bound"] },
    { "a": "NWJ bound", "t": "longtail", "aka": ["nguyen-wainwright-jordan", "NWJ", "f-GAN bound"] },
    { "a": "Barber–Agakov bound", "t": "longtail", "aka": ["barber agakov", "BA bound", "variational information maximization"] },
    { "a": "Empowerment", "t": "longtail", "q": "Channel capacity from your actions to your future states. An intrinsic reward for keeping options open." },
    { "a": "Bayesian surprise", "t": "longtail", "aka": ["surprise"] },
    { "a": "Minimum message length", "t": "longtail", "aka": ["MML", "wallace"] },
    { "a": "Solomonoff induction", "t": "longtail", "aka": ["solomonoff", "universal prior", "algorithmic probability"] },
    { "a": "Error-correcting codes", "t": "longtail", "aka": ["ECC", "channel coding", "hamming code", "hamming codes"] },
    { "a": "Information plane", "t": "longtail", "q": "Tishby's plot of I(X;T) vs I(T;Y) per layer. Do deep nets compress? Still argued over." },

    { "a": "Conditional mutual information", "t": "outlier", "aka": ["CMI"] },
    { "a": "Total correlation", "t": "outlier", "aka": ["multi-information", "multiinformation", "TC"], "q": "KL from the joint to the product of marginals. β-TCVAE penalizes it for disentanglement." },
    { "a": "Normalized mutual information", "t": "outlier", "aka": ["NMI"] },
    { "a": "Information gain ratio", "t": "outlier", "aka": ["gain ratio", "IGR"], "q": "C4.5's fix for ID3's love of features with many values." },
    { "a": "Entropy rate", "t": "outlier" },
    { "a": "Arithmetic coding", "t": "outlier", "aka": ["entropy coding", "range coding"], "q": "Turn a good next-token predictor into a near-optimal compressor. Language modeling is compression." },
    { "a": "Source coding theorem", "t": "outlier", "aka": ["shannon's source coding theorem", "noiseless coding theorem"] },
    { "a": "Noisy-channel coding theorem", "t": "outlier", "aka": ["channel coding theorem", "shannon's theorem", "shannon limit"] },
    { "a": "Data processing inequality", "t": "outlier", "aka": ["DPI"] },
    { "a": "Fano's inequality", "t": "outlier", "aka": ["fano"] },
    { "a": "Pinsker's inequality", "t": "outlier", "aka": ["pinsker"] },
    { "a": "Gibbs' inequality", "t": "outlier", "aka": ["gibbs inequality", "KL is non-negative"] },
    { "a": "InfoNCE", "t": "outlier", "aka": ["info nce", "CPC loss"], "q": "A contrastive lower bound on mutual information, capped at log of the batch size." },
    { "a": "MINE", "t": "outlier", "aka": ["mutual information neural estimation", "mutual information neural estimator"] },
    { "a": "Infomax", "t": "outlier", "aka": ["infomax principle", "mutual information maximization"] },
    { "a": "BALD", "t": "outlier", "aka": ["bayesian active learning by disagreement", "expected information gain", "EIG"] },
    { "a": "Bits per dimension", "t": "outlier", "aka": ["BPD", "bits per character", "BPC", "bits per byte", "BPB", "bits/dim"], "q": "Negative log-likelihood in base 2, divided by dimensions. How image and byte-level models brag." },
    { "a": "ELBO", "t": "outlier", "aka": ["evidence lower bound", "variational free energy", "free energy", "variational lower bound"] },
    { "a": "Negentropy", "t": "outlier", "aka": ["negative entropy"] },
    { "a": "Entropy regularization", "t": "outlier", "aka": ["entropy bonus", "maximum entropy RL", "max-ent RL", "entropy penalty"] },
    { "a": "Information geometry", "t": "outlier", "q": "Amari: statistical models form a manifold, with the Fisher information as its metric." },
    { "a": "Predictive entropy", "t": "outlier", "aka": ["entropy of the predictive distribution"] },
    { "a": "Error-correcting output codes", "t": "outlier", "aka": ["ECOC"], "q": "Dietterich & Bakiri 1995: multiclass as many binary problems, with codewords that tolerate mistakes." },
    { "a": "Bit", "t": "outlier", "aka": ["bits", "binary digit"] },
    { "a": "Nat", "t": "outlier", "aka": ["nats", "natural unit of information"] },

    { "a": "Perplexity", "t": "indist", "aka": ["PPL"], "q": "Exponentiated cross-entropy: how many tokens the model is effectively torn between." },
    { "a": "Conditional entropy", "t": "indist", "aka": ["H(Y|X)"] },
    { "a": "Joint entropy", "t": "indist", "aka": ["H(X,Y)"] },
    { "a": "Information gain", "t": "indist", "aka": ["IG"], "q": "Entropy before the split minus entropy after. ID3 chose splits with it." },
    { "a": "Jensen–Shannon divergence", "t": "indist", "aka": ["JS divergence", "JSD", "jensen-shannon", "information radius"] },
    { "a": "Channel capacity", "t": "indist", "aka": ["capacity", "shannon-hartley", "shannon capacity"] },
    { "a": "Rate–distortion", "t": "indist", "aka": ["rate-distortion theory", "rate distortion", "R(D)", "rate-distortion function"] },
    { "a": "Huffman coding", "t": "indist", "aka": ["huffman", "huffman code"] },
    { "a": "Minimum description length", "t": "indist", "aka": ["MDL"] },
    { "a": "Kolmogorov complexity", "t": "indist", "aka": ["algorithmic information theory", "algorithmic complexity", "kolmogorov"], "q": "The length of the shortest program that prints the data. Uncomputable, inconveniently." },
    { "a": "Fisher information", "t": "indist", "aka": ["fisher information matrix", "FIM"] },
    { "a": "Pointwise mutual information", "t": "indist", "aka": ["PMI", "PPMI", "positive pmi"], "q": "log p(x,y)/p(x)p(y) for a single pair. word2vec is secretly factorizing a shifted PMI matrix." },
    { "a": "Self-information", "t": "indist", "aka": ["surprisal", "information content", "shannon information"] },
    { "a": "Rényi entropy", "t": "indist", "aka": ["renyi entropy", "rényi", "renyi"] },
    { "a": "Differential entropy", "t": "indist", "aka": ["continuous entropy"] },
    { "a": "Maximum entropy", "t": "indist", "aka": ["max ent", "maxent", "principle of maximum entropy", "maximum entropy principle"] },

    { "a": "Information bottleneck", "t": "overfit", "aka": ["IB", "information bottleneck principle", "VIB", "variational information bottleneck", "deep variational information bottleneck"], "q": "Tishby: squeeze X into T, keep what predicts Y. The theory everyone cites to explain deep learning." },

    { "a": "Entropy", "t": "baseline", "aka": ["shannon entropy", "H(X)", "information entropy"] },
    { "a": "Cross-entropy", "t": "baseline", "aka": ["cross entropy", "cross-entropy loss", "log loss", "logarithmic loss", "CE"] },
    { "a": "KL divergence", "t": "baseline", "aka": ["KL", "KLD", "kullback-leibler", "kullback-leibler divergence", "relative entropy"] },
    { "a": "Mutual information", "t": "baseline", "aka": ["MI", "I(X;Y)"] }
  ]
}
