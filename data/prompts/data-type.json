{
  "id": "data-type",
  "pack": "classic",
  "text": "Name a type of data",
  "note": "ML data modalities and statistical or measurement types of data (and common data roles). Not file formats (CSV, Parquet) and not named datasets",
  "strip": ["data", "dataset", "datasets", "type", "types", "kind", "kinds"],
  "answers": [
    { "a": "Event camera", "t": "mlion", "aka": ["event-based", "event based vision", "event-based camera", "event camera data", "neuromorphic", "neuromorphic vision", "DVS", "dynamic vision sensor", "event stream", "event streams", "silicon retina", "address-event"], "q": "No frames: each pixel fires an asynchronous +/- event when its brightness changes, with microsecond timing. The dynamic vision sensor." },

    { "a": "Compositional", "t": "longtail", "aka": ["compositions", "simplex", "log-ratio data", "proportional data"], "q": "Parts of a whole that sum to 1. Aitchison's log-ratio transforms exist because ordinary correlations on it mislead." },
    { "a": "Circular", "t": "longtail", "aka": ["angular", "directional", "cyclic", "cyclical", "periodic", "von Mises"], "q": "Angles and clock times: 359 degrees and 1 degree are neighbours, which an ordinary mean gets wrong." },
    { "a": "Spherical", "t": "longtail", "aka": ["data on a sphere", "sphere-valued", "spherical signals"], "q": "Points on a sphere, like wind directions or full-sky maps. Spherical CNNs were built for it." },
    { "a": "Panoramic images", "t": "longtail", "aka": ["panorama", "panoramas", "360 images", "360-degree images", "omnidirectional images", "equirectangular", "360 degree", "360 video"] },
    { "a": "Truncated", "t": "longtail", "aka": ["left-truncated", "right-truncated", "truncation"], "q": "Cases outside a range never enter the sample at all. Censored data is the milder cousin: you still see that the case exists." },
    { "a": "Zero-inflated", "t": "longtail", "aka": ["zero inflated", "excess zeros", "many zeros"], "q": "Counts with far more zeros than a Poisson allows, like insurance claims or species surveys." },
    { "a": "Functional", "t": "longtail", "aka": ["functional data analysis", "FDA", "curves", "curve data", "functional observations"], "q": "Each observation is a whole curve or surface, such as a growth curve, not a vector of numbers." },
    { "a": "Manifold-valued", "t": "longtail", "aka": ["manifold", "riemannian", "SPD matrices", "symmetric positive definite", "Lie group", "Lie groups"], "q": "Points on a curved space such as rotations or covariance matrices, e.g. diffusion tensors in MRI." },
    { "a": "Persistence diagrams", "t": "longtail", "aka": ["topological", "TDA", "topological data", "persistent homology", "barcodes", "persistence barcodes"], "q": "Birth and death points of holes in a point cloud: the output of topological data analysis." },
    { "a": "Hypergraph", "t": "longtail", "aka": ["hypergraphs", "hyperedges", "higher-order", "higher-order networks"], "q": "Graphs whose edges can join any number of nodes, such as a paper with many co-authors." },
    { "a": "Temporal graph", "t": "longtail", "aka": ["dynamic graph", "dynamic graphs", "evolving graph", "temporal network", "dynamic network", "time-evolving graph", "temporal graphs"] },
    { "a": "Heterogeneous graph", "t": "longtail", "aka": ["heterogeneous information network", "HIN", "heterograph", "multi-relational graph", "typed graph"] },
    { "a": "Scene graph", "t": "longtail", "aka": ["scene graphs", "visual relationships"], "q": "Objects as nodes, relations as edges: 'man riding horse'. Visual Genome popularized it." },
    { "a": "Social network", "t": "longtail", "aka": ["social graph", "social networks", "social media graph", "friendship graph"] },
    { "a": "Spike trains", "t": "longtail", "aka": ["neural spikes", "neural recordings", "electrophysiology", "spiking data", "single-unit recordings", "spike recordings", "neuronal recordings"], "q": "Timestamps of neuron firings from electrodes: the raw material of neural decoding." },
    { "a": "EMG", "t": "longtail", "aka": ["electromyography", "muscle signals", "EMG signals"] },
    { "a": "Eye tracking", "t": "longtail", "aka": ["gaze", "eye movements", "gaze data", "fixations", "eye-tracking", "saccades"] },
    { "a": "Tactile", "t": "longtail", "aka": ["touch", "haptic", "haptics", "tactile sensing", "force sensing", "touch sensor", "touch sensors"], "q": "Contact and pressure maps from skin-like sensors such as GelSight, which robot hands read much like images." },
    { "a": "IMU", "t": "longtail", "aka": ["inertial measurement unit", "accelerometer", "accelerometer data", "gyroscope", "inertial", "motion sensor", "inertial sensor", "inertial sensors"] },
    { "a": "Smart meter", "t": "longtail", "aka": ["energy consumption", "load profile", "load profiles", "electricity consumption", "power consumption", "energy", "electricity load"] },
    { "a": "Radio signals", "t": "longtail", "aka": ["RF", "radio frequency", "wireless signals", "IQ samples", "CSI", "channel state information", "WiFi signals", "RF signals", "radio"], "q": "Raw IQ samples from an antenna. Modulation classification (RadioML) treats them like a 1D image." },
    { "a": "Network traffic", "t": "longtail", "aka": ["packets", "network flows", "netflow", "packet captures", "traffic flows", "network packets"] },
    { "a": "Seismic", "t": "longtail", "aka": ["seismograms", "seismology", "earthquake data", "seismic waveforms", "earthquake waveforms", "seismic signals"] },
    { "a": "Gravitational waves", "t": "longtail", "aka": ["gravitational wave", "gravitational wave strain", "LIGO", "GW strain", "strain data"], "q": "Detector strain time series from LIGO and Virgo, where a black-hole merger is a faint chirp in the noise." },
    { "a": "Light curves", "t": "longtail", "aka": ["lightcurves", "light curve", "stellar brightness", "photometric time series", "transit light curves"], "q": "A star's brightness over time. A periodic dip can mean a planet crossing in front." },
    { "a": "Mass spectrometry", "t": "longtail", "aka": ["mass spectra", "mass spec", "proteomics", "LC-MS", "MS/MS", "mass spectrum"] },
