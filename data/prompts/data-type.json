    { "a": "Continuous", "t": "indist", "aka": ["real-valued", "real valued", "float", "floating point", "floats", "real numbers", "interval-valued"], "q": "Can take any value in a range, like height or temperature." },
    { "a": "Discrete", "t": "indist", "aka": ["integer", "integers", "countable", "whole numbers", "integer-valued"], "q": "Countable, separate values, like number of children." },
    { "a": "Structured", "t": "indist", "aka": ["organized", "schema", "schema-based", "fixed schema", "organised", "database-like"], "q": "Fixed schema in rows and columns: what gradient boosting is best at." },
    { "a": "Unstructured", "t": "indist", "aka": ["free-form", "freeform", "free form", "no schema", "schemaless", "unorganized", "unorganised"], "q": "No predefined schema: text, images, audio. Most of the world's data, and what deep learning handles." },
    { "a": "Labeled", "t": "indist", "aka": ["labelled", "annotated", "supervised", "with labels", "labeled examples", "tagged", "annotations", "labelled examples"], "q": "Inputs paired with answers. What supervised learning needs, and what costs annotator hours." },
    { "a": "Unlabeled", "t": "indist", "aka": ["unlabelled", "unannotated", "unsupervised", "without labels", "unlabeled examples", "untagged", "no labels"], "q": "Inputs with no answers attached: the raw material of self-supervised and clustering methods." },
    { "a": "Multimodal", "t": "indist", "aka": ["multi-modal", "multimedia", "cross-modal", "mixed modality", "multiple modalities", "vision-language", "multimodality", "mixed media", "multi-modality"], "q": "Several kinds of data together, such as image plus text. CLIP, Flamingo and GPT-4V live here." },
    { "a": "Geospatial", "t": "indist", "aka": ["spatial", "geographic", "geographical", "GIS", "geodata", "geo", "geolocation", "location", "location data", "map", "maps", "map data", "geographic information", "coordinates"], "q": "Data tied to places on Earth: coordinates, maps, GIS layers. Nearby points tend to resemble each other." },
    { "a": "Sensor", "t": "indist", "aka": ["IoT", "internet of things", "sensors", "telemetry", "sensor readings", "sensor signals", "iot sensors", "sensor streams", "machine data", "device data", "wearable", "wearables", "wearable sensors"], "q": "Readings from physical devices: temperature, vibration, location. Often noisy, timestamped and multichannel." },
    { "a": "Synthetic", "t": "indist", "aka": ["generated", "artificial", "simulated", "simulation", "fake", "computer generated", "model generated", "AI generated", "procedural", "sim", "LLM-generated", "machine generated", "synthetically generated"], "q": "Made by a program or a model instead of the world, to fill gaps, protect privacy or scale up." },
    { "a": "Medical imaging", "t": "indist", "aka": ["medical images", "radiology", "medical scans", "biomedical imaging", "clinical imaging", "radiological images", "diagnostic imaging", "healthcare images", "biomedical images", "medical"], "q": "X-ray, CT, MRI, ultrasound and pathology images: 3D volumes and gigapixel slides, annotated by expensive experts." },
    { "a": "Genomic", "t": "indist", "aka": ["DNA", "genome", "genomics", "DNA sequences", "genes", "genetic", "nucleotide sequences", "biological sequences", "RNA", "gene sequences", "genetic sequences", "genome sequences", "sequencing data"], "q": "A four-letter alphabet (A, C, G, T) billions of letters long. DNA language models read it like text." },
    { "a": "Speech", "t": "indist", "aka": ["spoken language", "voice", "spoken", "utterances", "speech recordings", "voice recordings", "speech signals", "spoken audio", "speech audio", "voice data", "conversational speech"], "q": "Audio of people talking. Whisper and wav2vec 2.0 turn it into text." },
    { "a": "Music", "t": "indist", "aka": ["songs", "tracks", "musical", "music audio", "song", "recorded music"], "q": "Audio or notation with rhythm, harmony and long-range structure. Used for tagging, transcription and generation." },
    { "a": "Sequential", "t": "indist", "aka": ["sequence", "sequences", "ordered sequences", "serial", "token sequences", "variable-length sequences", "sequence-structured"], "q": "Ordered items where position matters: words, DNA bases, clicks. RNNs and transformers were built for it." },
    { "a": "Missing", "t": "indist", "aka": ["missing values", "incomplete", "nulls", "NaN", "NaNs", "null values", "partially observed", "partial", "gaps", "absent values"], "q": "Blank entries: missing at random or not. Imputing or masking it is a rite of passage." },
    { "a": "Big", "t": "outlier", "aka": ["big data", "large-scale", "large scale", "massive", "large datasets", "huge"], "q": "Too large for one machine's memory. The buzzword behind Hadoop and Spark." },
    { "a": "Satellite imagery", "t": "indist", "aka": ["satellite", "remote sensing", "earth observation", "aerial imagery", "aerial", "overhead imagery", "satellite images", "EO", "drone imagery", "aerial images"], "q": "Overhead images with many spectral bands, used for land cover, crops and disaster mapping." },
    { "a": "3D", "t": "indist", "aka": ["three-dimensional", "3D shapes", "3D models", "3D geometry", "3D scans", "3D objects", "3D spatial", "three dimensional"], "q": "Anything with depth: meshes, point clouds, voxels. No single canonical format, which is why so many exist." },
    { "a": "Training", "t": "outlier", "aka": ["train", "training set", "train set", "trainset", "training sample", "training examples", "train split", "training split"], "q": "The portion the model learns from. Never evaluate on it." },
