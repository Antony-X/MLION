    { "a": "Imbalanced", "t": "indist", "aka": ["class imbalanced", "skewed class distribution", "unbalanced", "imbalance", "class imbalance", "skewed", "imbalanced classes", "rare events"] },
    { "a": "Noisy", "t": "outlier", "aka": ["noise", "corrupted", "dirty", "messy", "noisy labels", "label noise", "unclean", "low quality"] },
    { "a": "Streaming", "t": "indist", "aka": ["stream", "streams", "data streams", "real-time", "real time", "online", "live data", "live"], "q": "Records that keep arriving and can be seen once. Online learning copes with it." },
    { "a": "Raw", "t": "outlier", "aka": ["unprocessed", "original", "uncleaned", "unprocessed data", "as collected"] },
    { "a": "Metadata", "t": "outlier", "aka": ["meta data", "meta-data", "data about data"], "q": "Data about data: timestamps, camera settings, authors, licences, and a classic source of leakage." },
    { "a": "Validation", "t": "outlier", "aka": ["val", "validation set", "dev set", "development set", "dev", "valid", "validation split", "val set"], "q": "The held-out slice you tune on, so the test set stays untouched." },
    { "a": "Interval", "t": "indist", "aka": ["interval scale", "interval-scale", "interval-level"], "q": "Equal steps, but no true zero. 20 C is not twice as hot as 10 C." },
    { "a": "Ratio", "t": "indist", "aka": ["ratio scale", "ratio-scale", "ratio-level"], "q": "Equal steps and a true zero, so 'twice as much' makes sense: height, mass, counts." },
    { "a": "Count", "t": "outlier", "aka": ["counts", "Poisson", "event counts", "frequency", "frequencies", "tally"], "q": "Non-negative integers, such as clicks per hour. Poisson and negative binomial models fit it." },
    { "a": "Censored", "t": "outlier", "aka": ["survival", "time-to-event", "time to event", "right-censored", "interval-censored", "left-censored", "lifetime", "event history", "failure time", "reliability", "duration"], "q": "Time until an event, where some subjects haven't had it yet. Kaplan-Meier and Cox models handle it." },
    { "a": "Longitudinal", "t": "outlier", "aka": ["repeated measures", "repeated-measures", "follow-up", "cohort", "serial measurements", "repeated observations"] },
    { "a": "Cross-sectional", "t": "outlier", "aka": ["cross sectional", "snapshot", "cross-section", "point in time", "single time point"], "q": "Many subjects measured at one moment, with no time dimension." },
    { "a": "Survey", "t": "outlier", "aka": ["questionnaire", "survey responses", "questionnaires", "polls", "poll", "self-reported", "self-report"] },
    { "a": "Observational", "t": "outlier", "aka": ["non-experimental", "retrospective", "passively collected", "observed"], "q": "Recorded without anyone controlling the treatment. Easy to collect, and confounded." },
