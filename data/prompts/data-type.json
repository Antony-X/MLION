    { "a": "Multi-view", "t": "longtail", "aka": ["multiview", "multi-view images", "multiple views", "multi-camera", "multi view", "multi-view data"] },
    { "a": "CAD models", "t": "longtail", "aka": ["CAD", "boundary representation", "B-rep", "brep", "computer-aided design", "engineering models", "parametric CAD"] },
    { "a": "Handwriting", "t": "longtail", "aka": ["handwritten", "handwritten text", "pen strokes", "online handwriting", "ink", "digital ink", "stroke data"], "q": "Pen-stroke sequences or scanned writing. Alex Graves' 2013 handwriting-generating RNN is the classic demo." },
    { "a": "Screenshots", "t": "longtail", "aka": ["UI screenshots", "GUI", "user interfaces", "app screens", "screen recordings", "GUI screenshots", "web UI", "screen captures"] },
