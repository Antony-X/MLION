    { "a": "Image", "t": "baseline", "aka": ["images", "picture", "pictures", "photo", "photos", "photograph", "photographs", "vision", "visual", "computer vision", "pixels", "imagery", "2D image", "RGB", "RGB image", "grayscale", "greyscale", "visual data"], "q": "A grid of pixels, usually three colour channels. The data of CNNs and vision transformers." },
    { "a": "Text", "t": "baseline", "aka": ["texts", "natural language", "language", "NLP", "prose", "written", "strings", "string", "words", "sentences", "textual", "written language", "natural language text", "linguistic"], "q": "Sequences of tokens. Everything language models learn from." },
    { "a": "Audio", "t": "baseline", "aka": ["sound", "sounds", "waveform", "acoustic", "audio signal", "raw audio", "acoustics", "auditory", "audio recordings", "audio waveform"], "q": "A 1D waveform sampled thousands of times a second, or its spectrogram." },
    { "a": "Video", "t": "baseline", "aka": ["videos", "footage", "moving images", "clips", "video clips", "film", "movies", "frames", "video frames", "video sequences"], "q": "Images stacked in time: lots of data per second. Spatial plus temporal structure." },
    { "a": "Tabular", "t": "baseline", "aka": ["table", "tables", "spreadsheet", "spreadsheets", "rows and columns", "dataframe", "data frame", "tabular format", "structured table", "relational table", "feature table", "columnar", "tabulated"], "q": "Rows of samples, columns of features. Gradient-boosted trees still often beat deep nets here." },
    { "a": "Time series", "t": "baseline", "aka": ["temporal", "timeseries", "time-series", "sequential time", "time dependent", "time-dependent", "ts", "temporal sequences", "time-indexed", "forecasting"], "q": "Values indexed by time: prices, sensor readings, demand. Neighbouring points are not independent." },
