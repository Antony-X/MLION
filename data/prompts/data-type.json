    { "a": "Adversarial", "t": "outlier", "aka": ["adversarial examples", "adversarial samples", "adversarial inputs", "adversarial attacks"], "q": "Inputs nudged by tiny, deliberate perturbations to fool a model." },

    { "a": "Ordinal", "t": "indist", "aka": ["ranked categories", "ordered categories", "likert", "likert scale", "graded", "ordinal scale", "ranking scale"], "q": "Categories with a natural order but unequal gaps, like small/medium/large or a 1-5 star rating." },
    { "a": "Nominal", "t": "indist", "aka": ["unordered categories", "nominal scale", "labels without order", "names"], "q": "Categories with no order: colours, countries, blood types." },
