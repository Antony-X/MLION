    { "a": "Histopathology", "t": "longtail", "aka": ["whole slide images", "whole-slide images", "WSI", "pathology slides", "H&E", "pathology", "tissue slides", "digital pathology"], "q": "Gigapixel scans of stained tissue, too big for a GPU, so models work on tiles." },
