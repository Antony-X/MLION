    { "a": "Interactions", "t": "outlier", "aka": ["user-item interactions", "implicit feedback", "user behavior", "user behaviour", "behavioral", "ratings", "explicit feedback", "user-item", "user interactions"], "q": "Who clicked, rated or bought what: the sparse matrix at the heart of recommenders." },
    { "a": "Clickstream", "t": "outlier", "aka": ["click data", "clicks", "web analytics", "browsing data", "click logs", "browsing history", "navigation data", "query logs", "click-through"] },
