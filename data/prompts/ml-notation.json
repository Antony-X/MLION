{
  "id": "ml-notation",
  "pack": "theory",
  "text": "Name a notation or symbol used in ML",
  "note": "Symbols and conventions ML papers write: Greek letters in their usual roles, calculus, linear-algebra, probability and set notation, marks like hats.",
  "strip": ["symbol", "notation", "sign", "operator", "letter", "greek"],
  "answers": [
    { "a": "Stop-gradient (sg)", "t": "mlion", "aka": ["stop gradient", "sg", "stop grad", "detach"], "q": "sg[·]: identity on the way forward, zero gradient on the way back. VQ-VAE and BYOL are built on it." },

    { "a": "Theta (θ)", "t": "baseline", "aka": ["theta"], "q": "θ: every parameter of the model, in one letter." },
    { "a": "Sigma (σ, Σ)", "t": "baseline", "aka": ["sigma", "summation", "sum", "summation sign", "capital sigma"], "q": "σ is a sigmoid or a standard deviation, Σ a sum or a covariance. Context decides." },
    { "a": "Nabla (∇)", "t": "baseline", "aka": ["gradient", "del", "grad", "gradient operator"], "q": "∇θℒ: the gradient of the loss, the one thing every backward pass computes." },
    { "a": "Lambda (λ)", "t": "baseline", "aka": ["lambda"], "q": "λ: how hard the regularizer pulls. Or an eigenvalue." },
    { "a": "Hat (ŷ)", "t": "baseline", "aka": ["hat", "y hat", "theta hat", "circumflex", "caret"], "q": "ŷ is the prediction, θ̂ the estimate: a hat means 'what the model thinks'." },
    { "a": "Alpha (α)", "t": "baseline", "aka": ["alpha"], "q": "α: a learning rate, a significance level, or attention weights." },

    { "a": "Eta (η)", "t": "overfit", "aka": ["eta"], "q": "η: the learning rate, for people who want you to know they read the optimization papers." },
    { "a": "Hadamard product (⊙)", "t": "overfit", "aka": ["hadamard", "element-wise product", "element-wise multiplication", "schur product", "odot", "circle dot"], "q": "⊙: multiply entry by entry. Saying 'Hadamard' instead of 'element-wise' is a power move." },

    { "a": "Epsilon (ε)", "t": "indist", "aka": ["epsilon"], "q": "ε: a tiny constant, the noise a diffusion model predicts, or the exploration rate in ε-greedy." },
    { "a": "Beta (β)", "t": "indist", "aka": ["beta"], "q": "β: Adam's decay rates, the β in β-VAE, or regression coefficients." },
    { "a": "Mu (μ)", "t": "indist", "aka": ["mu"], "q": "μ: the mean, nearly always." },
    { "a": "Gamma (γ)", "t": "indist", "aka": ["gamma"], "q": "γ: the discount factor in RL, or BatchNorm's learned scale." },
    { "a": "Delta (δ)", "t": "indist", "aka": ["delta"], "q": "δ: a small change, a TD error, or the error term in backprop." },
    { "a": "Pi (π)", "t": "indist", "aka": ["pi"], "q": "π: a policy, if you do RL. Otherwise 3.14159." },
    { "a": "Phi (φ)", "t": "indist", "aka": ["phi"], "q": "φ: a feature map or encoder parameters; Φ the normal CDF." },
    { "a": "argmax", "t": "indist", "aka": ["arg max", "argument of the maximum"], "q": "argmax: not the largest value but where it sits. Greedy decoding in one word." },
    { "a": "argmin", "t": "indist", "aka": ["arg min", "argument of the minimum"], "q": "θ* = argmin ℒ(θ): all of training, written in one line." },
    { "a": "Partial derivative (∂)", "t": "indist", "aka": ["partial", "partial d", "curly d", "round d"], "q": "∂ℒ/∂w: how the loss moves when you nudge one weight." },
    { "a": "Expectation (𝔼)", "t": "indist", "aka": ["expectation", "expected value", "expectation operator", "blackboard e", "e[x]", "e"], "q": "𝔼[·]: the average over a distribution. Most losses are an expectation in disguise." },
    { "a": "Transpose (ᵀ)", "t": "indist", "aka": ["transpose", "transposition", "superscript t", "x transpose", "w transpose"], "q": "Wᵀx: half of linear algebra in ML is getting the transposes right." },
    { "a": "Norm (‖·‖)", "t": "indist", "aka": ["l2 norm", "l1 norm", "lp norm", "euclidean norm", "double bars", "vector norm"], "q": "‖w‖²: the thing weight decay keeps small." },
    { "a": "Bar (x̄)", "t": "indist", "aka": ["bar", "x bar", "overline", "overbar"], "q": "x̄: the mean of x. A bar over a letter usually means an average." },
    { "a": "Product (Π)", "t": "indist", "aka": ["product", "capital pi", "big pi", "product sign"], "q": "∏: a likelihood is a product over examples, which is why everyone takes its log." },
    { "a": "Dot product (⟨·,·⟩)", "t": "indist", "aka": ["dot", "inner product", "scalar product", "angle brackets"], "q": "⟨q, k⟩: attention scores are dot products." },
    { "a": "Given (|)", "t": "indist", "aka": ["conditional bar", "conditional", "vertical bar", "pipe", "p(y|x)", "conditional probability"], "q": "p(y | x): read the bar as 'given'." },
    { "a": "Tilde (~)", "t": "indist", "aka": ["sampled from", "distributed as", "distributed according to", "squiggle", "twiddle", "x tilde"], "q": "x ~ 𝒩(0, I): x is drawn from a standard normal." },
    { "a": "Real numbers (ℝ)", "t": "indist", "aka": ["real numbers", "reals", "r", "r^n", "r^d", "blackboard r", "blackboard bold r", "set of real numbers"], "q": "x ∈ ℝᵈ: a vector of d real numbers. The first line of half the papers ever written." },
    { "a": "Normal distribution (𝒩)", "t": "indist", "aka": ["normal distribution", "calligraphic n", "n", "n(0, 1)", "n(0, i)", "n(mu, sigma^2)", "gaussian notation"] },
    { "a": "Loss (ℒ)", "t": "indist", "aka": ["loss", "l", "calligraphic l", "curly l", "script l", "l(theta)", "loss function"], "q": "ℒ(θ): the number training tries to push down." },
    { "a": "W (weights)", "t": "indist", "aka": ["w", "weights", "weight matrix"], "q": "Wx + b: a whole layer in five characters." },
    { "a": "KL divergence (D_KL)", "t": "indist", "aka": ["kl", "dkl", "kl divergence", "kl(p||q)", "kullback-leibler"], "q": "D_KL(p‖q): not symmetric, so the order inside the brackets matters." },
    { "a": "J (cost)", "t": "indist", "aka": ["j", "cost j", "j(theta)", "cost function j", "cost function", "cost"], "q": "J(θ): the cost function, as Andrew Ng's machine learning course writes it." },

    { "a": "Omega (ω, Ω)", "t": "outlier", "aka": ["omega"], "q": "ω: a weight or a frequency; Ω a regularizer or a sample space." },
    { "a": "Tau (τ)", "t": "outlier", "aka": ["tau"], "q": "τ: the softmax temperature, or a whole trajectory in RL." },
    { "a": "Rho (ρ)", "t": "outlier", "aka": ["rho"], "q": "ρ: a correlation, or RMSProp's decay rate." },
    { "a": "Chi (χ)", "t": "outlier", "aka": ["chi", "chi squared", "chi-squared"] },
    { "a": "Kappa (κ)", "t": "outlier", "aka": ["kappa"], "q": "κ: Cohen's kappa, or a condition number." },
    { "a": "Star (θ*)", "t": "outlier", "aka": ["star", "asterisk", "theta star", "x star", "superscript star"], "q": "θ*: the best parameters, the ones training never quite reaches." },
    { "a": "Inverse (⁻¹)", "t": "outlier", "aka": ["inverse", "matrix inverse", "inverse matrix", "superscript minus one", "to the minus one"] },
    { "a": "Integral (∫)", "t": "outlier", "aka": ["integral", "integral sign", "integration"], "q": "∫ p(x) dx = 1: the integral every density has to pass." },
    { "a": "Element of (∈)", "t": "outlier", "aka": ["element of", "belongs to", "member of", "set membership", "is in", "in"] },
    { "a": "Big O (𝒪)", "t": "outlier", "aka": ["big o", "big oh", "big o notation", "o notation", "landau notation"], "q": "𝒪(n²): why long contexts make attention expensive." },
    { "a": "Indicator function (𝟙)", "t": "outlier", "aka": ["indicator function", "indicator", "bold 1", "characteristic function"], "q": "𝟙[y = k]: 1 if true, 0 if not. Cross-entropy picks out the true class with one." },
    { "a": "Kronecker delta (δᵢⱼ)", "t": "outlier", "aka": ["kronecker delta", "delta ij"] },
    { "a": "Dirac delta", "t": "outlier", "aka": ["dirac", "delta function", "dirac delta function"] },
    { "a": "Frobenius norm (‖·‖_F)", "t": "outlier", "aka": ["frobenius norm", "frobenius", "f norm"] },
    { "a": "Trace (tr)", "t": "outlier", "aka": ["trace"] },
    { "a": "Determinant (det)", "t": "outlier", "aka": ["determinant"] },
    { "a": "Outer product (⊗)", "t": "outlier", "aka": ["outer product", "kronecker product", "tensor product", "otimes"] },
    { "a": "Convolution (∗)", "t": "outlier", "aka": ["convolution", "convolution operator", "conv operator"] },
    { "a": "Composition (∘)", "t": "outlier", "aka": ["composition", "function composition", "compose", "circle operator"], "q": "f ∘ g: a deep network is a long chain of compositions." },
    { "a": "Proportional to (∝)", "t": "outlier", "aka": ["proportional to", "proportional", "propto"], "q": "p(θ | D) ∝ p(D | θ) p(θ): Bayes without the normalizer." },
    { "a": "Approximately equal (≈)", "t": "outlier", "aka": ["approximately equal", "approximately", "approx"] },
    { "a": "Infinity (∞)", "t": "outlier", "aka": ["infinity", "inf"] },
    { "a": "Superscript (i)", "t": "outlier", "aka": ["superscript i", "i-th example", "ith example", "example index", "parenthesized superscript"], "q": "x⁽ⁱ⁾: the i-th training example, in brackets so nobody reads it as a power." },
    { "a": "Subscript t (xₜ)", "t": "outlier", "aka": ["subscript t", "time step t", "time index", "x_t", "h_t"] },
    { "a": "Bold for vectors (𝐱)", "t": "outlier", "aka": ["bold", "boldface", "bold x", "bold vector", "bold letters"] },
    { "a": "Q(s, a)", "t": "outlier", "aka": ["q function", "q value", "q", "action value"], "q": "Q(s, a): how good it is to take action a in state s. Q-learning is named after it." },
    { "a": "V(s)", "t": "outlier", "aka": ["value function", "v", "state value"] },
    { "a": "Hessian (∇²)", "t": "outlier", "aka": ["hessian", "nabla squared", "del squared"] },
    { "a": "Jacobian (∂y/∂x)", "t": "outlier", "aka": ["jacobian", "jacobian matrix"] },
    { "a": "Einstein summation", "t": "outlier", "aka": ["einsum", "einstein notation", "summation convention", "einstein summation convention"], "q": "Repeated indices are summed. torch.einsum turns it into code." },
    { "a": "Hidden state (h)", "t": "outlier", "aka": ["h", "hidden state"] },
    { "a": "Latent (z)", "t": "outlier", "aka": ["z", "latent", "latent z", "latent variable"], "q": "z: the latent code a VAE or GAN samples before decoding." },

    { "a": "Psi (ψ)", "t": "longtail", "aka": ["psi"] },
    { "a": "Xi (ξ)", "t": "longtail", "aka": ["xi", "ksi"], "q": "ξ: the slack variables of a soft-margin SVM. Famously hard to write by hand." },
    { "a": "Nu (ν)", "t": "longtail", "aka": ["nu"] },
    { "a": "Zeta (ζ)", "t": "longtail", "aka": ["zeta"] },
    { "a": "Floor (⌊⌋)", "t": "longtail", "aka": ["floor", "floor function"] },
    { "a": "Ceiling (⌈⌉)", "t": "longtail", "aka": ["ceiling", "ceil"] },
    { "a": "For all (∀)", "t": "longtail", "aka": ["for all", "forall", "for every", "universal quantifier"] },
    { "a": "There exists (∃)", "t": "longtail", "aka": ["there exists", "exists", "existential quantifier"] },
    { "a": "Empty set (∅)", "t": "longtail", "aka": ["empty set", "null set"] },
    { "a": "Set minus (∖)", "t": "longtail", "aka": ["set minus", "set difference", "setminus", "backslash"] },
    { "a": "Subset (⊆)", "t": "longtail", "aka": ["subset", "subseteq", "subset of"] },
    { "a": "Union (∪)", "t": "longtail", "aka": ["union", "cup"] },
    { "a": "Intersection (∩)", "t": "longtail", "aka": ["intersection", "cap"] },
    { "a": "Natural numbers (ℕ)", "t": "longtail", "aka": ["natural numbers", "naturals"] },
    { "a": "Integers (ℤ)", "t": "longtail", "aka": ["integers"] },
    { "a": "Maps to (↦)", "t": "longtail", "aka": ["maps to", "mapsto"] },
    { "a": "Arrow (→)", "t": "longtail", "aka": ["arrow", "right arrow", "rightarrow", "tends to", "converges to"] },
    { "a": "Implies (⇒)", "t": "longtail", "aka": ["implies", "implication"] },
    { "a": "Factorial (!)", "t": "longtail", "aka": ["factorial"] },
    { "a": "Binomial coefficient", "t": "longtail", "aka": ["n choose k", "choose", "binomial"] },
    { "a": "Iverson bracket", "t": "longtail", "aka": ["iverson", "iverson notation"], "q": "[P]: 1 when P is true, 0 when it isn't. Knuth made it popular." },
    { "a": "Little o", "t": "longtail", "aka": ["little oh", "small o"] },
    { "a": "Laplacian (Δ)", "t": "longtail", "aka": ["laplacian", "laplace operator"] },
    { "a": "Prime (′)", "t": "longtail", "aka": ["prime", "f prime", "lagrange notation"] },
    { "a": "Dot notation (ẋ)", "t": "longtail", "aka": ["x dot", "newton notation", "newton's notation"] },
    { "a": "Cardinality (|S|)", "t": "longtail", "aka": ["cardinality", "set size"] },
    { "a": "Absolute value (|x|)", "t": "longtail", "aka": ["absolute value", "abs", "modulus"] },
    { "a": "Defined as (:=)", "t": "longtail", "aka": ["defined as", "colon equals", "equals by definition", "definition", "triangleq"] },
    { "a": "Diagonal (diag)", "t": "longtail", "aka": ["diagonal", "diagonal matrix"] },
    { "a": "Bias (b)", "t": "longtail", "aka": ["b", "bias"] },
    { "a": "i.i.d.", "t": "longtail", "aka": ["independent and identically distributed"], "q": "i.i.d.: the assumption under almost every theorem, and broken by almost every real dataset." },
    { "a": "Subject to (s.t.)", "t": "longtail", "aka": ["subject to", "such that"] }
  ]
}
