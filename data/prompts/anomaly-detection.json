{
  "id": "anomaly-detection",
  "pack": "classic",
  "text": "Name an anomaly detection algorithm",
  "note": "Outlier, novelty and out-of-distribution detectors: statistical tests, classical ML, deep, time-series, graph and visual anomaly detection",
  "strip": ["anomaly", "anomalies", "outlier", "outliers", "detection", "detector", "algorithm", "method", "test"],
  "answers": [
    { "a": "Robust Random Cut Forest", "t": "mlion", "aka": ["RRCF", "random cut forest"], "q": "Isolation Forest's streaming cousin: cuts fall in proportion to each feature's range. AWS made it a Kinesis SQL function." },

    { "a": "Peirce's criterion", "t": "longtail", "aka": ["peirce criterion"], "q": "Benjamin Peirce, 1852: maybe the first published outlier rejection rule, written for astronomical observations." },
    { "a": "Tietjen-Moore test", "t": "longtail", "aka": ["tietjen moore"] },
    { "a": "Hampel filter", "t": "longtail", "aka": ["hampel identifier"] },
    { "a": "INFLO", "t": "longtail", "aka": ["influenced outlierness"] },
    { "a": "LDOF", "t": "longtail", "aka": ["local distance-based outlier factor"] },
    { "a": "SOD", "t": "longtail", "aka": ["subspace outlier degree"] },
    { "a": "HiCS", "t": "longtail", "aka": ["high contrast subspaces"] },
    { "a": "SCiForest", "t": "longtail", "aka": ["sci forest", "isolation forest with split-selection criterion"] },
    { "a": "iNNE", "t": "longtail", "aka": ["isolation using nearest neighbour ensembles", "isolation using nearest neighbor ensemble"] },
    { "a": "Deep Isolation Forest", "t": "longtail", "aka": ["DIF"] },
    { "a": "RS-Hash", "t": "longtail", "aka": ["rshash", "randomized subspace hashing"] },
    { "a": "xStream", "t": "longtail" },
    { "a": "LSCP", "t": "longtail", "aka": ["locally selective combination of parallel outlier ensembles"] },
    { "a": "XGBOD", "t": "longtail" },
    { "a": "Kernel PCA", "t": "longtail", "aka": ["kpca", "kernel principal component analysis"] },
    { "a": "f-AnoGAN", "t": "longtail", "aka": ["fast anogan"] },
    { "a": "EGBAD", "t": "longtail", "aka": ["efficient gan-based anomaly detection"] },
    { "a": "ALAD", "t": "longtail", "aka": ["adversarially learned anomaly detection"] },
    { "a": "OCGAN", "t": "longtail", "aka": ["one-class gan"] },
    { "a": "MemAE", "t": "longtail", "aka": ["memory-augmented autoencoder"], "q": "An autoencoder that may only rebuild from a memory of normal patterns, so anomalies come out wrong." },
    { "a": "DROCC", "t": "longtail", "aka": ["deep robust one-class classification"] },
    { "a": "GOAD", "t": "longtail" },
    { "a": "GEOM", "t": "longtail", "aka": ["geometric transformations", "geometric transformation anomaly detection"], "q": "Golan & El-Yaniv: learn to guess which rotation was applied. Anomalies are hard to guess." },
    { "a": "CSI", "t": "longtail", "aka": ["contrasting shifted instances"] },
    { "a": "DevNet", "t": "longtail", "aka": ["deviation networks", "deviation network"] },
    { "a": "NeuTraL AD", "t": "longtail", "aka": ["neural transformation learning"] },
    { "a": "SPADE", "t": "longtail", "aka": ["semantic pyramid anomaly detection"] },
    { "a": "CutPaste", "t": "longtail", "aka": ["cut paste"], "q": "Cut a patch, paste it somewhere else, and train the net to spot the fake defect." },
    { "a": "DRAEM", "t": "longtail", "aka": ["DRÆM", "discriminatively trained reconstruction embedding"] },
    { "a": "FastFlow", "t": "longtail" },
    { "a": "CFlow-AD", "t": "longtail", "aka": ["cflow"] },
    { "a": "DifferNet", "t": "longtail" },
    { "a": "STFPM", "t": "longtail", "aka": ["student-teacher feature pyramid matching"] },
    { "a": "Uninformed Students", "t": "longtail", "aka": ["student-teacher anomaly detection"] },
    { "a": "EfficientAD", "t": "longtail", "aka": ["efficient ad"] },
    { "a": "Reverse distillation", "t": "longtail", "aka": ["RD4AD"] },
    { "a": "SimpleNet", "t": "longtail" },
    { "a": "WinCLIP", "t": "longtail" },
    { "a": "HOT SAX", "t": "longtail", "aka": ["hotsax"] },
    { "a": "MSCRED", "t": "longtail", "aka": ["multi-scale convolutional recurrent encoder-decoder"] },
    { "a": "TranAD", "t": "longtail" },
    { "a": "OddBall", "t": "longtail" },
    { "a": "SpotLight", "t": "longtail" },
    { "a": "DOMINANT", "t": "longtail" },
    { "a": "Fraudar", "t": "longtail" },
    { "a": "MIDAS", "t": "longtail", "aka": ["microcluster-based detector of anomalies in edge streams"] },
    { "a": "OPTICS-OF", "t": "longtail", "aka": ["OPTICS"] },

    { "a": "Extended Isolation Forest", "t": "outlier", "aka": ["EIF", "extended iforest"], "q": "Random hyperplanes instead of axis-aligned cuts. No more ghostly cross-shaped score maps." },
    { "a": "HBOS", "t": "outlier", "aka": ["histogram-based outlier score", "histogram-based outlier detection"] },
    { "a": "COPOD", "t": "outlier", "aka": ["copula-based outlier detection"] },
    { "a": "ECOD", "t": "outlier", "aka": ["empirical cumulative distribution-based outlier detection"] },
    { "a": "ABOD", "t": "outlier", "aka": ["angle-based outlier detection", "FastABOD"] },
    { "a": "COF", "t": "longtail", "aka": ["connectivity-based outlier factor"] },
    { "a": "LoOP", "t": "outlier", "aka": ["local outlier probabilities", "local outlier probability"] },
    { "a": "LOCI", "t": "longtail", "aka": ["local correlation integral"] },
    { "a": "CBLOF", "t": "outlier", "aka": ["cluster-based local outlier factor"] },
    { "a": "Feature bagging", "t": "longtail" },
    { "a": "LODA", "t": "outlier", "aka": ["lightweight on-line detector of anomalies"] },
    { "a": "Half-Space Trees", "t": "outlier", "aka": ["HS-Trees", "HST", "half space tree"] },
    { "a": "Minimum Covariance Determinant", "t": "outlier", "aka": ["MCD", "FastMCD", "MinCovDet"] },
    { "a": "Robust PCA", "t": "outlier", "aka": ["RPCA", "principal component pursuit", "robust principal component analysis"] },
    { "a": "Hotelling's T²", "t": "outlier", "aka": ["hotelling t2", "hotelling t squared", "t-squared"] },
    { "a": "Generalized ESD", "t": "outlier", "aka": ["GESD", "ESD", "generalized extreme studentized deviate", "Rosner test"] },
    { "a": "Dixon's Q test", "t": "outlier", "aka": ["Q test", "dixon test", "dixons q"] },
    { "a": "Chauvenet's criterion", "t": "longtail", "aka": ["chauvenet criterion"] },
    { "a": "Cook's distance", "t": "outlier", "aka": ["cooks d"] },
    { "a": "Benford's law", "t": "outlier", "aka": ["benford", "first-digit law", "newcomb-benford law"], "q": "Leading digits should be 1 about 30% of the time. Cooked books often aren't." },
    { "a": "EWMA control chart", "t": "outlier", "aka": ["EWMA", "exponentially weighted moving average"] },
    { "a": "Holt-Winters", "t": "outlier", "aka": ["holt winters", "triple exponential smoothing", "brutlag"], "q": "Brutlag's 2000 aberrant-behavior detector put Holt-Winters bands into RRDtool." },
    { "a": "ARIMA", "t": "outlier", "aka": ["arima residuals", "autoregressive integrated moving average"] },
    { "a": "SPOT", "t": "outlier", "aka": ["DSPOT", "streaming peaks over threshold", "peaks over threshold", "POT", "extreme value theory", "EVT"] },
    { "a": "Seasonal Hybrid ESD", "t": "outlier", "aka": ["S-H-ESD", "SHESD", "twitter anomalydetection", "twitter anomaly detection"], "q": "Twitter's R package: STL decomposition, then a robust generalized ESD test on the residuals." },
    { "a": "Spectral Residual", "t": "outlier", "aka": ["SR-CNN"] },
    { "a": "Matrix Profile", "t": "outlier", "aka": ["STOMP", "SCRIMP", "STUMPY", "time series discords", "discord discovery"], "q": "Eamonn Keogh's all-pairs trick. The subsequence farthest from its nearest neighbor is the anomaly, a 'discord.'" },
    { "a": "HTM", "t": "outlier", "aka": ["hierarchical temporal memory", "numenta"], "q": "Numenta's neocortex-inspired detector. It also brought us the NAB benchmark." },
    { "a": "LSTM-AD", "t": "outlier", "aka": ["lstm anomaly detection", "lstm autoencoder", "lstm-ed"] },
    { "a": "Telemanom", "t": "outlier", "aka": ["LSTM-NDT"], "q": "NASA JPL's LSTM forecaster for spacecraft telemetry, with nonparametric dynamic thresholds." },
    { "a": "DeepLog", "t": "outlier" },
    { "a": "OmniAnomaly", "t": "longtail" },
    { "a": "USAD", "t": "longtail" },
    { "a": "Anomaly Transformer", "t": "outlier", "aka": ["association discrepancy"] },
    { "a": "AnoGAN", "t": "outlier", "q": "Schlegl et al., 2017: a GAN trained on healthy retinas, then a search for the closest fake to each scan." },
    { "a": "GANomaly", "t": "outlier" },
    { "a": "DAGMM", "t": "outlier", "aka": ["deep autoencoding gaussian mixture model"] },
    { "a": "Deep SAD", "t": "outlier", "aka": ["deep semi-supervised anomaly detection"] },
    { "a": "PatchCore", "t": "outlier", "q": "A memory bank of pretrained patch features, thinned with coresets. It nearly saturated MVTec AD." },
    { "a": "PaDiM", "t": "outlier", "aka": ["patch distribution modeling"] },
    { "a": "ODIN", "t": "outlier", "q": "There are two: Hautamäki's kNN-graph indegree method (2004) and Liang et al.'s temperature-scaled OOD detector (2018)." },
    { "a": "Energy-based OOD detection", "t": "outlier", "aka": ["energy score", "energy-based ood", "energy ood"] },
    { "a": "Outlier Exposure", "t": "outlier" },
    { "a": "Gaussian mixture model", "t": "indist", "aka": ["GMM", "gaussian mixture"] },

    { "a": "IQR", "t": "indist", "aka": ["interquartile range", "Tukey's fences", "tukey fences", "box plot", "boxplot", "1.5 iqr rule", "boxplot rule"], "q": "Anything past 1.5 IQRs from the box is a whisker-jumper. Tukey, 1977." },
    { "a": "Gaussian density estimation", "t": "indist", "aka": ["multivariate gaussian", "gaussian distribution", "gaussian model", "univariate gaussian"], "q": "Fit a Gaussian, flag p(x) < ε. Andrew Ng's anomaly-detection lecture in one line." },
    { "a": "Mahalanobis distance", "t": "indist", "aka": ["mahalanobis"] },
    { "a": "k-NN distance", "t": "indist", "aka": ["kNN", "k-nearest neighbors", "k nearest neighbours", "knn outlier", "distance-based outlier", "nearest neighbor distance"] },
    { "a": "PCA", "t": "indist", "aka": ["principal component analysis", "pca reconstruction error"] },
    { "a": "k-means", "t": "indist", "aka": ["kmeans", "distance to centroid", "k-means clustering"] },
    { "a": "Kernel density estimation", "t": "indist", "aka": ["KDE", "kernel density", "parzen window"] },
    { "a": "Variational autoencoder", "t": "indist", "aka": ["VAE", "vae reconstruction probability"] },
    { "a": "Grubbs' test", "t": "indist", "aka": ["grubbs", "maximum normed residual test"], "q": "Frank Grubbs, 1950: one outlier at a time, and only if your data is normal." },
    { "a": "Modified z-score", "t": "indist", "aka": ["MAD", "median absolute deviation", "robust z-score", "mad z-score"] },
    { "a": "SVDD", "t": "indist", "aka": ["support vector data description"] },
    { "a": "Deep SVDD", "t": "indist", "aka": ["deep support vector data description"], "q": "Ruff et al., 2018: squeeze normal data into the smallest hypersphere possible. Watch out for collapse." },
    { "a": "CUSUM", "t": "indist", "aka": ["cumulative sum", "cumulative sum control chart", "page's cusum"] },
    { "a": "Shewhart control chart", "t": "indist", "aka": ["control chart", "shewhart chart", "statistical process control", "SPC"] },
    { "a": "HDBSCAN", "t": "indist", "aka": ["GLOSH"] },
    { "a": "Maximum softmax probability", "t": "indist", "aka": ["MSP", "softmax baseline", "max softmax"], "q": "Hendrycks & Gimpel, 2017: low confidence might mean out-of-distribution. Every OOD paper's first baseline." },

    { "a": "Elliptic envelope", "t": "overfit", "aka": ["EllipticEnvelope", "robust covariance"], "q": "Assume inliers form one Gaussian blob, fit it robustly, flag whatever falls outside. sklearn's quietest detector." },

    { "a": "Isolation Forest", "t": "baseline", "aka": ["iForest", "IsolationForest", "isolation tree"], "q": "Anomalies are few and different, so random splits isolate them in fewer cuts. Liu, Ting & Zhou, 2008." },
    { "a": "Local Outlier Factor", "t": "baseline", "aka": ["LOF", "LocalOutlierFactor"] },
    { "a": "One-class SVM", "t": "baseline", "aka": ["OCSVM", "one-class support vector machine", "OneClassSVM", "one class svm"] },
    { "a": "Autoencoder", "t": "baseline", "aka": ["AE", "reconstruction error", "autoencoder reconstruction error"] },
    { "a": "DBSCAN", "t": "baseline", "aka": ["density-based spatial clustering of applications with noise"], "q": "Points that fit no dense cluster get labeled noise. Free anomalies." },
    { "a": "Z-score", "t": "baseline", "aka": ["standard score", "three sigma", "3-sigma", "3 sigma rule", "three-sigma rule", "68-95-99.7 rule", "standard deviation"] }
  ]
}
