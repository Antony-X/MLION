    {"a": "M3DM", "t": "longtail", "aka": ["Multi-3D-Memory", "multimodal industrial anomaly detection via hybrid fusion"], "q": "Multi-3D-Memory: hybrid fusion of RGB and point-cloud features for MVTec 3D-AD. Wang et al., CVPR 2023."},
    {"a": "BTF", "t": "longtail", "aka": ["back to the feature"], "q": "Classical, non-deep 3D features plus color beat learned 3D detectors on MVTec 3D-AD. Horwitz & Hoshen, CVPRW 2023."},
    {"a": "Segment Any Anomaly", "t": "longtail", "aka": ["SAA+", "SAA"], "q": "Training-free: assembles foundation models like Segment Anything with hybrid prompts for zero-shot defect masks. Cao et al., 2023."},
