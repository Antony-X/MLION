{
  "id": "gradient-estimator",
  "pack": "theory",
  "text": "Name a gradient estimation trick",
  "note": "Ways to get gradients through sampling or non-differentiable steps (reparameterization, REINFORCE, Gumbel-softmax, straight-through, SPSA, ...)",
  "strip": ["trick", "estimator", "estimators", "gradient", "gradients", "estimation", "method"],
  "answers": [
    { "a": "Sticking the landing", "t": "mlion", "aka": ["STL", "path derivative", "path derivative gradient"], "q": "Roeder, Wu & Duvenaud: drop the score term and the variance hits zero as q nails the posterior." },

    { "a": "REBAR", "t": "longtail", "q": "REINFORCE + concrete relaxation as a control variate. Unbiased and low variance." },
    { "a": "RELAX", "t": "longtail", "q": "REBAR's sequel: learn the control variate with a neural net. Then RELAX." },
    { "a": "NVIL", "t": "longtail", "aka": ["neural variational inference and learning"] },
    { "a": "MuProp", "t": "longtail" },
    { "a": "VIMCO", "t": "longtail" },
    { "a": "ARM", "t": "longtail", "aka": ["augment-reinforce-merge"] },
    { "a": "DisARM", "t": "longtail" },
    { "a": "DiCE", "t": "longtail", "aka": ["infinitely differentiable monte carlo"] },
    { "a": "Implicit reparameterization", "t": "longtail", "aka": ["implicit reparameterization gradients", "implicit reparametrization"] },
    { "a": "Generalized reparameterization", "t": "longtail", "aka": ["G-REP", "generalized reparametrization"] },
    { "a": "Acceptance-rejection reparameterization", "t": "longtail", "aka": ["rejection sampling reparameterization", "RSVI"] },
    { "a": "Measure-valued derivative", "t": "longtail", "aka": ["measure-valued gradient", "weak derivative"], "q": "Write the derivative of a density as the difference of two densities. Low variance, many samples." },
    { "a": "Doubly reparameterized gradients", "t": "longtail", "aka": ["DReG", "doubly reparameterized"] },
    { "a": "Flipout", "t": "longtail", "q": "Random sign flips decorrelate weight perturbations across a minibatch. Cheap pseudo-independence." },
    { "a": "Hard concrete", "t": "longtail", "q": "Stretch a binary concrete, clip it to [0,1]. Louizos et al.'s route to L0 regularization." },
    { "a": "Gumbel-Sinkhorn", "t": "longtail", "aka": ["gumbel sinkhorn"] },
    { "a": "Gumbel-top-k", "t": "longtail", "aka": ["gumbel top k"] },
    { "a": "Stochastic softmax tricks", "t": "longtail", "aka": ["stochastic softmax"] },
    { "a": "ReinMax", "t": "longtail" },
    { "a": "Perturbed optimizers", "t": "longtail", "aka": ["perturbed argmax", "differentiable perturbed optimizers", "perturbed optimizer"] },
    { "a": "I-MLE", "t": "longtail", "aka": ["implicit MLE", "implicit maximum likelihood estimation"] },
    { "a": "Blackbox differentiation", "t": "longtail", "aka": ["blackbox backprop", "differentiation of blackbox combinatorial solvers"] },
    { "a": "Stein gradient estimator", "t": "longtail", "aka": ["stein", "spectral stein"] },
    { "a": "Persistent evolution strategies", "t": "longtail", "aka": ["PES"] },
    { "a": "MeZO", "t": "longtail", "q": "Fine-tune an LLM with two forward passes and no backward. SPSA, rediscovered at scale." },
    { "a": "Complex-step differentiation", "t": "longtail", "aka": ["complex step", "complex-step derivative"] },
    { "a": "Kiefer–Wolfowitz", "t": "longtail", "aka": ["kiefer wolfowitz"] },

    { "a": "SPSA", "t": "outlier", "aka": ["simultaneous perturbation stochastic approximation", "simultaneous perturbation"], "q": "Perturb every parameter at once, two evals per step. Spall's 1992 trick." },
    { "a": "Gumbel-max", "t": "outlier", "aka": ["gumbel max"], "q": "argmax(log p + Gumbel noise) is an exact categorical sample. The trick underneath Gumbel-softmax." },
    { "a": "Local reparameterization", "t": "outlier", "aka": ["local reparametrization", "local reparameterization trick"], "q": "Sample the pre-activations, not the weights. Less variance, and it gave us variational dropout." },
    { "a": "NES", "t": "outlier", "aka": ["natural evolution strategies"] },
    { "a": "Zeroth-order", "t": "outlier", "aka": ["zeroth order", "ZO", "gaussian smoothing", "random gradient-free", "derivative-free gradient"] },
    { "a": "Forward gradient", "t": "outlier", "aka": ["forward-mode gradient", "gradients without backpropagation"], "q": "One forward-mode JVP along a random direction. Unbiased, no backprop required." },
    { "a": "Synthetic gradients", "t": "outlier", "aka": ["decoupled neural interfaces", "DNI"], "q": "A little net predicts the gradient so layers don't have to wait for backprop." },
    { "a": "Surrogate gradient", "t": "outlier", "aka": ["surrogate"] },
    { "a": "RLOO", "t": "outlier", "aka": ["REINFORCE leave-one-out", "leave-one-out baseline", "LOO baseline"], "q": "Each sample's baseline is the mean of the others. Old trick, now standard in LLM RL." },
    { "a": "GAE", "t": "outlier", "aka": ["generalized advantage estimation"] },

    { "a": "Straight-through Gumbel-softmax", "t": "indist", "aka": ["ST gumbel", "straight-through gumbel", "hard gumbel softmax", "ST gumbel-softmax"] },
    { "a": "Implicit differentiation", "t": "indist", "aka": ["implicit function theorem", "IFT"], "q": "Differentiate the fixed point, not the solver's 1000 steps. DEQs and bilevel HPO run on it." },
    { "a": "Rao-Blackwellization", "t": "indist", "aka": ["rao-blackwellized", "rao blackwell"] },
    { "a": "Antithetic sampling", "t": "indist", "aka": ["antithetic", "antithetic variates", "mirrored sampling"] },
    { "a": "Importance sampling", "t": "indist", "aka": ["importance weighting", "importance-weighted"] },
    { "a": "Finite differences", "t": "indist", "aka": ["numerical differentiation", "central differences", "forward differences", "numerical gradient"], "q": "(f(x+h) − f(x−h))/2h. The gradient check every backprop homework makes you write." },
    { "a": "Control variates", "t": "indist", "aka": ["baseline", "control variate", "baseline subtraction"], "q": "Subtract something with known mean that's correlated with your estimate. Variance drops, bias doesn't move." },

    { "a": "Evolution strategies", "t": "overfit", "aka": ["ES", "OpenAI ES", "evolution strategy"], "q": "Salimans et al. 2017: perturb weights, score them, average. Embarrassingly parallel." },

    { "a": "Reparameterization", "t": "baseline", "aka": ["reparametrization", "reparameterization trick", "reparam", "pathwise", "pathwise derivative"], "q": "z = μ + σ·ε. Move the randomness outside and backprop straight through. Kingma & Welling's gift." },
    { "a": "REINFORCE", "t": "baseline", "aka": ["score function", "likelihood ratio", "log-derivative", "log derivative trick", "williams", "policy gradient"], "q": "∇ log p times the reward. Unbiased, works on anything, variance like a slot machine." },
    { "a": "Gumbel-softmax", "t": "baseline", "aka": ["gumbel softmax", "concrete", "concrete distribution", "concrete relaxation", "relaxed bernoulli", "binary concrete"], "q": "Add Gumbel noise, softmax with a temperature: a differentiable stand-in for a discrete sample." },
    { "a": "Straight-through", "t": "baseline", "aka": ["STE", "straight through", "straight-through estimator"], "q": "Round on the way forward, pretend you didn't on the way back. Hinton's lecture hack, Bengio's paper." }
  ]
}
