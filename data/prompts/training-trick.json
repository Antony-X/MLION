{
  "id": "training-trick",
  "pack": "blocks",
  "text": "Name a deep learning training trick",
  "note": "Practical techniques that make training work or work better: stability, speed, memory, regularization, schedules, init. Not plain optimizers.",
  "strip": ["trick", "tricks", "training", "technique"],
  "answers": [
    { "a": "Model soups", "t": "mlion", "aka": ["model soup", "greedy soup", "uniform soup", "weight soup"], "q": "Average the weights of many fine-tunes into one model. Same inference cost, better accuracy. Bon appétit." },

    { "a": "Gradient clipping", "t": "baseline", "aka": ["grad clipping", "clip grad norm", "clip_grad_norm", "gradient norm clipping", "clipping", "clip by value", "gradient value clipping", "norm clipping", "gradient clipping by norm", "gradient clipping by value", "global norm clipping", "global gradient norm clipping"], "q": "The seatbelt for RNNs since Pascanu et al. 2013. Now standard for every LLM run." },
    { "a": "Learning rate warmup", "t": "baseline", "aka": ["warmup", "warm-up", "lr warmup", "linear warmup", "gradual warmup", "learning rate warm-up"], "q": "Start tiny and ramp up, so early giant gradients and fresh Adam statistics don't wreck the weights." },
    { "a": "Learning rate scheduling", "t": "baseline", "aka": ["lr schedule", "learning rate schedule", "lr scheduling", "learning rate decay", "lr decay", "learning rate annealing", "annealing", "scheduler", "lr scheduler"], "q": "Change the learning rate as training goes: usually a short warm-up, then a decay." },
    { "a": "Dropout", "t": "baseline", "aka": ["dropout regularization"], "q": "Hinton's idea: randomly silence neurons so none can freeload on the others." },
    { "a": "Batch normalization", "t": "baseline", "aka": ["batch norm", "batchnorm", "BN"], "q": "Ioffe & Szegedy blamed 'internal covariate shift'. The fix stuck; the explanation didn't." },
    { "a": "Early stopping", "t": "baseline", "aka": ["early stop", "stopping early"], "q": "The cheapest regularizer there is: stop when validation loss stops improving." },
    { "a": "Data augmentation", "t": "baseline", "aka": ["augmentation", "data augmentations", "augmenting data"], "q": "Train on transformed copies (flips, crops, noise) so the model learns what doesn't change the label." },

    { "a": "Label smoothing", "t": "overfit", "aka": ["label smoothing regularization", "LSR", "soft labels", "smoothed labels"], "q": "Tell the model the right answer is only 90% right. Szegedy et al.'s cure for overconfidence." },

    { "a": "Mixed precision", "t": "indist", "aka": ["AMP", "automatic mixed precision", "FP16", "FP16 training", "half precision", "mixed-precision training", "fp16 mixed precision"], "q": "FP16 math, FP32 master weights, loss scaling to rescue tiny gradients. Micikevicius et al. 2018." },
    { "a": "Gradient accumulation", "t": "indist", "aka": ["grad accumulation", "accumulating gradients", "accumulation steps", "virtual batch size", "gradient accumulation steps"], "q": "Fake a big batch on a small GPU: sum gradients over k micro-batches, then step." },
    { "a": "Weight decay", "t": "indist", "aka": ["L2 regularization", "L2 penalty", "wd", "L2 weight decay"] },
    { "a": "EMA", "t": "indist", "aka": ["exponential moving average", "model EMA", "weight EMA", "EMA of weights", "Polyak averaging", "Polyak-Ruppert averaging"], "q": "Keep a slow-moving copy of the weights and evaluate that instead. Diffusion models swear by it." },
    { "a": "Gradient checkpointing", "t": "indist", "aka": ["activation checkpointing", "rematerialization", "checkpointing", "activation recomputation", "selective recomputation", "recompute", "gradient checkpoint"], "q": "Store fewer activations, recompute them in backward. Sublinear memory for one extra forward pass." },
    { "a": "Cosine annealing", "t": "indist", "aka": ["cosine schedule", "cosine decay", "cosine learning rate", "CosineAnnealingLR", "cosine lr"] },
    { "a": "Step decay", "t": "indist", "aka": ["step schedule", "StepLR", "MultiStepLR", "piecewise constant schedule", "step lr", "multi-step decay"] },
    { "a": "One-cycle policy", "t": "indist", "aka": ["one cycle", "1cycle", "OneCycleLR", "super-convergence", "one-cycle schedule"], "q": "Leslie Smith's one big LR hill, up then down. Super-convergence on a budget." },
    { "a": "Cyclical learning rates", "t": "indist", "aka": ["CLR", "cyclic lr", "CyclicLR", "triangular schedule", "cyclical lr", "cyclical learning rate", "cyclic learning rate"] },
    { "a": "ReduceLROnPlateau", "t": "indist", "aka": ["reduce lr on plateau", "plateau scheduler", "reduce on plateau", "plateau decay"] },
    { "a": "Exponential decay", "t": "indist", "aka": ["ExponentialLR", "exponential lr", "exponential schedule"] },
    { "a": "Stochastic weight averaging", "t": "indist", "aka": ["SWA", "weight averaging"], "q": "Average the weights visited late in training with a high constant or cyclic LR. Flatter minima, free." },
    { "a": "Mixup", "t": "indist", "aka": ["mix-up", "input mixup"] },
    { "a": "Transfer learning", "t": "indist", "aka": ["fine-tuning", "finetuning", "fine tuning", "pretraining", "pre-training", "pretrained weights", "warm start", "warm starting", "self-supervised pretraining", "contrastive pretraining", "unsupervised pretraining"] },
    { "a": "Layer normalization", "t": "indist", "aka": ["layer norm", "layernorm", "LN"] },
    { "a": "Residual connections", "t": "indist", "aka": ["skip connections", "residuals", "shortcut connections", "identity shortcuts", "residual learning"] },
    { "a": "Weight initialization", "t": "indist", "aka": ["initialization", "proper initialization", "careful initialization", "good initialization", "weight init", "init", "truncated normal initialization"] },
    { "a": "Xavier initialization", "t": "indist", "aka": ["Glorot initialization", "Xavier init", "Glorot", "Xavier", "Glorot init"] },
    { "a": "He initialization", "t": "indist", "aka": ["Kaiming initialization", "Kaiming init", "He init", "Kaiming", "MSRA initialization"] },
    { "a": "Curriculum learning", "t": "indist", "aka": ["curriculum"], "q": "Bengio et al. 2009: easy examples first, like school. Works sometimes, which is also like school." },
    { "a": "Knowledge distillation", "t": "indist", "aka": ["distillation", "KD", "teacher-student", "model distillation", "dark knowledge", "online distillation"], "q": "Hinton, Vinyals & Dean 2015: train the student on the teacher's softened probabilities. Dark knowledge." },
    { "a": "Data shuffling", "t": "indist", "aka": ["shuffling", "shuffle", "shuffle every epoch", "random shuffling"] },
    { "a": "Input normalization", "t": "indist", "aka": ["feature scaling", "standardization", "normalize inputs", "mean subtraction", "feature normalization", "z-score normalization", "data normalization"] },
    { "a": "Teacher forcing", "t": "indist", "aka": ["teacher-forcing"] },
    { "a": "Class weighting", "t": "indist", "aka": ["class weights", "weighted loss", "loss reweighting", "cost-sensitive learning", "reweighting", "class-balanced loss"] },
    { "a": "Oversampling", "t": "indist", "aka": ["resampling", "undersampling", "class-balanced sampling", "balanced sampling", "weighted sampling", "minority oversampling", "SMOTE"] },
    { "a": "Test-time augmentation", "t": "indist", "aka": ["TTA", "test time augmentation"] },
    { "a": "LoRA", "t": "indist", "aka": ["low-rank adaptation", "low rank adaptation"] },
    { "a": "FlashAttention", "t": "indist", "aka": ["flash attention", "FlashAttention-2", "FlashAttention-3", "memory-efficient attention", "fused attention"], "q": "Same exact attention, tiled to live in SRAM. The speedup came from respecting the memory hierarchy." },
    { "a": "Data parallelism", "t": "indist", "aka": ["DDP", "distributed data parallel", "data parallel", "DataParallel", "distributed training"] },
    { "a": "Freezing layers", "t": "indist", "aka": ["layer freezing", "freezing", "freeze backbone", "frozen backbone", "freeze layers"] },
    { "a": "Experience replay", "t": "indist", "aka": ["replay buffer", "replay memory"], "q": "Replay shuffled past transitions to break correlations. Lin's 1992 idea, DQN's backbone." },

    { "a": "Learning rate finder", "t": "outlier", "aka": ["LR finder", "LR range test", "lr_find", "learning rate range test"], "q": "Ramp the LR exponentially over a few hundred steps, pick where loss falls fastest. fast.ai made it famous." },
    { "a": "Linear scaling rule", "t": "outlier", "aka": ["linear lr scaling", "learning rate scaling rule", "large batch training", "linear scaling"], "q": "Batch ×k, LR ×k, plus warmup. Goyal et al. trained ImageNet in an hour with it." },
    { "a": "SGDR", "t": "outlier", "aka": ["warm restarts", "cosine annealing with warm restarts", "CosineAnnealingWarmRestarts", "stochastic gradient descent with warm restarts"] },
    { "a": "Inverse square root schedule", "t": "outlier", "aka": ["inverse sqrt", "Noam schedule", "rsqrt decay", "transformer schedule", "Noam"], "q": "Attention Is All You Need's warmup then 1/√step decay, nicknamed after Noam Shazeer." },
    { "a": "WSD schedule", "t": "outlier", "aka": ["warmup-stable-decay", "WSD", "trapezoidal schedule", "learning rate cooldown", "cooldown"], "q": "Warm up, hold flat, decay at the end. Branch off checkpoints without fixing the horizon up front." },
    { "a": "Loss scaling", "t": "outlier", "aka": ["dynamic loss scaling", "GradScaler", "static loss scaling", "gradient scaling"] },
    { "a": "BF16", "t": "outlier", "aka": ["bfloat16", "bf16 training", "brain float", "bfloat16 training"] },
    { "a": "Adaptive gradient clipping", "t": "outlier", "aka": ["AGC"], "q": "Clip by the gradient-to-weight norm ratio, per unit. Let NFNets ditch batch norm." },
    { "a": "QK-norm", "t": "outlier", "aka": ["query-key normalization", "QK layernorm", "QK layer norm", "qk normalization"], "q": "Normalize queries and keys before the dot product. ViT-22B needed it to stop attention logits exploding." },
    { "a": "z-loss", "t": "outlier", "aka": ["softmax z-loss", "router z-loss", "auxiliary z-loss", "z loss"], "q": "Penalize log²Z of the output softmax so logits stay near zero. PaLM used a 1e-4 coefficient." },
    { "a": "Zero-init residual", "t": "outlier", "aka": ["zero gamma", "zero-init last BN gamma", "zero init residual", "zero-initialized residual branches", "zero-init"], "q": "Init each block's last BN γ to zero, so every residual block starts out as the identity." },
    { "a": "LayerScale", "t": "outlier", "aka": ["layer scale"] },
    { "a": "muP", "t": "outlier", "aka": ["μP", "maximal update parametrization", "mu-parametrization", "μTransfer", "muTransfer", "maximal update parameterization"], "q": "Parametrize so the best learning rate stops depending on width. Tune small, transfer big." },
    { "a": "Orthogonal initialization", "t": "outlier", "aka": ["orthogonal init", "orthogonal weights"] },
    { "a": "Forget gate bias", "t": "outlier", "aka": ["forget gate bias init", "forget bias 1", "LSTM forget bias", "forget gate bias of 1"], "q": "Set it to 1 so LSTMs remember by default. Gers et al. 2000; rediscovered by Jozefowicz et al. 2015." },
    { "a": "Spectral normalization", "t": "outlier", "aka": ["spectral norm", "SN"] },
    { "a": "Gradient penalty", "t": "outlier", "aka": ["WGAN-GP", "GP", "gradient norm penalty"] },
    { "a": "Group normalization", "t": "outlier", "aka": ["group norm", "GroupNorm", "GN"] },
