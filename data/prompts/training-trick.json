    { "a": "Hard example mining", "t": "outlier", "aka": ["OHEM", "hard negative mining", "online hard example mining", "hard mining", "triplet mining", "semi-hard mining", "semi-hard negative mining", "batch-hard mining"] },
    { "a": "Focal loss", "t": "outlier", "aka": ["focal"] },
    { "a": "Scheduled sampling", "t": "outlier", "aka": ["curriculum sampling"], "q": "Gradually feed the decoder its own predictions instead of the ground truth. Exposure bias, scheduled away." },
    { "a": "Truncated BPTT", "t": "outlier", "aka": ["TBPTT", "truncated backpropagation through time", "truncated backprop"] },
    { "a": "Gradual unfreezing", "t": "outlier", "aka": ["progressive unfreezing"] },
    { "a": "Discriminative learning rates", "t": "outlier", "aka": ["LLRD", "layer-wise learning rate decay", "layerwise lr decay", "discriminative fine-tuning", "differential learning rates", "layer-wise learning rates", "layer decay", "discriminative learning rate"], "q": "ULMFiT's idea: lower layers hold general features, so give them smaller learning rates." },
