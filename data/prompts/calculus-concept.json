{
  "id": "calculus-concept",
  "pack": "theory",
  "text": "Name a calculus concept used in ML",
  "note": "Concepts from calculus, real analysis and convex analysis that ML relies on. Optimizer algorithms (Adam, Newton, SGD) belong to other prompts",
  "strip": ["concept"],
  "answers": [
    { "a": "Dual numbers", "t": "mlion", "aka": ["Dual number", "Clifford dual numbers"], "q": "Numbers a + b*eps with eps^2 = 0. Evaluate f(a + eps) and the eps part is f'(a): forward-mode autodiff in one line." },

    { "a": "Gradient", "t": "baseline", "aka": ["Gradient vector", "Gradients", "Nabla", "Del", "Grad"], "q": "Points toward steepest ascent and is perpendicular to the level sets. Reverse-mode autodiff gets every entry in one backward pass." },
    { "a": "Derivative", "t": "baseline", "aka": ["Derivatives", "Differentiation", "Rate of change", "Instantaneous rate of change"], "q": "PyTorch defines ReLU's derivative at 0 as 0, even though it does not exist there." },
    { "a": "Partial derivative", "t": "baseline", "aka": ["Partial derivatives", "Partial differentiation"], "q": "Backprop's output is a long list of partial derivatives of the loss, one per weight." },
    { "a": "Chain rule", "t": "baseline", "aka": ["Chain rule of calculus", "Multivariate chain rule", "Chain rule for derivatives", "Multivariable chain rule"], "q": "Backpropagation is the chain rule applied in reverse order, with the intermediate values cached." },
    { "a": "Jacobian", "t": "baseline", "aka": ["Jacobian matrix", "Jacobi matrix"], "q": "Named for Carl Jacobi. Its determinant is the volume-change factor in a change of variables, as used in normalizing flows." },
    { "a": "Hessian", "t": "baseline", "aka": ["Hessian matrix", "Hessian of the loss"], "q": "Named for Ludwig Otto Hesse. A model with a billion parameters has 10^18 entries, so nobody forms it." },
    { "a": "Taylor series", "t": "baseline", "aka": ["Taylor", "Taylor expansion", "Taylor approximation", "Taylor's theorem", "Taylor polynomial", "Taylor series expansion", "Second-order approximation"], "q": "Gradient descent trusts a first-order Taylor model of the loss. Newton's method uses the second-order one." },

    { "a": "Lagrange multipliers", "t": "overfit", "aka": ["Lagrange", "Lagrange multiplier", "Method of Lagrange multipliers", "Lagrangian multipliers", "Lagrange multiplier method"], "q": "From Lagrange's 1788 Mécanique analytique. SVMs, PCA and maximum entropy all fall out of it." },
    { "a": "KKT conditions", "t": "overfit", "aka": ["Karush-Kuhn-Tucker", "KKT", "Karush Kuhn Tucker conditions", "KKT condition"], "q": "Karush derived them in his 1939 master's thesis. They became known after Kuhn and Tucker in 1951." },
    { "a": "Lipschitz continuity", "t": "overfit", "aka": ["Lipschitz", "Lipschitz constant", "Lipschitz function", "Lipschitz condition", "Lipschitz continuous", "K-Lipschitz"], "q": "WGAN needs a 1-Lipschitz critic, hence weight clipping, then gradient penalty, then spectral normalization." },

    { "a": "Integral", "t": "indist", "aka": ["Integration", "Definite integral", "Integrals", "Integral calculus"], "q": "Expectations, marginal likelihoods and normalizing constants are all integrals, and most have no closed form." },
    { "a": "Convexity", "t": "indist", "aka": ["Convex function", "Convex functions", "Convex", "Convex optimization"], "q": "For a convex function every local minimum is a global one." },
    { "a": "Directional derivative", "t": "indist", "aka": ["Directional derivatives"], "q": "A Jacobian-vector product is a directional derivative, which is what forward-mode autodiff computes." },
    { "a": "Automatic differentiation", "t": "indist", "aka": ["Autodiff", "AD", "Algorithmic differentiation", "Autograd"], "q": "Neither symbolic nor numerical: it applies the chain rule to the program's elementary operations." },
    { "a": "Saddle point", "t": "indist", "aka": ["Saddle points", "Saddle"], "q": "In high dimensions most critical points of a loss are saddles, not local minima (Dauphin et al., 2014)." },
    { "a": "Local minimum", "t": "indist", "aka": ["Local minima", "Local optimum", "Local min"] },
    { "a": "Global minimum", "t": "indist", "aka": ["Global optimum", "Global minima", "Global min"] },
    { "a": "Critical point", "t": "indist", "aka": ["Stationary", "Stationary point", "Stationary points", "Critical points"] },
    { "a": "Second derivative test", "t": "indist", "aka": ["Second-order condition", "Second derivative", "Second-order sufficient condition"] },
    { "a": "Product rule", "t": "indist", "aka": ["Leibniz product rule"] },
    { "a": "Reverse-mode differentiation", "t": "indist", "aka": ["Reverse mode", "Reverse-mode autodiff", "Reverse mode automatic differentiation", "Backpropagation", "Backprop"], "q": "Gives the full gradient of a scalar function for a small constant multiple of the cost of one forward evaluation." },
    { "a": "Forward-mode differentiation", "t": "indist", "aka": ["Forward mode", "Forward-mode autodiff", "Forward mode automatic differentiation"], "q": "The cost grows with the number of inputs, so it suits few inputs and many outputs." },
    { "a": "Linearization", "t": "indist", "aka": ["Tangent", "Linear approximation", "Tangent line approximation", "First-order approximation", "First-order Taylor approximation", "Tangent line"] },
    { "a": "Limit", "t": "indist", "aka": ["Limits", "Epsilon-delta", "Epsilon delta definition"] },
    { "a": "Continuity", "t": "indist", "aka": ["Continuous function", "Continuous functions"] },
    { "a": "Differentiability", "t": "indist", "aka": ["Differentiable", "Differentiable function", "Differentiable functions"] },
    { "a": "Laplacian", "t": "indist", "aka": ["Laplace operator", "Laplacian operator", "Del squared"], "q": "The sum of the second partial derivatives: the divergence of the gradient." },
    { "a": "Finite differences", "t": "indist", "aka": ["Numerical differentiation", "Finite difference", "Finite difference method", "Numerical derivative", "Central difference", "Forward difference"], "q": "Truncation and rounding errors trade off. For central differences the best step is about the cube root of machine epsilon." },
    { "a": "Strong convexity", "t": "indist", "aka": ["Strongly convex"], "q": "Gives gradient descent a linear convergence rate." },
    { "a": "Smoothness", "t": "indist", "aka": ["L-smoothness", "L-smooth", "Smooth function", "Smooth functions", "Lipschitz gradient"], "q": "With step size 1/L, gradient descent on an L-smooth function is guaranteed to decrease the loss." },
    { "a": "Extrema", "t": "indist", "aka": ["Extreme values", "Maxima and minima", "Minima and maxima", "Maxima", "Minima", "Optima", "Optimum"] },

    { "a": "Jacobian determinant", "t": "outlier", "aka": ["Jacobian det", "Determinant of the Jacobian"], "q": "Normalizing flows are built to make it cheap, for example with the triangular Jacobians of RealNVP." },
    { "a": "Change of variables", "t": "outlier", "aka": ["Change of variables formula", "Change of variable", "Variable substitution", "u-substitution", "Substitution rule"] },
    { "a": "Total derivative", "t": "outlier", "aka": ["Total differential", "Differential"] },
    { "a": "Matrix calculus", "t": "outlier", "aka": ["Matrix derivatives", "Matrix differentiation"], "q": "Numerator versus denominator layout is a classic source of transposed gradients." },
    { "a": "Subgradient", "t": "outlier", "aka": ["Subgradients"], "q": "ReLU and the hinge loss have kinks, so frameworks pick a subgradient there." },
    { "a": "Mean value theorem", "t": "outlier", "aka": ["MVT"] },
    { "a": "Fundamental theorem of calculus", "t": "outlier", "aka": ["FTC", "Fundamental theorem"] },
    { "a": "Integration by parts", "t": "outlier", "aka": ["Integral by parts", "By parts"], "q": "Score matching uses it to get rid of the unknown data score." },
    { "a": "Level set", "t": "outlier", "aka": ["Level sets", "Contour line", "Contour lines", "Level curve", "Isoline"] },
    { "a": "Vector field", "t": "outlier", "aka": ["Gradient field", "Vector fields"] },
    { "a": "Divergence", "t": "outlier", "aka": ["Divergence of a vector field", "Vector divergence"] },
    { "a": "Curl", "t": "outlier", "aka": ["Curl of a vector field"] },
    { "a": "Quotient rule", "t": "outlier", "aka": ["Quotient rule for derivatives"] },
    { "a": "Power rule", "t": "outlier", "aka": ["Power rule for derivatives"] },
    { "a": "Maclaurin series", "t": "outlier", "aka": ["Maclaurin expansion"] },
    { "a": "Power series", "t": "outlier", "aka": ["Series expansion"] },
    { "a": "Euler's method", "t": "outlier", "aka": ["Euler method", "Forward Euler", "Euler step"], "q": "A residual connection x + f(x) is one Euler step of dx/dt = f(x)." },
    { "a": "Runge-Kutta", "t": "outlier", "aka": ["Runge-Kutta methods", "RK4", "Runge Kutta 4"] },
    { "a": "Ordinary differential equation", "t": "outlier", "aka": ["ODE", "ODEs", "Differential equation", "Differential equations"] },
    { "a": "Partial differential equation", "t": "outlier", "aka": ["PDE", "PDEs"] },
    { "a": "Gamma function", "t": "outlier", "aka": ["Gamma", "Euler gamma function"], "q": "Gamma(n) = (n-1)!, and Gamma(1/2) = sqrt(pi)." },
    { "a": "Gaussian integral", "t": "outlier", "aka": ["Euler-Poisson integral", "Integral of exp(-x^2)"], "q": "The integral of exp(-x^2) is sqrt(pi), which is why the normal density has a 1/sqrt(2 pi) in front." },
    { "a": "Laplace approximation", "t": "outlier", "aka": ["Laplace's method", "Gaussian approximation at the mode"] },
    { "a": "Lagrangian duality", "t": "outlier", "aka": ["Duality", "Lagrange duality", "Dual problem", "Strong duality", "Weak duality"] },
    { "a": "Lagrangian", "t": "outlier", "aka": ["Lagrange function"] },
    { "a": "Complementary slackness", "t": "outlier", "aka": ["Complementary slackness condition"], "q": "In an SVM, only the support vectors have a nonzero multiplier." },
    { "a": "Proximal operator", "t": "outlier", "aka": ["Prox operator", "Proximal mapping", "Prox", "Proximal map"], "q": "The proximal operator of the L1 norm is soft thresholding." },
    { "a": "Convex conjugate", "t": "outlier", "aka": ["Legendre-Fenchel transform", "Fenchel conjugate", "Legendre transform", "Fenchel-Legendre transform"] },
    { "a": "Hessian-vector product", "t": "outlier", "aka": ["HVP"], "q": "Pearlmutter, 1994: computes Hv for about the price of two gradients, without ever forming H." },
    { "a": "Jacobian-vector product", "t": "outlier", "aka": ["JVP"] },
    { "a": "Vector-Jacobian product", "t": "outlier", "aka": ["VJP"], "q": "What backprop computes at every layer." },
    { "a": "Gradient checking", "t": "outlier", "aka": ["Numerical gradient check", "Gradient check", "Grad check"] },
    { "a": "Symbolic differentiation", "t": "outlier", "aka": ["Symbolic derivative", "Computer algebra"] },
    { "a": "Calculus of variations", "t": "outlier", "aka": ["Variational calculus", "Functional derivative", "Variational derivative"], "q": "Optimizing over functions, which is why it is called variational inference." },
    { "a": "Implicit differentiation", "t": "outlier", "aka": ["Implicit derivative", "Implicit function theorem"], "q": "Differentiates through the solution of an equation without unrolling the solver. Deep equilibrium models rely on it." },
    { "a": "Gradient flow", "t": "outlier", "aka": ["Gradient flows"], "q": "Gradient descent with an infinitesimal step: the ODE d(theta)/dt = -grad L(theta)." },
    { "a": "Curvature", "t": "outlier", "aka": ["Curvature of the loss"], "q": "The Hessian's eigenvalues measure the curvature of the loss along their eigenvectors." },
    { "a": "Polyak-Lojasiewicz condition", "t": "outlier", "aka": ["PL condition", "PL inequality", "Polyak-Lojasiewicz inequality", "PL"] },
    { "a": "Concavity", "t": "outlier", "aka": ["Concave function", "Concave functions", "Concave"] },
    { "a": "Numerical integration", "t": "outlier", "aka": ["Quadrature", "Numerical quadrature"] },
    { "a": "Multivariable calculus", "t": "outlier", "aka": ["Multivariate calculus", "Vector calculus"] },
    { "a": "Tensor calculus", "t": "outlier", "aka": ["Tensor analysis"] },

    { "a": "Complex-step differentiation", "t": "longtail", "aka": ["Complex step", "Complex-step derivative", "Complex step method"], "q": "f'(x) is about Im f(x + ih) / h. With h = 1e-20 there is no subtractive cancellation at all." },
    { "a": "Euler-Lagrange equation", "t": "longtail", "aka": ["Euler Lagrange"] },
    { "a": "Gâteaux derivative", "t": "longtail", "q": "The influence function of robust statistics is a Gateaux derivative." },
    { "a": "Fréchet derivative", "t": "longtail" },
    { "a": "Functional gradient", "t": "longtail", "aka": ["Functional gradient descent", "Gradient in function space"], "q": "Gradient boosting is gradient descent in function space." },
    { "a": "Inverse function theorem", "t": "longtail", "aka": ["Inverse function"] },
    { "a": "Rademacher's theorem", "t": "longtail", "aka": ["Rademacher theorem"], "q": "Every Lipschitz function is differentiable almost everywhere, which is why ReLU networks have gradients nearly everywhere." },
    { "a": "Heaviside step function", "t": "longtail", "aka": ["Heaviside function", "Step function", "Heaviside"], "q": "The derivative of ReLU." },
    { "a": "Dirac delta", "t": "longtail", "aka": ["Dirac delta function", "Delta function"], "q": "The derivative of the Heaviside step, if you squint." },
    { "a": "Error function", "t": "longtail", "aka": ["erf", "Gauss error function"], "q": "GELU is x times the normal CDF, which is computed with erf." },
    { "a": "Inflection point", "t": "longtail", "aka": ["Inflection", "Points of inflection"] },
    { "a": "Extreme value theorem", "t": "longtail", "aka": ["Weierstrass extreme value theorem"] },
    { "a": "Itô's lemma", "t": "longtail", "aka": ["Ito", "Stochastic calculus", "Ito formula", "Itô calculus", "Ito's formula"], "q": "The chain rule for stochastic processes, with an extra second-order term." },
    { "a": "Stochastic differential equation", "t": "longtail", "aka": ["SDE", "SDEs"] },
    { "a": "Fokker-Planck equation", "t": "longtail", "aka": ["Fokker Planck"] },
    { "a": "Heat equation", "t": "longtail", "aka": ["Diffusion equation"] },
    { "a": "Wiener process", "t": "longtail", "aka": ["Brownian motion"] },
    { "a": "Adjoint sensitivity method", "t": "longtail", "aka": ["Adjoint method", "Adjoint equation"], "q": "Neural ODEs backpropagate by solving a second ODE backward in time. The adjoint method goes back to Pontryagin." },
    { "a": "Pontryagin's maximum principle", "t": "longtail", "aka": ["Pontryagin maximum principle", "Maximum principle"] },
    { "a": "Hamilton-Jacobi-Bellman equation", "t": "longtail", "aka": ["HJB equation", "HJB"] },
    { "a": "Leibniz integral rule", "t": "longtail", "aka": ["Differentiation under the integral sign", "Feynman's trick", "Leibniz rule"], "q": "Feynman's favourite trick. In ML it justifies moving the gradient inside an expectation." },
    { "a": "Dominated convergence theorem", "t": "longtail", "aka": ["Lebesgue dominated convergence"] },
    { "a": "Fubini's theorem", "t": "longtail", "aka": ["Fubini"] },
    { "a": "Riemann sum", "t": "longtail", "aka": ["Riemann sums", "Riemann integral"] },
    { "a": "Trapezoidal rule", "t": "longtail", "aka": ["Trapezoid rule"] },
    { "a": "Simpson's rule", "t": "longtail", "aka": ["Simpson rule"] },
    { "a": "Gaussian quadrature", "t": "longtail", "aka": ["Gauss quadrature", "Gauss-Hermite quadrature"] },
    { "a": "Stirling's approximation", "t": "longtail", "aka": ["Stirling's formula"] },
    { "a": "L'Hôpital's rule", "t": "longtail", "aka": ["Lhopital"], "q": "Published by L'Hôpital, but discovered by Johann Bernoulli, who had been paid for it." },
    { "a": "Squeeze theorem", "t": "longtail", "aka": ["Sandwich theorem"] },
    { "a": "Intermediate value theorem", "t": "longtail", "aka": ["IVT"] },
    { "a": "Rolle's theorem", "t": "longtail", "aka": ["Rolle's lemma"] },
    { "a": "Uniform continuity", "t": "longtail", "aka": ["Uniformly continuous"] },
    { "a": "Uniform convergence", "t": "longtail", "aka": ["Uniformly convergent"] },
    { "a": "Holder continuity", "t": "longtail" },
    { "a": "Quasiconvexity", "t": "longtail", "aka": ["Quasi-convex"] },
    { "a": "Pseudoconvexity", "t": "longtail", "aka": ["Pseudoconvex"] },
    { "a": "Log-concavity", "t": "longtail", "aka": ["Log-concave"] },
    { "a": "Invexity", "t": "longtail", "aka": ["Invex"] },
    { "a": "Kurdyka-Lojasiewicz property", "t": "longtail", "aka": ["KL property"] },
    { "a": "Convex set", "t": "longtail", "aka": ["Convex sets"] },
    { "a": "Epigraph", "t": "longtail", "aka": ["Epigraph of a function"] },
    { "a": "Moreau envelope", "t": "longtail", "aka": ["Moreau-Yosida regularization", "Moreau-Yosida"] },
    { "a": "Differentiable manifold", "t": "longtail", "aka": ["Manifold", "Smooth manifold", "Tangent space"] },
    { "a": "Softmax Jacobian", "t": "longtail", "aka": ["Jacobian of softmax", "Softmax derivative", "Derivative of softmax", "Softmax gradient"], "q": "Its entries are p_i (delta_ij - p_j), that is diag(p) - p p^T." },
    { "a": "Log-derivative trick", "t": "longtail", "aka": ["Log derivative", "Score function", "Likelihood ratio trick", "REINFORCE trick"] },
    { "a": "Condition number", "t": "longtail", "aka": ["Ill-conditioning", "Ill-conditioned Hessian", "Conditioning"] },
    { "a": "Geometric series", "t": "longtail", "aka": ["Geometric sum"], "q": "The reason a discounted return with gamma below 1 converges." },
    { "a": "Divergence theorem", "t": "longtail", "aka": ["Gauss's theorem", "Gauss divergence theorem"] },
    { "a": "Green's theorem", "t": "longtail", "aka": ["Green theorem"] },
