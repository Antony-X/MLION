    { "a": "Digamma function", "t": "longtail", "aka": ["Digamma", "Psi function"] },
    { "a": "Beta function", "t": "longtail", "aka": ["Euler beta function"] },
    { "a": "Convergence", "t": "longtail", "aka": ["Convergent sequence", "Sequence convergence", "Convergence of a sequence"] },
    { "a": "Bregman divergence", "t": "longtail", "aka": ["Bregman distance"], "q": "Defined from a convex function as the gap between it and its tangent. KL divergence and squared error are both special cases." },
