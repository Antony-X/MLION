    { "a": "KDE plot", "t": "indist", "aka": ["density plot", "kernel density plot", "kernel density estimate", "kdeplot", "density curve", "2D KDE plot", "bivariate KDE", "density estimate plot"], "q": "A smooth histogram: each point contributes a little bump." },
    { "a": "Area chart", "t": "indist", "aka": ["area plot", "filled line chart"] },
    { "a": "Stacked bar chart", "t": "indist", "aka": ["stacked bar plot", "stacked bar graph", "stacked bars", "100% stacked bar chart", "percent stacked bar chart", "normalized stacked bar chart", "stacked column chart"] },
    { "a": "Grouped bar chart", "t": "indist", "aka": ["clustered bar chart", "grouped bar plot", "side-by-side bar chart", "clustered column chart"] },
