{
  "id": "plot-type",
  "pack": "classic",
  "text": "Name a type of plot or chart used in data analysis",
  "note": "Any named kind of plot or chart for exploring data or judging a model: Matplotlib, Seaborn, pandas, statistics and ML diagnostics; not a library or a function",
