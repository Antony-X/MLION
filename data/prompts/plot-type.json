  "answers": [
    { "a": "Hinton diagram", "t": "mlion", "aka": ["Hinton plot", "Hinton"], "q": "Squares sized by weight magnitude, white positive and black negative. Named after Geoffrey Hinton; it's in Matplotlib's gallery." },

    { "a": "Scatter plot", "t": "baseline", "aka": ["scatterplot", "scatter", "scatter graph", "scattergram"], "q": "One dot per row, two columns on the axes. Where most EDA starts." },
    { "a": "Histogram", "t": "baseline", "aka": ["hist", "distplot", "displot", "histplot", "frequency histogram", "frequency distribution plot"], "q": "Counts per bin. Change the bin count and the story changes." },
    { "a": "Bar chart", "t": "baseline", "aka": ["bar plot", "bar graph", "barplot", "barchart", "column chart", "horizontal bar chart", "barh", "vertical bar chart", "column graph"], "q": "Heights for categories. Start the axis at zero or lose credibility." },
    { "a": "Line plot", "t": "baseline", "aka": ["line chart", "line graph", "lineplot", "curve plot", "multi-line chart", "multiple line chart", "multi-line plot"], "q": "Points joined in order. The default of plt.plot." },
    { "a": "Box plot", "t": "baseline", "aka": ["boxplot", "box and whisker plot", "box-and-whisker", "whisker plot", "box whisker", "notched box plot"], "q": "Median, quartiles and whiskers: Tukey's five-number summary, drawn." },
    { "a": "Pie chart", "t": "baseline", "aka": ["piechart", "pie"], "q": "Loved by management, avoided by statisticians." },
