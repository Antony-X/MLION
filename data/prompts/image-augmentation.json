{
  "id": "image-augmentation",
  "pack": "blocks",
  "text": "Name an image data augmentation technique",
  "note": "Any transform, corruption, mixing strategy or learned policy applied to training images (or at test time) to get more out of the data",
  "strip": ["augmentation", "augmentations", "augment", "data", "image", "images", "random", "randomly", "transform", "transformation", "technique"],
  "answers": [
    { "a": "Fancy PCA", "t": "mlion", "aka": ["PCA color augmentation", "PCA colour augmentation", "AlexNet color augmentation", "PCA lighting", "lighting noise", "PCA jitter"], "q": "AlexNet's trick: jitter RGB along the pixel PCA axes. Per the paper, it cut top-1 error by over 1%." },

    { "a": "Horizontal flip", "t": "baseline", "aka": ["flip", "flipping", "mirror", "mirroring", "RandomHorizontalFlip", "hflip", "left-right flip", "horizontal flipping"], "q": "Free 2x data, unless you're reading text or telling left hands from right." },
    { "a": "Rotation", "t": "baseline", "aka": ["rotate", "rotations", "RandomRotation", "random rotation"], "q": "Turn the image by a random angle. Fine for cells and satellite tiles; turn a 6 far enough and it becomes a 9." },
    { "a": "Random crop", "t": "baseline", "aka": ["crop", "cropping", "RandomCrop", "pad and crop", "padding and cropping", "random cropping"], "q": "Train on random patches of each image. AlexNet took 224×224 crops from 256×256 images, and flipped them too." },
    { "a": "Color jitter", "t": "baseline", "aka": ["ColorJitter", "color jittering", "colour jitter", "color augmentation", "colour augmentation", "photometric distortion", "HSV augmentation", "HSV jitter", "color distortion"], "q": "Random shifts in brightness, contrast, saturation and hue, so the model stops leaning on exact colours." },

    { "a": "Mixup", "t": "overfit", "aka": ["mix-up", "input mixup"], "q": "Blend two images and their labels. A 40% cat, 60% dog: nonsense to humans, regularization to nets." },
    { "a": "CutMix", "t": "overfit", "aka": ["cut mix", "cut-mix"], "q": "Paste a patch of one image onto another, mix labels by area. Cutout meets Mixup, and wins." },

    { "a": "Vertical flip", "t": "indist", "aka": ["vflip", "RandomVerticalFlip", "up-down flip", "vertical flipping"], "q": "Great for satellites and microscopes. Terrible for cats, who rarely stand on the ceiling." },
    { "a": "RandomResizedCrop", "t": "indist", "aka": ["random resized crop", "random sized crop", "inception crop", "Inception-style crop", "crop and resize", "scale and aspect ratio augmentation"], "q": "The Inception-era crop: random area from 8% to 100%, random aspect ratio. ImageNet's daily bread." },
    { "a": "Scaling", "t": "indist", "aka": ["scale", "zoom", "random zoom", "random scaling", "RandomZoom", "resize", "rescaling", "zoom in", "upscale", "upscaling"] },
    { "a": "Translation", "t": "indist", "aka": ["shift", "translate", "random shift", "random translation", "width shift", "height shift", "shifting"] },
    { "a": "Shear", "t": "indist", "aka": ["shearing", "random shear", "shear transform"] },
    { "a": "Affine transformation", "t": "indist", "aka": ["affine", "random affine", "RandomAffine", "affine transform", "affine warp", "ShiftScaleRotate", "shift scale rotate", "geometric augmentation", "geometric transformation", "geometric transform"] },
    { "a": "Brightness", "t": "indist", "aka": ["brightness adjustment", "random brightness", "brightness jitter", "RandomBrightness", "RandomBrightnessContrast", "brightness and contrast", "exposure", "exposure adjustment", "intensity shift", "intensity scaling"] },
    { "a": "Contrast", "t": "indist", "aka": ["contrast adjustment", "random contrast", "contrast jitter", "RandomContrast"] },
    { "a": "Saturation", "t": "indist", "aka": ["saturation adjustment", "random saturation", "saturation jitter"] },
    { "a": "Hue shift", "t": "indist", "aka": ["hue", "hue jitter", "random hue", "hue adjustment", "HueSaturationValue", "HSV shift"] },
    { "a": "Grayscale", "t": "indist", "aka": ["greyscale", "random grayscale", "RandomGrayscale", "to gray", "ToGray", "desaturation"] },
    { "a": "Gaussian blur", "t": "indist", "aka": ["blur", "blurring", "GaussianBlur", "random blur", "Gaussian smoothing", "Gaussian filter"], "q": "SimCLR found it mattered on ImageNet. Contrastive learning's least obvious ingredient." },
    { "a": "Gaussian noise", "t": "indist", "aka": ["noise", "noise injection", "additive noise", "random noise", "GaussNoise", "additive Gaussian noise"] },
    { "a": "Cutout", "t": "indist", "aka": ["cut out", "coarse dropout", "CoarseDropout", "blackout", "black patches", "random black box", "black box"], "q": "Black out a random square. DeVries & Taylor called it dropout for the input." },
    { "a": "Random Erasing", "t": "indist", "aka": ["RandomErasing", "erasing", "random erase", "occlusion", "random occlusion", "occlusion augmentation"], "q": "Arrived the same month as Cutout, with random sizes, aspect ratios and noise fill." },
    { "a": "RandAugment", "t": "indist", "aka": ["rand augment"], "q": "AutoAugment's search space collapsed to two knobs, N and M. Turns out that was enough." },
    { "a": "AutoAugment", "t": "indist", "aka": ["auto augment"], "q": "Thousands of GPU hours of RL to learn which ops to apply and how hard. RandAugment later matched it with two knobs." },
    { "a": "Test-time augmentation", "t": "indist", "aka": ["TTA", "test time augmentation", "ten-crop", "ten crop", "five-crop", "inference-time augmentation", "FiveCrop"], "q": "Augment at inference, average the predictions. A Kaggle leaderboard ritual." },
    { "a": "Mosaic", "t": "indist", "aka": ["mosaic augmentation", "4-image mosaic", "mosaic9"], "q": "YOLOv4 stitched four images into one, so every batch sees objects at weird scales and contexts." },
    { "a": "GAN-based augmentation", "t": "indist", "aka": ["generative augmentation", "synthetic data", "synthetic images", "GAN augmentation", "diffusion augmentation", "diffusion-based augmentation", "generated images", "CycleGAN", "image-to-image translation", "domain translation"], "q": "Train a generator to make your training set. What could possibly go wrong?" },

    { "a": "Manifold Mixup", "t": "outlier", "aka": ["manifold mix-up", "feature mixup", "hidden state mixup"], "q": "Mixup, but on hidden representations instead of pixels." },
    { "a": "AugMix", "t": "outlier", "aka": ["aug mix"], "q": "Mix several augmentation chains, then add a Jensen-Shannon consistency loss. Robustness on the cheap." },
    { "a": "TrivialAugment", "t": "outlier", "aka": ["TrivialAugmentWide", "trivial augment wide", "TA"], "q": "One random op, one random strength, per image. Beat searched policies with zero search." },
    { "a": "Fast AutoAugment", "t": "outlier", "aka": ["FAA", "fast auto augment"] },
    { "a": "Copy-Paste", "t": "outlier", "aka": ["simple copy-paste", "copy paste", "cut-paste", "cut paste and learn", "instance copy-paste", "object pasting"], "q": "Ghiasi et al. pasted random objects onto random images, no context needed, and set a COCO state of the art." },
    { "a": "Perspective transform", "t": "outlier", "aka": ["perspective", "random perspective", "RandomPerspective", "homography", "perspective warp"] },
    { "a": "Elastic deformation", "t": "outlier", "aka": ["elastic", "elastic transform", "elastic distortion", "ElasticTransform", "smooth deformation", "random deformation", "B-spline deformation", "free-form deformation"], "q": "Simard et al. 2003 wobbled MNIST digits like jelly. Still a medical-imaging staple." },
    { "a": "Salt-and-pepper noise", "t": "outlier", "aka": ["salt and pepper", "impulse noise", "salt pepper noise"] },
    { "a": "Motion blur", "t": "outlier", "aka": ["MotionBlur"] },
    { "a": "Sharpening", "t": "outlier", "aka": ["sharpen", "sharpness", "RandomAdjustSharpness", "unsharp mask", "UnsharpMask", "unsharp"] },
    { "a": "Solarize", "t": "outlier", "aka": ["solarization", "RandomSolarize", "solarise"], "q": "Invert every pixel above a threshold. BYOL put it in the standard SSL recipe." },
    { "a": "Posterize", "t": "outlier", "aka": ["posterization", "RandomPosterize", "posterise", "bit reduction"] },
    { "a": "Equalize", "t": "outlier", "aka": ["histogram equalization", "RandomEqualize", "equalization"] },
    { "a": "Autocontrast", "t": "outlier", "aka": ["auto contrast", "RandomAutocontrast", "contrast stretching", "histogram stretching"] },
    { "a": "Invert", "t": "outlier", "aka": ["color inversion", "RandomInvert", "inversion", "negative"] },
    { "a": "CLAHE", "t": "outlier", "aka": ["contrast limited adaptive histogram equalization", "adaptive histogram equalization"] },
    { "a": "Gamma correction", "t": "outlier", "aka": ["gamma", "random gamma", "RandomGamma", "gamma adjustment"] },
    { "a": "JPEG compression", "t": "outlier", "aka": ["JPEG", "JPEG artifacts", "ImageCompression", "compression artifacts", "JpegCompression", "compression"], "q": "Teaches the model that blocky 8x8 artifacts are not a feature." },
    { "a": "Hide-and-Seek", "t": "outlier", "aka": ["hide and seek", "HaS"], "q": "Hide random grid patches so the network can't just stare at the most obvious part of the object." },
    { "a": "GridMask", "t": "outlier", "aka": ["grid mask", "GridDropout"], "q": "Drop a regular grid of squares instead of one blob. Cutout, now with structure." },
    { "a": "Multi-scale training", "t": "outlier", "aka": ["multiscale training", "multi-scale", "scale jittering", "scale jitter", "multi-scale resizing"] },
    { "a": "Style transfer", "t": "outlier", "aka": ["neural style transfer", "style", "style augmentation", "Stylized ImageNet", "stylization"], "q": "Geirhos et al. restyled ImageNet as paintings and nudged CNNs from texture bias toward shape." },
    { "a": "Domain randomization", "t": "outlier", "aka": ["domain randomisation"], "q": "Render sims with absurd textures and lighting until reality looks like just another variation." },
    { "a": "Multi-crop", "t": "outlier", "aka": ["multicrop", "multi crop", "local and global crops"], "q": "SwAV's trick: two big views plus several cheap low-res crops per image." },
    { "a": "Adaptive discriminator augmentation", "t": "outlier", "aka": ["ADA", "StyleGAN2-ADA"], "q": "StyleGAN2 trained on a few thousand images by augmenting what the discriminator sees, tuned on the fly." },
    { "a": "Random 90-degree rotation", "t": "outlier", "aka": ["RandomRotate90", "rot90", "rotate 90", "90 degree rotation", "right-angle rotation", "rotate 180", "180 degree rotation"], "q": "Lossless: no interpolation, no black corners. Aerial imagery's favorite." },
    { "a": "Channel shuffle", "t": "outlier", "aka": ["ChannelShuffle", "RGB shuffle", "channel permutation"] },

    { "a": "SaliencyMix", "t": "longtail", "aka": ["saliency mix"] },
    { "a": "PuzzleMix", "t": "longtail", "aka": ["puzzle mix"] },
    { "a": "Co-Mixup", "t": "longtail", "aka": ["comixup"] },
    { "a": "SnapMix", "t": "longtail", "aka": ["snap mix"] },
    { "a": "ResizeMix", "t": "longtail", "aka": ["resize mix"] },
    { "a": "FMix", "t": "longtail", "aka": ["Fourier mix"] },
    { "a": "Attentive CutMix", "t": "longtail", "aka": ["AttentiveMix", "attentive mix"] },
    { "a": "TransMix", "t": "longtail", "aka": ["trans mix"] },
    { "a": "TokenMix", "t": "longtail", "aka": ["token mix"] },
    { "a": "Remix", "t": "longtail", "aka": ["rebalanced mixup"] },
    { "a": "AutoMix", "t": "longtail", "aka": ["auto mix"] },
    { "a": "StyleMix", "t": "longtail", "aka": ["style mix"] },
    { "a": "MixStyle", "t": "longtail", "aka": ["mix style"], "q": "Don't mix pixels, mix feature statistics. Domain generalization by swapping instance-norm styles." },
    { "a": "AlignMixup", "t": "longtail", "aka": ["align mixup"] },
    { "a": "GridMix", "t": "longtail", "aka": ["grid mix"] },
    { "a": "SamplePairing", "t": "longtail", "aka": ["sample pairing"], "q": "Average two images, keep only the first label. Shouldn't work. Inoue 2018 says it does." },
    { "a": "Between-class learning", "t": "longtail", "aka": ["BC learning", "BC+", "between class learning"] },
    { "a": "RICAP", "t": "longtail", "aka": ["random image cropping and patching"] },
    { "a": "CutBlur", "t": "longtail", "aka": ["cut blur"] },
    { "a": "MoEx", "t": "longtail", "aka": ["moment exchange"] },
    { "a": "YOCO", "t": "longtail", "aka": ["you only cut once"] },
    { "a": "KeepAugment", "t": "longtail", "aka": ["keep augment"] },
    { "a": "PixMix", "t": "longtail", "aka": ["pix mix"], "q": "Mix training images with fractals and feature visualizations. Robustness via psychedelia." },
    { "a": "DeepAugment", "t": "longtail", "aka": ["deep augment"] },
    { "a": "Patch Gaussian", "t": "longtail", "aka": ["patch gaussian noise", "PatchGaussian"] },
    { "a": "Population Based Augmentation", "t": "longtail", "aka": ["PBA", "population-based augmentation"] },
    { "a": "UniformAugment", "t": "longtail", "aka": ["uniform augment"] },
    { "a": "Adversarial AutoAugment", "t": "longtail", "aka": ["adversarial auto augment"] },
    { "a": "Faster AutoAugment", "t": "longtail", "aka": ["faster auto augment"] },
    { "a": "DADA", "t": "longtail", "aka": ["differentiable automatic data augmentation"] },
    { "a": "Deep AutoAugment", "t": "longtail", "aka": ["DeepAA"] },
    { "a": "3-Augment", "t": "longtail", "aka": ["ThreeAugment", "three augment", "DeiT III augmentation"], "q": "DeiT III's minimalist recipe: per image, pick one of grayscale, solarize or blur." },
    { "a": "RangeAugment", "t": "longtail", "aka": ["range augment"] },
    { "a": "DiffAugment", "t": "longtail", "aka": ["differentiable augmentation"], "q": "Augment real and fake images differentiably, so data-starved GANs stop memorizing." },
    { "a": "Large Scale Jittering", "t": "longtail", "aka": ["LSJ", "large-scale jitter"], "q": "Resize anywhere from 0.1x to 2x, then crop. Copy-Paste's partner in crime." },
    { "a": "Zoom out", "t": "longtail", "aka": ["random expand", "expand", "SSD zoom out", "RandomZoomOut"], "q": "SSD shrinks the image onto a bigger canvas to manufacture small objects." },
    { "a": "Min-IoU random crop", "t": "longtail", "aka": ["RandomIoUCrop", "IoU crop", "SSD random crop", "MinIoURandomCrop"] },
    { "a": "InstaBoost", "t": "longtail", "aka": ["insta boost"] },
    { "a": "Stitcher", "t": "longtail" },
    { "a": "Patch shuffle", "t": "longtail", "aka": ["PatchShuffle", "grid shuffle", "RandomGridShuffle", "jigsaw"] },
    { "a": "Grid distortion", "t": "longtail", "aka": ["GridDistortion"] },
    { "a": "Optical distortion", "t": "longtail", "aka": ["OpticalDistortion", "lens distortion", "barrel distortion", "pincushion distortion"] },
