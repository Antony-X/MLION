    { "a": "Patch dropout", "t": "longtail", "aka": ["PatchDropout", "token dropout"] },
    { "a": "Random masking", "t": "outlier", "aka": ["patch masking", "mask patches", "MAE masking", "block masking", "masked image modeling masking"] },
    { "a": "Background replacement", "t": "longtail", "aka": ["background swap", "background removal", "background randomization", "background augmentation"] },
    { "a": "Weather effects", "t": "longtail", "aka": ["weather", "weather augmentation", "weather simulation", "synthetic weather"] },
