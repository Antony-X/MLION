    { "a": "Median blur", "t": "longtail", "aka": ["MedianBlur", "median filter"] },
    { "a": "Box blur", "t": "longtail", "aka": ["average blur", "mean blur", "box filter"] },
    { "a": "Defocus blur", "t": "longtail", "aka": ["defocus", "Defocus", "lens blur", "bokeh blur"] },
    { "a": "Glass blur", "t": "longtail", "aka": ["GlassBlur"] },
    { "a": "Zoom blur", "t": "longtail", "aka": ["ZoomBlur"] },
