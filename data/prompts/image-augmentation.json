    { "a": "Pixel dropout", "t": "longtail", "aka": ["PixelDropout"] },
    { "a": "RGB shift", "t": "longtail", "aka": ["RGBShift", "channel shift", "channel shift range", "color cast"] },
    { "a": "Downscale", "t": "longtail", "aka": ["downscaling", "downsampling", "resolution degradation", "pixelate", "pixelation", "low resolution"] },
