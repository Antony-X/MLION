{
  "id": "transformer-component",
  "pack": "blocks",
  "text": "Name a component of a transformer",
  "note": "A part of a transformer layer or the stack around it: sub-layers, norms, masks, embeddings, heads, MoE parts, and swapped-in variants of those parts.",
  "strip": ["component", "transformer", "module", "block"],
  "answers": [
    { "a": "Multi-head attention", "t": "baseline", "aka": ["MHA", "multihead attention", "MHSA", "multi-head self-attention", "multi head attention"], "q": "Several attention patterns run in parallel on slices of the representation, then concatenated and mixed back together." },
    { "a": "Self-attention", "t": "baseline", "aka": ["attention", "attention mechanism", "attention layer", "attention block", "self attention layer"], "q": "Every token scores every other token, then takes a weighted average of their values." },
    { "a": "Feed-forward network", "t": "baseline", "aka": ["FFN", "MLP", "feed forward", "feedforward", "feed-forward layer", "position-wise feed-forward network", "positionwise feedforward", "fully connected network", "feed forward neural network", "multilayer perceptron", "multi-layer perceptron", "dense block"], "q": "Two linear layers around a nonlinearity, applied to each token separately. Holds about two-thirds of a standard block's parameters." },
    { "a": "Residual connection", "t": "baseline", "aka": ["skip connection", "residual", "shortcut connection", "residual link", "skip", "residual path", "add and norm", "add & norm"], "q": "Add the input back onto the output of every sub-layer. Take it away and deep stacks stop training." },
    { "a": "Layer normalization", "t": "baseline", "aka": ["LayerNorm", "layer norm", "LN", "nn.LayerNorm", "normalization", "normalisation", "norm", "layer normalisation"], "q": "Normalises across each token's own features, so batch size and padding don't matter." },
    { "a": "Positional encoding", "t": "baseline", "aka": ["positional embedding", "position encoding", "position embedding", "positional embeddings", "positional encodings", "sinusoidal positional encoding", "sinusoidal encoding", "sinusoidal embeddings", "absolute positional encoding", "PE"], "q": "Attention ignores order, so you have to inject where each token sits. The original used sines and cosines." },

    { "a": "Residual stream", "t": "overfit", "aka": ["residual pathway"], "q": "Mech-interp's favourite noun: the running sum every layer reads from and writes to. Not a layer, but everyone says it." },
    { "a": "KV cache", "t": "overfit", "aka": ["key-value cache", "key value cache", "KV caching", "kv-cache", "key value caching"], "q": "Not in the maths, but in every LLM server: past keys and values are stored, so each new token attends to them instead of recomputing them." },

    { "a": "Register tokens", "t": "mlion", "aka": ["registers", "register token", "ViT registers", "vision transformer registers", "visual registers"], "q": "Vision Transformers Need Registers (Darcet et al., 2023): spare scratch tokens stop ViTs from hijacking background patches as storage." },

    { "a": "Cross-attention", "t": "indist", "aka": ["cross attention", "encoder-decoder attention", "encoder decoder attention"], "q": "Queries from the decoder, keys and values from the encoder. How translation models look at the source." },
    { "a": "Masked self-attention", "t": "indist", "aka": ["masked multi-head attention", "causal self-attention", "causal attention", "masked attention", "masked self attention", "masked multi head attention"], "q": "Decoder attention that is not allowed to peek at future tokens." },
    { "a": "Attention mask", "t": "indist", "aka": ["mask", "masking", "attention masking"] },
    { "a": "Causal mask", "t": "indist", "aka": ["look-ahead mask", "lookahead mask", "subsequent mask", "triangular mask", "autoregressive mask", "upper triangular mask", "causal masking"], "q": "A triangle of minus infinity above the diagonal, so no token reads the future." },
    { "a": "Query, key and value projections", "t": "indist", "aka": ["QKV", "QKV projection", "query key value", "query", "key", "value", "queries", "keys", "values", "query projection", "key projection", "value projection", "queries keys and values", "linear projections", "qkv matrices", "W_Q", "W_K", "W_V"] },
    { "a": "Scaled dot-product attention", "t": "indist", "aka": ["dot-product attention", "dot product attention", "scaled dot product", "scaled dot product attention"] },
    { "a": "Attention scores", "t": "indist", "aka": ["attention logits", "pre-softmax scores", "raw attention scores", "attention energies", "similarity scores", "QK^T", "QK transpose"] },
    { "a": "Attention weights", "t": "indist", "aka": ["attention matrix", "attention map", "attention pattern", "attention probabilities", "attention distribution", "alignment weights"] },
    { "a": "Softmax", "t": "indist", "aka": ["softmax layer", "softmax function", "nn.Softmax", "output softmax"] },
    { "a": "Attention head", "t": "indist", "aka": ["head", "heads", "attention heads"] },
    { "a": "Dropout", "t": "indist", "aka": ["nn.Dropout"] },
    { "a": "Token embedding", "t": "indist", "aka": ["embedding layer", "input embedding", "word embedding", "embedding", "input embeddings", "token embeddings", "nn.Embedding", "embedding matrix", "word embeddings", "embeddings"] },
    { "a": "Activation function", "t": "indist", "aka": ["nonlinearity", "non-linearity", "activation", "GELU", "ReLU", "nonlinear activation"] },
    { "a": "Linear layer", "t": "indist", "aka": ["linear projection", "dense layer", "fully connected layer", "nn.Linear", "projection layer", "linear", "projection", "FC layer"] },
    { "a": "Encoder", "t": "indist", "aka": ["encoder stack", "encoder block", "encoder layer", "transformer encoder", "encoder layers"] },
    { "a": "Decoder", "t": "indist", "aka": ["decoder stack", "decoder block", "decoder layer", "transformer decoder", "decoder layers"] },
    { "a": "RMSNorm", "t": "indist", "aka": ["RMS norm", "root mean square normalization", "root mean square layer normalization", "RMS layer norm", "nn.RMSNorm", "RMS normalization"], "q": "LayerNorm without the mean-centering. Llama kept the scale and dropped the rest." },
    { "a": "Pre-norm", "t": "indist", "aka": ["pre-LN", "pre-layer norm", "pre-layernorm", "pre-normalization", "pre-LayerNorm", "pre layer normalization", "norm_first", "norm first"], "q": "Normalise before each sub-layer, not after. Gradients behave and deep stacks train." },
    { "a": "Post-norm", "t": "indist", "aka": ["post-LN", "post-layer norm", "post-layernorm", "post-normalization", "post-LayerNorm", "post layer normalization"], "q": "The original recipe: add, then normalise. Needs warmup and some patience." },
    { "a": "[CLS] token", "t": "indist", "aka": ["CLS token", "class token", "classification token", "CLS"], "q": "A dummy token prepended to the input whose final state stands for the whole sequence." },
    { "a": "Patch embedding", "t": "indist", "aka": ["patch embeddings", "patchify", "image patches", "patch projection", "patch embed", "patchifying", "patch tokenizer"] },
    { "a": "Output head", "t": "indist", "aka": ["LM head", "language model head", "language modeling head", "lm_head", "classification head", "prediction head", "output layer", "final linear layer", "output linear layer"] },

    { "a": "Rotary position embedding", "t": "outlier", "aka": ["RoPE", "rotary embeddings", "rotary positional embedding", "rotary position encoding", "rotary embedding", "rotary", "rotary positional encoding"], "q": "Rotates query and key pairs by position-dependent angles, so their dot product sees relative offsets." },
    { "a": "ALiBi", "t": "outlier", "aka": ["attention with linear biases", "linear biases"], "q": "No position embeddings at all: just subtract a distance penalty, one slope per head, from the attention scores." },
    { "a": "Learned positional embedding", "t": "outlier", "aka": ["learned position embedding", "learnable positional embedding", "trainable positional embedding", "absolute position embedding", "learned positional encoding", "learned absolute positional embeddings", "trainable position embeddings", "learned positions"], "q": "A trainable vector per position, as in BERT and GPT-2." },
    { "a": "Relative position bias", "t": "outlier", "aka": ["relative positional encoding", "relative position embedding", "relative positional embeddings", "relative attention", "T5 relative bias", "relative position representations", "relative position encoding"] },
    { "a": "Segment embedding", "t": "outlier", "aka": ["token type embedding", "token type embeddings", "segment embeddings", "token_type_ids", "token type ids"], "q": "BERT's A/B marker for which sentence a token belongs to." },
    { "a": "Output projection", "t": "outlier", "aka": ["W_O", "attention output projection", "o_proj", "out_proj", "output linear", "head concatenation projection"], "q": "The matrix that stitches the heads back together. Easy to forget, never actually missing." },
    { "a": "Up-projection", "t": "outlier", "aka": ["up projection", "up_proj", "expansion layer", "first linear layer", "W1", "intermediate dense", "hidden expansion", "fc1", "c_fc"] },
    { "a": "Down-projection", "t": "outlier", "aka": ["down projection", "down_proj", "contraction layer", "second linear layer", "W2", "fc2"] },
    { "a": "Gated linear unit", "t": "outlier", "aka": ["GLU", "gated FFN", "gated feed-forward", "gated MLP", "GLU variants"] },
    { "a": "SwiGLU", "t": "outlier", "aka": ["Swish GLU", "swiglu activation", "SiLU GLU", "swish-gated linear unit"], "q": "Shazeer's 2020 GLU paper credits its success, \"as all else, to divine benevolence.\"" },
    { "a": "Router", "t": "outlier", "aka": ["gating network", "gate network", "expert router", "routing network", "gate", "routing", "top-k router", "gating function", "expert gate"], "q": "A small linear layer that decides which experts each token visits." },
    { "a": "Mixture-of-experts layer", "t": "outlier", "aka": ["MoE", "MoE layer", "sparse MoE", "experts", "mixture of experts", "sparse mixture of experts", "expert layer", "MoE block", "expert"] },
    { "a": "Grouped-query attention", "t": "outlier", "aka": ["GQA", "grouped query attention"] },
    { "a": "Multi-query attention", "t": "outlier", "aka": ["MQA", "multi query attention"] },
    { "a": "Scaling factor", "t": "outlier", "aka": ["1/sqrt(d_k)", "sqrt(d_k)", "square root of d_k", "attention scale", "scale", "scaling", "scale factor", "root d_k"], "q": "Divide the dot products by √d_k, or the softmax saturates and gradients vanish." },
    { "a": "Unembedding matrix", "t": "outlier", "aka": ["unembedding", "unembed", "output embedding", "output embedding matrix", "W_U", "unembedding layer"] },
    { "a": "Weight tying", "t": "outlier", "aka": ["tied embeddings", "tied weights", "shared embeddings", "embedding tying", "tied input-output embeddings", "tied input and output embeddings", "shared input output embedding", "weight sharing between embedding and output"], "q": "Use the same matrix to embed tokens in and read tokens out. Saves a vocabulary's worth of parameters." },
    { "a": "QK-norm", "t": "outlier", "aka": ["QK normalization", "query-key normalization", "QK layernorm", "qk norm", "query key norm", "QKNorm"], "q": "Normalise queries and keys before the dot product so attention logits can't blow up. ViT-22B and Gemma 3 both use it." },
    { "a": "Final layer norm", "t": "outlier", "aka": ["final norm", "ln_f", "output layer norm", "final layernorm", "last layer norm", "final normalization"] },
    { "a": "Attention dropout", "t": "outlier", "aka": ["dropout on attention weights", "attention weight dropout"] },
    { "a": "Attention sink", "t": "outlier", "aka": ["sink token", "attention sinks", "sink tokens", "StreamingLLM sink", "attention sink token"], "q": "Surplus attention piles onto the first token. StreamingLLM keeps it in the cache forever." },
    { "a": "Sliding-window attention", "t": "outlier", "aka": ["sliding window", "local attention", "windowed attention", "SWA", "sliding window attention"] },
    { "a": "Parallel attention and FFN", "t": "outlier", "aka": ["parallel block", "parallel transformer block", "parallel layers", "parallel residual", "parallel attention", "GPT-J parallel block", "parallel formulation", "parallel attn and mlp"], "q": "Run attention and the FFN side by side on the same input and add both. GPT-J and PaLM did it for speed." },
    { "a": "adaLN", "t": "outlier", "aka": ["adaptive layer norm", "adaptive layer normalization", "adaLN-Zero", "adaLN zero", "AdaLN-single", "adaptive layernorm"], "q": "DiT's conditioning trick: predict LayerNorm's scale and shift from the timestep and class." },
    { "a": "Stochastic depth", "t": "outlier", "aka": ["DropPath", "drop path", "drop_path", "layer dropout", "LayerDrop"], "q": "Dropout for depth: randomly skip whole residual branches during training." },
    { "a": "Mask token", "t": "outlier", "aka": ["[MASK] token", "mask embedding"] },

    { "a": "GeGLU", "t": "longtail", "aka": ["GELU GLU", "geglu activation"] },
    { "a": "Gate projection", "t": "longtail", "aka": ["gate_proj", "gate linear", "W_gate", "gating projection"] },
    { "a": "Patch merging", "t": "longtail", "aka": ["patch merging layer", "Swin patch merging", "downsampling layer"], "q": "Swin's pooling: glue each 2x2 group of patch tokens into one, halving resolution between stages." },
    { "a": "Window attention", "t": "longtail", "aka": ["shifted window attention", "W-MSA", "SW-MSA", "shifted windows", "window-based self-attention", "window self-attention", "shifted window"] },
    { "a": "Gated attention", "t": "longtail", "aka": ["attention output gate", "sigmoid gate after attention", "output gating", "gated softmax attention", "attention gate"], "q": "A sigmoid gate after the attention output. Qwen's team found it removes attention sinks. NeurIPS 2025 best paper." },
    { "a": "Hyper-connections", "t": "longtail", "aka": ["hyper connections", "HC", "manifold-constrained hyper-connections", "mHC"], "q": "Swap the single residual stream for several learnable, mixed streams. ByteDance, 2024." },
    { "a": "Logit soft-capping", "t": "longtail", "aka": ["softcapping", "attention soft-capping", "tanh soft-capping", "logit capping", "soft capping", "attn_logit_softcapping", "final logit softcapping"], "q": "Gemma 2 squashes attention and output logits through a scaled tanh. Gemma 3 swapped the attention one for QK-norm." },
    { "a": "LayerScale", "t": "longtail", "aka": ["layer scale", "per-channel residual scaling"], "q": "CaiT's learnable per-channel scale on each residual branch, initialised tiny so deep ViTs train." },
    { "a": "ReZero", "t": "longtail", "aka": ["ReZero is all you need", "rezero residual"], "q": "Scale each residual branch by a learnable scalar that starts at zero, so the network begins as the identity." },
    { "a": "DeepNorm", "t": "longtail", "aka": ["DeepNet", "deep norm"], "q": "Post-LN with a scaled residual and careful init, which let DeepNet stack 1,000 layers." },
    { "a": "Sandwich LayerNorm", "t": "longtail", "aka": ["sandwich norm", "sandwich-LN", "sandwich LN", "Sandwich-LN", "sandwich layer norm"], "q": "CogView's fix for unstable training: a LayerNorm both before and after each sub-layer." },
    { "a": "Peri-LN", "t": "longtail", "aka": ["peripheral layer norm", "peri layernorm", "Peri-LayerNorm", "peri layer norm"], "q": "Normalise both the input and the output of each sub-layer. Several open models did it before the paper named it." },
    { "a": "Embedding scaling", "t": "longtail", "aka": ["sqrt(d_model) scaling", "embedding scale", "scaled embeddings", "embedding multiplier", "multiply embeddings by sqrt d_model"], "q": "The original Transformer multiplies embeddings by √d_model before adding positions. Easy to forget, hard to debug." },
    { "a": "Multi-token prediction head", "t": "longtail", "aka": ["MTP", "multi-token prediction", "MTP head", "MTP module", "multi token prediction"], "q": "Extra output heads that predict tokens further ahead. DeepSeek-V3 trains with one." },
    { "a": "Shared expert", "t": "longtail", "aka": ["shared experts", "always-on expert", "DeepSeekMoE shared expert"], "q": "An expert every token passes through, so the routed experts are free to specialise. DeepSeekMoE." },
    { "a": "Expert-choice routing", "t": "longtail", "aka": ["expert choice", "expert choice routing", "expert-choice router"], "q": "Flip the router: each expert picks its top tokens instead of each token picking experts." },
    { "a": "Multi-head latent attention", "t": "longtail", "aka": ["MLA", "latent attention", "DeepSeek MLA"], "q": "DeepSeek's KV-cache squeezer: cache one small latent per token, re-expand it into keys and values." },
    { "a": "Pooler", "t": "longtail", "aka": ["BERT pooler", "pooling layer", "pooler output", "tanh pooler"], "q": "BERT's dense layer plus tanh on the [CLS] vector." },
    { "a": "Distillation token", "t": "longtail", "aka": ["distill token", "DeiT token", "teacher token"], "q": "DeiT's second special token: it learns to copy the teacher's labels while [CLS] learns the true ones." },
    { "a": "Object queries", "t": "longtail", "aka": ["learned queries", "query embeddings", "DETR queries", "object query"], "q": "DETR's N learned decoder inputs. Each one ends up claiming an object, or \"no object\"." },
    { "a": "Gated cross-attention", "t": "longtail", "aka": ["tanh-gated cross-attention", "gated xattn-dense", "Flamingo cross-attention", "tanh gated cross attention"], "q": "Flamingo's trick: tanh gates start at zero, so slotting vision layers into a frozen LLM can't wreck it." },
    { "a": "Prefix mask", "t": "longtail", "aka": ["prefix-LM mask", "prefix LM mask", "prefix attention mask", "bidirectional prefix mask", "prefix-LM attention"], "q": "Bidirectional attention over the prompt, causal over the output. The middle road between BERT and GPT." },
    { "a": "Embedding layer norm", "t": "longtail", "aka": ["embedding LayerNorm", "embeddings layernorm", "LayerNorm after embeddings"] },
    { "a": "Residual dropout", "t": "longtail", "aka": ["sublayer dropout", "sub-layer dropout", "residual-path dropout"] }
  ]
}
