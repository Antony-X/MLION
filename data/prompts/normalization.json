    { "a": "Local response normalization", "t": "indist", "aka": ["LRN", "LocalResponseNorm", "CrossMapLRN2d", "nn.LocalResponseNorm", "F.local_response_norm", "tf.nn.local_response_normalization", "LocalResponseNormalization"], "q": "AlexNet's lateral-inhibition trick, quietly dropped once VGG reported it didn't help." },
    { "a": "Adaptive instance normalization", "t": "indist", "aka": ["AdaIN"], "q": "Swap in the style image's channel mean and std. Arbitrary style transfer in real time, then StyleGAN." },
    { "a": "L2 normalization", "t": "indist", "aka": ["L2 norm", "unit normalization", "unit-norm embeddings", "F.normalize", "torch.nn.functional.normalize", "UnitNormalization", "l2_normalize", "tf.math.l2_normalize", "tf.nn.l2_normalize", "sklearn Normalizer", "Normalizer", "unit vector scaling", "row normalization", "feature normalization (L2)", "hypersphere projection", "projection onto the unit sphere"] },
    { "a": "Standardization", "t": "indist", "aka": ["standardisation", "z-score normalization", "standard scaling", "StandardScaler", "input normalization", "per-image standardization", "per_image_standardization", "feature scaling", "mean-variance normalization", "zero mean unit variance", "Z-score"] },
    { "a": "Min-max normalization", "t": "indist", "aka": ["min-max scaling", "MinMaxScaler", "rescaling", "min max scaling", "feature scaling min-max", "rescale to [0,1]"] },

