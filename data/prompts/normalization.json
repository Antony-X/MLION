{
  "id": "normalization",
  "pack": "blocks",
  "text": "Name a normalization technique for neural networks",
  "note": "Normalization layers and reparameterizations used in or around neural nets: BatchNorm, LayerNorm, RMSNorm, WeightNorm, spectral norm…",
  "strip": ["normalization", "normalisation", "norm", "normalize", "normalizing", "technique", "nn", "torch"],
  "answers": [
    { "a": "Ghost batch normalization", "t": "mlion", "aka": ["Ghost BatchNorm", "ghost BN", "GBN"], "q": "BatchNorm statistics over small \"ghost\" sub-batches inside a big one: large-batch speed, small-batch generalization." },

    { "a": "Sandwich-LN", "t": "longtail", "aka": ["sandwich norm", "sandwich layer norm"] },
    { "a": "Peri-LN", "t": "longtail" },
    { "a": "Global response normalization", "t": "longtail", "aka": ["GRN"] },
    { "a": "nGPT", "t": "longtail", "aka": ["normalized transformer", "hypersphere normalization"], "q": "Every vector lives on the unit hypersphere. NVIDIA's normalized Transformer, 2024." },
    { "a": "ScaleNorm", "t": "longtail" },
    { "a": "PowerNorm", "t": "longtail" },
    { "a": "Local contrast normalization", "t": "longtail", "aka": ["LCN", "contrast normalization"] },
    { "a": "Divisive normalization", "t": "longtail", "aka": ["generalized divisive normalization", "GDN"] },
    { "a": "Conditional instance normalization", "t": "longtail", "aka": ["CIN"] },
    { "a": "AdaLIN", "t": "longtail", "aka": ["adaptive layer-instance normalization"] },
    { "a": "IBN-Net", "t": "longtail", "aka": ["instance-batch normalization"] },
    { "a": "Batch-instance normalization", "t": "longtail", "aka": ["BIN"] },
    { "a": "Cross-iteration batch normalization", "t": "longtail", "aka": ["cross-iteration BN"] },
    { "a": "Recurrent batch normalization", "t": "longtail" },
    { "a": "Mean-only batch normalization", "t": "longtail" },
    { "a": "Decorrelated batch normalization", "t": "longtail", "aka": ["DBN"] },
    { "a": "Iterative normalization", "t": "longtail", "aka": ["IterNorm"] },
    { "a": "Batch-channel normalization", "t": "longtail", "aka": ["BCN"] },
    { "a": "Positional normalization", "t": "longtail", "aka": ["PONO"] },
    { "a": "Cosine normalization", "t": "longtail" },
    { "a": "Online normalization", "t": "longtail" },
    { "a": "Centered weight normalization", "t": "longtail" },
    { "a": "Orthogonal weight normalization", "t": "longtail", "aka": ["OWN"] },
    { "a": "Mode normalization", "t": "longtail" },
    { "a": "Normalization propagation", "t": "longtail", "aka": ["NormProp"] },
    { "a": "Logit normalization", "t": "longtail", "aka": ["LogitNorm"] },
    { "a": "Frozen batch normalization", "t": "longtail", "aka": ["FrozenBatchNorm2d", "FrozenBN"] },

    { "a": "Batch renormalization", "t": "outlier", "aka": ["Batch Renorm", "BRN", "batch renormalisation"], "q": "Ioffe's 2017 sequel: nudges BN toward its moving averages so tiny or non-i.i.d. batches stop hurting." },
    { "a": "Weight standardization", "t": "outlier", "aka": ["WS", "weight standardisation", "scaled weight standardization"] },
    { "a": "Synchronized batch normalization", "t": "outlier", "aka": ["SyncBatchNorm", "sync BN", "synchronised batch normalisation", "cross-GPU batch normalization"] },
    { "a": "Pre-LN", "t": "indist", "aka": ["pre-norm", "pre-layer normalization"], "q": "LayerNorm before each sublayer instead of after. Tames gradients enough to drop the warmup (Xiong et al. 2020)." },
    { "a": "Post-LN", "t": "outlier", "aka": ["post-norm", "post-layer normalization"] },
    { "a": "QK-Norm", "t": "outlier", "aka": ["query-key normalization", "QK LayerNorm"], "q": "Normalize queries and keys before the dot product so attention logits can't explode. ViT-22B needed it." },
    { "a": "Adaptive layer normalization", "t": "outlier", "aka": ["AdaLN", "adaLN-Zero"] },
    { "a": "Conditional batch normalization", "t": "outlier", "aka": ["CBN", "conditional BatchNorm"] },
    { "a": "SPADE", "t": "outlier", "aka": ["spatially-adaptive normalization", "spatially-adaptive denormalization"] },
    { "a": "Pixel normalization", "t": "outlier", "aka": ["PixelNorm", "pixelwise feature vector normalization"] },
    { "a": "Weight demodulation", "t": "outlier", "aka": ["demodulation", "modulated convolution"], "q": "StyleGAN2 baked AdaIN into the conv weights to get rid of the water-droplet artifacts." },
    { "a": "Filter response normalization", "t": "outlier", "aka": ["FRN"] },
    { "a": "EvoNorm", "t": "outlier", "aka": ["EvoNorm-B0", "EvoNorm-S0"], "q": "Found by evolutionary search over joint normalization-activation layers (Liu et al. 2020)." },
    { "a": "Switchable normalization", "t": "outlier", "aka": ["SwitchNorm"] },
    { "a": "DeepNorm", "t": "outlier", "aka": ["DeepNet"], "q": "Up-weights the residual before Post-LN. Trained a 1,000-layer Transformer." },
    { "a": "ZCA whitening", "t": "outlier", "aka": ["whitening", "PCA whitening"] },
    { "a": "Virtual batch normalization", "t": "outlier", "aka": ["VBN"], "q": "Normalize against a reference batch chosen once at the start. One of Salimans et al.'s GAN tricks." },
    { "a": "Self-normalizing networks", "t": "outlier", "aka": ["SELU", "self-normalization", "SNN"], "q": "No norm layers at all: SELU's fixed point pulls activations to zero mean, unit variance by itself." },
    { "a": "Dynamic Tanh", "t": "outlier", "aka": ["DyT"], "q": "tanh(αx) in place of LayerNorm: \"Transformers without Normalization\" (2025). Not a norm, strictly. We'll allow it." },
    { "a": "Equalized learning rate", "t": "outlier", "aka": ["equalized LR"], "q": "ProGAN rescales weights by He's constant at runtime, not at init, so Adam treats every layer alike." },

    { "a": "Instance normalization", "t": "indist", "aka": ["InstanceNorm", "IN", "InstanceNorm2d"], "q": "Per-sample, per-channel statistics. \"The missing ingredient for fast stylization.\"" },
    { "a": "Weight normalization", "t": "indist", "aka": ["WeightNorm", "WN"] },
    { "a": "Spectral normalization", "t": "indist", "aka": ["SpectralNorm", "SN"], "q": "Divide each weight matrix by its largest singular value. Keeps GAN discriminators roughly 1-Lipschitz." },
    { "a": "Local response normalization", "t": "indist", "aka": ["LRN", "LocalResponseNorm", "CrossMapLRN2d"], "q": "AlexNet's lateral-inhibition trick, quietly dropped once VGG reported it didn't help." },
    { "a": "Adaptive instance normalization", "t": "indist", "aka": ["AdaIN"], "q": "Swap in the style image's channel mean and std. Arbitrary style transfer in real time, then StyleGAN." },
    { "a": "L2 normalization", "t": "indist", "aka": ["L2 norm", "unit normalization", "unit-norm embeddings"] },
    { "a": "Standardization", "t": "indist", "aka": ["standardisation", "z-score normalization", "standard scaling", "StandardScaler", "input normalization"] },
    { "a": "Min-max normalization", "t": "indist", "aka": ["min-max scaling", "MinMaxScaler", "rescaling"] },

    { "a": "RMSNorm", "t": "overfit", "aka": ["RMS normalization", "root mean square normalization", "root mean square layer normalization"], "q": "LayerNorm without the mean-centering. Cheaper, and now inside nearly every LLM." },
    { "a": "Group normalization", "t": "overfit", "aka": ["GroupNorm", "GN"], "q": "Wu & He 2018: BatchNorm that ignores batch size. Detection heads and diffusion U-Nets love it." },

    { "a": "Batch normalization", "t": "baseline", "aka": ["BatchNorm", "BN", "BatchNorm1d", "BatchNorm2d", "BatchNorm3d"] },
    { "a": "Layer normalization", "t": "baseline", "aka": ["LayerNorm", "LN"] }
  ]
}
