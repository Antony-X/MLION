    { "a": "Virtual batch normalization", "t": "outlier", "aka": ["VBN"], "q": "Normalize against a reference batch chosen once at the start. One of Salimans et al.'s GAN tricks." },
    { "a": "Self-normalizing networks", "t": "outlier", "aka": ["SELU", "self-normalization", "SNN", "SELU network", "scaled exponential linear unit normalization"], "q": "No norm layers at all: SELU's fixed point pulls activations to zero mean, unit variance by itself." },
