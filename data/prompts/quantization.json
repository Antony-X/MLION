    { "a": "INT4", "t": "indist", "aka": ["4-bit integer", "4-bit"] },
    { "a": "FP8", "t": "indist", "aka": ["float8", "E4M3", "E5M2", "8-bit floating point"], "q": "E4M3 for weights and activations, E5M2 for gradients. Hopper made it mainstream." },
    { "a": "FP16", "t": "indist", "aka": ["half precision", "float16"] },
