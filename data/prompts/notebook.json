    { "a": "IPython", "t": "indist", "aka": ["ipython shell", "ipython notebook"], "q": "Fernando Pérez's 2001 grad-school side project, and Jupyter's ancestor." },
    { "a": "VS Code", "t": "indist", "aka": ["visual studio code", "vscode"] },
    { "a": "Databricks Notebooks", "t": "indist", "aka": ["databricks"] },
    { "a": "RStudio", "t": "indist", "aka": ["posit", "rstudio ide", "posit workbench"], "q": "Made by a company that renamed itself Posit in 2022." },
    { "a": "R Markdown", "t": "indist", "aka": ["rmd", "rmarkdown", "r notebook"] },
    { "a": "Quarto", "t": "indist" },
