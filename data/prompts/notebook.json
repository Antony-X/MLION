  "answers": [
    { "a": "Org mode", "t": "mlion", "aka": ["org-babel", "org babel", "emacs org mode", "orgmode"], "q": "Emacs plain-text outlines with runnable code blocks. Literate notebooks from before Jupyter had a name." },

    { "a": "Iodide", "t": "longtail", "q": "Mozilla's 2019 in-browser notebook. It faded, but its spin-off Pyodide lives on." },
    { "a": "Starboard", "t": "longtail", "aka": ["starboard.gg"] },
    { "a": "Gorilla REPL", "t": "longtail" },
    { "a": "Clerk", "t": "longtail" },
    { "a": "Nextjournal", "t": "longtail" },
    { "a": "Hydrogen", "t": "longtail", "aka": ["atom hydrogen"] },
    { "a": "EIN", "t": "longtail", "aka": ["emacs ipython notebook", "emacs ein"] },
    { "a": "Spark Notebook", "t": "longtail" },
    { "a": "Apache Toree", "t": "longtail", "aka": ["toree"] },
    { "a": "BeakerX", "t": "longtail", "aka": ["beaker notebook", "beaker"] },
    { "a": "Polynote", "t": "longtail", "q": "Netflix's polyglot, Scala-first notebook." },
    { "a": "Noteable", "t": "longtail" },
    { "a": "Google Cloud Datalab", "t": "longtail", "aka": ["datalab", "cloud datalab"] },
    { "a": "Azure Notebooks", "t": "longtail" },
    { "a": "Kotlin Notebook", "t": "longtail" },
    { "a": "Polyglot Notebooks", "t": "longtail", "aka": [".net interactive", "dotnet interactive", "try .net"] },
    { "a": "Maple", "t": "longtail", "aka": ["maple worksheet"] },
    { "a": "Mathcad", "t": "longtail", "aka": ["ptc mathcad"] },
    { "a": "Wolfram Cloud", "t": "longtail" },
    { "a": "bpython", "t": "longtail" },
    { "a": "ptpython", "t": "longtail" },
    { "a": "IDLE", "t": "longtail", "aka": ["python idle"] },
    { "a": "Paperspace Gradient", "t": "longtail", "aka": ["gradient"] },
    { "a": "Lightning Studio", "t": "longtail", "aka": ["lightning ai studio", "lightning studios"] },
    { "a": "Positron", "t": "longtail" },

    { "a": "Pluto.jl", "t": "outlier", "aka": ["pluto"], "q": "Reactive Julia notebooks: change one cell and its dependents rerun. No stale state." },
    { "a": "Binder", "t": "outlier", "aka": ["mybinder", "mybinder.org"], "q": "Turn any GitHub repo into a live notebook with one link." },
    { "a": "Hex", "t": "outlier" },
    { "a": "Observable", "t": "outlier", "aka": ["observablehq", "observable framework"], "q": "Reactive JavaScript notebooks from D3's creator, Mike Bostock." },
    { "a": "MATLAB Live Editor", "t": "outlier", "aka": ["live script", "live scripts", "matlab live script", "matlab"] },
    { "a": "nteract", "t": "outlier" },
    { "a": "IJulia", "t": "outlier" },
    { "a": "DataSpell", "t": "outlier" },
    { "a": "Datalore", "t": "outlier" },
    { "a": "Vertex AI Workbench", "t": "outlier", "aka": ["vertex workbench", "ai platform notebooks", "colab enterprise"] },
    { "a": "CoCalc", "t": "outlier", "aka": ["sagemathcloud"], "q": "Collaborative Jupyter in the browser, formerly SageMathCloud." },
    { "a": "SageMath", "t": "outlier", "aka": ["sage", "sage notebook"] },
    { "a": "JupyterLite", "t": "outlier" },
