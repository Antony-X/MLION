    { "a": "JupyterHub", "t": "indist" },
    { "a": "SageMaker Studio", "t": "indist", "aka": ["sagemaker notebooks", "sagemaker studio lab", "amazon sagemaker"] },
    { "a": "PyCharm", "t": "indist", "aka": ["pycharm scientific mode"] },

    { "a": "Mathematica", "t": "overfit", "aka": ["wolfram notebook", "wolfram mathematica", "wolfram language"], "q": "Wolfram shipped notebooks in 1988. Everyone else is still catching up, says Wolfram." },
    { "a": "marimo", "t": "overfit", "q": "Reactive Python notebooks saved as plain .py files. Git-friendly, no hidden state." },

    { "a": "Jupyter Notebook", "t": "baseline", "aka": ["jupyter", "jupyter classic", "ipynb"], "q": "Named for Julia, Python and R, with a nod to Galileo's notebooks on Jupiter's moons." },
    { "a": "JupyterLab", "t": "baseline", "aka": ["jupyter lab"] },
    { "a": "Google Colab", "t": "baseline", "aka": ["colab", "colaboratory", "colab pro"], "q": "Google's hosted Jupyter, loved for free GPUs and feared for its timeouts." },
    { "a": "Kaggle Notebooks", "t": "baseline", "aka": ["kaggle", "kaggle kernels"] }
