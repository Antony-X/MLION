    { "a": "Skewness", "t": "indist", "aka": ["skew", "window skewness", "third moment"], "q": "Asymmetry: positive when the right tail is longer." },
    { "a": "Kurtosis", "t": "indist", "aka": ["kurt", "window kurtosis", "fourth moment"], "q": "How heavy the tails are. A normal distribution has kurtosis 3." },
    { "a": "Variance", "t": "indist", "aka": ["window variance", "second moment"] },

