{
  "id": "ts-feature",
  "pack": "classic",
  "text": "Name a feature-engineering technique for time series",
  "note": "A hand-crafted or learned feature, or a transform that yields features, from a series or its timestamps: windows, lags, calendar, spectral, entropy",
  "strip": ["feature", "features", "engineering", "technique"],
  "answers": [
    { "a": "Gramian angular field", "t": "mlion", "aka": ["GAF", "Gramian angular summation field", "GASF", "Gramian angular difference field", "GADF", "angular field"], "q": "Rescale to [-1, 1], read values as angles, take a Gram matrix: the series becomes an image for a CNN." },

    { "a": "Lag features", "t": "baseline", "aka": ["lags", "lagged values", "lag variables", "autoregressive features", "lagged features", "lagged target", "lag"], "q": "The value k steps ago, as a column. Where most forecasting pipelines begin." },
    { "a": "Rolling mean", "t": "baseline", "aka": ["moving average", "rolling average", "SMA", "simple moving average", "window mean", "moving mean", "running mean", "rolling window mean", "moving average smoothing"], "q": "Average of the last w points. Centre the window and you've leaked the future." },
    { "a": "Sliding window", "t": "baseline", "aka": ["rolling window", "windowing", "window features", "windowed features", "windows", "sliding windows", "rolling windows", "window slicing"], "q": "Overlapping chunks of the series: the input format of nearly every sequence model." },
    { "a": "Differencing", "t": "baseline", "aka": ["first difference", "first differencing", "diff", "differences", "first-order differencing", "lag-1 difference", "second difference", "second-order differencing", "second order differencing", "double differencing"], "q": "Subtract the previous value. The cheap route to stationarity." },
    { "a": "Calendar features", "t": "baseline", "aka": ["date features", "datetime features", "time features", "date parts", "timestamp features", "datetime components", "date-time features", "time-based features", "datetime feature extraction", "temporal features", "date components"], "q": "Hour, weekday, month, end-of-quarter flags: the timestamp, unpacked." },

    { "a": "Fourier transform", "t": "overfit", "aka": ["FFT", "fast Fourier transform", "DFT", "discrete Fourier transform", "Fourier features", "Fourier terms", "Fourier coefficients", "FFT coefficients", "Fourier series", "harmonic features", "harmonics", "frequency domain features", "spectral features"], "q": "Typed to look clever. In practice you keep a few coefficients or sin/cos terms, not the whole spectrum." },
    { "a": "Wavelet transform", "t": "overfit", "aka": ["wavelets", "DWT", "CWT", "wavelet coefficients", "discrete wavelet transform", "continuous wavelet transform", "wavelet features", "wavelet decomposition", "scalogram"], "q": "Time-frequency features at several scales. Named often, used rarely." },

    { "a": "Rolling standard deviation", "t": "indist", "aka": ["rolling std", "moving standard deviation", "moving std", "rolling volatility", "rolling stdev", "window std", "running standard deviation", "std", "standard deviation"], "q": "Volatility over a moving window." },
    { "a": "Exponentially weighted moving average", "t": "indist", "aka": ["EWMA", "EMA", "exponential moving average", "exponential smoothing", "exponentially weighted mean", "exponentially weighted features", "ewm"], "q": "A moving average whose weights decay geometrically with age. One parameter, alpha." },
    { "a": "Expanding mean", "t": "indist", "aka": ["expanding window", "expanding window features", "cumulative mean", "expanding statistics", "running average", "expanding average"], "q": "The mean of all values up to now, which never peeks at the future." },
    { "a": "Autocorrelation", "t": "indist", "aka": ["ACF", "autocorrelation features", "serial correlation", "autocorrelation coefficient", "lag autocorrelation", "autocorrelation function", "autocorrelation at lag k"], "q": "Correlation of a series with a shifted copy of itself. Seasonality shows up as periodic spikes." },
    { "a": "Summary statistics", "t": "indist", "aka": ["descriptive statistics", "aggregate statistics", "basic statistics", "global statistics", "statistical features", "aggregations", "aggregate features", "window statistics", "mean median std min max"] },
    { "a": "Statistical moments", "t": "indist", "aka": ["moment features", "statistical moment features", "higher-order moments", "mean variance skewness kurtosis", "first four moments", "moments"], "q": "Mean, variance, skewness, kurtosis: the cheapest description of a window's shape." },
    { "a": "Day of week", "t": "indist", "aka": ["weekday", "dow", "day-of-week", "day of the week", "weekday feature"], "q": "Weekly patterns: Mondays and Sundays rarely look alike. Encode as categories or cyclically." },
    { "a": "Month of year", "t": "indist", "aka": ["month", "month feature", "month number"] },
    { "a": "Hour of day", "t": "indist", "aka": ["hour", "hour feature", "hour of the day", "time of day", "part of day", "daypart"], "q": "Daily cycles. Encode with sine and cosine so 23:00 sits next to 00:00." },
    { "a": "Is weekend", "t": "indist", "aka": ["weekend flag", "weekend indicator", "weekend", "is_weekend", "weekend dummy"] },
    { "a": "Holiday indicator", "t": "indist", "aka": ["is holiday", "holiday flag", "holiday features", "public holiday indicator", "is_holiday", "holidays", "holiday dummy", "holiday effects"], "q": "A flag for holidays, which break the usual weekly pattern." },
    { "a": "Cyclical encoding", "t": "indist", "aka": ["sine cosine encoding", "sin cos transform", "cyclic encoding", "cyclical features", "sin/cos encoding", "trigonometric encoding", "cyclic features", "circular encoding", "sin cos features"], "q": "Hour 23 sits next to hour 0 once you map it onto a circle with sin and cos." },
    { "a": "Time index", "t": "indist", "aka": ["trend term", "time counter", "time step index", "elapsed time since start", "trend feature", "time trend", "timestep", "linear time trend", "running index", "trend line", "time since start"] },
    { "a": "Percent change", "t": "indist", "aka": ["pct_change", "returns", "rate of change", "percentage change", "growth rate", "percent returns", "relative change"], "q": "(xₜ − xₜ₋₁)/xₜ₋₁: relative change, free of scale." },
    { "a": "Log returns", "t": "indist", "aka": ["log difference", "log-returns", "logarithmic returns", "log return", "log differencing"], "q": "log(p_t / p_t-1). Additive over time, which simple returns are not." },
    { "a": "Seasonal differencing", "t": "indist", "aka": ["seasonal difference", "lag-s differencing", "seasonal differences", "seasonal lag difference"], "q": "Subtract the value one season ago, xₜ − xₜ₋₁₂ for monthly data." },
    { "a": "Detrending", "t": "indist", "aka": ["detrend", "trend removal", "remove trend", "trend subtraction", "trend elimination", "detrended series", "detrended"], "q": "Remove the long-run trend so the rest, seasonality and noise, can be modelled." },
    { "a": "STL decomposition", "t": "indist", "aka": ["seasonal-trend decomposition", "seasonal decomposition", "classical decomposition", "time series decomposition", "decomposition", "trend seasonal residual", "seasonal decompose", "trend/seasonal/residual components", "STL"], "q": "Seasonal-Trend decomposition using Loess. Trend, season and residual become three features." },
    { "a": "Seasonal dummies", "t": "indist", "aka": ["seasonality", "seasonal features", "seasonal component", "seasonal indicators", "month dummies", "seasonal one-hot", "seasonality indicators", "seasonal indicator variables", "seasonal dummy variables", "one-hot encoded calendar", "season of year"], "q": "One indicator per month or weekday, so a linear model learns each one's level." },
    { "a": "Rolling median", "t": "indist", "aka": ["moving median", "median filter", "running median", "window median"] },
    { "a": "Rolling max", "t": "indist", "aka": ["rolling maximum", "moving maximum", "moving max", "window max", "running max"] },
    { "a": "Rolling min", "t": "indist", "aka": ["rolling minimum", "moving minimum", "moving min", "window min", "running min"] },
