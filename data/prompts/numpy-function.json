    { "a": "array", "t": "baseline", "q": "Copies its input by default. Ragged lists now raise an error instead of quietly becoming object arrays." },
    { "a": "zeros", "t": "baseline", "q": "np.zeros(3, 4) fails: the shape is one tuple, np.zeros((3, 4))." },
