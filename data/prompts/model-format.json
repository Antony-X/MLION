{
  "id": "model-format",
  "pack": "stack",
  "text": "Name a model or tensor file format",
  "note": "Formats for saving or shipping model weights, graphs, checkpoints or tensor data (ONNX, safetensors, GGUF, .pt, .h5, SavedModel, ...)",
  "strip": ["format", "file", "files", "extension"],
  "answers": [
    { "a": "llamafile", "t": "mlion", "aka": ["llama file", "mozilla llamafile"], "q": "Weights glued to a Cosmopolitan libc binary: one file that runs on six operating systems." },

    { "a": "Caffe2 protobuf", "t": "longtail", "aka": ["init_net.pb", "predict_net.pb", "caffe2 model"] },
    { "a": "torch.package", "t": "longtail" },
    { "a": "PyTorch Distributed Checkpoint", "t": "longtail", "aka": ["DCP", "torch.distributed.checkpoint"] },
    { "a": "Orbax", "t": "longtail", "aka": ["orbax checkpoint"] },
    { "a": "Flax msgpack", "t": "longtail", "aka": ["msgpack", "flax serialization"] },
    { "a": "NeMo checkpoint", "t": "longtail", "aka": [".nemo", "nemo"] },
    { "a": "MLflow MLmodel", "t": "longtail", "aka": ["mlflow model"] },
    { "a": "PFA", "t": "longtail", "aka": ["portable format for analytics"] },
    { "a": "MLeap bundle", "t": "longtail", "aka": ["mleap"] },
    { "a": "skops", "t": "longtail", "aka": [".skops"] },
    { "a": "XGBoost UBJSON", "t": "longtail", "aka": [".ubj", "ubjson", "xgboost json", "xgboost model"] },
    { "a": "WebDataset", "t": "longtail", "aka": ["wds", "tar shards"] },
    { "a": "LMDB", "t": "longtail", "aka": ["lightning memory-mapped database"] },
    { "a": "RecordIO", "t": "longtail", "aka": [".rec", "mxnet recordio"] },
    { "a": "FlatBuffers", "t": "longtail", "aka": ["flatbuffer", ".fbs"] },
    { "a": "Parquet", "t": "longtail", "aka": [".parquet", "apache parquet"] },
    { "a": "ORT format", "t": "longtail", "aka": [".ort", "onnx runtime format"] },
    { "a": "MindIR", "t": "longtail", "aka": [".mindir"] },
    { "a": "MNN model", "t": "longtail", "aka": [".mnn", "mnn"] },
    { "a": "NNEF", "t": "longtail", "aka": ["neural network exchange format"] },

    { "a": "Caffe model", "t": "outlier", "aka": [".caffemodel", "caffemodel", "prototxt", ".prototxt"], "q": "Network in a prototxt, weights in a .caffemodel. Model Zoo classics." },
    { "a": "Darknet weights", "t": "outlier", "aka": [".weights", "darknet cfg", "yolo weights", "darknet"], "q": "YOLO's raw float dump, paired with a .cfg text file." },
    { "a": "Torch7 .t7", "t": "outlier", "aka": [".t7", "t7", "lua torch"], "q": "Lua Torch's serialization. Old style-transfer repos still ship them." },
    { "a": "MXNet params", "t": "outlier", "aka": [".params", "mxnet symbol json", "mxnet"] },
    { "a": "PaddlePaddle model", "t": "outlier", "aka": [".pdmodel", ".pdparams", "paddle"] },
    { "a": "ncnn model", "t": "outlier", "aka": ["ncnn", "ncnn param"] },
    { "a": "ExecuTorch .pte", "t": "outlier", "aka": [".pte", "pte", "executorch"] },
    { "a": "torch.export", "t": "outlier", "aka": [".pt2", "pt2", "exportedprogram", "exported program"] },
    { "a": "EXL2", "t": "outlier", "aka": ["exllamav2", "exllama"], "q": "ExLlamaV2's mixed-bit quant format: pick an average bits-per-weight, any average." },
    { "a": "StableHLO", "t": "outlier", "aka": ["HLO", "xla hlo", "mhlo"] },
    { "a": "TensorFlow.js format", "t": "outlier", "aka": ["model.json", "tfjs", "tfjs layers model", "tfjs graph model"] },
    { "a": "H2O MOJO", "t": "outlier", "aka": ["MOJO", "POJO", "h2o pojo"], "q": "H2O's 'Model Object, Optimized', ready to drop into a JVM." },
    { "a": "Zarr", "t": "outlier" },
    { "a": "NetCDF", "t": "outlier", "aka": [".nc", "network common data form"] },
    { "a": "MAT-file", "t": "outlier", "aka": [".mat", "matlab mat", "mat"] },
    { "a": "Apache Arrow", "t": "outlier", "aka": ["arrow", "feather", "arrow ipc"] },

    { "a": "SavedModel", "t": "indist", "aka": ["tensorflow savedmodel", "saved_model.pb", "tf savedmodel", "saved model"] },
    { "a": "TFLite", "t": "indist", "aka": ["tensorflow lite", ".tflite", "litert", "tf lite"] },
    { "a": "Core ML", "t": "indist", "aka": [".mlmodel", ".mlpackage", "mlmodel", "mlpackage"] },
    { "a": "TorchScript", "t": "indist", "aka": ["torch.jit", "jit", ".ptl", "scripted model"], "q": "PyTorch minus Python: a serializable, JIT-able subset of the language." },
    { "a": "NumPy .npy", "t": "indist", "aka": [".npy", "npy", ".npz", "npz", "numpy array"] },
    { "a": "GGML", "t": "indist", "aka": ["ggjt", "ggmf", "ggml bin"], "q": "Gerganov's original llama.cpp format, retired in 2023 in favor of GGUF." },
    { "a": "joblib", "t": "indist", "aka": [".joblib"] },
    { "a": "Keras format", "t": "indist", "aka": [".keras", "keras v3", "keras zip"] },
    { "a": "TensorFlow checkpoint", "t": "indist", "aka": [".ckpt", "ckpt", "tf checkpoint", "checkpoint"] },
    { "a": "Frozen graph", "t": "indist", "aka": [".pb", "pb", "protobuf", "graphdef", "frozen graphdef", "protocol buffers"], "q": "TF1's variables baked into constants and shipped as one .pb." },
    { "a": "TFRecord", "t": "indist", "aka": [".tfrecord", "tfrecords"] },
    { "a": "PMML", "t": "indist", "aka": ["predictive model markup language"], "q": "XML for predictive models, around since 1997. Your bank probably still uses it." },
    { "a": "TensorRT engine", "t": "indist", "aka": [".engine", ".plan", "trt engine", "tensorrt plan", "tensorrt"] },
    { "a": "OpenVINO IR", "t": "indist", "aka": ["openvino", "intermediate representation"] },

    { "a": "GGUF", "t": "overfit", "aka": [".gguf"], "q": "llama.cpp's one-blob format: weights, tokenizer and metadata together. GGML's successor." },

    { "a": "ONNX", "t": "baseline", "aka": ["open neural network exchange", ".onnx", "onnx-ml"], "q": "Facebook and Microsoft's 2017 lingua franca for moving models between frameworks." },
    { "a": "Pickle", "t": "baseline", "aka": [".pkl", "pkl", "cloudpickle", "dill"], "q": "Loading one can execute arbitrary code. That's why safetensors exists." },
    { "a": "PyTorch .pt", "t": "baseline", "aka": [".pt", ".pth", "pt", "pth", "torch.save", "pytorch checkpoint", "state_dict", "pytorch state dict", "pytorch_model.bin"] },
    { "a": "HDF5", "t": "baseline", "aka": [".h5", "h5", "hdf", ".hdf5", "keras h5", "hierarchical data format"], "q": "The .h5 Keras used for years, born at NCSA for supercomputer data." },
    { "a": "safetensors", "t": "baseline", "aka": [".safetensors"], "q": "Hugging Face's no-code-execution weight format: a JSON header, then raw bytes." }
  ]
}
