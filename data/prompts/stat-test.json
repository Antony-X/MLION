    { "a": "Paired t-test", "t": "indist", "aka": ["paired t", "dependent t-test", "paired samples t-test"] },
    { "a": "Welch's t-test", "t": "indist", "aka": ["welch", "welch t-test", "unequal variances t-test"], "q": "The t-test that doesn't assume equal variances. Should probably be your default." },
    { "a": "F-test", "t": "indist", "aka": ["f test", "variance ratio test"] },
    { "a": "Mann–Whitney U", "t": "indist", "aka": ["mann whitney", "mann-whitney u test", "U test", "wilcoxon rank-sum", "wilcoxon rank sum", "MWU"], "q": "Do values from one group tend to beat values from the other? Ranks only." },
    { "a": "Wilcoxon signed-rank", "t": "indist", "aka": ["wilcoxon", "wilcoxon signed rank", "signed-rank"], "q": "The paired t-test's nonparametric twin, and Demšar's pick for two classifiers over many datasets." },
    { "a": "Shapiro–Wilk", "t": "indist", "aka": ["shapiro wilk", "SW test"], "q": "The go-to normality test, and the one that rejects everything once n is large." },
    { "a": "Kruskal–Wallis", "t": "indist", "aka": ["kruskal wallis", "H test", "kruskal-wallis h"], "q": "One-way ANOVA on ranks. No normality required." },
    { "a": "McNemar's test", "t": "indist", "aka": ["mcnemar"], "q": "Two classifiers, same test set: count where exactly one is right. Dietterich's recommendation, 1998." },
