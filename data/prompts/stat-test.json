    { "a": "Grubbs' test", "t": "outlier", "aka": ["grubbs", "maximum normed residual test"], "q": "Is the most extreme point an outlier? One at a time, assuming normality." },
    { "a": "SPRT", "t": "outlier", "aka": ["sequential probability ratio test", "wald's sequential test", "sequential test"], "q": "Wald, 1945: stop the moment the evidence is strong enough. Classified during the war for being too useful." },
