    { "a": "Permutation test", "t": "indist", "aka": ["randomization test", "exact permutation test", "re-randomization test"], "q": "Shuffle the labels a thousand times and see how often chance does as well. Fisher's tea lady approved." },
    { "a": "Binomial test", "t": "indist", "aka": ["exact binomial test", "binomial"] },
    { "a": "Friedman test", "t": "indist", "aka": ["friedman"], "q": "Rank-based repeated-measures ANOVA. Yes, by Milton Friedman, before the economics." },
    { "a": "Levene's test", "t": "indist", "aka": ["levene"] },
    { "a": "Tukey's HSD", "t": "indist", "aka": ["tukey", "tukey hsd", "honestly significant difference", "tukey-kramer"] },

    { "a": "Kolmogorov–Smirnov", "t": "overfit", "aka": ["KS", "KS test", "kolmogorov smirnov", "two-sample KS", "kolmogorov"], "q": "The largest gap between two CDFs. The nonparametric answer everyone has ready." },
    { "a": "Fisher's exact test", "t": "overfit", "aka": ["fisher's exact", "fisher exact", "fisher", "exact test"], "q": "Born from a lady who claimed she could tell if the milk went in first. She got all eight cups right." },

    { "a": "t-test", "t": "baseline", "aka": ["student's t-test", "t test", "student t-test", "two-sample t-test", "one-sample t-test", "student"], "q": "Gosset's small-sample test, published as 'Student' because Guinness said so." },
    { "a": "Chi-squared test", "t": "baseline", "aka": ["chi-square test", "χ² test", "chi2", "pearson's chi-squared", "chi-squared test of independence", "chi-squared goodness of fit"], "q": "Karl Pearson, 1900: sum of (observed − expected)² / expected." },
    { "a": "ANOVA", "t": "baseline", "aka": ["analysis of variance", "one-way anova", "two-way anova", "repeated measures anova"], "q": "Fisher's analysis of variance, born at Rothamsted's agricultural experiments." },
