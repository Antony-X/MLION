{
  "id": "nn-family",
  "pack": "blocks",
  "text": "Name a type of neural network",
  "note": "Broad architecture families, not specific named models: CNN yes, ResNet-50 or GPT-4 no. Historical, exotic and hardware-flavored types count.",
  "strip": ["network", "networks", "neural", "net", "nets", "nn", "model", "models"],
  "answers": [
    { "a": "Neural cellular automata", "t": "mlion", "aka": ["NCA", "neural cellular automaton", "growing neural cellular automata"], "q": "Every pixel runs the same tiny net. Train it right and it grows a lizard emoji, then regrows its tail." },

    { "a": "MLP", "t": "baseline", "aka": ["multilayer perceptron", "multi-layer perceptron", "feedforward", "feedforward neural network", "feed-forward network", "FFN", "FNN", "FFNN", "fully connected network", "dense network", "DNN", "deep neural network", "ANN", "artificial neural network", "vanilla neural network"], "q": "The universal approximator: one hidden layer is enough in theory, never in practice." },
    { "a": "CNN", "t": "baseline", "aka": ["convolutional neural network", "convolutional", "ConvNet", "convnet", "1D CNN", "2D CNN", "3D CNN", "3D convolutional network"], "q": "LeCun's nets read checks in the '90s. AlexNet made everyone care in 2012." },
    { "a": "RNN", "t": "baseline", "aka": ["recurrent neural network", "recurrent", "vanilla RNN", "stacked RNN", "deep RNN", "multi-layer RNN", "multilayer RNN"], "q": "One set of weights reused at every time step, with a hidden state carrying the past. Trained by backpropagation through time." },
    { "a": "Transformer", "t": "baseline", "aka": ["transformers", "attention network", "self-attention network"], "q": "\"Attention Is All You Need\", 2017. Turned out to be roughly true." },
    { "a": "LSTM", "t": "baseline", "aka": ["long short-term memory", "long short term memory", "peephole LSTM", "stacked LSTM", "deep LSTM"], "q": "Hochreiter & Schmidhuber, 1997. Schmidhuber would like you to remember that." },
    { "a": "GAN", "t": "baseline", "aka": ["generative adversarial network", "generative adversarial"], "q": "Goodfellow, an argument at a bar, and one night of coding in 2014." },

    { "a": "Capsule network", "t": "overfit", "aka": ["CapsNet", "capsule", "capsules", "dynamic routing between capsules"], "q": "Hinton called pooling \"a big mistake\". Routing-by-agreement was the fix everyone tried in 2017, then forgot." },
    { "a": "Spiking neural network", "t": "overfit", "aka": ["SNN", "spiking", "neuromorphic network", "third generation neural network"], "q": "Neurons that talk in discrete spikes over time. Brain-like, neuromorphic, and a pain to backprop through." },

    { "a": "GRU", "t": "indist", "aka": ["gated recurrent unit"], "q": "Cho et al., 2014: an LSTM with two gates and no separate cell state. Fewer parameters, often just as good." },
    { "a": "Autoencoder", "t": "indist", "aka": ["AE", "auto-encoder", "autoencoders", "convolutional autoencoder", "undercomplete autoencoder", "deep autoencoder"], "q": "Compress the input to a small code, then reconstruct it from that code." },
    { "a": "VAE", "t": "indist", "aka": ["variational autoencoder", "variational auto-encoder"], "q": "Kingma & Welling's reparameterization trick made the latent space trainable." },
    { "a": "GNN", "t": "indist", "aka": ["graph neural network", "graph"], "q": "Nodes update by passing messages to their neighbours, one layer at a time." },
    { "a": "Hopfield network", "t": "indist", "aka": ["Hopfield", "Hopfield net"], "q": "Associative memory from 1982. Hopfield shared the 2024 physics Nobel with Hinton." },
    { "a": "RBM", "t": "indist", "aka": ["restricted Boltzmann machine"], "q": "Restricted so inference is easy, then stacked into the deep belief nets of 2006." },
    { "a": "Boltzmann machine", "t": "indist", "aka": ["BM", "Boltzmann"], "q": "Hinton & Sejnowski's stochastic net, cited in Hinton's 2024 physics Nobel." },
    { "a": "Deep belief network", "t": "indist", "aka": ["DBN", "deep belief net"], "q": "Hinton, Osindero & Teh 2006: greedy layer-wise pretraining, and deep learning's comeback." },
    { "a": "Perceptron", "t": "indist", "aka": ["single-layer perceptron", "Rosenblatt perceptron", "Mark I Perceptron", "single-layer neural network", "single layer neural network"], "q": "Rosenblatt's 1958 machine. Minsky & Papert's 1969 XOR critique helped freeze the field." },
    { "a": "Self-organizing map", "t": "indist", "aka": ["SOM", "Kohonen map", "Kohonen network", "self-organising map", "Kohonen"], "q": "Kohonen's map squashes data onto a 2D grid while keeping neighbors neighbors." },
    { "a": "Siamese network", "t": "indist", "aka": ["siamese", "twin network"], "q": "Two towers, shared weights, compare the outputs. Bromley et al. verified signatures with one in 1993." },
    { "a": "Encoder-decoder", "t": "indist", "aka": ["seq2seq", "sequence-to-sequence", "encoder decoder network", "sequence to sequence"], "q": "One network reads the input into a representation, another writes the output from it: T5, the original transformer." },
    { "a": "Diffusion model", "t": "indist", "aka": ["diffusion", "denoising diffusion", "denoising diffusion probabilistic model", "score-based model", "score-based generative model"], "q": "Learn to undo noise step by step, then generate by denoising pure noise. Ho et al., 2020 (DDPM)." },
    { "a": "Mixture of experts", "t": "indist", "aka": ["MoE", "sparse mixture of experts", "mixture-of-experts", "Switch transformer"], "q": "Jacobs, Jordan, Nowlan & Hinton, 1991. Now how trillion-parameter models run only a sliver per token." },
    { "a": "Kolmogorov-Arnold network", "t": "indist", "aka": ["KAN", "Kolmogorov Arnold network"], "q": "Learnable activations on edges, plain sums on nodes. 2024's MLP challenger owned Twitter for a month." },
    { "a": "Bayesian neural network", "t": "indist", "aka": ["BNN", "Bayesian NN", "bayesian"], "q": "Distributions over the weights instead of single values, so predictions come with uncertainty." },
    { "a": "Vision transformer", "t": "indist", "aka": ["ViT", "vision transformers"], "q": "Dosovitskiy et al., 2020: cut the image into 16×16 patches and treat them as tokens." },
    { "a": "Large language model", "t": "indist", "aka": ["LLM", "language model"], "q": "A transformer trained to predict the next token on trillions of tokens of text." },
    { "a": "Residual network", "t": "indist", "aka": ["ResNet", "residual", "residual neural network"], "q": "Blocks compute x + F(x), so gradients flow straight through the skips." },
    { "a": "U-Net", "t": "indist", "aka": ["UNet"], "q": "Built for biomedical segmentation in 2015, now the denoiser inside most diffusion models." },
    { "a": "State space model", "t": "indist", "aka": ["SSM", "structured state space model", "state-space model", "deep state space model", "Mamba", "S4", "S5", "selective state space model", "structured state space sequence model", "structured state space"], "q": "A linear recurrence that can also run as one long convolution. S4 (2021), then Mamba (2023) with input-dependent dynamics." },
    { "a": "Graph convolutional network", "t": "indist", "aka": ["GCN", "graph convolutional"], "q": "Kipf & Welling, 2016: each layer averages neighbours' features through a normalized adjacency matrix." },
    { "a": "Normalizing flow", "t": "indist", "aka": ["flow", "flow-based model", "flows", "invertible neural network", "INN", "continuous normalizing flow", "CNF"], "q": "A chain of invertible maps from a simple density, so the exact likelihood is computable. RealNVP, Glow." },

    { "a": "RBF network", "t": "outlier", "aka": ["radial basis function network", "RBFN", "radial basis network"] },
