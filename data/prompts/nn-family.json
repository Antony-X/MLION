    { "a": "Elman network", "t": "outlier", "aka": ["simple recurrent network", "SRN", "Elman RNN", "Elman"] },
    { "a": "Neural Turing machine", "t": "outlier", "aka": ["NTM"], "q": "Graves et al. 2014: a controller with a differentiable tape. It learned to copy and sort." },
    { "a": "Memory network", "t": "outlier", "aka": ["MemNN", "end-to-end memory network", "MemN2N", "memory networks", "memory-augmented neural network", "MANN"] },
    { "a": "Pointer network", "t": "outlier", "aka": ["Ptr-Net", "pointer net"], "q": "Point at input positions instead of a fixed vocabulary. Vinyals et al. solved small TSPs with it." },
