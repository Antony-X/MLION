{
  "id": "fairness-metric",
  "pack": "theory",
  "text": "Name a fairness criterion or metric",
  "note": "Group, individual, causal and ranking fairness criteria, plus the bias metrics and benchmarks used to measure them",
  "strip": ["metric", "criterion", "fairness", "measure"],
  "answers": [
    { "a": "Rich subgroup fairness", "t": "mlion", "aka": ["fairness gerrymandering", "subgroup fairness", "statistical parity subgroup fairness"], "q": "Fair by race, fair by gender, unfair where they intersect. Kearns et al. named it gerrymandering." },

    { "a": "Multiaccuracy", "t": "longtail", "aka": ["multi-accuracy"] },
    { "a": "Minimax fairness", "t": "longtail", "aka": ["minimax group fairness", "minimax pareto fairness"] },
    { "a": "Path-specific fairness", "t": "longtail", "aka": ["path-specific counterfactual fairness", "path specific"] },
    { "a": "No unresolved discrimination", "t": "longtail", "aka": ["no proxy discrimination", "unresolved discrimination", "proxy discrimination"] },
    { "a": "Envy-freeness", "t": "longtail", "aka": ["envy free", "envy-free", "preference-based fairness"], "q": "Borrowed from cake-cutting: no group would trade its outcomes for another's." },
    { "a": "Differential fairness", "t": "longtail" },
    { "a": "Balance for the positive class", "t": "longtail", "aka": ["balance for the negative class", "balance"] },
    { "a": "Theil index", "t": "longtail", "aka": ["theil"], "q": "An economist's inequality index, now shipped in IBM's AIF360." },
    { "a": "Generalized entropy index", "t": "longtail", "aka": ["generalized entropy"] },
    { "a": "Consistency", "t": "longtail", "aka": ["knn consistency", "k-nn consistency"] },
    { "a": "Strong demographic parity", "t": "longtail", "aka": ["distributional parity", "wasserstein demographic parity"] },
    { "a": "xAUC", "t": "longtail", "aka": ["cross-auc"] },
    { "a": "ABROCA", "t": "longtail", "aka": ["absolute between-roc area"] },
    { "a": "Subgroup AUC", "t": "longtail", "aka": ["BPSN AUC", "BNSP AUC", "bias AUC"] },
    { "a": "Fairness of exposure", "t": "longtail", "aka": ["equal exposure", "disparate exposure", "exposure"], "q": "Singh & Joachims: rankings hand out attention, so share it in proportion to merit." },
    { "a": "Equity of attention", "t": "longtail" },
    { "a": "Gini coefficient", "t": "longtail", "aka": ["gini"] },
    { "a": "Delayed impact", "t": "longtail", "aka": ["long-term fairness", "delayed impact of fair ml"] },
    { "a": "Procedural fairness", "t": "longtail" },
    { "a": "SEAT", "t": "longtail", "aka": ["sentence encoder association test"] },
    { "a": "Direct bias", "t": "longtail", "aka": ["bolukbasi direct bias"] },
    { "a": "StereoSet", "t": "longtail" },
    { "a": "CrowS-Pairs", "t": "longtail", "aka": ["crows pairs"] },
    { "a": "BBQ", "t": "longtail", "aka": ["bias benchmark for qa"] },
    { "a": "WinoBias", "t": "longtail" },
    { "a": "Winogender", "t": "longtail" },
    { "a": "Counterfactual token fairness", "t": "longtail", "aka": ["CTF"] },

    { "a": "Conditional use accuracy equality", "t": "outlier", "aka": ["PPV and NPV parity"] },
    { "a": "Disparate mistreatment", "t": "outlier" },
    { "a": "Disparate treatment", "t": "outlier" },
    { "a": "Multicalibration", "t": "outlier", "aka": ["multi-calibration"], "q": "Calibrated on every efficiently identifiable subgroup at once. Hébert-Johnson et al. 2018." },
    { "a": "Rawlsian fairness", "t": "outlier", "aka": ["max-min fairness", "maxmin", "rawls", "rawlsian"] },
    { "a": "Worst-group accuracy", "t": "outlier", "aka": ["worst group", "worst-group error"], "q": "Group DRO's yardstick: judge the model on the group it serves worst." },
    { "a": "Intersectional fairness", "t": "outlier", "aka": ["intersectionality"] },
    { "a": "Average odds difference", "t": "outlier", "aka": ["average absolute odds difference", "AOD"], "q": "Mean of the FPR gap and the TPR gap. AIF360 reports it by default." },
    { "a": "WEAT", "t": "outlier", "aka": ["word embedding association test"], "q": "The IAT, run on word2vec. Caliskan et al. 2017 found the same biases people have." },

    { "a": "Predictive equality", "t": "indist", "aka": ["FPR parity", "false positive rate parity", "false positive error rate balance"] },
    { "a": "Conditional statistical parity", "t": "indist", "aka": ["conditional demographic parity"] },
    { "a": "Treatment equality", "t": "indist", "q": "Match the FN/FP ratio across groups. The odd one out in most fairness surveys." },
    { "a": "Individual fairness", "t": "indist", "aka": ["fairness through awareness", "lipschitz fairness"], "q": "Dwork et al. 2012: similar individuals, similar outcomes. Now define \"similar\"." },
    { "a": "Calibration within groups", "t": "indist", "aka": ["calibration", "group calibration", "well-calibration", "sufficiency", "test-fairness"], "q": "A score of 0.7 means 70% for everyone. Kleinberg et al. proved you can't also have equal error rates." },
    { "a": "Predictive parity", "t": "indist", "aka": ["PPV parity", "positive predictive value parity", "outcome test"], "q": "The COMPAS defense. Kleinberg and Chouldechova showed why it clashes with equalized odds." },
    { "a": "Fairness through unawareness", "t": "indist", "aka": ["unawareness", "blindness", "anti-classification", "FTU"], "q": "Just delete the race column. Zip code would like a word." },
    { "a": "Accuracy parity", "t": "indist", "aka": ["overall accuracy equality", "equal accuracy"] },
    { "a": "Group fairness", "t": "indist", "aka": ["group"] },

    { "a": "Counterfactual fairness", "t": "overfit", "aka": ["counterfactual"], "q": "Kusner et al. 2017: would the decision change in the world where your race did? Causal graph required." },

    { "a": "Demographic parity", "t": "baseline", "aka": ["statistical parity", "independence", "statistical parity difference", "demographic parity difference", "selection rate parity"], "q": "Equal positive rates across groups, regardless of who actually qualifies." },
    { "a": "Equalized odds", "t": "baseline", "aka": ["equalised odds", "separation", "error rate balance", "equalized odds difference"], "q": "Hardt, Price & Srebro 2016: equal TPR and FPR across groups. Separation, formally." },
    { "a": "Equal opportunity", "t": "baseline", "aka": ["equality of opportunity", "TPR parity", "true positive rate parity", "FNR parity", "equal opportunity difference"], "q": "Equalized odds' easier half: just match true positive rates." },
    { "a": "Disparate impact", "t": "baseline", "aka": ["four-fifths rule", "80% rule", "p% rule", "disparate impact ratio", "adverse impact"], "q": "The US four-fifths rule: a selection rate under 80% of the top group's raises a flag." }
  ]
}
