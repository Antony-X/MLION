{
  "id": "dim-reduction",
  "pack": "classic",
  "text": "Name a dimensionality reduction technique",
  "note": "Any way of mapping data to fewer dimensions: projections, manifold learning, factorizations, autoencoders and feature selection",
  "strip": ["dimensionality", "dimension", "dimensional", "reduction", "technique", "method", "analysis"],
  "answers": [
    { "a": "Oja's rule", "t": "mlion", "aka": ["oja", "oja rule", "oja's learning rule"], "q": "Oja, 1982: one Hebbian neuron with weight normalization converges to the top principal component." },

    { "a": "Randomized SVD", "t": "longtail", "aka": ["randomized PCA"] },
    { "a": "Bayesian PCA", "t": "longtail", "aka": ["BPCA"] },
    { "a": "Functional PCA", "t": "longtail", "aka": ["FPCA", "functional principal component analysis"] },
    { "a": "Multilinear PCA", "t": "longtail", "aka": ["MPCA"] },
    { "a": "Contrastive PCA", "t": "longtail", "aka": ["cPCA"] },
    { "a": "Kernel Fisher discriminant", "t": "longtail", "aka": ["KFD", "kernel discriminant analysis", "generalized discriminant analysis", "GDA", "kernel LDA"] },
    { "a": "LFDA", "t": "longtail", "aka": ["local fisher discriminant analysis"] },
    { "a": "Landmark MDS", "t": "longtail", "aka": ["LMDS"] },
    { "a": "FastMap", "t": "longtail" },
    { "a": "Modified LLE", "t": "longtail", "aka": ["MLLE", "modified locally linear embedding"] },
    { "a": "Hessian LLE", "t": "longtail", "aka": ["HLLE", "hessian eigenmaps", "hessian eigenmapping"] },
    { "a": "LTSA", "t": "longtail", "aka": ["local tangent space alignment"] },
    { "a": "SNE", "t": "longtail", "aka": ["stochastic neighbor embedding"] },
    { "a": "Parametric t-SNE", "t": "longtail" },
    { "a": "Parametric UMAP", "t": "longtail" },
    { "a": "DensMAP", "t": "longtail" },
    { "a": "TriMap", "t": "longtail", "q": "Amid & Warmuth, 2019: preserve which point is closer within triplets." },
    { "a": "LargeVis", "t": "longtail" },
    { "a": "Ivis", "t": "longtail" },
    { "a": "Principal curves", "t": "longtail", "aka": ["principal curve", "principal surfaces"] },
    { "a": "GTM", "t": "longtail", "aka": ["generative topographic mapping", "generative topographic map"], "q": "Bishop, Svensén & Williams, 1998: the self-organizing map's probabilistic makeover." },
    { "a": "RBM", "t": "longtail", "aka": ["restricted boltzmann machine"], "q": "Hinton & Salakhutdinov, Science 2006: RBM-pretrained deep autoencoders beat PCA. Deep learning's comeback single." },
    { "a": "Sparse random projection", "t": "longtail", "aka": ["SparseRandomProjection", "achlioptas projection", "very sparse random projection"] },
    { "a": "Fast Johnson–Lindenstrauss transform", "t": "longtail", "aka": ["FJLT"] },
    { "a": "CUR decomposition", "t": "longtail", "aka": ["CUR"], "q": "A low-rank approximation built from actual rows and columns, so the factors stay interpretable." },
    { "a": "Tensor train", "t": "longtail", "aka": ["TT decomposition", "tensor-train decomposition", "TT-SVD"] },
    { "a": "pLSA", "t": "longtail", "aka": ["probabilistic latent semantic analysis", "pLSI", "probabilistic latent semantic indexing"] },
    { "a": "Kernel CCA", "t": "longtail", "aka": ["KCCA", "kernel canonical correlation analysis"] },
    { "a": "Deep CCA", "t": "longtail", "aka": ["DCCA", "deep canonical correlation analysis"] },
    { "a": "FAMD", "t": "longtail", "aka": ["factor analysis of mixed data"] },
    { "a": "Multiple factor analysis", "t": "longtail", "aka": ["MFA"] },
    { "a": "Sliced inverse regression", "t": "longtail", "aka": ["SIR"] },
    { "a": "SAVE", "t": "longtail", "aka": ["sliced average variance estimation"] },
    { "a": "Slow feature analysis", "t": "longtail", "aka": ["SFA"], "q": "Wiskott & Sejnowski, 2002: keep the features that change slowest over time." },
    { "a": "Locality preserving projections", "t": "longtail", "aka": ["LPP"] },
    { "a": "Neighborhood preserving embedding", "t": "longtail", "aka": ["NPE"] },
    { "a": "Maximum variance unfolding", "t": "longtail", "aka": ["MVU", "semidefinite embedding", "SDE"], "q": "Weinberger & Saul: pull points as far apart as possible while neighbor distances hold. Solved as an SDP." },
    { "a": "Curvilinear component analysis", "t": "longtail", "aka": ["curvilinear components analysis"] },
    { "a": "Archetypal analysis", "t": "longtail", "q": "Cutler & Breiman, 1994: write each point as a mix of extreme archetypes." },
    { "a": "Feature agglomeration", "t": "longtail", "aka": ["FeatureAgglomeration"] },
    { "a": "PAA", "t": "longtail", "aka": ["piecewise aggregate approximation"] },
    { "a": "SAX", "t": "longtail", "aka": ["symbolic aggregate approximation"], "q": "Turns a time series into a short string of letters. Lin, Keogh et al., 2003." },
    { "a": "Nyström method", "t": "longtail", "aka": ["nystroem", "nyström approximation"] },
    { "a": "Generalized Hebbian algorithm", "t": "longtail", "aka": ["GHA", "sanger's rule"] },

    { "a": "Sparse PCA", "t": "outlier", "aka": ["SparsePCA", "SPCA"] },
    { "a": "Incremental PCA", "t": "outlier", "aka": ["IPCA", "IncrementalPCA", "online PCA"] },
    { "a": "Probabilistic PCA", "t": "outlier", "aka": ["PPCA"] },
    { "a": "Robust PCA", "t": "outlier", "aka": ["RPCA", "principal component pursuit"], "q": "Candès et al.: low-rank plus sparse. Peels walking people off a static background." },
    { "a": "NCA", "t": "outlier", "aka": ["neighbourhood components analysis", "neighborhood components analysis"] },
    { "a": "Classical MDS", "t": "outlier", "aka": ["torgerson scaling", "principal coordinates analysis", "PCoA", "torgerson-gower scaling", "cMDS"], "q": "Torgerson, 1952. Feed it Euclidean distances and you get PCA back exactly." },
    { "a": "Non-metric MDS", "t": "outlier", "aka": ["NMDS", "nonmetric multidimensional scaling", "kruskal's MDS"] },
    { "a": "Diffusion maps", "t": "outlier", "aka": ["diffusion map"], "q": "Coifman & Lafon: distance measured by how fast random walks spread between points." },
    { "a": "PLS", "t": "outlier", "aka": ["partial least squares", "projection to latent structures", "PLS regression", "PLS-DA"] },
    { "a": "Correspondence analysis", "t": "outlier", "aka": ["CA"] },
    { "a": "Multiple correspondence analysis", "t": "outlier", "aka": ["MCA"] },
    { "a": "Self-organizing map", "t": "outlier", "aka": ["SOM", "kohonen map", "self-organising map"] },
    { "a": "Feature hashing", "t": "outlier", "aka": ["hashing trick", "FeatureHasher"], "q": "Hash features into a fixed number of buckets. Collisions are a feature." },
    { "a": "Dictionary learning", "t": "outlier", "aka": ["sparse coding", "DictionaryLearning", "sparse dictionary learning"] },
    { "a": "Lasso", "t": "outlier", "aka": ["L1 regularization", "least absolute shrinkage and selection operator"] },
    { "a": "Recursive feature elimination", "t": "outlier", "aka": ["RFE", "RFECV"] },
    { "a": "Forward selection", "t": "outlier", "aka": ["forward feature selection", "sequential forward selection", "SFS"] },
    { "a": "Backward elimination", "t": "outlier", "aka": ["backward feature elimination", "sequential backward selection", "SBS"] },
    { "a": "Variance threshold", "t": "outlier", "aka": ["low variance filter", "VarianceThreshold"] },
    { "a": "PaCMAP", "t": "outlier", "aka": ["pairwise controlled manifold approximation"], "q": "Wang, Huang, Rudin & Shaposhnik, 2021: near, mid-near and far pairs keep both local and global structure." },
    { "a": "PHATE", "t": "outlier", "q": "Built for single-cell trajectories: diffusion potentials, then MDS." },
    { "a": "Sammon mapping", "t": "outlier", "aka": ["sammon projection", "sammon's mapping"], "q": "Sammon, 1969: MDS that weights small distances more, so local structure survives." },
    { "a": "Projection pursuit", "t": "outlier", "aka": ["exploratory projection pursuit"], "q": "Friedman & Tukey, 1974: hunt for the most 'interesting', least Gaussian projections." },
    { "a": "Latent Dirichlet allocation", "t": "outlier" },
    { "a": "CP decomposition", "t": "outlier", "aka": ["CANDECOMP", "PARAFAC", "CPD", "canonical polyadic decomposition"] },
    { "a": "Tucker decomposition", "t": "outlier", "aka": ["HOSVD", "higher-order SVD", "tucker"] },
    { "a": "GPLVM", "t": "outlier", "aka": ["gaussian process latent variable model"] },

    { "a": "LDA", "t": "indist", "aka": ["linear discriminant analysis", "fisher's linear discriminant", "fisher discriminant analysis"], "q": "Supervised: maximize between-class over within-class scatter. At most C−1 dimensions." },
    { "a": "Kernel PCA", "t": "indist", "aka": ["KPCA", "kernel principal component analysis"], "q": "Schölkopf, Smola & Müller, 1998: PCA in a feature space you never compute." },
    { "a": "ICA", "t": "indist", "aka": ["independent component analysis", "FastICA", "infomax ICA"], "q": "Unmix the cocktail party: find maximally non-Gaussian, independent sources." },
    { "a": "Factor analysis", "t": "indist", "aka": ["FA", "exploratory factor analysis", "EFA", "common factor analysis"] },
    { "a": "MDS", "t": "indist", "aka": ["multidimensional scaling", "metric MDS"] },
    { "a": "NMF", "t": "indist", "aka": ["non-negative matrix factorization", "NNMF"], "q": "Lee & Seung, Nature 1999: non-negative parts that add up to faces." },
    { "a": "Random projection", "t": "indist", "aka": ["gaussian random projection", "GaussianRandomProjection", "johnson-lindenstrauss", "JL lemma", "JL transform"], "q": "Johnson–Lindenstrauss: random directions keep pairwise distances within ε in O(log n / ε²) dims." },
    { "a": "VAE", "t": "indist", "aka": ["variational autoencoder"] },
    { "a": "LSA", "t": "indist", "aka": ["latent semantic analysis", "latent semantic indexing", "LSI"], "q": "Truncated SVD of a term-document matrix, 1990. Search's first taste of semantics." },
    { "a": "Feature selection", "t": "indist", "aka": ["variable selection", "attribute selection", "subset selection"] },
    { "a": "Laplacian eigenmaps", "t": "indist", "aka": ["spectral embedding", "SpectralEmbedding"], "q": "Belkin & Niyogi: the bottom eigenvectors of a graph Laplacian become your coordinates." },
    { "a": "CCA", "t": "indist", "aka": ["canonical correlation analysis"] },
    { "a": "Matrix factorization", "t": "indist", "aka": ["low-rank matrix factorization", "low-rank approximation", "low rank factorization"] },

    { "a": "Isomap", "t": "overfit", "aka": ["isometric mapping", "isometric feature mapping", "landmark isomap"], "q": "Tenenbaum, de Silva & Langford, Science 2000: geodesics through a kNN graph, then MDS." },
    { "a": "LLE", "t": "overfit", "aka": ["locally linear embedding"], "q": "Roweis & Saul, same Science issue as Isomap: rebuild each point from its neighbors, keep the weights." },

    { "a": "PCA", "t": "baseline", "aka": ["principal component analysis", "principal components analysis", "karhunen-loeve transform", "KLT", "hotelling transform", "proper orthogonal decomposition", "POD", "empirical orthogonal functions", "EOF"], "q": "Pearson, 1901; Hotelling, 1933. Still the first thing anyone tries." },
    { "a": "SVD", "t": "baseline", "aka": ["singular value decomposition", "truncated SVD", "TruncatedSVD"] },
    { "a": "t-SNE", "t": "baseline", "aka": ["t-distributed stochastic neighbor embedding", "barnes-hut t-SNE", "BH-SNE", "FIt-SNE", "openTSNE"], "q": "van der Maaten & Hinton, 2008. Cluster sizes and gaps in the plot mean less than you think." },
    { "a": "UMAP", "t": "baseline", "aka": ["uniform manifold approximation and projection"], "q": "McInnes et al., 2018: fuzzy simplicial sets and category theory, in service of prettier scatter plots." },
    { "a": "Autoencoder", "t": "baseline", "aka": ["AE", "deep autoencoder", "stacked autoencoder", "undercomplete autoencoder"] }
  ]
}
