{
  "id": "matrix-decomposition",
  "pack": "theory",
  "text": "Name a matrix decomposition",
  "note": "Any way of factoring a matrix (or tensor) into a product of structured pieces",
  "strip": ["decomposition", "factorization", "factorisation", "matrix", "form"],
  "answers": [
    { "a": "Butterfly factorization", "t": "mlion", "aka": ["butterfly", "butterfly matrices", "butterfly matrix"], "q": "The FFT is secretly log n sparse butterflies. Dao et al. learned the wings instead." },

    { "a": "Hessenberg", "t": "longtail", "aka": ["upper hessenberg"] },
    { "a": "Golub–Kahan bidiagonalization", "t": "longtail", "aka": ["bidiagonalization", "bidiagonal", "golub kahan", "lanczos bidiagonalization"] },
    { "a": "Lanczos tridiagonalization", "t": "longtail", "aka": ["lanczos", "tridiagonalization", "tridiagonal"], "q": "Krylov subspaces + a three-term recurrence. Loses orthogonality if you blink." },
    { "a": "QZ", "t": "longtail", "aka": ["generalized schur", "qz algorithm"] },
    { "a": "Generalized SVD", "t": "longtail", "aka": ["GSVD", "generalized singular value decomposition"] },
    { "a": "Higher-order SVD", "t": "longtail", "aka": ["HOSVD", "higher order singular value decomposition", "multilinear svd"] },
    { "a": "Tensor train", "t": "longtail", "aka": ["TT", "TT decomposition", "matrix product state", "MPS"], "q": "Physicists called it a matrix product state first. Oseledets gave it a train." },
    { "a": "Tensor ring", "t": "longtail", "aka": ["TR decomposition"] },
    { "a": "Hierarchical Tucker", "t": "longtail", "aka": ["HT decomposition", "h-tucker"] },
    { "a": "Block term", "t": "longtail", "aka": ["BTD", "block term decomposition"] },
    { "a": "PARAFAC2", "t": "longtail" },
    { "a": "t-SVD", "t": "longtail", "aka": ["tensor svd", "tensor singular value decomposition"] },
    { "a": "Interpolative", "t": "longtail", "aka": ["ID", "interpolative decomposition"], "q": "Pick k actual columns and express the rest in terms of them." },
    { "a": "Incomplete Cholesky", "t": "longtail", "aka": ["ichol"] },
    { "a": "Pivoted Cholesky", "t": "longtail", "q": "GPyTorch's favorite preconditioner. Greedy, low-rank, surprisingly good." },
    { "a": "Rank-revealing QR", "t": "longtail", "aka": ["RRQR", "QR with column pivoting", "pivoted QR", "QRCP"] },
    { "a": "RQ", "t": "longtail" },
    { "a": "LQ", "t": "longtail" },
    { "a": "QL", "t": "longtail" },
    { "a": "Jordan–Chevalley", "t": "longtail", "aka": ["jordan chevalley", "SN decomposition"] },
    { "a": "Smith normal form", "t": "longtail", "aka": ["smith"] },
    { "a": "Hermite normal form", "t": "longtail", "aka": ["hermite", "HNF"] },
    { "a": "Rational canonical form", "t": "longtail", "aka": ["frobenius normal form", "frobenius"] },
    { "a": "Takagi", "t": "longtail", "aka": ["takagi factorization", "autonne takagi"] },
    { "a": "Bunch–Kaufman", "t": "longtail", "aka": ["bunch kaufman"] },
    { "a": "Cartan", "t": "longtail", "aka": ["KAK", "KAK decomposition"] },
    { "a": "Iwasawa", "t": "longtail" },
    { "a": "Bruhat", "t": "longtail" },
    { "a": "CS decomposition", "t": "longtail", "aka": ["cosine-sine decomposition", "cosine sine"] },
    { "a": "Block LU", "t": "longtail" },
    { "a": "Rank factorization", "t": "longtail", "aka": ["full rank factorization", "rank decomposition"] },
    { "a": "Semi-NMF", "t": "longtail", "aka": ["semi-nonnegative", "convex nmf"] },
    { "a": "Boolean matrix factorization", "t": "longtail", "aka": ["BMF", "boolean"] },
    { "a": "Probabilistic matrix factorization", "t": "longtail", "aka": ["PMF", "probabilistic"] },
    { "a": "SVD++", "t": "longtail", "q": "Koren's Netflix Prize upgrade: SVD plus implicit feedback. Plus plus." },
    { "a": "K-SVD", "t": "longtail" },
    { "a": "Sparse PCA", "t": "longtail", "aka": ["sparse principal component analysis", "SPCA"] },
    { "a": "Dynamic mode decomposition", "t": "longtail", "aka": ["DMD", "dynamic mode"], "q": "Fit a linear operator to snapshot data and read off its eigenmodes. Fluid dynamicists love it." },

    { "a": "CP", "t": "outlier", "aka": ["CANDECOMP", "PARAFAC", "CANDECOMP/PARAFAC", "canonical polyadic", "CPD"] },
    { "a": "Tucker", "t": "outlier", "aka": ["tucker decomposition"], "q": "A small core tensor times a factor matrix per mode. HOSVD is one way to compute it." },
    { "a": "CUR", "t": "outlier", "aka": ["skeleton", "pseudoskeleton", "CUR decomposition"], "q": "Keep actual columns and rows, so the factors still mean something." },
    { "a": "Nyström approximation", "t": "outlier", "aka": ["nystrom", "nystrom method"] },
    { "a": "Robust PCA", "t": "outlier", "aka": ["RPCA", "principal component pursuit", "low-rank plus sparse", "low rank + sparse"], "q": "Low-rank background plus sparse foreground. Candès et al. split the surveillance video." },
    { "a": "Dictionary learning", "t": "outlier", "aka": ["sparse coding", "sparse dictionary learning"] },
    { "a": "Funk SVD", "t": "outlier", "aka": ["Funk MF", "simon funk svd"], "q": "Simon Funk's Netflix Prize blog post: 'SVD' with no actual SVD in it." },
    { "a": "Factor analysis", "t": "outlier", "aka": ["FA"] },

    { "a": "Polar", "t": "indist", "aka": ["polar decomposition"], "q": "A = UP: a rotation times a stretch. Matrices in polar coordinates." },
    { "a": "LDLᵀ", "t": "indist", "aka": ["LDL", "LDLT", "LDL^T", "LDL transpose"] },
    { "a": "Randomized SVD", "t": "indist", "aka": ["randomized singular value decomposition", "halko martinsson tropp"], "q": "Halko, Martinsson & Tropp: sketch it with a random matrix, SVD the small thing." },
    { "a": "Alternating least squares", "t": "indist", "aka": ["ALS"], "q": "Fix one factor, solve, swap, repeat. Spark's recommender default." },
    { "a": "Latent semantic analysis", "t": "indist", "aka": ["LSA", "LSI", "latent semantic indexing"], "q": "Truncated SVD on a term-document matrix, 1990. Topic models before topic models." },
    { "a": "Schur", "t": "indist", "aka": ["schur decomposition", "real schur", "schur triangulation"] },
    { "a": "Jordan normal form", "t": "indist", "aka": ["jordan", "jordan canonical form", "jordan decomposition"], "q": "Exists for every square matrix over ℂ and is numerically useless. Beautiful anyway." },
    { "a": "Truncated SVD", "t": "indist", "aka": ["TruncatedSVD", "low-rank approximation", "low rank", "rank-k approximation", "eckart-young"] },
    { "a": "PCA", "t": "indist", "aka": ["principal component analysis", "POD", "proper orthogonal decomposition", "karhunen-loeve", "KLT", "hotelling transform"], "q": "Technically an eigendecomposition of the covariance wearing a trench coat." },
    { "a": "NMF", "t": "indist", "aka": ["non-negative matrix factorization", "nonnegative matrix factorization", "NNMF"], "q": "Lee & Seung 1999: faces as sums of parts, since nothing is allowed to be negative." },
    { "a": "ICA", "t": "indist", "aka": ["independent component analysis", "FastICA"], "q": "Unmixes the cocktail party, as long as nobody there is Gaussian." },

    { "a": "Cholesky", "t": "overfit", "aka": ["LLᵀ", "LLT", "cholesky decomposition"], "q": "LLᵀ for positive-definite matrices. Every Gaussian-process sampler leans on it." },

    { "a": "SVD", "t": "baseline", "aka": ["singular value decomposition"], "q": "Every matrix is rotate, stretch, rotate. Linear algebra's universal answer." },
    { "a": "Eigendecomposition", "t": "baseline", "aka": ["eigenvalue decomposition", "eigen decomposition", "eigen", "spectral decomposition", "EVD", "diagonalization"] },
    { "a": "QR", "t": "baseline", "aka": ["gram-schmidt", "householder", "householder qr", "givens"], "q": "Orthogonal times upper triangular. Least squares solved without forming XᵀX." },
    { "a": "LU", "t": "baseline", "aka": ["PLU", "LUP", "LU with partial pivoting", "gaussian elimination", "doolittle", "crout"] }
  ]
}
