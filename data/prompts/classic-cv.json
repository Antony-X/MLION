    { "a": "Exemplar-based inpainting", "t": "longtail", "aka": ["Criminisi inpainting", "Criminisi algorithm"] },
    { "a": "Image quilting", "t": "longtail", "aka": ["Texture quilting", "Efros-Freeman"] },
