{
  "id": "classic-cv",
  "pack": "classic",
  "text": "Name a classic computer vision technique",
  "note": "Hand-crafted or pre-deep-learning vision and image processing: features, filters, segmentation, geometry, tracking. No CNNs or learned deep models",
  "strip": ["algorithm", "method", "technique", "detector", "filter", "operator", "descriptor", "detection"],
  "answers": [
    { "a": "Roberts cross", "t": "mlion", "aka": ["Roberts operator", "Roberts edge detector", "Roberts cross edge detector"], "q": "Lawrence Roberts' 2x2 gradient kernel, from his 1963 MIT thesis. He later led the design of the ARPANET." },

    { "a": "SIFT", "t": "baseline", "aka": ["Scale-Invariant Feature Transform"], "q": "Lowe's patent expired in March 2020, after which OpenCV moved SIFT from its non-free module into the main library." },
    { "a": "Canny edge detector", "t": "baseline", "aka": ["Canny"], "q": "Canny's 1986 criteria: good detection, good localization, one response per edge. Hysteresis keeps weak edges only if they touch strong ones." },
    { "a": "Hough transform", "t": "baseline", "aka": ["Hough", "Hough lines", "Hough circle", "Hough line transform", "Hough circle transform", "Circle Hough transform"], "q": "Paul Hough patented it in 1962 for bubble chamber tracks. The rho-theta line form we use is Duda and Hart's, from 1972." },
    { "a": "HOG", "t": "baseline", "aka": ["Histogram of Oriented Gradients", "Histograms of Oriented Gradients", "HOG features"], "q": "Dalal and Triggs, 2005, for pedestrians: gradient orientation histograms over 8x8 cells, normalized in overlapping blocks." },
    { "a": "Viola-Jones", "t": "baseline", "aka": ["Haar cascade", "Haar cascades", "Haar cascade classifier", "Haar-like features", "Cascade classifier", "Viola Jones face detector"], "q": "The first real-time face detector (2001): 15 frames per second on a 700 MHz Pentium III." },
    { "a": "Sobel operator", "t": "baseline", "aka": ["Sobel edge detector"], "q": "Presented at a 1968 Stanford AI talk and never published. The world met it through a footnote in Duda and Hart's 1973 book." },
    { "a": "Harris corner detector", "t": "baseline", "aka": ["Harris", "Harris corners", "Harris-Stephens"], "q": "Harris and Stephens, 1988. The response is det(M) - k * trace(M)^2, with k around 0.04 to 0.06." },

    { "a": "RANSAC", "t": "overfit", "aka": ["Random Sample Consensus"], "q": "Fischler and Bolles, 1981: fit random minimal subsets and keep the model with the most inliers." },
    { "a": "SURF", "t": "overfit", "aka": ["Speeded-Up Robust Features"], "q": "Box filters on an integral image make it fast. It is patented, so OpenCV keeps it in the non-free contrib module." },
    { "a": "Optical flow", "t": "overfit", "aka": ["Optic flow", "Dense optical flow", "Sparse optical flow"], "q": "The term goes back to the psychologist James J. Gibson in the 1940s, describing the motion seen by a moving observer." },

    { "a": "ORB", "t": "indist", "aka": ["Oriented FAST and Rotated BRIEF", "ORB features"], "q": "Oriented FAST plus rotated BRIEF, built by the OpenCV team in 2011 as a free alternative to SIFT and SURF." },
    { "a": "Lucas-Kanade", "t": "indist", "aka": ["Lucas-Kanade optical flow", "LK optical flow", "Pyramidal Lucas-Kanade"], "q": "1981: assume constant motion inside a small window and solve a tiny least-squares problem. The pyramidal version handles large motions." },
    { "a": "Otsu's method", "t": "indist", "aka": ["Otsu", "Otsu thresholding", "Otsu threshold", "Otsu binarization"], "q": "Nobuyuki Otsu, 1979: picks the threshold that maximizes the between-class variance." },
    { "a": "Watershed", "t": "indist", "aka": ["Watershed segmentation", "Marker-controlled watershed"], "q": "Treats the image as a topographic surface and floods it from markers." },
    { "a": "Mean shift", "t": "indist", "aka": ["Mean shift clustering", "Mean shift segmentation", "Mean shift tracking"], "q": "Fukunaga and Hostetler, 1975. Comaniciu and Meer made it a workhorse for segmentation and tracking." },
    { "a": "Kalman filter", "t": "indist", "aka": ["Kalman filtering"], "q": "NASA used it for Apollo navigation." },
    { "a": "Template matching", "t": "indist", "aka": ["Normalized cross-correlation", "NCC", "Cross-correlation matching", "Normalised cross-correlation"], "q": "Slide a small image over a big one and score every position, often by normalized cross-correlation." },
    { "a": "Gaussian blur", "t": "indist", "aka": ["Gaussian smoothing", "Gaussian blurring", "Gaussian filtering", "Gaussian filter"], "q": "A Gaussian is separable, so a 2D blur costs two 1D passes." },
    { "a": "Morphological operations", "t": "indist", "aka": ["Mathematical morphology", "Morphology", "Morphological image processing", "Morphological transformations", "Morphological filtering"], "q": "Mathematical morphology grew out of Matheron and Serra's work at the Ecole des Mines in Fontainebleau in the 1960s." },
    { "a": "Erosion", "t": "indist", "aka": ["Image erosion", "Morphological erosion"], "q": "Morphology: shrink bright regions, removing specks. Erosion then dilation is an opening." },
    { "a": "Dilation", "t": "indist", "aka": ["Image dilation", "Morphological dilation"], "q": "Morphology: grow bright regions by a structuring element, closing small gaps." },
    { "a": "Histogram equalization", "t": "indist", "aka": ["Histogram equalisation", "HE"], "q": "Remaps intensities through the image's own cumulative histogram." },
    { "a": "Bilateral filter", "t": "indist", "aka": ["Bilateral filtering"], "q": "Tomasi and Manduchi, 1998: weights neighbours by both spatial distance and intensity difference, so edges survive." },
    { "a": "Median filter", "t": "indist", "aka": ["Median filtering", "Median blur"], "q": "John Tukey introduced the running median. It removes salt-and-pepper noise while keeping edges." },
    { "a": "Non-maximum suppression", "t": "indist", "aka": ["NMS", "Non-max suppression"], "q": "Born in edge detection and still used to prune duplicate boxes in many detectors." },
    { "a": "Image pyramid", "t": "indist", "aka": ["Gaussian pyramid", "Laplacian pyramid", "Image pyramids", "Scale pyramid"], "q": "Burt and Adelson's 1983 Laplacian pyramid is a compact image code." },
    { "a": "Fourier transform", "t": "indist", "aka": ["Fourier", "FFT", "Fast Fourier transform", "DFT", "Discrete Fourier transform", "Frequency domain filtering"], "q": "An image as a sum of sinusoids. Convolution becomes multiplication in the frequency domain." },
    { "a": "Shi-Tomasi corner detector", "t": "indist", "aka": ["Shi-Tomasi", "Good features to track", "Shi-Tomasi corners"], "q": "A small change to Harris: use the smaller eigenvalue directly. OpenCV's goodFeaturesToTrack uses it." },
    { "a": "FAST", "t": "indist", "aka": ["Features from Accelerated Segment Test", "FAST corners", "FAST corner detector"], "q": "Tests a ring of 16 pixels around each candidate corner. Rosten and Drummond, 2006." },
    { "a": "Laplacian", "t": "indist", "q": "Sum of second derivatives. It amplifies noise, so it is usually applied after a Gaussian blur." },
    { "a": "Eigenfaces", "t": "indist", "aka": ["Eigenface", "PCA faces"], "q": "The top PCA components of a face dataset look like ghostly faces. Turk and Pentland, 1991." },
    { "a": "Bag of visual words", "t": "indist", "aka": ["Bag of words", "Bag of features", "BoVW", "BoW"], "q": "Sivic and Zisserman's 2003 \"Video Google\" treated images like text documents." },
    { "a": "K-means segmentation", "t": "indist", "aka": ["K-means clustering", "Color quantization", "K-means color segmentation", "K-means"], "q": "Cluster pixel colours (sometimes with position) and label each pixel by its cluster." },
    { "a": "Thresholding", "t": "indist", "aka": ["Binary thresholding", "Image thresholding", "Global thresholding", "Simple thresholding"], "q": "Pixels above a value are foreground. Otsu's method (1979) picks the value automatically." },
    { "a": "Gabor filter", "t": "indist", "aka": ["Gabor filters", "Gabor wavelet", "Gabor wavelets"], "q": "Dennis Gabor won the 1971 Nobel Prize in Physics for holography. Gabor filters are a common model of V1 cells." },
    { "a": "Wavelet transform", "t": "indist", "aka": ["Wavelet", "Wavelets", "Haar wavelet", "Discrete wavelet transform", "DWT"], "q": "Localized waves at many scales, giving frequency and position at once. JPEG 2000 is built on it." },
    { "a": "Local binary patterns", "t": "indist", "aka": ["LBP", "Local binary pattern", "LBP histogram"], "q": "Threshold the 8 neighbours against the centre pixel and read the bits as a number." },
    { "a": "Edge detection", "t": "indist", "aka": ["Edge detectors"], "q": "Find sharp intensity changes: Sobel filters, or Canny (1986) with non-maximum suppression and hysteresis." },
    { "a": "Corner detection", "t": "indist", "aka": ["Corner detectors"], "q": "Find points where intensity changes in two directions: Harris & Stephens, 1988; Shi–Tomasi, 1994." },

    { "a": "Hu moments", "t": "outlier", "aka": ["Hu invariant moments", "Moment invariants", "Image moments"], "q": "Seven combinations of image moments that stay unchanged under translation, scale and rotation. Ming-Kuei Hu, 1962." },
    { "a": "Horn-Schunck", "t": "outlier", "aka": ["Horn-Schunck optical flow"], "q": "Horn and Schunck, 1981, the same year as Lucas-Kanade. A global smoothness term fills in flow where there is no texture." },
    { "a": "Farneback optical flow", "t": "outlier", "aka": ["Farneback"], "q": "OpenCV's calcOpticalFlowFarneback, based on polynomial expansion. Gunnar Farnebäck, 2003." },
    { "a": "Active contours", "t": "outlier", "aka": ["Snakes", "Active contour model", "Kass snakes", "Snake algorithm"], "q": "Kass, Witkin and Terzopoulos, 1988: a spline that wriggles toward edges by minimizing an energy, hence \"snakes\"." },
    { "a": "Level set method", "t": "outlier", "aka": ["Level sets", "Level set segmentation"], "q": "Osher and Sethian, 1988. Contours change topology for free because the curve is the zero level of a higher-dimensional function." },
    { "a": "GrabCut", "t": "outlier", "aka": ["GrabCut segmentation"], "q": "Rother, Kolmogorov and Blake at Microsoft Research, 2004: you draw a box and graph cuts do the rest." },
    { "a": "Graph cuts", "t": "outlier", "aka": ["Graph cut", "Min-cut segmentation", "Boykov-Kolmogorov"] },
    { "a": "Normalized cuts", "t": "outlier", "aka": ["Normalised cuts", "Ncut", "Shi-Malik normalized cuts"] },
    { "a": "Felzenszwalb segmentation", "t": "outlier", "aka": ["Felzenszwalb-Huttenlocher", "Graph-based segmentation", "Efficient graph-based image segmentation"], "q": "Selective Search starts from these regions." },
    { "a": "SLIC", "t": "outlier", "aka": ["SLIC superpixels", "Simple Linear Iterative Clustering", "Superpixels"], "q": "k-means in a 5-D (L, a, b, x, y) space with a local search window." },
    { "a": "Selective Search", "t": "outlier", "aka": ["Region proposals"], "q": "Its region proposals fed the original R-CNN." },
    { "a": "Deformable part model", "t": "outlier", "aka": ["DPM", "Deformable parts model", "Deformable part models", "Felzenszwalb DPM"], "q": "Dominated PASCAL VOC detection until R-CNN arrived in 2013." },
    { "a": "Eight-point algorithm", "t": "outlier", "aka": ["Normalized eight-point algorithm"], "q": "Longuet-Higgins, 1981, in Nature: reconstructing a scene from two projections." },
    { "a": "Epipolar geometry", "t": "outlier", "aka": ["Fundamental matrix", "Epipolar constraint", "Fundamental matrix estimation", "Essential matrix estimation"] },
    { "a": "Bundle adjustment", "t": "outlier", "aka": ["BA"], "q": "Named for the bundles of light rays between 3D points and camera centres, whose reprojection error it minimizes." },
    { "a": "Iterative Closest Point", "t": "outlier", "aka": ["ICP"], "q": "Besl and McKay, and independently Chen and Medioni, published it in 1992." },
    { "a": "Perspective-n-Point", "t": "outlier", "aka": ["PnP", "Perspective-n-Point problem", "Pose from points", "P3P", "solvePnP"] },
    { "a": "Homography estimation", "t": "outlier", "aka": ["Homography", "Planar homography", "Homography matrix"] },
    { "a": "Structure from motion", "t": "outlier", "aka": ["SfM", "Incremental SfM"] },
    { "a": "Semi-global matching", "t": "outlier", "aka": ["SGM", "Semi-global block matching", "SGBM"], "q": "Hirschmüller, 2005: aggregates matching costs along many 1D paths through the image." },
    { "a": "Stereo block matching", "t": "outlier", "aka": ["Block matching", "StereoBM", "Stereo matching", "Disparity map", "Disparity estimation", "Stereo correspondence"] },
    { "a": "Zhang's calibration method", "t": "outlier", "aka": ["Zhang calibration", "Camera calibration", "Checkerboard calibration", "Zhang's method"], "q": "Zhengyou Zhang, 2000: calibrate from several views of a flat checkerboard. OpenCV's calibrateCamera builds on it." },
    { "a": "Gaussian mixture background subtraction", "t": "outlier", "aka": ["MOG", "MOG2", "GMM background subtraction", "Mixture of Gaussians", "Stauffer-Grimson", "Background subtraction"], "q": "Stauffer and Grimson, 1999: model every pixel as a mixture of Gaussians." },
    { "a": "CAMShift", "t": "outlier", "aka": ["Continuously Adaptive Mean Shift", "CamShift tracker"], "q": "Gary Bradski's 1998 face tracker at Intel, built on mean shift." },
    { "a": "Particle filter", "t": "outlier", "aka": ["CONDENSATION", "Sequential Monte Carlo tracking"], "q": "Isard and Blake's 1998 CONDENSATION algorithm brought particle filters to visual tracking." },
    { "a": "KLT tracker", "t": "outlier", "aka": ["KLT", "Kanade-Lucas-Tomasi", "Kanade Lucas Tomasi tracker", "Feature tracking"] },
    { "a": "MOSSE", "t": "outlier", "aka": ["MOSSE tracker", "Correlation filter tracking", "Correlation filter tracker"], "q": "Bolme et al., CVPR 2010: a correlation filter tracker that ran at 669 frames per second." },
    { "a": "Seam carving", "t": "outlier", "aka": ["Content-aware resizing", "Content-aware image resizing", "Content-aware scaling", "Image retargeting"], "q": "Avidan and Shamir, 2007: delete the lowest-energy pixel path again and again to shrink an image without squashing the subject." },
    { "a": "Poisson image editing", "t": "outlier", "aka": ["Poisson blending", "Poisson image blending", "Gradient domain blending"], "q": "Pérez, Gangnet and Blake, 2003. A Poisson equation lets a pasted patch keep its gradients but take on the colours around it." },
    { "a": "PatchMatch", "t": "outlier", "aka": ["Randomized patch matching"], "q": "Barnes et al., 2009. It shipped in Photoshop CS5 as Content-Aware Fill." },
    { "a": "Anisotropic diffusion", "t": "outlier", "aka": ["Perona-Malik", "Perona-Malik diffusion"], "q": "Perona and Malik, 1990: smooth inside regions, not across edges." },
    { "a": "Non-local means", "t": "outlier", "aka": ["NLM", "Non-local means denoising"], "q": "Buades, Coll and Morel, 2005: average patches that look alike anywhere in the image." },
    { "a": "BM3D", "t": "outlier", "aka": ["Block-matching and 3D filtering", "BM3D denoising"] },
    { "a": "Unsharp masking", "t": "outlier", "aka": ["Unsharp mask", "USM", "Image sharpening", "Sharpening"], "q": "From darkroom photography: subtract a blurred copy to sharpen." },
    { "a": "Laplacian of Gaussian", "t": "outlier", "aka": ["LoG", "Marr-Hildreth", "Marr Hildreth edge detector"], "q": "Marr and Hildreth, 1980: the zero crossings of the LoG mark edges." },
    { "a": "Difference of Gaussians", "t": "outlier", "aka": ["DoG", "Difference of Gaussian"], "q": "A cheap approximation of the LoG. It is the blob detector inside SIFT." },
    { "a": "Integral image", "t": "outlier", "aka": ["Summed-area table", "Integral images"], "q": "Crow's 1984 summed-area table. Viola-Jones made it a face-detection workhorse." },
    { "a": "Connected component labeling", "t": "outlier", "aka": ["Connected components", "Connected-component analysis", "Blob labeling", "CCL"] },
    { "a": "Distance transform", "t": "outlier", "aka": ["Euclidean distance transform", "EDT", "Chamfer distance"] },
    { "a": "Opening", "t": "outlier", "aka": ["Morphological opening"], "q": "Erosion followed by dilation. Closing is the reverse." },
    { "a": "Closing", "t": "outlier", "aka": ["Morphological closing"], "q": "Dilation followed by erosion." },
    { "a": "Top-hat transform", "t": "outlier", "aka": ["Top hat", "White top-hat", "Black top-hat", "Black-hat"] },
    { "a": "Skeletonization", "t": "outlier", "aka": ["Thinning", "Image skeletonization", "Zhang-Suen thinning", "Medial axis"] },
    { "a": "Flood fill", "t": "outlier", "aka": ["Seed fill"] },
    { "a": "Region growing", "t": "outlier", "aka": ["Seeded region growing", "Region merging"] },
    { "a": "Color histogram", "t": "outlier", "aka": ["Color histograms", "Colour histogram", "Histogram features"] },
    { "a": "Gamma correction", "t": "outlier", "aka": ["Gamma", "Power-law transform", "Gamma adjustment"] },
    { "a": "Log transform", "t": "outlier", "aka": ["Logarithmic transformation", "Log transformation", "Logarithmic transform"], "q": "s = c log(1 + r): stretches dark pixels and compresses bright ones." },
    { "a": "CLAHE", "t": "outlier", "aka": ["Contrast Limited Adaptive Histogram Equalization", "Adaptive histogram equalization", "AHE"], "q": "Zuiderveld described it in Graphics Gems IV, 1994." },
    { "a": "MSER", "t": "outlier", "aka": ["Maximally Stable Extremal Regions"], "q": "Matas et al., 2002, for wide-baseline stereo: blobs whose area barely changes as the threshold sweeps." },
    { "a": "BRIEF", "t": "outlier", "aka": ["Binary Robust Independent Elementary Features"], "q": "Compares random pairs of pixels in a smoothed patch to build a binary string. Calonder et al., 2010." },
    { "a": "Adaptive thresholding", "t": "outlier", "aka": ["Adaptive threshold", "Local thresholding", "Adaptive Gaussian thresholding"] },
    { "a": "Prewitt operator", "t": "outlier", "aka": ["Prewitt edge detector"] },
    { "a": "Markov random field", "t": "outlier", "aka": ["MRF", "Markov random fields", "MRF segmentation"] },
    { "a": "Image convolution", "t": "outlier", "aka": ["Kernel convolution", "Spatial filtering", "Linear filtering", "Convolution", "2D convolution"] },
    { "a": "Color thresholding", "t": "outlier", "aka": ["HSV thresholding", "Color segmentation", "inRange", "Color-based segmentation", "Colour thresholding"] },
    { "a": "Sliding window", "t": "outlier" },
    { "a": "Box filter", "t": "outlier", "aka": ["Box blur", "Mean filter", "Boxcar filter"] },
    { "a": "SLAM", "t": "outlier", "aka": ["Simultaneous localization and mapping", "EKF-SLAM"] },
    { "a": "Visual odometry", "t": "outlier", "aka": ["VO", "Monocular visual odometry", "Stereo visual odometry"] },
    { "a": "Perspective transform", "t": "outlier", "aka": ["Perspective warp", "warpPerspective", "Perspective transformation", "Perspective warping"] },
    { "a": "Affine transformation", "t": "outlier", "aka": ["Affine transform", "Affine warp", "warpAffine", "Image warping"] },
    { "a": "Blob detection", "t": "outlier", "aka": ["SimpleBlobDetector", "Blob detectors"] },
    { "a": "Color space conversion", "t": "outlier", "aka": ["Colour space conversion", "HSV", "RGB to HSV", "Grayscale conversion", "Color conversion", "Color space", "RGB to grayscale"] },
    { "a": "Image histogram", "t": "outlier", "aka": ["Histogram", "Intensity histogram", "Histograms"] },
    { "a": "Image gradients", "t": "outlier", "aka": ["Gradient magnitude", "Image gradient", "Gradient image"] },
    { "a": "Bilinear interpolation", "t": "outlier", "aka": ["Bilinear resampling", "Bilinear filtering"] },
    { "a": "Bicubic interpolation", "t": "outlier", "aka": ["Bicubic resampling", "Bicubic"] },

    { "a": "Harris-Laplace", "t": "longtail", "aka": ["Harris-Affine"], "q": "Mikolajczyk and Schmid, 2004: Harris corners picked at the scale where the Laplacian peaks." },
    { "a": "Hessian-Affine", "t": "longtail", "aka": ["Hessian-Laplace"] },
    { "a": "Scale-space", "t": "longtail", "aka": ["Scale space theory"] },
    { "a": "BRISK", "t": "longtail", "aka": ["Binary Robust Invariant Scalable Keypoints"], "q": "Leutenegger, Chli and Siegwart, 2011." },
    { "a": "FREAK", "t": "longtail", "aka": ["Fast Retina Keypoint"], "q": "A binary descriptor sampled on a retina-like pattern. Alahi et al., 2012." },
    { "a": "KAZE", "t": "longtail", "aka": ["KAZE features"], "q": "Detects features in a nonlinear scale space instead of a Gaussian one. Alcantarilla et al., 2012." },
    { "a": "AKAZE", "t": "longtail", "aka": ["Accelerated-KAZE", "AKAZE features"] },
    { "a": "DAISY", "t": "longtail", "q": "Tola et al., 2010: a dense descriptor built for wide-baseline stereo." },
    { "a": "GLOH", "t": "longtail", "aka": ["Gradient Location and Orientation Histogram"] },
    { "a": "PCA-SIFT", "t": "longtail" },
    { "a": "RootSIFT", "t": "longtail", "q": "Take the square root of the L1-normalized SIFT vector, and Euclidean distance becomes the Hellinger kernel." },
    { "a": "Dense SIFT", "t": "longtail", "aka": ["DSIFT"] },
    { "a": "SIFT flow", "t": "longtail" },
    { "a": "Lowe's ratio test", "t": "longtail", "aka": ["Ratio test", "Ratio test for feature matching", "Lowe ratio test"], "q": "The SIFT paper suggested keeping a match only if the nearest neighbour is under 0.8 times as far as the second nearest." },
    { "a": "Fisher vector", "t": "longtail", "aka": ["Fisher vectors", "Improved Fisher vector"] },
    { "a": "VLAD", "t": "longtail", "aka": ["Vector of Locally Aggregated Descriptors"] },
    { "a": "Spatial pyramid matching", "t": "longtail", "aka": ["SPM", "Spatial pyramid"] },
    { "a": "Vocabulary tree", "t": "longtail", "aka": ["Hierarchical k-means vocabulary"] },
    { "a": "GIST descriptor", "t": "longtail", "aka": ["Gist features"] },
    { "a": "Aggregate channel features", "t": "longtail", "aka": ["ACF", "Integral channel features", "ICF"] },
    { "a": "Exemplar SVM", "t": "longtail", "aka": ["Exemplar SVMs"] },
    { "a": "Poselets", "t": "longtail", "aka": ["Poselet"] },
    { "a": "Implicit shape model", "t": "longtail", "aka": ["ISM"] },
    { "a": "Constellation model", "t": "longtail", "aka": ["Fergus Perona Zisserman model"] },
    { "a": "Pictorial structures", "t": "longtail", "aka": ["Pictorial structure model", "Fischler-Elschlager"], "q": "Fischler and Elschlager, 1973. The same Fischler as in RANSAC." },
    { "a": "Active appearance models", "t": "longtail", "aka": ["AAM", "Active appearance model"] },
    { "a": "Active shape models", "t": "longtail", "aka": ["ASM", "Active shape model"] },
    { "a": "Fisherfaces", "t": "longtail", "aka": ["Fisherface"] },
    { "a": "Shape context", "t": "longtail", "aka": ["Shape contexts"] },
    { "a": "Chamfer matching", "t": "longtail" },
    { "a": "Generalized Hough transform", "t": "longtail", "aka": ["GHT", "Generalised Hough transform"], "q": "Ballard, 1981: Hough voting for arbitrary shapes, using a table of edge orientations." },
    { "a": "Probabilistic Hough transform", "t": "longtail", "aka": ["PHT", "HoughLinesP", "Progressive probabilistic Hough transform"] },
    { "a": "Line Segment Detector", "t": "longtail", "aka": ["LSD", "LSD line detector"] },
    { "a": "Radon transform", "t": "longtail", "aka": ["Radon"], "q": "The mathematics behind CT reconstruction. Johann Radon, 1917." },
    { "a": "Phase correlation", "t": "longtail", "aka": ["Phase correlation registration", "FFT phase correlation"] },
