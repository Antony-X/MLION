    { "a": "Total variation denoising", "t": "longtail", "aka": ["TV denoising", "ROF model", "Rudin-Osher-Fatemi"] },
    { "a": "TV-L1 optical flow", "t": "longtail", "aka": ["TV-L1", "Dual TV-L1"] },
    { "a": "DIS optical flow", "t": "longtail", "aka": ["Dense Inverse Search", "DIS flow"] },
    { "a": "Retinex", "t": "longtail", "aka": ["Multi-scale Retinex", "MSR", "Single-scale Retinex"], "q": "Edwin Land, of Polaroid, coined the name from \"retina\" plus \"cortex\"." },
    { "a": "Gray world assumption", "t": "longtail", "aka": ["Grey world", "Gray world", "Gray-world white balance"] },
    { "a": "Demosaicing", "t": "longtail", "aka": ["Bayer demosaicing", "Debayering", "Bayer interpolation", "Color filter array interpolation"], "q": "Bryce Bayer's 1976 Kodak filter has twice as many green sites as red or blue." },
