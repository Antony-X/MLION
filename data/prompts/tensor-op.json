    { "a": "Moveaxis", "t": "longtail", "aka": ["movedim", "rollaxis", "move axis"] },
    { "a": "Rearrange", "t": "outlier", "aka": ["einops", "einops rearrange", "einops.rearrange"], "q": "einops: 'b c h w -> b (h w) c'. Reshapes you can actually read." },
    { "a": "Unfold", "t": "outlier", "aka": ["im2col", "extract patches", "extract_patches", "sliding_window_view", "sliding window", "patches"], "q": "im2col: copy every sliding patch into a column and convolution becomes one big matmul." },
    { "a": "Maximum", "t": "longtail", "aka": ["elementwise max", "element-wise maximum", "np.maximum", "fmax"] },
