{
  "id": "tensor-op",
  "pack": "blocks",
  "text": "Name a tensor operation",
  "note": "Operations on arrays and tensors, by their common framework-agnostic names (NumPy, PyTorch, JAX, TensorFlow): shape, math, reductions, linear algebra",
  "strip": ["op", "ops", "operation", "operations", "tensor", "torch", "np", "numpy", "tf", "jnp", "jax", "lax", "f", "nn", "functional", "linalg"],
  "answers": [
    { "a": "as_strided", "t": "mlion", "aka": ["as strided", "stride tricks", "stride_tricks", "np.lib.stride_tricks.as_strided"], "q": "Craft any view by lying about strides. NumPy's docs: \"This function has to be used with extreme care.\"" },

    { "a": "Matmul", "t": "baseline", "aka": ["matrix multiplication", "matrix multiply", "mm", "matrix product", "GEMM", "addmm", "general matrix multiply"], "q": "Most of a transformer's FLOPs, and the reason GPUs grew tensor cores." },
    { "a": "Reshape", "t": "baseline", "aka": ["view", "reshaping"], "q": "Same data, new shape. Complains only when the element counts disagree." },
    { "a": "Transpose", "t": "baseline", "aka": ["T", "swapaxes", "swapdims", "transposition", "matrix transpose"], "q": "Free in theory: just swap the strides. Then the next op demands contiguous memory." },
    { "a": "Concatenate", "t": "baseline", "aka": ["concat", "cat", "concatenation"], "q": "cat in PyTorch, concat in TensorFlow, concatenate in NumPy. One op, three names to typo." },
    { "a": "Addition", "t": "baseline", "aka": ["add", "element-wise addition", "elementwise add", "plus", "elementwise addition"], "q": "Residual connections are just this. Arguably the most important op in deep learning." },
    { "a": "Element-wise multiplication", "t": "baseline", "aka": ["Hadamard product", "elementwise product", "element-wise product", "mul", "multiply", "pointwise multiplication", "elementwise multiplication", "multiplication", "Schur product"], "q": "The Hadamard product, for those who want to sound fancy." },

    { "a": "Einsum", "t": "overfit", "aka": ["Einstein summation", "einsum notation", "Einstein notation"], "q": "One string, every contraction: 'bij,bjk->bik'. A 2018 blog post declared it all you need." },

    { "a": "Permute", "t": "indist", "aka": ["permute_dims", "permute dims", "dimension permutation", "axis permutation"], "q": "Reorder every axis at once. NCHW to NHWC and back again." },
    { "a": "Flatten", "t": "indist", "aka": ["ravel", "flattening"], "q": "Where the convnet ends and the classifier begins." },
    { "a": "Squeeze", "t": "indist", "q": "Removes size-1 dims. Squeeze a batch of one and the batch dimension vanishes too." },
    { "a": "Unsqueeze", "t": "indist", "aka": ["expand_dims", "expand dims", "newaxis", "add dimension", "None indexing"], "q": "Add a size-1 dim so broadcasting lines up. Also spelled None, newaxis and expand_dims." },
    { "a": "Broadcast", "t": "indist", "aka": ["broadcasting", "broadcast_to", "expand", "expand_as"], "q": "Align shapes from the right, stretch the 1s. Elegant, until it silently does the wrong thing." },
    { "a": "Stack", "t": "indist", "aka": ["stacking"], "q": "Concatenate's sibling: adds a new axis instead of growing an old one." },
    { "a": "Split", "t": "indist", "aka": ["array_split", "tensor_split", "hsplit", "vsplit", "dsplit", "splitting"] },
    { "a": "Slicing", "t": "indist", "aka": ["slice", "narrow", "basic indexing"], "q": "x[:, ::2] returns a view, so writing to it quietly edits the original." },
    { "a": "Indexing", "t": "indist", "aka": ["index", "fancy indexing", "advanced indexing", "integer indexing", "integer array indexing"] },
    { "a": "Gather", "t": "indist", "aka": ["take_along_axis", "gather_nd", "take along axis"], "q": "Pick values along an axis with an index tensor. Every DQN's Q-value lookup." },
    { "a": "Scatter", "t": "indist", "aka": ["scatter_", "scatter_nd", "index_put", "put_along_axis"], "q": "Gather in reverse: write values to indexed slots. Duplicate indices? Some write wins." },
    { "a": "Sum", "t": "indist", "aka": ["reduce_sum", "summation", "reduce sum"] },
    { "a": "Mean", "t": "indist", "aka": ["average", "reduce_mean", "avg", "reduce mean"] },
    { "a": "Max", "t": "indist", "aka": ["amax", "reduce_max", "max reduction", "reduce max"] },
    { "a": "Min", "t": "indist", "aka": ["amin", "reduce_min", "min reduction", "reduce min"] },
    { "a": "Argmax", "t": "indist", "aka": ["arg max"], "q": "Not differentiable, which is exactly why Gumbel-softmax exists." },
    { "a": "Dot product", "t": "indist", "aka": ["dot", "inner product", "inner", "vdot", "scalar product"], "q": "The atom of attention: queries dot keys." },
    { "a": "Outer product", "t": "indist", "aka": ["outer", "ger", "tensor product"], "q": "Column times row, rank one. Hebbian learning in a single op." },
    { "a": "Pad", "t": "indist", "aka": ["padding", "zero padding", "F.pad"] },
    { "a": "Where", "t": "indist", "aka": ["np.where", "conditional select", "select", "ternary"], "q": "Branch without branching: pick from x or y elementwise by a condition." },
    { "a": "Sort", "t": "indist", "aka": ["sorting"] },
    { "a": "Norm", "t": "indist", "aka": ["L2 norm", "vector norm", "matrix norm", "Frobenius norm", "Euclidean norm", "vector_norm", "matrix_norm"] },
    { "a": "Convolution", "t": "indist", "aka": ["conv", "conv2d", "convolve", "conv1d", "conv3d", "correlate", "cross-correlation"], "q": "In deep learning frameworks it's really cross-correlation. Nobody flips the kernel." },
    { "a": "Softmax", "t": "indist", "aka": ["soft max"], "q": "Subtract the max first or exp() overflows. Every framework quietly does it for you." },
    { "a": "Clamp", "t": "indist", "aka": ["clip", "clamping", "clipping"] },
    { "a": "Inverse", "t": "indist", "aka": ["matrix inverse", "inv", "inversion"], "q": "Numerical analysts beg you: call solve() instead of inv(). Faster and more stable." },
    { "a": "SVD", "t": "indist", "aka": ["singular value decomposition"], "q": "Every matrix is a rotation, a stretch, and another rotation." },
    { "a": "FFT", "t": "indist", "aka": ["fast Fourier transform", "rfft", "fft2", "fftn", "ifft", "inverse FFT", "Fourier transform"], "q": "Cooley-Tukey 1965, though Gauss got there around 1805. O(n log n) ever since." },
    { "a": "Cast", "t": "indist", "aka": ["type casting", "astype", "to dtype", "dtype conversion", "type conversion", "casting"] },
    { "a": "Subtraction", "t": "indist", "aka": ["sub", "subtract", "minus"] },
    { "a": "Division", "t": "indist", "aka": ["div", "divide", "true_divide", "true divide"] },
    { "a": "Pooling", "t": "indist", "aka": ["max pool", "avg pool", "max pooling", "average pooling", "max_pool2d", "avg_pool2d", "pool"] },

    { "a": "Tile", "t": "outlier", "aka": ["tiling"], "q": "Copies the whole tensor k times. PyTorch calls this repeat; NumPy's repeat means something else." },
    { "a": "Repeat", "t": "outlier", "aka": ["repeat_interleave", "repeat interleave"] },
    { "a": "hstack", "t": "outlier", "aka": ["horizontal stack", "column_stack", "column stack"] },
    { "a": "vstack", "t": "outlier", "aka": ["vertical stack", "row_stack", "row stack"] },
    { "a": "Chunk", "t": "outlier", "aka": ["chunking"] },
    { "a": "Unbind", "t": "longtail", "aka": ["unstack"] },
    { "a": "Index select", "t": "outlier", "aka": ["index_select", "take"] },
    { "a": "Scatter-add", "t": "outlier", "aka": ["scatter_add", "index_add", "scatter_reduce", "scatter reduce", "index_add_"], "q": "Message passing in one line: sum each edge's message into its target node." },
    { "a": "Masked fill", "t": "outlier", "aka": ["masked_fill", "fill with mask", "masked_fill_"], "q": "Set future positions to -inf before the softmax. The causal mask's favorite op." },
    { "a": "Boolean masking", "t": "outlier", "aka": ["boolean indexing", "boolean mask", "masked_select", "boolean_mask", "mask", "masking"] },
    { "a": "Nonzero", "t": "outlier", "aka": ["argwhere", "find", "flatnonzero"], "q": "Its output size depends on the data, which is why compilers hate it." },
    { "a": "Roll", "t": "outlier", "aka": ["circular shift", "np.roll", "cyclic shift"], "q": "Shift elements cyclically. Swin Transformer's shifted windows are a torch.roll." },
    { "a": "Flip", "t": "outlier", "aka": ["reverse", "fliplr", "flipud", "flipping"] },
    { "a": "Diagonal", "t": "outlier", "aka": ["diag", "diag_embed", "diagflat", "diagonal extraction"] },
